---
import { menuData } from '../data/menu';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const isES = lang === 'es';
const t = isES ? 'es' : 'en';

const drinks = menuData.drinks;
const food = menuData.foodPackage[t];

const waText = isES
  ? 'Hola! Quisiera hacer un pedido del menú.'
  : 'Hola! Me gustaría pedir algo del menú.';
const waHref = `https://wa.me/573163946401?text=${encodeURIComponent(waText)}`;
const waLabel = isES ? 'Pedir por WhatsApp →' : 'Order on WhatsApp →';

function formatCOP(price: number | null): string | null {
  if (price === null) return null;
  return `$${price.toLocaleString('es-CO')} COP`;
}
---

<div class="max-w-md mx-auto px-5 pt-10 pb-32">
  <div class="text-center mb-10">
    <img src="/images/logo.png" alt="Casa Gaviota Baru" class="h-14 w-auto mx-auto mb-5" />
    <p class="text-terracotta text-xs uppercase tracking-widest font-medium mb-2">
      {drinks[t].subtitle}
    </p>
    <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-brown">
      {drinks[t].title}
    </h1>
  </div>

  <!-- FOOD PACKAGE -->
  <section class="mb-12">
    <h2 class="font-serif text-2xl font-semibold text-brown mb-2 text-center">{food.title}</h2>
    <p class="text-sm text-ink/60 text-center mb-6">{food.description}</p>
    <div class="grid grid-cols-1 gap-4">
      {food.options.map(option => (
        <div class="bg-white border border-sand rounded-2xl p-5 shadow-sm">
          <div class="flex items-baseline justify-between gap-3 mb-3">
            <h3 class="font-serif text-lg font-semibold text-brown">{option.name}</h3>
            <p class="text-sm font-semibold text-brown whitespace-nowrap">{option.price}</p>
          </div>
          <ul class="space-y-1.5">
            {option.includes.map(item => (
              <li class="flex items-start gap-2 text-sm text-ink/70">
                <span class="text-terracotta font-bold flex-shrink-0">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="text-xs text-muted italic text-center mt-4">{food.note}</p>
  </section>

  <!-- DRINKS -->
  <section>
    {drinks.categories.map(category => (
      <div class="mb-9">
        <h2 class="font-serif text-xl font-semibold text-brown mb-3">{category[t].name}</h2>
        <div class="divide-y divide-sand/40">
          {category.items.map(item => (
            <div class="flex items-start justify-between gap-4 py-3">
              <div>
                <p class="text-sm font-medium text-ink">{item[t]}</p>
                {(isES ? item.description_es : item.description_en) && (
                  <p class="text-xs text-muted italic mt-0.5">
                    {isES ? item.description_es : item.description_en}
                  </p>
                )}
              </div>
              {formatCOP(item.price) && (
                <p class="text-sm font-semibold text-brown whitespace-nowrap">{formatCOP(item.price)}</p>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <p class="text-xs text-muted italic text-center mt-4">{drinks.note[t]}</p>
</div>

<!-- Sticky bottom WhatsApp order button -->
<a
  href={waHref}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-0 left-0 right-0 z-40 flex items-center justify-center gap-2 bg-whatsapp text-white font-semibold py-4 text-center shadow-[0_-2px_10px_rgba(0,0,0,0.1)]"
>
  <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
  {waLabel}
</a>
