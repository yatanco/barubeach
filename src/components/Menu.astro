---
import { menuData } from '../data/menu';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { waLink } from '../lib/whatsapp';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const isES = lang === 'es';
const t = isES ? 'es' : 'en';

const drinks = menuData.drinks;
const food = menuData.foodPackage[t];

const waText = isES
  ? 'Hola! Quisiera hacer un pedido del menú.'
  : 'Hola! Me gustaría pedir algo del menú.';
const waHref = waLink(waText);
const waLabel = isES ? 'Pedir por WhatsApp →' : 'Order on WhatsApp →';
---

<div class="max-w-md mx-auto px-5 pt-10 pb-32">
  <div class="text-center mb-10">
    <img src="/images/logo.png" alt="Casa Gaviota Baru" class="h-14 w-auto mx-auto mb-5" />
    <p class="text-terracotta text-xs uppercase tracking-widest font-medium mb-2">
      {drinks[t].subtitle}
    </p>
    <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-brown">
      {drinks[t].title}
    </h1>
  </div>

  <!-- FOOD PACKAGE -->
  <section class="mb-12">
    <div class="text-center mb-6">
      <h2 class="font-serif text-2xl font-semibold text-brown mb-2">{food.title}</h2>
      <p class="text-sm text-ink/60 mb-4">{food.subtitle}</p>
      <div class="inline-flex flex-col items-center gap-2">
        <span class="bg-sand text-brown text-sm font-semibold rounded-full px-4 py-1.5">{food.price}</span>
        <span class="text-xs text-brown/80 font-medium">{food.premiumLabel} · {food.premiumPrice}</span>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white border border-sand rounded-2xl p-5 shadow-sm">
        <h3 class="font-serif text-lg font-semibold text-brown mb-3">{food.breakfast.title}</h3>
        <ul class="space-y-1.5">
          {food.breakfast.items.map(item => (
            <li class="flex items-start gap-2 text-sm text-ink/70">
              <span class="flex-shrink-0">🌿</span>
              {item}
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-white border border-sand rounded-2xl p-5 shadow-sm">
        <h3 class="font-serif text-lg font-semibold text-brown mb-1">{food.lunch.title}</h3>
        <p class="text-xs text-muted italic mb-3">{food.lunch.subtitle}</p>
        <ul class="space-y-1.5">
          {food.lunch.items.map(item => (
            <li class="flex items-start gap-2 text-sm text-ink/70">
              <span class="flex-shrink-0">🌿</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <ul class="space-y-1.5 mt-5">
      {food.includes.map(item => (
        <li class="flex items-start gap-2 text-sm text-ink/70">
          <span class="text-terracotta font-bold flex-shrink-0">✓</span>
          {item}
        </li>
      ))}
    </ul>
    <p class="text-xs text-muted italic text-center mt-4">{food.note}</p>
  </section>

  <p class="text-xs text-muted italic text-center mt-4">{drinks.note[t]}</p>

  <div class="text-center mt-6">
    <a
      href={isES ? '/es/drinks' : '/drinks'}
      class="text-sm text-terracotta hover:text-brown font-medium underline underline-offset-4"
    >
      {isES ? 'Ver nuestra carta de bebidas →' : 'See our drinks menu →'}
    </a>
  </div>
</div>

<!-- Sticky bottom WhatsApp order button -->
<a
  href={waHref}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-0 left-0 right-0 z-40 flex items-center justify-center gap-2 bg-whatsapp text-white font-semibold py-4 text-center shadow-[0_-2px_10px_rgba(0,0,0,0.1)]"
>
  <WhatsAppIcon class="w-5 h-5 flex-shrink-0" />
  {waLabel}
</a>
