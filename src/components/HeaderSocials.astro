---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { waLink } from '../lib/whatsapp';

interface Props {
  lang?: 'en' | 'es';
  class?: string;
}
const { lang = 'en', class: className = '' } = Astro.props;
const isES = lang === 'es';

const INSTAGRAM_URL = 'https://instagram.com/casagaviotabaru';
const AIRBNB_URL = 'https://airbnb.com/h/casagaviotabaru';
const MAPS_URL = 'https://share.google/SHahHFkk8vXJIW7hH';

const airbnbLabel = isES ? 'Reservar en Airbnb' : 'Book on Airbnb';
const mapsLabel = isES ? 'Google Maps' : 'Google Maps';

const iconLinkClass = 'text-white/50 hover:text-white transition-colors';
