  <a href={waLink('gaviotafooter')} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" title="WhatsApp" class={iconLinkClass}>
    <WhatsAppIcon class="w-5 h-5" />
  </a>

  <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label="Instagram" title="Instagram" class={iconLinkClass}>
