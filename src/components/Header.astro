---
import WhatsAppIcon from './icons/WhatsAppIcon.astro';

interface Props {
  lang?: 'en' | 'es';
  altHref?: string;
}

const { lang = 'en', altHref } = Astro.props;
const isES = lang === 'es';

const altURL = altHref ?? (isES ? '/' : '/es');

// Hide nav escape hatches (lang switch, WhatsApp icon) for ad traffic — keep
// the toggle + CTA, since that's the conversion path we want ad clicks to hit.
const hasAd = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'gclid']
  .some(p => Astro.url.searchParams.has(p));

const waLabel = isES ? 'Consulta tus fechas y tu tarifa →' : 'Check your dates & get your rate →';
const flagLabel = isES ? '🇬🇧' : '🇪🇸';
const flagTitle = isES ? 'View in English' : 'Ver en español';

// Day Trip/Stay toggle — routes the CTA action:
// Day Trip → day-trip page, Stay → overnight-stay WhatsApp flow.
const daytripHref = isES ? '/es/pasadia' : '/daytrip';
const dayTripLabel = isES ? 'Pasadía' : 'Day Trip';
const stayLabel = isES ? 'Estadía' : 'Stay';
const tripToggleLabel = isES ? 'Pasadía o estadía' : 'Day trip or overnight stay';

const toggleTabClass = 'trip-toggle-btn px-3 py-1.5 rounded-full text-xs font-medium transition-colors cursor-pointer';
---

<header
  id="site-header"
  data-daytrip-href={daytripHref}
  class="sticky top-0 z-50 bg-brown"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- Desktop row -->
    <div class="hidden md:flex items-center justify-between h-16">
      <a href={isES ? '/es' : '/'} class="flex items-center gap-2.5 flex-shrink-0">
        <img src="/images/logo.png" alt="Casa Gaviota Baru" class="h-8 w-auto" />
        <span class="font-serif font-semibold text-white text-sm">Casa Gaviota</span>
      </a>

      <div class="flex items-center gap-4">
        <div
          role="tablist"
          aria-label={tripToggleLabel}
          class="trip-toggle inline-flex items-center gap-0.5 rounded-full border border-white/10 bg-white/5 p-0.5"
        >
          <button type="button" role="tab" data-mode="days" aria-selected="false" class={`${toggleTabClass} text-white/50 hover:text-white/80`}>
            {dayTripLabel}
          </button>
          <button type="button" role="tab" data-mode="nights" aria-selected="true" class={`${toggleTabClass} bg-white/15 text-white`}>
            {stayLabel}
          </button>
        </div>

        {!hasAd && (
          <button
            type="button"
            onclick="window.dispatchEvent(new CustomEvent('open-wa-popup'))"
            aria-label="WhatsApp"
            title="WhatsApp"
            class="text-white/40 hover:text-white transition-colors inline-flex items-center p-0 bg-transparent cursor-pointer"
          >
            <WhatsAppIcon class="w-5 h-5" />
          </button>
        )}

        <button
          type="button"
          class="check-availability-btn inline-flex items-center gap-1.5 bg-sand text-brown text-sm font-semibold px-5 py-2.5 rounded-full hover:opacity-90 transition-opacity cursor-pointer whitespace-nowrap"
        >
          {waLabel}
        </button>

        {!hasAd && (
          <a
            href={altURL}
            title={flagTitle}
            aria-label={flagTitle}
            class="text-base leading-none hover:opacity-70 transition-opacity select-none"
          >
            {flagLabel}
          </a>
        )}
      </div>
    </div>

    <!-- Mobile rows -->
    <div class="md:hidden py-3">
      <div class="flex items-center justify-between">
        <a href={isES ? '/es' : '/'} class="flex items-center gap-2 flex-shrink-0">
          <img src="/images/logo.png" alt="Casa Gaviota Baru" class="h-7 w-auto" />
          <span class="font-serif font-semibold text-white text-sm">Casa Gaviota</span>
        </a>

        {!hasAd && (
          <a
            href={altURL}
            title={flagTitle}
            aria-label={flagTitle}
            class="text-base leading-none hover:opacity-70 transition-opacity select-none"
          >
            {flagLabel}
          </a>
        )}
      </div>

      <div class="flex items-center gap-2 mt-3">
        <div
          role="tablist"
          aria-label={tripToggleLabel}
          class="trip-toggle inline-flex items-center gap-0.5 rounded-full border border-white/10 bg-white/5 p-0.5 flex-shrink-0"
        >
          <button type="button" role="tab" data-mode="days" aria-selected="false" class={`${toggleTabClass} text-white/50 hover:text-white/80`}>
            {dayTripLabel}
          </button>
          <button type="button" role="tab" data-mode="nights" aria-selected="true" class={`${toggleTabClass} bg-white/15 text-white`}>
            {stayLabel}
          </button>
        </div>

        <button
          type="button"
          class="check-availability-btn flex-1 inline-flex items-center justify-center gap-1.5 bg-sand text-brown text-sm font-semibold px-4 py-2.5 rounded-full hover:opacity-90 transition-opacity cursor-pointer text-center leading-tight"
        >
          {waLabel}
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  window.addEventListener('scroll', () => {
    const header = document.getElementById('site-header');
    if (!header) return;
    header.classList.toggle('shadow-md', window.scrollY > 10);
  });

  // Day Trip/Stay toggle — controls what the CTA buttons do.
  const daytripHref = document.getElementById('site-header')?.dataset.daytripHref || '/daytrip';
  const toggleBtns = document.querySelectorAll('.trip-toggle-btn');
  const ctaBtns = document.querySelectorAll('.check-availability-btn');
  let tripMode = 'nights';

  function renderTripMode() {
    toggleBtns.forEach((b) => {
      const el = b as HTMLElement;
      const active = el.dataset.mode === tripMode;
      el.setAttribute('aria-selected', String(active));
      el.classList.toggle('bg-white/15', active);
      el.classList.toggle('text-white', active);
      el.classList.toggle('text-white/50', !active);
      el.classList.toggle('hover:text-white/80', !active);
    });
  }

  toggleBtns.forEach((b) =>
    b.addEventListener('click', () => {
      tripMode = (b as HTMLElement).dataset.mode || 'nights';
      renderTripMode();
    })
  );

  ctaBtns.forEach((c) =>
    c.addEventListener('click', () => {
      if (tripMode === 'days') {
        window.location.href = daytripHref;
      } else {
        window.dispatchEvent(new CustomEvent('open-wa-popup', { detail: { type: 'stay' } }));
      }
    })
  );

  renderTripMode();
</script>
