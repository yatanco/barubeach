---
interface Props {
  lang?: 'en' | 'es';
  altHref?: string;
}

const { lang = 'en', altHref } = Astro.props;
const isES = lang === 'es';

const altURL = altHref ?? (isES ? '/' : '/es');

const nav = isES
  ? [
      { href: '/es', label: 'Estadía' },
      { href: '/es/pasadia', label: 'Pasadía' },
      { href: '/gallery', label: 'Galería' },
      { href: '/es/#faq', label: 'FAQ' },
    ]
  : [
      { href: '/', label: 'Stay' },
      { href: '/daytrip', label: 'Day Trip' },
      { href: '/gallery', label: 'Gallery' },
      { href: '/#faq', label: 'FAQ' },
    ];

const waHref = 'https://wa.me/573163946401?text=gaviotastay';
const waLabel = isES ? 'Planear por WhatsApp →' : 'Plan on WhatsApp →';
const flagLabel = isES ? '🇬🇧' : '🇪🇸';
const flagTitle = isES ? 'View in English' : 'Ver en español';
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-background/95 backdrop-blur-sm border-b border-sand/20"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href={isES ? '/es' : '/'} class="flex items-center gap-2.5 flex-shrink-0">
        <img src="/images/logo.png" alt="Casa Gaviota Baru" class="h-8 w-auto" />
        <span class="font-serif font-semibold text-ink text-sm hidden sm:block">Casa Gaviota</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-7">
        {nav.map(link => (
          <a
            href={link.href}
            class="text-sm font-medium text-ink/60 hover:text-ink transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right side -->
      <div class="flex items-center gap-3">
        <a
          href={altURL}
          title={flagTitle}
          aria-label={flagTitle}
          class="text-base leading-none hover:opacity-70 transition-opacity select-none"
        >
          {flagLabel}
        </a>

        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden md:inline-flex items-center gap-1.5 bg-whatsapp text-white text-sm font-medium px-4 py-2 rounded-full hover:opacity-90 transition-opacity"
        >
          {waLabel}
        </a>

        <button
          id="menu-btn"
          aria-label="Toggle menu"
          aria-expanded="false"
          class="md:hidden p-2 -mr-1 rounded-lg hover:bg-sand/10 transition-colors"
        >
          <svg id="icon-open" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-sand/20 py-4">
      <nav class="flex flex-col gap-1 mb-4">
        {nav.map(link => (
          <a
            href={link.href}
            class="text-sm font-medium text-ink/70 hover:text-ink px-2 py-2.5 rounded-lg hover:bg-sand/10 transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>
      <a
        href={waHref}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 bg-whatsapp text-white text-sm font-medium px-4 py-3 rounded-full hover:opacity-90 transition-opacity w-full"
      >
        {waLabel}
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') === false;
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  window.addEventListener('scroll', () => {
    const header = document.getElementById('site-header');
    if (!header) return;
    header.classList.toggle('shadow-sm', window.scrollY > 10);
  });
</script>
