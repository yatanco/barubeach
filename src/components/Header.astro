---
import HeaderSocials from './HeaderSocials.astro';

interface Props {
  lang?: 'en' | 'es';
  altHref?: string;
}

const { lang = 'en', altHref } = Astro.props;
const isES = lang === 'es';

const altURL = altHref ?? (isES ? '/' : '/es');

// Hide nav for ad traffic (UTM params, fbclid, gclid)
const hasAd = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'fbclid', 'gclid']
  .some(p => Astro.url.searchParams.has(p));

const nav = isES
  ? [
      { href: '/es', label: 'Estadía' },
      { href: '/es/pasadia', label: 'Pasadía' },
      { href: '/es/#faq', label: 'Preguntas' },
    ]
  : [
      { href: '/', label: 'Stay' },
      { href: '/daytrip', label: 'Day Trip' },
      { href: '/#faq', label: 'FAQ' },
    ];

const waLabel = isES ? 'Verificar Disponibilidad →' : 'Check Availability →';
const flagLabel = isES ? '🇬🇧' : '🇪🇸';
const flagTitle = isES ? 'View in English' : 'Ver en español';
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-brown"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16">

      <!-- Logo -->
      <a href={isES ? '/es' : '/'} class="flex items-center gap-2.5 flex-shrink-0">
        <img src="/images/logo.png" alt="Casa Gaviota Baru" class="h-8 w-auto" />
        <span class="font-serif font-semibold text-white text-sm hidden sm:block">Casa Gaviota</span>
      </a>

      <!-- Desktop nav — hidden for ad traffic -->
      {!hasAd && (
        <nav class="hidden md:flex items-center gap-7">
          {nav.map(link => (
            <a
              href={link.href}
              class="text-base font-medium text-white/70 hover:text-white transition-colors"
            >
              {link.label}
            </a>
          ))}
          <HeaderSocials lang={lang} class="pl-5 border-l border-white/15" />
        </nav>
      )}

      <!-- Right side -->
      <div class="flex items-center gap-3">
        {!hasAd && (
          <a
            href={altURL}
            title={flagTitle}
            aria-label={flagTitle}
            class="text-base leading-none hover:opacity-70 transition-opacity select-none"
          >
            {flagLabel}
          </a>
        )}

        <button
          onclick="window.dispatchEvent(new CustomEvent('open-wa-popup'))"
          class="hidden md:inline-flex items-center gap-1.5 bg-sand text-brown text-sm font-semibold px-4 py-2 rounded-full hover:opacity-90 transition-opacity cursor-pointer"
        >
          {waLabel}
        </button>

        {!hasAd && (
          <button
            id="menu-btn"
            aria-label="Toggle menu"
            aria-expanded="false"
            class="md:hidden p-2 -mr-1 rounded-lg hover:bg-white/10 transition-colors text-white"
          >
            <svg id="icon-open" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        )}
      </div>
    </div>

    <!-- Mobile menu — hidden for ad traffic -->
    {!hasAd && (
      <div id="mobile-menu" class="hidden md:hidden border-t border-white/20 py-4">
        <nav class="flex flex-col gap-1 mb-4">
          {nav.map(link => (
            <a
              href={link.href}
              class="text-base font-medium text-white/70 hover:text-white px-2 py-2.5 rounded-lg hover:bg-white/10 transition-colors"
            >
              {link.label}
            </a>
          ))}
        </nav>
        <button
          onclick="window.dispatchEvent(new CustomEvent('open-wa-popup'))"
          class="flex items-center justify-center gap-2 bg-sand text-brown text-sm font-semibold px-4 py-3 rounded-full hover:opacity-90 transition-opacity w-full cursor-pointer"
        >
          {waLabel}
        </button>
        <HeaderSocials lang={lang} class="justify-center gap-6 pt-5 mt-4 border-t border-white/10" />
      </div>
    )}
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') === false;
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });

  window.addEventListener('scroll', () => {
    const header = document.getElementById('site-header');
    if (!header) return;
    header.classList.toggle('shadow-md', window.scrollY > 10);
  });
</script>
