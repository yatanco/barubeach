---
import { drinksData } from '../data/menu';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import { waLink } from '../lib/whatsapp';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;
const isES = lang === 'es';
const t = isES ? 'es' : 'en';

const page = drinksData[t];
const categories = drinksData.categories;

const waHref = waLink(page.whatsappText);
const waLabel = isES ? 'Pedir por WhatsApp →' : 'Order on WhatsApp →';

function formatCOP(price: number): string {
  return `$${price.toLocaleString('es-CO')} COP`;
}
---

<div class="max-w-md mx-auto px-5 pt-10 pb-32">
  <div class="text-center mb-10">
    <img src="/images/logo.png" alt="Casa Gaviota Baru" class="h-14 w-auto mx-auto mb-5" />
    <p class="text-terracotta text-xs uppercase tracking-widest font-medium mb-2">
      {page.subtitle}
    </p>
    <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-brown mb-3">
      {page.title}
    </h1>
    <p class="text-sm text-ink/60">{page.description}</p>
  </div>

  <section>
    {categories.map(category => (
      <div class="mb-9">
        <h2 class="font-serif text-xl font-semibold text-brown mb-3">{category[t].name}</h2>
        <div class="divide-y divide-sand/40">
          {category.items.map(item => (
            <div class="flex items-start justify-between gap-4 py-3">
              <div>
                <p class="text-sm font-medium text-ink">{item[t]}</p>
                {(isES ? item.description_es : item.description_en) && (
                  <p class="text-xs text-muted italic mt-0.5">
                    {isES ? item.description_es : item.description_en}
                  </p>
                )}
              </div>
              <div class="text-right whitespace-nowrap">
                <p class="text-sm font-semibold text-brown">{formatCOP(item.price_unit)}</p>
                {item.price_6pack !== null && (
                  <p class="text-xs text-muted mt-0.5">
                    {isES ? 'Six-pack' : '6-pack'}: {formatCOP(item.price_6pack)}
                    <br />
                    <span class="text-terracotta">
                      ({isES ? 'ahorras' : 'saves'} {formatCOP(item.price_unit * 6 - item.price_6pack)})
                    </span>
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <p class="text-xs text-muted italic text-center mt-4">{page.note}</p>

  <div class="text-center mt-6 space-y-4">
    <div>
      <a
        href={isES ? '/es/menu' : '/menu'}
        class="text-sm text-terracotta hover:text-brown font-medium underline underline-offset-4"
      >
        {isES ? 'Ver nuestro menú de comida →' : 'See our food menu →'}
      </a>
    </div>
    <a
      href="https://instagram.com/casagaviotabaru"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram"
      class="inline-flex text-muted hover:text-brown transition-colors"
    >
      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
    </a>
  </div>
</div>

<!-- Sticky bottom WhatsApp order button -->
<a
  href={waHref}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-0 left-0 right-0 z-40 flex items-center justify-center gap-2 bg-whatsapp text-white font-semibold py-4 text-center shadow-[0_-2px_10px_rgba(0,0,0,0.1)]"
>
  <WhatsAppIcon class="w-5 h-5 flex-shrink-0" />
  {waLabel}
</a>
