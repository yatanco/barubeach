---
import { requireDb, boldPaymentLink, getRuntimeEnv } from '../../lib/db';
import { getPriceLabsQuote } from '../../lib/pricelabs';
import {
  money, shortDate, timeAgo, waLinkTo, nightsBetween, channelBadgeClass,
  STATUS_LABELS, STATUS_COLORS, pipelineFor, normalizeStatus,
  BOOKING_CHANNELS, BOOKING_CHANNEL_LABELS, CHANNEL_PILL_LABELS, DEFAULT_COMMISSION_RATE,
  PAYMENT_METHODS,
} from '../../lib/crm';
import { checkAvailability } from '../../lib/crm-availability';
import { buildChatGptSalesPrompt, buildSalesSuggestionContext } from '../../lib/sales-suggestion';

interface Props {
  kind: 'lead' | 'booking';
  record: any;
}
const { kind, record } = Astro.props;

const db = requireDb(Astro.locals);
const env = getRuntimeEnv(Astro.locals);

const isBooking = kind === 'booking';
const phone: string | null = isBooking ? record.guest_phone : record.whatsapp;
const nights = nightsBetween(record.date_from, record.date_to);
const guests = (record.adults || 0) + (record.children || 0);
const channel: string | null = isBooking ? record.channel : null;
const isAirbnb = channel === 'airbnb';

const checkinISO: string | null = record.date_from ? record.date_from.slice(0, 10) : null;
const checkoutISO: string | null = record.date_to ? record.date_to.slice(0, 10) : null;
const priceLabsQuote = (checkinISO && checkoutISO && nights > 0)
  ? await getPriceLabsQuote(env, checkinISO, checkoutISO)
  : null;
const priceLabsMoney = (amount: number, currency: string) =>
  new Intl.NumberFormat('es-CO', { style: 'currency', currency, maximumFractionDigits: 0 }).format(amount);

let accommodationCents = 0;
let accommodationChargeId: string | null = null;
if (isBooking) {
  const row = await db.prepare(`SELECT id, amount_cents FROM charges WHERE booking_id = ?1 AND category = 'accommodation' LIMIT 1`)
    .bind(record.id).first<{ id: string; amount_cents: number }>();
  accommodationCents = row?.amount_cents ?? 0;
  accommodationChargeId = row?.id ?? null;
} else {
  accommodationCents = record.accommodation_amount ?? 0;
}
const airbnbPayoutCents = isBooking ? (record.airbnb_payout_cents ?? 0) : 0;
const commissionRate = isBooking ? (record.commission_rate ?? DEFAULT_COMMISSION_RATE) : DEFAULT_COMMISSION_RATE;
const isBookingCom = isBooking && channel === 'booking.com';
const commissionCents = isBookingCom ? Math.round(accommodationCents * (commissionRate / 100) * 1.19) : 0;

const collectibleAccommodationCents = isAirbnb ? 0 : accommodationCents;
const foodCents = record.food_confirmed ? (record.food_amount ?? 0) : 0;
const transportCents = record.transport_confirmed ? (record.transport_amount ?? 0) : 0;
const totalToCollectCents = collectibleAccommodationCents + foodCents + transportCents;
const netToYouCents = totalToCollectCents - commissionCents;
const defaultDepositCents = Math.round(totalToCollectCents * 0.5);

const costStaffCents = isBooking ? (record.cost_staff_cents ?? 0) : 0;
const costFoodCents = isBooking ? (record.cost_food_cents ?? 0) : 0;
const costTransportCents = isBooking ? (record.cost_transport_cents ?? 0) : 0;
const revenueForContributionCents = (isAirbnb ? airbnbPayoutCents : accommodationCents) + foodCents + transportCents;
const netContributionCents = revenueForContributionCents - commissionCents - costStaffCents - costFoodCents - costTransportCents;
const perNightCents = nights > 0 ? Math.round(netContributionCents / nights) : 0;
const perGuestCents = guests > 0 ? Math.round(netContributionCents / guests) : 0;

const revenueTotalCents = revenueForContributionCents - commissionCents;
const costsTotalCents = costStaffCents + costFoodCents + costTransportCents;

interface PaymentRow { id: string; amount_cents: number; method: string | null; paid_at: string; }
const paymentsResult = isBooking
  ? await db.prepare(`SELECT p.id, p.amount_cents, p.method, p.paid_at FROM payments p JOIN charges c ON c.id = p.charge_id WHERE c.booking_id = ?1 ORDER BY p.paid_at DESC`).bind(record.id).all<PaymentRow>()
  : await db.prepare(`SELECT p.id, p.amount_cents, p.method, p.paid_at FROM payments p JOIN charges c ON c.id = p.charge_id WHERE c.lead_id = ?1 ORDER BY p.paid_at DESC`).bind(record.id).all<PaymentRow>();
const payments = paymentsResult.results;
const totalReceivedCents = payments.reduce((sum, p) => sum + p.amount_cents, 0);
const balanceDueCents = totalToCollectCents - totalReceivedCents;
const bookingBalanceDueCents = revenueTotalCents - totalReceivedCents;

const lastSync = isBooking && record.source === 'hosthub_ical'
  ? await db.prepare(`SELECT synced_at FROM sync_log ORDER BY synced_at DESC LIMIT 1`).first<{ synced_at: string }>()
  : null;

const availability = await checkAvailability(db, record.date_from, record.date_to, kind, record.id);
const linkedBooking = !isBooking
  ? await db.prepare('SELECT id, status FROM bookings WHERE lead_id = ?1 LIMIT 1').bind(record.id).first<{ id: string; status: string }>()
  : null;
const chatGptPrompt = !isBooking ? buildChatGptSalesPrompt(buildSalesSuggestionContext({
  lead: { ...record, nights }, availability, priceLabsQuote, paymentsReceivedCents: totalReceivedCents, linkedBooking,
})) : '';

const pipeline = pipelineFor(kind, channel);
const currentStatus = normalizeStatus(record.status);
const boldLink = boldPaymentLink(env);
const boldLinkIsFallback = !env.BOLD_PAYMENT_LINK;

const apiBase = isBooking ? `/admin/api/bookings/${record.id}` : `/admin/api/leads/${record.id}`;

// --- Next Step extras --------------------------------------------------------
const todayStr = new Date().toISOString().slice(0, 10);
const checkinDateMs = checkinISO ? Date.parse(checkinISO + 'T00:00:00Z') : null;
const daysUntilCheckin = checkinDateMs !== null
  ? Math.ceil((checkinDateMs - Date.now()) / 86_400_000)
  : null;
const upsellNudge =
  (currentStatus === 'deposit_paid' || currentStatus === 'confirmed') &&
  daysUntilCheckin !== null && daysUntilCheckin > 0 && daysUntilCheckin <= 14 &&
  !record.transport_confirmed && (record.transport_amount ?? 0) === 0;
const menuUrl = `https://casagaviota.com${record.language === 'es' ? '/es/menu' : '/menu'}`;
const drinksWaLink = phone
  ? waLinkTo(phone, `Hola ${record.guest_name || ''}! 🍹 Aquí puedes ver nuestro menú y hacer tu pedido:\n${menuUrl}`)
  : null;
const nextStepBalanceDue = Math.max(0, isBooking ? bookingBalanceDueCents : balanceDueCents);
const isTerminal = ['completed', 'lost', 'cancelled'].includes(currentStatus);
---

<div class="urd" data-kind={kind} data-id={record.id}>

  <!-- ── OVERVIEW ────────────────────────────────────────────────────────── -->
  <section class="record-overview" aria-label="Guest and stay overview">
    <div class="header-top">
      <div class="record-title">
        <div class="actions record-kicker">
          <span class={`type-pill ${kind}`}>{isBooking ? 'BOOKING' : 'LEAD'}</span>
          {isBooking && <span class={`channel-pill ${channelBadgeClass(channel!)}`}>{CHANNEL_PILL_LABELS[channel as typeof BOOKING_CHANNELS[number]] || channel}</span>}
          {isBooking && record.source === 'hosthub_ical' && <span class="badge hh">HH</span>}
        </div>
        <h1>{record.guest_name || (isBooking ? 'Unnamed booking' : 'Unnamed lead')}</h1>
        <p class="muted dates-line">
          {record.date_from && record.date_to ? <>{shortDate(record.date_from)} → {shortDate(record.date_to)} · {nights} nights</> : 'No dates yet'}
          {guests > 0 && <> · {guests} guests</>}
        </p>
        {checkinISO && checkoutISO && nights > 0 && (
          priceLabsQuote ? (
            <div class="pricelabs-note">
              <span>💡 PriceLabs: <strong>{priceLabsMoney(priceLabsQuote.avgPricePerNight, priceLabsQuote.currency)}/night avg</strong> · <strong>{priceLabsMoney(priceLabsQuote.totalPrice, priceLabsQuote.currency)} total</strong> · min {priceLabsQuote.minStay} {priceLabsQuote.minStay === 1 ? 'night' : 'nights'}</span>
              {nights < priceLabsQuote.minStay && (
                <p class="pricelabs-warning">⚠️ Requested {nights} {nights === 1 ? 'night' : 'nights'} is below PriceLabs minimum ({priceLabsQuote.minStay}).</p>
              )}
            </div>
          ) : (
            <p class="muted pricelabs-note">Pricing lookup unavailable</p>
          )
        )}
      </div>
      <a id="wa-btn" class="button whatsapp" href={phone ? waLinkTo(phone) : '#'} target="_blank" rel="noopener" style={phone ? '' : 'display:none'}>💬 WhatsApp</a>
    </div>

    {record.date_from && record.date_to && (
      availability.hardConflicts.length > 0 ? (
        <div class="availability-badge hard">
          🔴 Dates unavailable — booked: {availability.hardConflicts.map((c) => `${c.guestName || 'Unnamed'} (${STATUS_LABELS[normalizeStatus(c.status)]})`).join(', ')}
        </div>
      ) : availability.softConflicts.length > 0 ? (
        <details class="availability-badge soft">
          <summary>🟡 {availability.softConflicts.length} other lead{availability.softConflicts.length > 1 ? 's' : ''} interested in these dates</summary>
          <ul>{availability.softConflicts.map((c) => <li>{c.guestName || 'Unnamed inquiry'} — {STATUS_LABELS[normalizeStatus(c.status)]}</li>)}</ul>
        </details>
      ) : (
        <div class="availability-badge clear">🟢 Dates available</div>
      )
    )}

    <label class="phone-field">Phone
      <input type="tel" inputmode="tel" autocomplete="tel" id="phone-input" value={phone || ''} placeholder="+57 300 000 0000" />
    </label>
    <div class="inline-feedback" id="phone-feedback" role="status" aria-live="polite"></div>
  </section>

  <!-- ── STATUS PILLS ────────────────────────────────────────────────────── -->
  <section class="card urd-section">
    <h2>Status</h2>
    <div class="status-pills" id="status-pills">
      {pipeline.map((status) => (
        <button type="button" class={`status-pill ${currentStatus === status ? 'active' : ''}`} data-status={status} style={`--pill-color:${STATUS_COLORS[status]}`}>
          {STATUS_LABELS[status]}
        </button>
      ))}
    </div>
    <div class="inline-feedback" id="status-feedback" role="status" aria-live="polite"></div>
  </section>

  <!-- ── NEXT STEP CARD ───────────────────────────────────────────────────── -->
  {!isTerminal && (

    <section class="card urd-section next-step-card" id="next-step" aria-labelledby="next-step-heading">
      <p class="ns-eyebrow">NEXT STEP</p>

      {/* ── new (lead) ── */}
      {currentStatus === 'new' && !isBooking && (
        <>
          <h2 id="next-step-heading">Reply to this inquiry</h2>
          <p class="muted ns-hint">Copy the lead context into ChatGPT to draft your first reply. Nothing is sent automatically.</p>
          <div class="actions ns-actions">
            <button type="button" id="copy-chatgpt-prompt-btn">📋 Copy for ChatGPT</button>
          </div>
          <div class="inline-feedback" id="chatgpt-copy-feedback" role="status" aria-live="polite"></div>
          <div class="ns-divider"></div>
          <button type="button" class="ns-primary-btn" id="ns-mark-replied-btn">✅ Mark as replied</button>
          <div class="inline-feedback" id="ns-status-feedback" role="status" aria-live="polite"></div>
        </>
      )}

      {/* ── new (booking) ── */}
      {currentStatus === 'new' && isBooking && (
        <>
          <h2 id="next-step-heading">Set up &amp; quote</h2>
          <p class="muted ns-hint">Open <strong>Full record</strong> below to set the accommodation amount, then send a quote to the guest.</p>
          <button type="button" class="ns-primary-btn" id="ns-mark-quoted-btn">📤 Mark as quoted</button>
          <div class="inline-feedback" id="ns-status-feedback" role="status" aria-live="polite"></div>
        </>
      )}

      {/* ── replied (lead only) ── */}
      {currentStatus === 'replied' && !isBooking && (
        <>
          <h2 id="next-step-heading">Send a quote</h2>
          <div class="ns-quote-form" id="ns-quote-form">
            <label>Accommodation (COP) *
              <input type="text" inputmode="numeric" id="ns-acc" value={accommodationCents > 0 ? accommodationCents / 100 : ''} placeholder="e.g. 3500000" />
            </label>
            <div class="ns-toggle-row">
              <label class="ns-toggle-label">
                <input type="checkbox" id="ns-transport-toggle" checked={record.transport_confirmed || false} />
                <span>🚤 Transport</span>
              </label>
              <input type="text" inputmode="numeric" id="ns-transport-amt"
                value={record.transport_amount ? record.transport_amount / 100 : ''}
                placeholder="Amount COP"
                class="ns-toggle-input"
                style={record.transport_confirmed ? '' : 'display:none'} />
            </div>
            <div class="ns-toggle-row">
              <label class="ns-toggle-label">
                <input type="checkbox" id="ns-food-toggle" checked={record.food_confirmed || false} />
                <span>🍽️ Food</span>
              </label>
              <input type="text" inputmode="numeric" id="ns-food-amt"
                value={record.food_amount ? record.food_amount / 100 : ''}
                placeholder="Amount COP"
                class="ns-toggle-input"
                style={record.food_confirmed ? '' : 'display:none'} />
            </div>
            <div class="ns-total-row">
              <span>Total</span>
              <strong id="ns-quote-total">{money(totalToCollectCents)}</strong>
            </div>
          </div>

          <div class="ns-divider"></div>
          <div class="ns-followup-block">
            <div class="row"><span>Last contacted</span><strong>{record.last_contact_date ? shortDate(record.last_contact_date) : '—'}</strong></div>
            <div class="row"><span>Next follow-up</span><strong id="next-followup-display">{record.next_followup_date ? shortDate(record.next_followup_date) : '—'}</strong></div>
            <button type="button" class="secondary" id="log-followup-btn">✅ Log follow-up (today)</button>
            <div class="inline-feedback" id="followup-feedback"></div>
          </div>
          <div class="ns-divider"></div>

          <p class="field-error" id="ns-quote-error" style="display:none"></p>
          <button type="button" class="ns-primary-btn" id="ns-log-quote-btn">📤 Log quote sent</button>
          <div class="inline-feedback" id="ns-status-feedback" role="status" aria-live="polite"></div>
        </>
      )}

      {/* ── quoted ── */}
      {currentStatus === 'quoted' && (
        <>
          <h2 id="next-step-heading">Follow up &amp; request deposit</h2>
          {!isBooking && (
            <>
              <div class="ns-followup-block">
                <div class="row"><span>Last contacted</span><strong>{record.last_contact_date ? shortDate(record.last_contact_date) : '—'}</strong></div>
                <div class="row"><span>Next follow-up</span><strong id="next-followup-display">{record.next_followup_date ? shortDate(record.next_followup_date) : '—'}</strong></div>
                <button type="button" class="secondary" id="log-followup-btn">✅ Log follow-up (today)</button>
                <div class="inline-feedback" id="followup-feedback"></div>
              </div>
              <div class="ns-divider"></div>
            </>
          )}
          <button type="button" class="ns-primary-btn" id="ns-request-deposit-btn">💰 Request deposit</button>
          <div class="inline-feedback" id="ns-status-feedback" role="status" aria-live="polite"></div>
        </>
      )}

      {/* ── deposit_requested ── */}
      {currentStatus === 'deposit_requested' && (
        <>
          <h2 id="next-step-heading">Log deposit received</h2>
          {!isBooking && (
            <>
              <div class="ns-followup-block">
                <div class="row"><span>Last contacted</span><strong>{record.last_contact_date ? shortDate(record.last_contact_date) : '—'}</strong></div>
                <div class="row"><span>Next follow-up</span><strong id="next-followup-display">{record.next_followup_date ? shortDate(record.next_followup_date) : '—'}</strong></div>
                <button type="button" class="secondary" id="log-followup-btn">✅ Log follow-up (today)</button>
                <div class="inline-feedback" id="followup-feedback"></div>
              </div>
              <div class="ns-divider"></div>
            </>
          )}
          <div class="ns-payment-form">
            <label>Amount (COP)
              <input type="text" inputmode="numeric" id="ns-payment-amount" value={defaultDepositCents > 0 ? defaultDepositCents / 100 : ''} placeholder="e.g. 1750000" />
            </label>
            <label>Method
              <select id="ns-payment-method">
                {PAYMENT_METHODS.map((m) => <option value={m}>{m}</option>)}
              </select>
            </label>
            <label>Date<input type="date" id="ns-payment-date" value={todayStr} /></label>
          </div>
          <p class="field-error" id="ns-payment-error" style="display:none"></p>
          <button type="button" class="ns-primary-btn" id="ns-log-deposit-btn">✅ Log deposit received</button>
          <div class="inline-feedback" id="ns-status-feedback" role="status" aria-live="polite"></div>
        </>
      )}

      {/* ── deposit_paid / confirmed ── */}
      {(currentStatus === 'deposit_paid' || currentStatus === 'confirmed') && (
        <>
          <h2 id="next-step-heading">
            {currentStatus === 'confirmed' && isAirbnb ? 'Airbnb confirmed' : 'Deposit confirmed'}
          </h2>
          {daysUntilCheckin !== null && daysUntilCheckin > 0 && (
            <p class="ns-days-badge">{daysUntilCheckin} {daysUntilCheckin === 1 ? 'day' : 'days'} until check-in</p>
          )}
          {daysUntilCheckin !== null && daysUntilCheckin <= 0 && checkinISO && (
            <p class="ns-days-badge ns-days-today">Check-in is today — welcome the guest!</p>
          )}
          {upsellNudge ? (
            <div class="ns-upsell-nudge">
              <p>🚤 <strong>Transport not added</strong> — check-in in {daysUntilCheckin} {daysUntilCheckin === 1 ? 'day' : 'days'}. Good time to upsell.</p>
              <div class="ns-upsell-row">
                <input type="text" inputmode="numeric" id="ns-transport-upsell-amt" placeholder="Transport amount COP" />
                <button type="button" class="secondary" id="ns-add-transport-btn">Add transport</button>
              </div>
              <div class="inline-feedback" id="ns-upsell-feedback"></div>
            </div>
          ) : (
            <p class="muted ns-hint">
              {[
                accommodationCents > 0 ? 'Accommodation' : null,
                foodCents > 0 ? 'food' : null,
                transportCents > 0 ? 'transport' : null,
              ].filter(Boolean).join(', ')} set.
              {daysUntilCheckin !== null && daysUntilCheckin > 14 ? ' No action needed until closer to check-in.' : ''}
            </p>
          )}
        </>
      )}

      {/* ── upsell_pending / upsell_confirmed (Airbnb bookings) ── */}
      {currentStatus === 'upsell_pending' && (
        <>
          <h2 id="next-step-heading">Add upsells</h2>
          <p class="muted ns-hint">Open <strong>Full record</strong> below to add food or transport. Then mark as Upsell Confirmed.</p>
          <button type="button" class="ns-primary-btn" id="ns-upsell-confirm-btn">✅ Mark upsell confirmed</button>
          <div class="inline-feedback" id="ns-status-feedback" role="status" aria-live="polite"></div>
        </>
      )}
      {currentStatus === 'upsell_confirmed' && (
        <>
          <h2 id="next-step-heading">Upsell confirmed</h2>
          {daysUntilCheckin !== null && daysUntilCheckin > 0 && (
            <p class="ns-days-badge">{daysUntilCheckin} {daysUntilCheckin === 1 ? 'day' : 'days'} until check-in</p>
          )}
          <p class="muted ns-hint">All set. No action needed until check-in.</p>
        </>
      )}

      {/* ── in_house ── */}
      {currentStatus === 'in_house' && (
        <>
          <h2 id="next-step-heading">Guest is in house</h2>
          {drinksWaLink && (
            <a href={drinksWaLink} class="button ns-drinks-btn" target="_blank" rel="noopener">🍹 Send drinks menu</a>
          )}
          <div class="ns-tally" id="ns-tally">
            <div class="ns-tally-header">
              <span>Drinks tally</span>
              <strong id="ns-tally-total">$0</strong>
            </div>
            <div class="ns-tally-row">
              <input type="text" inputmode="numeric" id="ns-tally-input" placeholder="Add amount (COP)" />
              <button type="button" class="secondary" id="ns-tally-add-btn">+ Add</button>
              <button type="button" class="secondary" id="ns-tally-clear-btn">Reset</button>
            </div>
          </div>
        </>
      )}

      {/* ── balance_requested ── */}
      {currentStatus === 'balance_requested' && (
        <>
          <h2 id="next-step-heading">Collect final balance</h2>
          <div class="ns-balance-row">
            <span>Balance due</span>
            <strong class={`amount ${nextStepBalanceDue > 0 ? 'negative' : 'positive'}`}>{money(nextStepBalanceDue)}</strong>
          </div>
          <div class="ns-payment-form">
            <label>Amount (COP)
              <input type="text" inputmode="numeric" id="ns-final-amount" value={nextStepBalanceDue > 0 ? nextStepBalanceDue / 100 : ''} placeholder="e.g. 2000000" />
            </label>
            <label>Method
              <select id="ns-final-method">
                {PAYMENT_METHODS.map((m) => <option value={m}>{m}</option>)}
              </select>
            </label>
            <label>Date<input type="date" id="ns-final-date" value={todayStr} /></label>
          </div>
          <p class="field-error" id="ns-final-error" style="display:none"></p>
          <button type="button" class="ns-primary-btn" id="ns-log-final-btn">✅ Log final payment &amp; complete</button>
          <div class="inline-feedback" id="ns-status-feedback" role="status" aria-live="polite"></div>
        </>
      )}
    </section>
  )}

  {/* ── Terminal status quiet banner ── */}
  {isTerminal && (
    <div class={`ns-terminal-banner ns-terminal-${currentStatus}`}>
      {currentStatus === 'completed' && '✓ Stay completed'}
      {currentStatus === 'lost' && '✕ Lead lost'}
      {currentStatus === 'cancelled' && '✕ Cancelled'}
    </div>
  )}

  <!-- ── FULL RECORD ACCORDION ────────────────────────────────────────────── -->
  <details class="full-record" id="full-record">
    <summary>Full record <span class="full-record-hint">accommodations, payments, notes, HostHub</span></summary>

    {/* Head of Sales (leads only — always in accordion for reference at any stage) */}
    {!isBooking && (
      <section class="card urd-section sales-assistant" aria-labelledby="sales-assistant-title">
        <div class="sales-assistant-head">
          <div>
            <p class="sales-eyebrow">HUMAN-TRIGGERED SALES SUPPORT</p>
            <h2 id="sales-assistant-title">Head of Sales</h2>
          </div>
        </div>
        <p class="muted sales-intro">Copy the current lead context into ChatGPT to get the next recommended reply and sales strategy. Nothing is sent automatically.</p>
        <div class="actions sales-actions">
          <button type="button" id="copy-chatgpt-prompt-btn-fr">📋 Copy for ChatGPT</button>
          <button type="button" class="secondary" id="preview-chatgpt-prompt-btn" aria-expanded="false">Preview prompt</button>
        </div>
        <div class="inline-feedback" id="chatgpt-copy-feedback-fr" role="status" aria-live="polite"></div>
        <div id="chatgpt-prompt-preview" hidden>
          <label>Exact prompt to copy
            <textarea id="chatgpt-prompt-text" readonly rows="14">{chatGptPrompt}</textarea>
          </label>
        </div>
      </section>
    )}

    <section class="card urd-section">
      <h2>Accommodation</h2>
      {isAirbnb
        ? <>
            <p class="info-box">✅ Paid by Airbnb</p>
            <label>Payout received (COP)
              <input type="text" inputmode="numeric" id="airbnb-payout-input" value={airbnbPayoutCents / 100} placeholder="Enter amount Airbnb paid you" />
            </label>
          </>
        : <label>Amount (COP)
            <input type="text" inputmode="numeric" id="accommodation-input" value={accommodationCents / 100 || ''} placeholder="Enter amount in COP" />
          </label>}
      <div class="inline-feedback" id="accommodation-feedback"></div>
    </section>

    <section class="card urd-section">
      <h2>Food &amp; transport</h2>
      <div class="extras-list">
        <div class="extras-row" data-field="food">
          <span class="extras-label">🍽️ Food</span>
          <div class="extras-control">
            {record.food_confirmed
              ? <>
                  <span class="extras-amount-display">{money(record.food_amount || 0)}</span>
                  <input class="extras-amount-input" type="text" inputmode="numeric" value={(record.food_amount || 0) / 100} style="display:none" />
                  <button type="button" class="secondary extras-remove">✕ Remove</button>
                </>
              : <button type="button" class="secondary extras-add">➕ Add food</button>}
          </div>
        </div>
        <div class="extras-row" data-field="transport">
          <span class="extras-label">🚤 Transport</span>
          <div class="extras-control">
            {record.transport_confirmed
              ? <>
                  <span class="extras-amount-display">{money(record.transport_amount || 0)}</span>
                  <input class="extras-amount-input" type="text" inputmode="numeric" value={(record.transport_amount || 0) / 100} style="display:none" />
                  <button type="button" class="secondary extras-remove">✕ Remove</button>
                </>
              : <button type="button" class="secondary extras-add">➕ Add transport</button>}
          </div>
        </div>
      </div>
    </section>

    {!isBooking && (
      <>
        <section class="card urd-section">
          <h2>Totals</h2>
          <div class="row"><span>Total to collect</span><strong class="amount" id="total-to-collect">{money(totalToCollectCents)}</strong></div>
          <div class="row"><span>Deposit (50%)</span><strong class="amount" id="deposit-preview">{money(defaultDepositCents)}</strong></div>
          {isBookingCom && <>
            <div class="row">
              <span>Commission rate</span>
              <span class="rc-cell" id="commission-rate-cell">
                <span class="rc-display amount">{commissionRate}%</span>
                <input class="rc-input" type="text" inputmode="decimal" id="commission-rate-input" value={commissionRate} style="display:none" />
              </span>
            </div>
            <div class="row"><span>Commission (18% VAT incl.)</span><strong class="amount" id="commission-amount">{money(commissionCents)}</strong></div>
            <div class="row"><strong>Net to you</strong><strong class="amount" id="net-to-you">{money(netToYouCents)}</strong></div>
          </>}
        </section>

        {totalToCollectCents > 0 && (
          <section class="card urd-section">
            <h2>Collect deposit</h2>
            <label>Deposit (COP)
              <input type="text" inputmode="numeric" id="deposit-input" value={defaultDepositCents / 100} />
            </label>
            {boldLinkIsFallback && <p class="muted" style="font-size:12px;margin-top:-6px">⚠️ BOLD_PAYMENT_LINK secret not set — using fallback link.</p>}
            <button type="button" class="secondary" id="copy-deposit-btn" style="margin-top:8px">📋 Copy WhatsApp message</button>
            <div class="inline-feedback" id="deposit-feedback"></div>
          </section>
        )}

        <section class="card urd-section">
          <h2>Payments received</h2>
          <div class="payments-list" id="payments-list">
            {payments.length === 0 && <p class="muted" id="no-payments">No payments recorded yet.</p>}
            {payments.map((p) => (
              <div class="row payment-row" data-payment-id={p.id}>
                <span>{shortDate(p.paid_at)} · {p.method || '—'}</span>
                <div class="actions">
                  <strong class="amount">{money(p.amount_cents)}</strong>
                  <button type="button" class="secondary payment-remove" data-id={p.id}>✕</button>
                </div>
              </div>
            ))}
          </div>
          <button type="button" class="secondary" id="add-payment-btn" style="margin-top:10px">+ Add payment</button>
          <form class="form-grid" id="add-payment-form" style="display:none;margin-top:12px">
            <label>Amount (COP)<input type="text" inputmode="numeric" id="payment-amount" required /></label>
            <label>Method<select id="payment-method">{PAYMENT_METHODS.map((m) => <option value={m}>{m}</option>)}</select></label>
            <label class="span-2">Date<input type="date" id="payment-date" value={new Date().toISOString().slice(0, 10)} /></label>
            <div class="span-2 actions">
              <button type="button" class="secondary" id="payment-cancel-btn">Cancel</button>
              <button type="button" id="payment-save-btn">Save</button>
            </div>
          </form>
          <p class="field-error" id="payment-error" style="display:none"></p>
          <div class="row" style="margin-top:6px"><span>Total received</span><strong class="amount">{money(totalReceivedCents)}</strong></div>
          <div class="row"><strong>Balance due</strong><strong class={`amount ${balanceDueCents > 0 ? 'negative' : 'positive'}`}>{money(Math.max(0, balanceDueCents))}</strong></div>
        </section>
      </>
    )}

    {isBooking && (
      <section class="card urd-section financial-card">
        <div class="fin-columns">
          <div class="fin-col">
            <h3 class="fin-col-header">Revenue</h3>
            <div class="fin-lines">
              <div class="fin-line">
                <span class="fin-label">{isAirbnb ? 'Airbnb payout' : 'Accommodation'}</span>
                <span class="fin-value-group">
                  <span class="fin-value" id="rev-accommodation-display">{money(isAirbnb ? airbnbPayoutCents : accommodationCents)}</span>
                  <input class="fin-input" type="text" inputmode="numeric" id="rev-accommodation-input" value={(isAirbnb ? airbnbPayoutCents : accommodationCents) / 100 || ''} style="display:none" />
                  <button type="button" class="fin-edit-btn" id="rev-accommodation-edit" aria-label="Edit amount">✏️</button>
                </span>
              </div>
              {foodCents > 0 && (
                <div class="fin-line">
                  <span class="fin-label">Food</span>
                  <span class="fin-value-group">
                    <span class="fin-value" id="rev-food-display">{money(foodCents)}</span>
                    <input class="fin-input" type="text" inputmode="numeric" id="rev-food-input" value={foodCents / 100} style="display:none" />
                    <button type="button" class="fin-edit-btn" id="rev-food-edit" aria-label="Edit amount">✏️</button>
                  </span>
                </div>
              )}
              {transportCents > 0 && (
                <div class="fin-line">
                  <span class="fin-label">Transport</span>
                  <span class="fin-value-group">
                    <span class="fin-value" id="rev-transport-display">{money(transportCents)}</span>
                    <input class="fin-input" type="text" inputmode="numeric" id="rev-transport-input" value={transportCents / 100} style="display:none" />
                    <button type="button" class="fin-edit-btn" id="rev-transport-edit" aria-label="Edit amount">✏️</button>
                  </span>
                </div>
              )}
              {isBookingCom && commissionCents > 0 && (
                <div class="fin-line">
                  <span class="fin-label">BK commission ({commissionRate}%)</span>
                  <span class="fin-value-group">
                    <span class="fin-value negative" id="rev-commission-display">-{money(commissionCents)}</span>
                    <input class="fin-input" type="text" inputmode="decimal" id="rev-commission-rate-input" value={commissionRate} style="display:none" placeholder="rate %" />
                    <button type="button" class="fin-edit-btn" id="rev-commission-edit" aria-label="Edit commission rate">✏️</button>
                  </span>
                </div>
              )}
            </div>
            <div class="fin-total"><span>Total</span><strong id="revenue-total">{money(revenueTotalCents)}</strong></div>
          </div>

          <div class="fin-col">
            <h3 class="fin-col-header">Received</h3>
            <div class="fin-lines payments-list" id="payments-list">
              {payments.length === 0 && <p class="muted fin-empty" id="no-payments">No payments yet.</p>}
              {payments.map((p) => (
                <div class="fin-line payment-row" data-payment-id={p.id}>
                  <span class="fin-label">{shortDate(p.paid_at)} · {p.method || '—'}</span>
                  <span class="fin-value-group">
                    <strong class="fin-value">{money(p.amount_cents)}</strong>
                    <button type="button" class="fin-remove-btn payment-remove" data-id={p.id} aria-label="Remove payment">✕</button>
                  </span>
                </div>
              ))}
            </div>
            <button type="button" class="secondary fin-add-btn" id="add-payment-btn">+ Add payment</button>
            <form class="fin-add-form" id="add-payment-form" style="display:none">
              <input type="text" inputmode="numeric" id="payment-amount" placeholder="Amount COP" required />
              <select id="payment-method">{PAYMENT_METHODS.map((m) => <option value={m}>{m}</option>)}</select>
              <input type="date" id="payment-date" value={new Date().toISOString().slice(0, 10)} />
              <div class="fin-add-actions">
                <button type="button" class="secondary" id="payment-cancel-btn">Cancel</button>
                <button type="button" id="payment-save-btn">Save</button>
              </div>
            </form>
            <p class="field-error" id="payment-error" style="display:none"></p>
            <div class="fin-total"><span>Total</span><strong id="received-total">{money(totalReceivedCents)}</strong></div>
          </div>

          <div class="fin-col">
            <h3 class="fin-col-header">Costs</h3>
            <div class="fin-lines">
              <div class="fin-line"><span class="fin-label">Staff</span><input class="fin-input" type="text" inputmode="numeric" id="cost-staff-input" value={costStaffCents / 100 || ''} placeholder="0" /></div>
              <div class="fin-line"><span class="fin-label">Food</span><input class="fin-input" type="text" inputmode="numeric" id="cost-food-input" value={costFoodCents / 100 || ''} placeholder="0" /></div>
              <div class="fin-line"><span class="fin-label">Transport</span><input class="fin-input" type="text" inputmode="numeric" id="cost-transport-input" value={costTransportCents / 100 || ''} placeholder="0" /></div>
            </div>
            <div class="inline-feedback" id="costs-feedback"></div>
            <div class="fin-total"><span>Total</span><strong id="costs-total">{money(costsTotalCents)}</strong></div>
          </div>
        </div>

        <div class="fin-summary">
          <div class="fin-summary-row">
            <span>Balance due</span>
            <span class="fin-summary-value-group">
              <strong class={`amount ${bookingBalanceDueCents > 0 ? 'negative' : 'positive'}`}>{money(Math.max(0, bookingBalanceDueCents))}</strong>
              {bookingBalanceDueCents > 0 && <button type="button" class="secondary" id="copy-balance-btn">📋 Copy WhatsApp message</button>}
            </span>
          </div>
          {boldLinkIsFallback && bookingBalanceDueCents > 0 && <p class="muted fin-fallback-note">⚠️ BOLD_PAYMENT_LINK secret not set — using fallback link.</p>}
          <div class="inline-feedback" id="balance-feedback"></div>
          <div class="fin-summary-row"><span>Net contribution</span><strong class="amount">{money(netContributionCents)}</strong></div>
          <div class="fin-summary-row"><span>Per night</span><strong class="amount">{money(perNightCents)}</strong></div>
          <div class="fin-summary-row"><span>Per guest</span><strong class="amount">{money(perGuestCents)}</strong></div>
        </div>
      </section>
    )}

    <section class="card urd-section">
      <h2>Notes <span class="muted notes-state" id="notes-feedback">Autosaves</span></h2>
      <textarea id="notes-input" placeholder="Internal notes...">{record.notes || ''}</textarea>
    </section>

    <section class="card urd-section">
      <h2>HostHub</h2>
      {isBooking
        ? <>
            <div class="row"><span>Reservation</span><strong>{record.reservation_id || 'not linked'}</strong></div>
            <label>Channel
              <select id="hosthub-channel-select">
                {BOOKING_CHANNELS.map((c) => <option value={c} selected={c === channel}>{BOOKING_CHANNEL_LABELS[c]}</option>)}
              </select>
            </label>
            <div class="inline-feedback" id="channel-feedback"></div>
            {record.source === 'hosthub_ical' && <p class="muted" style="font-size:12px">Last synced: {lastSync ? timeAgo(lastSync.synced_at) : 'never'}</p>}
            <a class="button secondary" href="https://app.hosthub.com" target="_blank" rel="noopener" style="margin-top:8px">Open HostHub ↗</a>
          </>
        : <form method="POST" action="/admin/api/bookings/create" id="convert-form">
            <input type="hidden" name="lead_id" value={record.id} />
            <input type="hidden" name="guest_name" value={record.guest_name || ''} />
            <input type="hidden" name="guest_phone" value={record.whatsapp || ''} />
            <input type="hidden" name="date_from" value={record.date_from?.slice(0, 10) || ''} />
            <input type="hidden" name="date_to" value={record.date_to?.slice(0, 10) || ''} />
            <input type="hidden" name="adults" value={record.adults || 1} />
            <input type="hidden" name="children" value={record.children || 0} />
            <input type="hidden" name="notes" value={record.notes || ''} />
            <label>🔗 Link HostHub reservation<input name="reservation_id" required placeholder="c1zshdhyycnzc1" /></label>
            <button type="submit" style="margin-top:10px">Confirm booking</button>
          </form>}
    </section>
  </details>

</div>

<style>
  .urd { max-width:1040px; margin-inline:auto; }
  .record-overview { padding:4px 2px 2px; }
  .header-top { display:flex; align-items:center; justify-content:space-between; gap:18px; margin-bottom:14px; }
  .record-title { min-width:0; }
  .record-kicker { gap:5px; margin-bottom:7px; }
  .header-top h1 { margin:0; font-size:clamp(27px,4vw,36px); }
  .dates-line { margin:5px 0 0; font-size:14px; font-weight:600; }
  .pricelabs-note { font-size:13px; margin:6px 0 0; }
  .pricelabs-warning { color:#92400E; background:#FEF3C7; border-radius:8px; padding:8px 10px; margin:6px 0 0; font-size:12px; font-weight:600; }
  .availability-badge { border-radius:10px; padding:10px 14px; font-weight:700; font-size:13px; margin:-4px 0 16px; }
  .availability-badge.clear { background:#dff8f1; color:#116149; }
  .availability-badge.soft { background:#fff4e5; color:#7a4b00; cursor:pointer; }
  .availability-badge.soft summary { list-style:none; padding:0; color:inherit; }
  .availability-badge.soft summary::-webkit-details-marker { display:none; }
  .availability-badge.soft ul { margin:8px 0 0; padding-left:18px; font-weight:500; }
  .availability-badge.hard { background:#fee4e2; color:var(--red); }
  .phone-field { max-width:320px; }
  .urd-section { position:relative; margin-top:16px; }
  .urd-section > h2 { display:flex; align-items:baseline; justify-content:space-between; padding-bottom:10px; border-bottom:1px solid var(--line); }
  .type-pill { display:inline-flex; border-radius:6px; padding:3px 8px; font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.04em; color:#fff; }
  .type-pill.booking { background:#57392E; }
  .type-pill.lead { background:#7D98AB; }
  #status-pills { gap:7px; }
  .info-box { background:#dff8f1; color:#116149; border-radius:10px; padding:12px 14px; font-weight:700; margin-bottom:10px; }
  .extras-list { display:grid; gap:0; }
  .extras-row { display:flex; min-height:54px; align-items:center; justify-content:space-between; gap:12px; border-top:1px solid var(--line); }
  .extras-row:first-child { border-top:0; }
  .extras-label { font-weight:700; }
  .extras-control { display:flex; align-items:center; gap:10px; }
  .extras-amount-display { cursor:pointer; font-variant-numeric:tabular-nums; font-weight:750; border-bottom:1px dotted #a89890; }
  .extras-amount-input { max-width:140px; text-align:right; }
  .rc-cell { cursor:pointer; }
  .rc-cell .rc-input { max-width:100px; text-align:right; display:inline-block; }
  .amount.positive { color:#166534; }
  .amount.negative { color:var(--red); }
  .field-error { color:var(--red); font-size:12px; margin-top:8px; }
  .notes-state { font-size:12px; font-weight:400; }
  .sales-assistant { border-top:3px solid var(--steel); }
  .sales-assistant-head { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; padding-bottom:10px; border-bottom:1px solid var(--line); }
  .sales-assistant-head h2 { margin:0; }
  .sales-eyebrow { margin:0 0 3px; color:var(--steel); font-size:10px; font-weight:850; letter-spacing:.08em; }
  .sales-intro { margin:12px 0; }
  .sales-actions { justify-content:flex-start; }
  #chatgpt-prompt-preview { margin-top:12px; }
  #chatgpt-prompt-preview[hidden] { display:none; }
  #chatgpt-prompt-text { min-height:280px; font:13px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace; background:var(--input-bg); }
  #notes-input { min-height:120px; }
  details > summary { cursor:pointer; font-weight:700; color:var(--brown); padding:10px 0; list-style:none; }
  details > summary::-webkit-details-marker { display:none; }
  .payment-row { padding:10px 0; }
  .financial-card { padding:20px; border-top:3px solid var(--sand); }
  .fin-columns { display:grid; grid-template-columns:repeat(3,1fr); gap:0; }
  .fin-col { padding:0 18px; min-width:0; }
  .fin-col:first-child { padding-left:0; }
  .fin-col:last-child { padding-right:0; }
  .fin-col + .fin-col { border-left:1px solid #E6C497; }
  .fin-col-header { margin:0 0 12px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#B28471; }
  .fin-lines { display:grid; gap:10px; margin-bottom:10px; }
  .fin-line { display:flex; align-items:center; justify-content:space-between; gap:8px; font-size:13px; }
  .fin-label { color:var(--ink); min-width:0; }
  .fin-value-group { display:flex; align-items:center; gap:6px; flex-shrink:0; }
  .fin-value { font-variant-numeric:tabular-nums; font-weight:600; }
  .fin-value.negative { color:var(--red); }
  .fin-edit-btn { appearance:none; border:0; background:none; padding:2px; min-height:auto; cursor:pointer; font-size:12px; opacity:.55; }
  .fin-edit-btn:hover { opacity:1; }
  .fin-input { max-width:110px; min-height:34px; padding:4px 8px; text-align:right; font-size:13px; }
  .fin-remove-btn { appearance:none; border:0; background:none; color:var(--red); cursor:pointer; padding:2px 4px; min-height:auto; font-size:13px; }
  .fin-total { display:flex; align-items:center; justify-content:space-between; padding-top:10px; border-top:1px solid var(--sand); font-weight:750; color:var(--brown); }
  .fin-empty { font-size:12px; margin:0; }
  .fin-add-btn { width:100%; margin-top:4px; font-size:13px; min-height:38px; }
  .fin-add-form { display:grid; gap:8px; margin-top:10px; }
  .fin-add-actions { display:flex; gap:8px; justify-content:flex-end; }
  .fin-summary { margin-top:18px; padding-top:16px; border-top:1px solid #E6C497; display:grid; gap:10px; }
  .fin-summary-row { display:flex; align-items:center; justify-content:space-between; gap:10px; }
  .fin-summary-value-group { display:flex; align-items:center; gap:10px; }
  .fin-fallback-note { font-size:12px; margin:-4px 0 0; }

  /* ── Next Step card ──────────────────────────────────────────────────── */
  .next-step-card { border-top:3px solid var(--ocean); background:var(--surface); }
  .ns-eyebrow { margin:0 0 4px; color:var(--ocean); font-size:10px; font-weight:850; letter-spacing:.1em; }
  .next-step-card h2 { margin:0 0 14px; border-bottom:0; padding-bottom:0; }
  .ns-hint { margin:0 0 16px; }
  .ns-actions { justify-content:flex-start; gap:10px; margin-bottom:6px; }
  .ns-primary-btn { width:100%; min-height:50px; font-size:15px; font-weight:750; margin-top:14px; }
  .ns-divider { border:0; border-top:1px solid var(--line); margin:16px 0; }
  .ns-quote-form { display:grid; gap:12px; }
  .ns-toggle-row { display:flex; align-items:center; gap:12px; min-height:44px; }
  .ns-toggle-label { display:flex; align-items:center; gap:8px; font-weight:600; cursor:pointer; flex-shrink:0; }
  .ns-toggle-label input[type="checkbox"] { width:18px; height:18px; cursor:pointer; }
  .ns-toggle-input { flex:1; }
  .ns-total-row { display:flex; align-items:center; justify-content:space-between; padding:12px 0 0; border-top:1px solid var(--line); font-size:15px; }
  .ns-total-row strong { font-size:18px; font-variant-numeric:tabular-nums; color:var(--brown); }
  .ns-followup-block { display:grid; gap:8px; }
  .ns-followup-block .row { padding:6px 0; }
  .ns-payment-form { display:grid; gap:10px; margin-bottom:4px; }
  .ns-days-badge { display:inline-block; background:var(--surface-soft); border:1px solid var(--line); border-radius:999px; padding:6px 16px; font-size:14px; font-weight:750; color:var(--brown); margin:0 0 12px; }
  .ns-days-today { background:#FEF3C7; border-color:#F59E0B; color:#92400E; }
  .ns-upsell-nudge { background:#FFF7ED; border:1px solid #FED7AA; border-radius:12px; padding:14px; margin-top:8px; }
  .ns-upsell-nudge p { margin:0 0 10px; font-size:14px; }
  .ns-upsell-row { display:flex; align-items:center; gap:8px; }
  .ns-upsell-row input { flex:1; }
  .ns-balance-row { display:flex; align-items:center; justify-content:space-between; padding:12px 0; border-bottom:1px solid var(--line); margin-bottom:14px; font-size:15px; }
  .ns-balance-row strong { font-size:20px; font-variant-numeric:tabular-nums; }
  .ns-drinks-btn { width:100%; margin-bottom:16px; }
  .ns-tally { background:var(--surface-soft); border-radius:12px; padding:14px; }
  .ns-tally-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; font-weight:700; }
  .ns-tally-header strong { font-size:18px; font-variant-numeric:tabular-nums; color:var(--brown); }
  .ns-tally-row { display:flex; align-items:center; gap:8px; }
  .ns-tally-row input { flex:1; }
  .ns-terminal-banner { border-radius:12px; padding:14px 18px; margin-top:16px; font-weight:750; font-size:15px; text-align:center; }
  .ns-terminal-completed { background:#dff8f1; color:#116149; }
  .ns-terminal-lost, .ns-terminal-cancelled { background:#fee4e2; color:var(--red); }

  /* ── Full Record accordion ───────────────────────────────────────────── */
  .full-record { margin-top:16px; }
  .full-record > summary { display:flex; align-items:center; gap:10px; padding:14px 18px; background:var(--surface); border:1px solid var(--line); border-radius:12px; font-size:15px; font-weight:750; color:var(--ink); transition:border-radius 160ms; }
  .full-record[open] > summary { border-radius:12px 12px 0 0; }
  .full-record > summary::before { content:'▶'; font-size:11px; color:var(--muted); transition:transform 200ms; flex-shrink:0; }
  .full-record[open] > summary::before { transform:rotate(90deg); }
  .full-record-hint { font-size:12px; font-weight:400; color:var(--muted); }
  .full-record > *:not(summary) { border:1px solid var(--line); border-top:0; }
  .full-record > .urd-section:last-child { border-radius:0 0 12px 12px; }

  @media(max-width:760px) {
    .record-overview { padding-top:0; }
    .header-top { align-items:flex-start; }
    .header-top .button { flex:0 0 44px; width:44px; padding:0; overflow:hidden; font-size:0; }
    .header-top .button::before { content:'💬'; font-size:17px; }
    .dates-line { font-size:13px; }
    #status-pills { flex-wrap:nowrap; overflow-x:auto; margin-inline:-14px; padding:2px 14px 8px; scrollbar-width:none; }
    #status-pills::-webkit-scrollbar { display:none; }
    #status-pills .status-pill { flex:0 0 auto; }
    .urd-section { margin-top:12px; }
    .urd-section > h2 { margin-bottom:10px; }
    .extras-control { max-width:68%; }
    .extras-control button { padding-inline:10px; }
    .fin-columns { grid-template-columns:1fr; }
    .fin-col { padding:14px 0; }
    .fin-col:first-child { padding-top:0; }
    .fin-col:last-child { padding-bottom:0; }
    .fin-col + .fin-col { border-left:0; border-top:1px solid #E6C497; }
    .fin-summary-row { align-items:flex-start; }
    .fin-summary-value-group { align-items:flex-end; flex-direction:column; }
    .sales-assistant-head { flex-direction:column; }
    .sales-actions { display:grid; grid-template-columns:1fr 1fr; width:100%; }
    .ns-upsell-row { flex-direction:column; align-items:stretch; }
    .ns-tally-row { flex-wrap:wrap; }
  }
</style>

<script define:vars={{ apiBase, kind, boldLink, guestName: record.guest_name, dateFrom: record.date_from, dateTo: record.date_to, isBookingCom, accommodationCents, foodCentsInit: foodCents, transportCentsInit: transportCents, isAirbnb, balanceDueCents: bookingBalanceDueCents, recordId: record.id, nextStepBalanceDue }}>
  function pesosFromInput(str) {
    const n = Number(String(str).replace(/[^0-9]/g, ''));
    return Number.isFinite(n) ? n : 0;
  }
  function formatCOP(pesos) {
    return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(pesos);
  }
  function shortDateEs(value) {
    if (!value) return '';
    return new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${value.slice(0, 10)}T00:00:00Z`));
  }
  function flash(el, ok) {
    if (!el) return;
    el.classList.remove('error');
    if (!ok) el.classList.add('error');
    el.textContent = ok ? '✓ Saved' : 'Could not save';
    setTimeout(() => { if (ok) el.textContent = ''; }, 1200);
  }
  async function patchStatus(status) {
    const res = await fetch(`${apiBase}/status`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status }) });
    const data = await res.json();
    if (!res.ok || !data.success) throw new Error(data.error || 'Could not update status');
  }
  async function postPayment(amount, method, date) {
    const res = await fetch(`${apiBase}/payments`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ amount, method, date }),
    });
    const data = await res.json();
    if (!res.ok || !data.success) throw new Error(data.error || 'Could not save payment');
  }

  // ── Phone ─────────────────────────────────────────────────────────────────
  const phoneInput = document.getElementById('phone-input');
  const waBtn = document.getElementById('wa-btn');
  const phoneFeedback = document.getElementById('phone-feedback');
  function syncWaBtn() {
    const digits = (phoneInput.value || '').replace(/\D/g, '');
    if (digits) { waBtn.href = `https://wa.me/${digits}`; waBtn.style.display = ''; }
    else { waBtn.style.display = 'none'; }
  }
  phoneInput?.addEventListener('input', syncWaBtn);
  phoneInput?.addEventListener('blur', async () => {
    const field = kind === 'booking' ? 'guest_phone' : 'whatsapp';
    try {
      const res = await fetch(`${apiBase}/update`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ [field]: phoneInput.value }) });
      if (!res.ok) throw new Error();
      flash(phoneFeedback, true);
    } catch { flash(phoneFeedback, false); }
  });

  // ── Status pills ──────────────────────────────────────────────────────────
  const statusFeedback = document.getElementById('status-feedback');
  document.querySelectorAll('#status-pills .status-pill').forEach((pill) => {
    pill.addEventListener('click', async () => {
      const status = pill.getAttribute('data-status');
      if (!status) return;
      document.querySelectorAll('#status-pills button').forEach((b) => { b.disabled = true; });
      try {
        await patchStatus(status);
        window.location.reload();
      } catch (error) {
        if (statusFeedback) { statusFeedback.classList.add('error'); statusFeedback.textContent = error instanceof Error ? error.message : 'Could not update status'; }
        document.querySelectorAll('#status-pills button').forEach((b) => { b.disabled = false; });
      }
    });
  });

  // ── ChatGPT clipboard (both Next Step and Full Record buttons) ────────────
  const chatGptPromptText = document.getElementById('chatgpt-prompt-text')?.value || '';
  async function doCopyChatGpt(btn, feedbackId) {
    const feedback = document.getElementById(feedbackId);
    const original = btn?.textContent;
    try {
      await navigator.clipboard.writeText(chatGptPromptText);
      if (btn) btn.textContent = 'Copied ✓';
      if (feedback) feedback.textContent = 'Paste it into your Casa Gaviota ChatGPT conversation.';
    } catch {
      if (feedback) { feedback.classList.add('error'); feedback.textContent = 'Could not copy. Preview the prompt and copy it manually.'; }
    }
    setTimeout(() => { if (btn && original) btn.textContent = original; }, 1800);
  }
  document.getElementById('copy-chatgpt-prompt-btn')?.addEventListener('click', (e) => doCopyChatGpt(e.currentTarget, 'chatgpt-copy-feedback'));
  document.getElementById('copy-chatgpt-prompt-btn-fr')?.addEventListener('click', (e) => doCopyChatGpt(e.currentTarget, 'chatgpt-copy-feedback-fr'));
  const previewBtn = document.getElementById('preview-chatgpt-prompt-btn');
  const chatGptPreview = document.getElementById('chatgpt-prompt-preview');
  previewBtn?.addEventListener('click', () => {
    if (!chatGptPreview) return;
    chatGptPreview.hidden = !chatGptPreview.hidden;
    previewBtn.setAttribute('aria-expanded', String(!chatGptPreview.hidden));
    previewBtn.textContent = chatGptPreview.hidden ? 'Preview prompt' : 'Hide preview';
  });

  // ── Follow-up ─────────────────────────────────────────────────────────────
  document.getElementById('log-followup-btn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const feedback = document.getElementById('followup-feedback');
    btn.disabled = true;
    try {
      const res = await fetch(`${apiBase}/log-followup`, { method: 'POST' });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Could not log follow-up');
      window.location.reload();
    } catch (error) {
      btn.disabled = false;
      if (feedback) { feedback.classList.add('error'); feedback.textContent = error instanceof Error ? error.message : 'Could not log follow-up'; }
    }
  });

  // ── Next Step: simple status-change buttons ───────────────────────────────
  function wireSimpleStatusBtn(btnId, targetStatus) {
    document.getElementById(btnId)?.addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const feedback = document.getElementById('ns-status-feedback');
      btn.disabled = true;
      try {
        await patchStatus(targetStatus);
        window.location.reload();
      } catch (error) {
        btn.disabled = false;
        if (feedback) { feedback.classList.add('error'); feedback.textContent = error instanceof Error ? error.message : 'Could not update'; }
      }
    });
  }
  wireSimpleStatusBtn('ns-mark-replied-btn', 'replied');
  wireSimpleStatusBtn('ns-mark-quoted-btn', 'quoted');
  wireSimpleStatusBtn('ns-request-deposit-btn', 'deposit_requested');
  wireSimpleStatusBtn('ns-upsell-confirm-btn', 'upsell_confirmed');

  // ── Next Step: quote form (replied → quoted) ──────────────────────────────
  const nsTransportToggle = document.getElementById('ns-transport-toggle');
  const nsFoodToggle = document.getElementById('ns-food-toggle');
  const nsTransportAmt = document.getElementById('ns-transport-amt');
  const nsFoodAmt = document.getElementById('ns-food-amt');
  const nsQuoteTotal = document.getElementById('ns-quote-total');

  function recomputeNsTotal() {
    if (!nsQuoteTotal) return;
    const acc = pesosFromInput(document.getElementById('ns-acc')?.value) * 100;
    const transport = nsTransportToggle?.checked ? pesosFromInput(nsTransportAmt?.value) * 100 : 0;
    const food = nsFoodToggle?.checked ? pesosFromInput(nsFoodAmt?.value) * 100 : 0;
    nsQuoteTotal.textContent = formatCOP((acc + transport + food) / 100);
  }
  nsTransportToggle?.addEventListener('change', () => {
    if (nsTransportAmt) nsTransportAmt.style.display = nsTransportToggle.checked ? '' : 'none';
    recomputeNsTotal();
  });
  nsFoodToggle?.addEventListener('change', () => {
    if (nsFoodAmt) nsFoodAmt.style.display = nsFoodToggle.checked ? '' : 'none';
    recomputeNsTotal();
  });
  document.getElementById('ns-acc')?.addEventListener('input', recomputeNsTotal);
  nsTransportAmt?.addEventListener('input', recomputeNsTotal);
  nsFoodAmt?.addEventListener('input', recomputeNsTotal);

  document.getElementById('ns-log-quote-btn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const errorBox = document.getElementById('ns-quote-error');
    const feedback = document.getElementById('ns-status-feedback');
    const accPesos = pesosFromInput(document.getElementById('ns-acc')?.value);
    if (accPesos <= 0) {
      if (errorBox) { errorBox.textContent = 'Enter an accommodation amount.'; errorBox.style.display = ''; }
      return;
    }
    if (errorBox) errorBox.style.display = 'none';
    btn.disabled = true;
    btn.textContent = 'Saving…';
    try {
      const accRes = await fetch(`${apiBase}/accommodation`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ amount: accPesos }) });
      if (!accRes.ok) throw new Error('Could not save accommodation');
      if (nsTransportToggle?.checked) {
        const tp = pesosFromInput(nsTransportAmt?.value);
        const tRes = await fetch(`${apiBase}/extras`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ field: 'transport', confirmed: true, amount: tp }) });
        if (!tRes.ok) throw new Error('Could not save transport');
      }
      if (nsFoodToggle?.checked) {
        const fp = pesosFromInput(nsFoodAmt?.value);
        const fRes = await fetch(`${apiBase}/extras`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ field: 'food', confirmed: true, amount: fp }) });
        if (!fRes.ok) throw new Error('Could not save food');
      }
      await patchStatus('quoted');
      window.location.reload();
    } catch (error) {
      btn.disabled = false;
      btn.textContent = '📤 Log quote sent';
      if (feedback) { feedback.classList.add('error'); feedback.textContent = error instanceof Error ? error.message : 'Could not save'; }
    }
  });

  // ── Next Step: log deposit received (deposit_requested → deposit_paid) ────
  document.getElementById('ns-log-deposit-btn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const errorBox = document.getElementById('ns-payment-error');
    const feedback = document.getElementById('ns-status-feedback');
    const pesos = pesosFromInput(document.getElementById('ns-payment-amount')?.value);
    const method = document.getElementById('ns-payment-method')?.value || 'Transferencia';
    const date = document.getElementById('ns-payment-date')?.value || new Date().toISOString().slice(0, 10);
    if (pesos <= 0) {
      if (errorBox) { errorBox.textContent = 'Enter a valid amount.'; errorBox.style.display = ''; }
      return;
    }
    if (errorBox) errorBox.style.display = 'none';
    btn.disabled = true;
    btn.textContent = 'Saving…';
    try {
      await postPayment(pesos, method, date);
      await patchStatus('deposit_paid');
      window.location.reload();
    } catch (error) {
      btn.disabled = false;
      btn.textContent = '✅ Log deposit received';
      if (feedback) { feedback.classList.add('error'); feedback.textContent = error instanceof Error ? error.message : 'Could not save'; }
    }
  });

  // ── Next Step: upsell quick-add transport ────────────────────────────────
  document.getElementById('ns-add-transport-btn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const feedback = document.getElementById('ns-upsell-feedback');
    const pesos = pesosFromInput(document.getElementById('ns-transport-upsell-amt')?.value);
    btn.disabled = true;
    try {
      const res = await fetch(`${apiBase}/extras`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ field: 'transport', confirmed: true, amount: pesos }) });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error();
      window.location.reload();
    } catch {
      btn.disabled = false;
      if (feedback) { feedback.classList.add('error'); feedback.textContent = 'Could not save transport'; }
    }
  });

  // ── Next Step: drinks tally (localStorage scratch-pad) ───────────────────
  const TALLY_KEY = `drinks-tally-${recordId}`;
  const tallyTotalEl = document.getElementById('ns-tally-total');
  if (tallyTotalEl) {
    let tallyTotal = Number(localStorage.getItem(TALLY_KEY) || 0);
    tallyTotalEl.textContent = formatCOP(tallyTotal);
    document.getElementById('ns-tally-add-btn')?.addEventListener('click', () => {
      const input = document.getElementById('ns-tally-input');
      const added = pesosFromInput(input?.value);
      if (added > 0) {
        tallyTotal += added;
        localStorage.setItem(TALLY_KEY, String(tallyTotal));
        tallyTotalEl.textContent = formatCOP(tallyTotal);
        if (input) { input.value = ''; input.focus(); }
      }
    });
    document.getElementById('ns-tally-clear-btn')?.addEventListener('click', () => {
      tallyTotal = 0;
      localStorage.removeItem(TALLY_KEY);
      tallyTotalEl.textContent = formatCOP(0);
    });
  }

  // ── Next Step: log final payment (balance_requested → completed) ──────────
  document.getElementById('ns-log-final-btn')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    const errorBox = document.getElementById('ns-final-error');
    const feedback = document.getElementById('ns-status-feedback');
    const pesos = pesosFromInput(document.getElementById('ns-final-amount')?.value);
    const method = document.getElementById('ns-final-method')?.value || 'Transferencia';
    const date = document.getElementById('ns-final-date')?.value || new Date().toISOString().slice(0, 10);
    if (pesos <= 0) {
      if (errorBox) { errorBox.textContent = 'Enter a valid amount.'; errorBox.style.display = ''; }
      return;
    }
    if (errorBox) errorBox.style.display = 'none';
    btn.disabled = true;
    btn.textContent = 'Saving…';
    try {
      await postPayment(pesos, method, date);
      await patchStatus('completed');
      window.location.reload();
    } catch (error) {
      btn.disabled = false;
      btn.textContent = '✅ Log final payment & complete';
      if (feedback) { feedback.classList.add('error'); feedback.textContent = error instanceof Error ? error.message : 'Could not save'; }
    }
  });

  // ── Full Record: persist open/closed state across reloads ─────────────────
  const fullRecord = document.getElementById('full-record');
  const FR_KEY = `full-record-open-${recordId}`;
  if (fullRecord) {
    if (sessionStorage.getItem(FR_KEY)) fullRecord.open = true;
    fullRecord.addEventListener('toggle', () => {
      if (fullRecord.open) sessionStorage.setItem(FR_KEY, '1');
      else sessionStorage.removeItem(FR_KEY);
    });
  }

  // ── Accommodation (Full Record) ───────────────────────────────────────────
  const accommodationFeedback = document.getElementById('accommodation-feedback');
  let currentAccommodationCents = accommodationCents;
  const accommodationInput = document.getElementById('accommodation-input');
  accommodationInput?.addEventListener('blur', async () => {
    const pesos = pesosFromInput(accommodationInput.value);
    accommodationInput.value = String(pesos);
    try {
      const res = await fetch(`${apiBase}/accommodation`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ amount: pesos }) });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error();
      currentAccommodationCents = pesos * 100;
      flash(accommodationFeedback, true);
      recomputeTotals();
    } catch { flash(accommodationFeedback, false); }
  });
  const airbnbPayoutInput = document.getElementById('airbnb-payout-input');
  airbnbPayoutInput?.addEventListener('blur', async () => {
    const pesos = pesosFromInput(airbnbPayoutInput.value);
    airbnbPayoutInput.value = String(pesos);
    try {
      const res = await fetch(`${apiBase}/accommodation`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ airbnbPayout: pesos }) });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error();
      flash(accommodationFeedback, true);
    } catch { flash(accommodationFeedback, false); }
  });

  // ── Food & transport (Full Record) ────────────────────────────────────────
  let currentFoodCents = foodCentsInit;
  let currentTransportCents = transportCentsInit;
  function wireExtraRow(row) {
    const field = row.dataset.field;
    const addBtn = row.querySelector('.extras-add');
    const removeBtn = row.querySelector('.extras-remove');
    const display = row.querySelector('.extras-amount-display');
    const input = row.querySelector('.extras-amount-input');
    addBtn?.addEventListener('click', async () => {
      addBtn.disabled = true;
      try {
        const res = await fetch(`${apiBase}/extras`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ field, confirmed: true, amount: 0 }) });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error();
        if (field === 'food') currentFoodCents = 0; else currentTransportCents = 0;
        window.location.reload();
      } catch { addBtn.disabled = false; }
    });
    removeBtn?.addEventListener('click', async () => {
      removeBtn.disabled = true;
      try {
        const res = await fetch(`${apiBase}/extras`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ field, confirmed: false, amount: 0 }) });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error();
        if (field === 'food') currentFoodCents = 0; else currentTransportCents = 0;
        window.location.reload();
      } catch { removeBtn.disabled = false; }
    });
    display?.addEventListener('click', () => { display.style.display = 'none'; input.style.display = ''; input.focus(); input.select(); });
    input?.addEventListener('keydown', (e) => { if (e.key === 'Enter') input.blur(); });
    input?.addEventListener('blur', async () => {
      const pesos = pesosFromInput(input.value);
      input.value = String(pesos);
      try {
        const res = await fetch(`${apiBase}/extras`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ field, amount: pesos }) });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error();
        display.textContent = formatCOP(pesos);
        if (field === 'food') currentFoodCents = pesos * 100; else currentTransportCents = pesos * 100;
        recomputeTotals();
      } catch { return; }
      display.style.display = ''; input.style.display = 'none';
    });
  }
  document.querySelectorAll('.extras-row').forEach(wireExtraRow);

  // ── Revenue column inline edits (bookings) ────────────────────────────────
  function wireRevenueEdit(displayId, inputId, editBtnId, onSave) {
    const display = document.getElementById(displayId);
    const input = document.getElementById(inputId);
    const editBtn = document.getElementById(editBtnId);
    if (!display || !input || !editBtn) return;
    editBtn.addEventListener('click', () => { display.style.display = 'none'; input.style.display = ''; input.focus(); input.select(); });
    input.addEventListener('keydown', (e) => { if (e.key === 'Enter') input.blur(); });
    input.addEventListener('blur', async () => {
      const ok = await onSave(input.value);
      if (ok) { window.location.reload(); }
      else { display.style.display = ''; input.style.display = 'none'; }
    });
  }
  wireRevenueEdit('rev-accommodation-display', 'rev-accommodation-input', 'rev-accommodation-edit', async (value) => {
    const pesos = pesosFromInput(value);
    try {
      const body = isAirbnb ? { airbnbPayout: pesos } : { amount: pesos };
      const res = await fetch(`${apiBase}/accommodation`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const data = await res.json(); return res.ok && data.success;
    } catch { return false; }
  });
  wireRevenueEdit('rev-food-display', 'rev-food-input', 'rev-food-edit', async (value) => {
    const pesos = pesosFromInput(value);
    try {
      const res = await fetch(`${apiBase}/extras`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ field: 'food', amount: pesos }) });
      const data = await res.json(); return res.ok && data.success;
    } catch { return false; }
  });
  wireRevenueEdit('rev-transport-display', 'rev-transport-input', 'rev-transport-edit', async (value) => {
    const pesos = pesosFromInput(value);
    try {
      const res = await fetch(`${apiBase}/extras`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ field: 'transport', amount: pesos }) });
      const data = await res.json(); return res.ok && data.success;
    } catch { return false; }
  });
  wireRevenueEdit('rev-commission-display', 'rev-commission-rate-input', 'rev-commission-edit', async (value) => {
    const rate = Number(String(value).replace(/[^0-9.]/g, '')) || 0;
    try {
      const res = await fetch(`${apiBase}/commission-rate`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ rate }) });
      return res.ok;
    } catch { return false; }
  });

  // ── Copy balance (bookings) ───────────────────────────────────────────────
  document.getElementById('copy-balance-btn')?.addEventListener('click', async () => {
    const lines = [`Hola ${guestName || ''}! 🌴`, ''];
    if (dateFrom && dateTo) lines.push(`Para confirmar tu reserva del ${shortDateEs(dateFrom)}`, `al ${shortDateEs(dateTo)}:`, '');
    else lines.push('Para confirmar tu reserva:', '');
    lines.push(`💳 Saldo pendiente: ${formatCOP(balanceDueCents / 100)}`, '', 'Ingresa ese monto aquí y paga con', 'tarjeta, PSE o Nequi:', boldLink, '', '¡Gracias! 🌊');
    const btn = document.getElementById('copy-balance-btn');
    const feedback = document.getElementById('balance-feedback');
    try {
      await navigator.clipboard.writeText(lines.join('\n'));
      flash(feedback, true);
      if (btn) { const orig = btn.textContent; btn.textContent = 'Copied!'; setTimeout(() => { if (btn) btn.textContent = orig; }, 1500); }
    } catch { flash(feedback, false); }
  });

  // ── Totals recompute (leads) ──────────────────────────────────────────────
  const commissionRateInput = document.getElementById('commission-rate-input');
  const commissionRateCell = document.getElementById('commission-rate-cell');
  function currentCommissionRate() { return commissionRateInput ? Number(commissionRateInput.value) || 0 : 0; }
  function recomputeTotals() {
    const collectibleAccommodation = isAirbnb ? 0 : currentAccommodationCents;
    const totalToCollect = collectibleAccommodation + currentFoodCents + currentTransportCents;
    const commission = isBookingCom ? Math.round(currentAccommodationCents * (currentCommissionRate() / 100) * 1.19) : 0;
    const el = (id) => document.getElementById(id);
    if (el('total-to-collect')) el('total-to-collect').textContent = formatCOP(totalToCollect / 100);
    if (el('deposit-preview')) el('deposit-preview').textContent = formatCOP(Math.round(totalToCollect * 0.5) / 100);
    if (el('commission-amount')) el('commission-amount').textContent = formatCOP(commission / 100);
    if (el('net-to-you')) el('net-to-you').textContent = formatCOP((totalToCollect - commission) / 100);
    const depositInput = el('deposit-input');
    if (depositInput && !depositInput.dataset.touched) depositInput.value = String(Math.round(totalToCollect / 2 / 100));
  }
  document.getElementById('deposit-input')?.addEventListener('input', (e) => { e.target.dataset.touched = '1'; });
  if (commissionRateCell) {
    const display = commissionRateCell.querySelector('.rc-display');
    display?.addEventListener('click', () => { display.style.display = 'none'; commissionRateInput.style.display = ''; commissionRateInput.focus(); commissionRateInput.select(); });
    commissionRateInput?.addEventListener('keydown', (e) => { if (e.key === 'Enter') commissionRateInput.blur(); });
    commissionRateInput?.addEventListener('blur', async () => {
      const rate = Number(commissionRateInput.value.replace(/[^0-9.]/g, '')) || 0;
      commissionRateInput.value = String(rate);
      display.textContent = `${rate}%`; display.style.display = ''; commissionRateInput.style.display = 'none';
      recomputeTotals();
      try { await fetch(`${apiBase}/commission-rate`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ rate }) }); } catch { /* low-stakes */ }
    });
  }

  // ── Collect deposit copy (leads) ──────────────────────────────────────────
  document.getElementById('copy-deposit-btn')?.addEventListener('click', async () => {
    const depositInput = document.getElementById('deposit-input');
    const pesos = pesosFromInput(depositInput.value);
    const lines = [`Hola ${guestName || ''}! 🌴`, ''];
    if (dateFrom && dateTo) lines.push(`Para confirmar tu reserva del ${shortDateEs(dateFrom)}`, `al ${shortDateEs(dateTo)}:`, '');
    else lines.push('Para confirmar tu reserva:', '');
    lines.push(`💳 Depósito: ${formatCOP(pesos)}`, '', 'Ingresa ese monto aquí y paga con', 'tarjeta, PSE o Nequi:', boldLink, '', '¡Gracias! 🌊');
    const btn = document.getElementById('copy-deposit-btn');
    const feedback = document.getElementById('deposit-feedback');
    try {
      await navigator.clipboard.writeText(lines.join('\n'));
      flash(feedback, true);
      if (btn) { const orig = btn.textContent; btn.textContent = 'Copied!'; setTimeout(() => { if (btn) btn.textContent = orig; }, 1500); }
    } catch { flash(feedback, false); }
  });

  // ── Payments received (Full Record) ───────────────────────────────────────
  const addPaymentBtn = document.getElementById('add-payment-btn');
  const addPaymentForm = document.getElementById('add-payment-form');
  addPaymentBtn?.addEventListener('click', () => { addPaymentForm.style.display = ''; addPaymentBtn.style.display = 'none'; });
  document.getElementById('payment-cancel-btn')?.addEventListener('click', () => { addPaymentForm.style.display = 'none'; addPaymentBtn.style.display = ''; });
  document.getElementById('payment-save-btn')?.addEventListener('click', async () => {
    const amountInput = document.getElementById('payment-amount');
    const methodSelect = document.getElementById('payment-method');
    const dateInput = document.getElementById('payment-date');
    const errorBox = document.getElementById('payment-error');
    const pesos = pesosFromInput(amountInput.value);
    if (pesos <= 0) { if (errorBox) { errorBox.textContent = 'Enter a valid amount.'; errorBox.style.display = ''; } return; }
    const btn = document.getElementById('payment-save-btn');
    btn.disabled = true;
    try {
      await postPayment(pesos, methodSelect.value, dateInput.value);
      window.location.reload();
    } catch (error) {
      if (errorBox) { errorBox.textContent = error instanceof Error ? error.message : 'Could not save payment.'; errorBox.style.display = ''; }
      btn.disabled = false;
    }
  });
  document.querySelectorAll('.payment-remove').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      if (!id) return;
      btn.disabled = true;
      try {
        const res = await fetch(`/admin/api/payments/${id}`, { method: 'DELETE' });
        if (!res.ok) throw new Error();
        window.location.reload();
      } catch { btn.disabled = false; }
    });
  });

  // ── Costs (bookings) ──────────────────────────────────────────────────────
  function wireCostInput(id, field) {
    const input = document.getElementById(id);
    input?.addEventListener('blur', async () => {
      const pesos = pesosFromInput(input.value);
      input.value = String(pesos);
      const feedback = document.getElementById('costs-feedback');
      try {
        const res = await fetch(`${apiBase}/costs`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ [field]: pesos }) });
        if (!res.ok) throw new Error();
        flash(feedback, true);
        window.location.reload();
      } catch { flash(feedback, false); }
    });
  }
  wireCostInput('cost-staff-input', 'staff');
  wireCostInput('cost-food-input', 'food');
  wireCostInput('cost-transport-input', 'transport');

  // ── Notes autosave ────────────────────────────────────────────────────────
  const notesInput = document.getElementById('notes-input');
  const notesFeedback = document.getElementById('notes-feedback');
  let notesTimer;
  notesInput?.addEventListener('input', () => {
    if (notesFeedback) notesFeedback.textContent = 'Saving…';
    clearTimeout(notesTimer);
    notesTimer = setTimeout(async () => {
      try {
        const res = await fetch(`${apiBase}/update`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ notes: notesInput.value }) });
        if (!res.ok) throw new Error();
        if (notesFeedback) notesFeedback.textContent = '✓ Saved';
      } catch { if (notesFeedback) notesFeedback.textContent = 'Could not save'; }
    }, 600);
  });

  // ── HostHub channel ───────────────────────────────────────────────────────
  const channelSelect = document.getElementById('hosthub-channel-select');
  const channelFeedback = document.getElementById('channel-feedback');
  channelSelect?.addEventListener('change', async () => {
    try {
      const res = await fetch(`${apiBase}/channel`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ channel: channelSelect.value }) });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error();
      flash(channelFeedback, true);
      window.location.reload();
    } catch { flash(channelFeedback, false); }
  });
</script>
