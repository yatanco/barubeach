---
import WhatsAppPopup from '../components/WhatsAppPopup.tsx';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  lang?: 'en' | 'es';
  defaultPopupType?: 'daytrip' | 'stay';
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/og-image.jpg',
  lang = 'en',
  defaultPopupType = 'daytrip',
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).href;
const stickyLabel = lang === 'es' ? 'Planear por WhatsApp →' : 'Plan on WhatsApp →';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Casa Gaviota Baru" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="icon" type="image/png" href="/images/logo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-Y3SP3YNDE6"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-Y3SP3YNDE6');
    </script>
  </head>
  <body class="bg-background text-ink font-sans antialiased">
    <slot />

    <WhatsAppPopup lang={lang} defaultType={defaultPopupType} client:load />

    <!-- Sticky mobile bottom bar -->
    <div
      id="sticky-wa-bar"
      class="fixed bottom-0 left-0 right-0 z-40 md:hidden translate-y-full transition-transform duration-300"
      style="background: #25D366;"
    >
      <button
        onclick="window.dispatchEvent(new CustomEvent('open-wa-popup'))"
        class="flex items-center justify-between w-full px-5 py-4 text-white font-semibold cursor-pointer"
        aria-label={stickyLabel}
      >
        <span class="flex items-center gap-3">
          <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          {stickyLabel}
        </span>
        <svg class="w-4 h-4 text-white/70" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <script>
      import { initLightbox } from '../lib/lightbox';
      initLightbox();
    </script>

    <script is:inline>
      // Sticky WA bar — show after 300px, hide near the form
      (function () {
        var bar = document.getElementById('sticky-wa-bar');
        var book = document.getElementById('book');
        function update() {
          if (!bar) return;
          if (window.scrollY < 300) { bar.classList.add('translate-y-full'); return; }
          if (book) {
            var rect = book.getBoundingClientRect();
            if (rect.top < window.innerHeight + 200) { bar.classList.add('translate-y-full'); return; }
          }
          bar.classList.remove('translate-y-full');
        }
        window.addEventListener('scroll', update, { passive: true });
        update();
      })();

      // Exit intent + 40-second timer
      (function () {
        if (window.location.pathname.indexOf('/booking/confirm') !== -1) return;
        if (sessionStorage.getItem('popup_shown')) return;
        var fired = false;
        function fire() {
          if (fired || sessionStorage.getItem('popup_shown')) return;
          fired = true;
          clearTimeout(timer);
          document.removeEventListener('mouseleave', onLeave);
          sessionStorage.setItem('popup_shown', '1');
          window.dispatchEvent(new CustomEvent('open-wa-popup'));
        }
        var timer = setTimeout(fire, 40000);
        function onLeave(e) { if (e.clientY <= 5) fire(); }
        document.addEventListener('mouseleave', onLeave);
      })();
    </script>
  </body>
</html>
