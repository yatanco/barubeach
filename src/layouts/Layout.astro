---
import '../styles/global.css';
import WhatsAppPopup from '../components/WhatsAppPopup.tsx';
import WhatsAppIcon from '../components/icons/WhatsAppIcon.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  altHref?: string;
  ogImage?: string;
  lang?: 'en' | 'es';
  defaultPopupType?: 'daytrip' | 'stay';
  jsonLd?: Record<string, unknown>;
  hideBookingWidgets?: boolean;
  heroImage?: string;
}

const {
  title,
  description,
  canonical,
  altHref,
  ogImage = '/images/og-image.jpg',
  lang = 'en',
  defaultPopupType = 'daytrip',
  jsonLd,
  hideBookingWidgets = false,
  heroImage,
} = Astro.props;

const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).href;
const altURL = altHref ? new URL(altHref, Astro.site).href : null;
const ogLocale = lang === 'es' ? 'es_CO' : 'en_US';
const stickyLabel = lang === 'es' ? 'Verificar Disponibilidad →' : 'Check Availability →';
const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID ?? '1039533654806987';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Casa Gaviota Baru" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="robots" content="index, follow" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {altURL && <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={altURL} />}
    {altURL && <link rel="alternate" hreflang={lang} href={canonicalURL} />}
    {altURL && <link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonicalURL : altURL} />}

    <link rel="icon" type="image/png" href="/images/logo.png" />

    {heroImage && (
      <link rel="preload" as="image" href={heroImage} fetchpriority="high" type="image/webp" />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-YCRQRM6R43"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      window.gtag = (...args) => window.dataLayer?.push(args);
      window.gtag('js', new Date());
      window.gtag('config', 'G-YCRQRM6R43');
    </script>

    <!-- Meta Pixel -->
    <script is:inline define:vars={{ metaPixelId }}>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window,document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', metaPixelId);
      fbq('track', 'PageView');
    </script>
  </head>
  <body class="bg-background text-ink font-sans antialiased">
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`}
        alt=""
      />
    </noscript>

    <slot />

    {!hideBookingWidgets && (
      <>
        <WhatsAppPopup lang={lang} defaultType={defaultPopupType} client:idle />

        <!-- Sticky mobile bottom bar -->
        <div
          id="sticky-wa-bar"
          class="fixed bottom-0 left-0 right-0 z-40 md:hidden translate-y-full transition-transform duration-300"
          style="background: #25D366;"
        >
          <button
            onclick="window.dispatchEvent(new CustomEvent('open-wa-popup', {detail:{intentional:true}}))"
            class="flex items-center justify-between w-full px-5 py-4 text-white font-semibold cursor-pointer"
            aria-label={stickyLabel}
          >
            <span class="flex items-center gap-3">
              <WhatsAppIcon class="w-5 h-5 flex-shrink-0" />
              {stickyLabel}
            </span>
            <svg class="w-4 h-4 text-white/70" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>

        <script is:inline>
          // Sticky WA bar — show after 300px, hide near the form
          (function () {
            var bar = document.getElementById('sticky-wa-bar');
            var book = document.getElementById('book');
            function update() {
              if (!bar) return;
              if (window.scrollY < 300) { bar.classList.add('translate-y-full'); return; }
              if (book) {
                var rect = book.getBoundingClientRect();
                if (rect.top < window.innerHeight + 200) { bar.classList.add('translate-y-full'); return; }
              }
              bar.classList.remove('translate-y-full');
            }
            window.addEventListener('scroll', update, { passive: true });
            update();
          })();

          // Exit intent + 40-second timer
          (function () {
            if (window.location.pathname.indexOf('/booking/confirm') !== -1) return;
            if (sessionStorage.getItem('popup_shown')) return;
            var fired = false;
            function fire() {
              if (fired || sessionStorage.getItem('popup_shown')) return;
              fired = true;
              clearTimeout(timer);
              document.removeEventListener('mouseleave', onLeave);
              sessionStorage.setItem('popup_shown', '1');
              window.dispatchEvent(new CustomEvent('open-wa-popup', {detail:{intentional:false}}));
            }
            var timer = setTimeout(fire, 40000);
            function onLeave(e) { if (e.clientY <= 5) fire(); }
            document.addEventListener('mouseleave', onLeave);
          })();
        </script>
      </>
    )}

    <script>
      import { initLightbox } from '../lib/lightbox';
      import { publicAnalyticsContext, trackGA4Event } from '../lib/analytics';
      initLightbox();

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const link = event.target.closest<HTMLAnchorElement>('a[href*="wa.me/"]');
        if (!link) return;
        const language = document.documentElement.lang === 'es' ? 'es' : 'en';
        trackGA4Event('whatsapp_click', {
          link_type: 'whatsapp',
          ...publicAnalyticsContext(language),
        });
      });
    </script>
  </body>
</html>
