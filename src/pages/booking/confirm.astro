---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';

const WA = 'https://wa.me/573163946401?text=' + encodeURIComponent('Hi, I would like to follow up on my Baru Beach House inquiry.');
---

<Layout
  title="Inquiry Received — Baru Beach House"
  description="Thank you for your inquiry. We will get back to you on WhatsApp or email within a few hours."
  lang="en"
>
  <Header lang="en" page="confirm" />

  <section class="min-h-[70vh] flex items-center justify-center px-6 py-20">
    <div class="max-w-lg mx-auto text-center">

      <!-- Checkmark icon -->
      <div class="w-16 h-16 rounded-full bg-ocean/10 flex items-center justify-center mx-auto mb-8">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-ocean" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
      </div>

      <p class="text-sand text-xs uppercase tracking-widest font-medium mb-3">Thank you</p>
      <h1 class="font-serif text-3xl sm:text-4xl font-semibold mb-5">We received your inquiry</h1>
      <p class="text-ink/70 text-base sm:text-lg leading-relaxed mb-10">
        We will get back to you on WhatsApp or email within a few hours to confirm availability and details.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={WA}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 bg-whatsapp text-white px-7 py-4 rounded-full text-sm font-medium hover:opacity-90 transition shadow-md"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          Message us on WhatsApp
        </a>
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 border border-ocean/30 text-ocean px-7 py-4 rounded-full text-sm font-medium hover:bg-ocean/5 transition"
        >
          Back to home
        </a>
      </div>
    </div>
  </section>

  <Footer lang="en" />
  <WhatsAppButton lang="en" page="confirm" />
</Layout>
