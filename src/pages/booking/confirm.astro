---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppIcon from '../../components/icons/WhatsAppIcon.astro';
import { waLink } from '../../lib/whatsapp';
---

<Layout
  title="We received your message — Casa Gaviota Baru"
  description="We will get back to you on WhatsApp or email within a few hours with availability and details."
  lang="en"
>
  <Header lang="en" altHref="/booking/confirm" />

  <section class="min-h-[75vh] flex items-center justify-center px-6 py-24">
    <div class="max-w-md mx-auto text-center">

      <div class="w-16 h-16 rounded-full bg-brown/10 flex items-center justify-center mx-auto mb-8">
        <svg class="w-8 h-8 text-brown" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
      </div>

      <p class="text-terracotta text-xs uppercase tracking-widest font-medium mb-3">Thank you</p>
      <h1 class="font-serif text-3xl sm:text-4xl font-semibold mb-5 text-brown">We received your message. ✓</h1>
      <p class="text-ink/65 text-base leading-relaxed mb-10">
        We will get back to you on WhatsApp or email within a few hours with availability and details.
      </p>
      <p class="text-ink/50 text-sm mb-8">In the meantime, feel free to message us directly.</p>

      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={waLink('gaviotaconfirm')}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 bg-whatsapp text-white px-7 py-4 rounded-full text-sm font-medium hover:opacity-90 transition shadow-md"
        >
          <WhatsAppIcon class="w-4 h-4" />
          Open WhatsApp
        </a>
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 border border-ink/20 text-ink/70 px-7 py-4 rounded-full text-sm font-medium hover:bg-sand/10 transition"
        >
          ← Back to home
        </a>
      </div>
    </div>
  </section>

  <Footer lang="en" />
</Layout>
