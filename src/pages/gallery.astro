---
import { Picture, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Import all gallery assets dynamically. Uppercase extensions are included
// because iOS exports (.JPG, .PNG) land in this folder alongside lowercase
// Instagram exports, and glob matching is case-sensitive on Cloudflare's
// (Linux) build filesystem.
const photoImports = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/gallery/photos/*.{jpg,jpeg,webp,png,JPG,JPEG,WEBP,PNG}',
  { eager: true }
);
const videoImports = import.meta.glob<{ default: string }>('../assets/gallery/reels/*.mp4', {
  eager: true,
});

const photosRaw = Object.entries(photoImports)
  .map(([path, mod]) => ({
    type: 'photo' as const,
    src: mod.default,
    filename: path.split('/').pop() ?? '',
  }))
  // newest Instagram filenames first (they use timestamps)
  .sort((a, b) => b.filename.localeCompare(a.filename));

const videos = Object.entries(videoImports)
  .map(([path, mod]) => ({
    type: 'video' as const,
    src: mod.default,
    filename: path.split('/').pop() ?? '',
  }))
  .sort((a, b) => b.filename.localeCompare(a.filename));

// A single higher-res source per photo for the lightbox (the grid itself
// only ever needs up to 1200w).
const photos = await Promise.all(
  photosRaw.map(async (photo) => {
    const lightbox = await getImage({
      src: photo.src,
      format: 'webp',
      quality: 85,
      width: Math.min(1200, photo.src.width),
    });
    return { ...photo, lightboxSrc: lightbox.src };
  })
);

const total = photos.length + videos.length;
---

<Layout
  title="Gallery — Casa Gaviota Barú"
  description="Photos and videos of Casa Gaviota, a private beach house in Barú, Colombia."
  lang="en"
>
  <Header lang="en" altHref="/gallery" />

  <main class="gallery-page">
    {/* PHOTOS SECTION */}
    {photos.length > 0 && (
      <section class="gallery-section">
        <p class="section-label">Photos</p>
        <div class="gallery-grid" id="photo-grid">
          {photos.map((photo, index) => (
            <div
              class="gallery-item"
              data-index={index}
              data-type="photo"
              data-lightbox-src={photo.lightboxSrc}
              aria-label={`Open photo ${index + 1} of ${total}`}
              role="button"
              tabindex="0"
            >
              <Picture
                src={photo.src}
                formats={index < 4 ? ['avif', 'webp'] : ['webp']}
                fallbackFormat="jpeg"
                widths={index < 4 ? [400, 800, 1200] : [400, 800]}
                sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
                alt="Casa Gaviota Barú"
                priority={index < 4}
                layout="constrained"
                quality={index < 4 ? 90 : 75}
                style="width: 100%; aspect-ratio: 1/1; object-fit: cover; cursor: pointer; display: block;"
              />
            </div>
          ))}
        </div>
      </section>
    )}

    {/* DIVIDER - only shown when both sections have content */}
    {photos.length > 0 && videos.length > 0 && <hr class="section-divider" />}

    {/* VIDEOS SECTION */}
    {videos.length > 0 && (
      <section class="gallery-section">
        <p class="section-label">Videos</p>
        <div class="gallery-grid" id="video-grid">
          {videos.map((video, index) => (
            <div
              class="gallery-item video-item"
              data-index={photos.length + index}
              data-type="video"
              data-lightbox-src={video.src}
              aria-label={`Open video ${photos.length + index + 1} of ${total}`}
              role="button"
              tabindex="0"
            >
              {/* Thumbnail placeholder — video loads via JS */}
              <div class="video-placeholder">
                <svg viewBox="0 0 24 24" fill="white" width="32" height="32">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
              <video
                class="gallery-video"
                data-src={video.src}
                preload="none"
                muted
                loop
                playsinline
                style="width: 100%; aspect-ratio: 1/1; object-fit: cover; cursor: pointer; display: none;"
              />
            </div>
          ))}
        </div>
      </section>
    )}

    {/* EMPTY STATE */}
    {photos.length === 0 && videos.length === 0 && (
      <div class="empty-state">
        <p>Gallery coming soon</p>
        <a href="https://instagram.com/casagaviotabaru" target="_blank" rel="noopener noreferrer">
          @casagaviotabaru
        </a>
      </div>
    )}

    {/* INSTAGRAM LINK */}
    {(photos.length > 0 || videos.length > 0) && (
      <div class="instagram-link">
        <a href="https://instagram.com/casagaviotabaru" target="_blank" rel="noopener noreferrer">
          📸 Follow us on Instagram
          <span>@casagaviotabaru</span>
        </a>
      </div>
    )}
  </main>

  <!-- Lightbox -->
  <div id="lightbox" class="lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Gallery viewer">
    <button id="lightbox-close" type="button" aria-label="Close" class="lightbox-close">&times;</button>
    <button id="lightbox-prev" type="button" aria-label="Previous" class="lightbox-nav lightbox-prev">&#8249;</button>
    <button id="lightbox-next" type="button" aria-label="Next" class="lightbox-nav lightbox-next">&#8250;</button>

    <img id="lightbox-img" class="lightbox-media hidden" alt="" />
    <video id="lightbox-video" class="lightbox-media hidden" controls playsinline></video>

    <div id="lightbox-counter" class="lightbox-counter"></div>
  </div>

  <Footer lang="en" />
</Layout>

<style>
  .gallery-page {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0;
  }

  .section-label {
    font-family: var(--font-sans, Inter, sans-serif);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #b28471;
    padding: 16px 16px 8px;
    margin: 0;
  }

  .section-divider {
    border: none;
    border-top: 1px solid #e6c497;
    margin: 24px 16px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4px;
    padding: 0 4px;
  }

  @media (min-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    background: #e6c497;
    cursor: pointer;
    aspect-ratio: 1/1;
  }

  .gallery-item:hover img,
  .gallery-item:hover video {
    transform: scale(1.03);
    transition: transform 0.3s ease;
  }

  .video-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #57392e;
  }

  .gallery-video {
    position: absolute;
    inset: 0;
  }

  .empty-state {
    text-align: center;
    padding: 80px 20px;
    color: #b28471;
  }

  .instagram-link {
    text-align: center;
    padding: 48px 20px;
  }

  .instagram-link a {
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    color: #b28471;
    text-decoration: none;
    font-size: 14px;
  }

  .instagram-link span {
    font-weight: 600;
    color: #57392e;
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 999;
    background: #000;
    align-items: center;
    justify-content: center;
  }

  .lightbox.open {
    display: flex;
  }

  .lightbox-media {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
  }

  .lightbox-media.hidden {
    display: none;
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
    line-height: 1;
    z-index: 10;
  }

  .lightbox-close {
    top: 12px;
    right: 16px;
    font-size: 2.5rem;
    padding: 10px;
  }

  .lightbox-nav {
    top: 50%;
    transform: translateY(-50%);
    font-size: 3.5rem;
    padding: 12px;
    color: rgba(255, 255, 255, 0.7);
  }

  .lightbox-prev {
    left: 4px;
  }

  .lightbox-next {
    right: 4px;
  }

  .lightbox-close:hover,
  .lightbox-nav:hover {
    color: #fff;
  }

  .lightbox-counter {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.8);
    font-size: 14px;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .lightbox-close {
      top: 24px;
      right: 24px;
    }
    .lightbox-prev {
      left: 16px;
    }
    .lightbox-next {
      right: 16px;
    }
    .lightbox-counter {
      bottom: 24px;
    }
  }
</style>

<script>
  // Videos in the grid: only load + autoplay once 50%+ visible.
  function setupGridVideoAutoplay() {
    const videos = document.querySelectorAll<HTMLVideoElement>('.gallery-video');
    if (!videos.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          const placeholder = video.previousElementSibling as HTMLElement | null;
          if (entry.isIntersecting) {
            if (!video.src && video.dataset.src) video.src = video.dataset.src;
            placeholder?.style.setProperty('display', 'none');
            video.style.display = 'block';
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        }
      },
      { threshold: 0.5 }
    );

    videos.forEach((v) => io.observe(v));
  }

  // Full-screen lightbox: photos and videos share one continuous sequence,
  // in DOM order (photos section first, then videos section).
  function setupLightbox() {
    const items = Array.from(document.querySelectorAll<HTMLElement>('.gallery-item'));
    if (!items.length) return;

    const lightbox = document.getElementById('lightbox');
    const imgEl = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const videoEl = document.getElementById('lightbox-video') as HTMLVideoElement | null;
    const counterEl = document.getElementById('lightbox-counter');
    const closeBtn = document.getElementById('lightbox-close') as HTMLButtonElement | null;
    const prevBtn = document.getElementById('lightbox-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('lightbox-next') as HTMLButtonElement | null;
    if (!lightbox || !imgEl || !videoEl || !counterEl || !closeBtn || !prevBtn || !nextBtn) return;

    const focusable = [prevBtn, nextBtn, closeBtn];

    let index = 0;
    let touchX = 0;
    let lastTrigger: HTMLElement | null = null;

    function show(i: number) {
      index = ((i % items.length) + items.length) % items.length;
      const item = items[index];
      const type = item.dataset.type;
      const src = item.dataset.lightboxSrc || '';

      videoEl!.pause();
      videoEl!.removeAttribute('src');
      videoEl!.load();

      if (type === 'video') {
        imgEl!.classList.add('hidden');
        videoEl!.classList.remove('hidden');
        videoEl!.src = src;
        videoEl!.play().catch(() => {});
      } else {
        videoEl!.classList.add('hidden');
        imgEl!.classList.remove('hidden');
        imgEl!.src = src;
      }

      counterEl!.textContent = `${index + 1} / ${items.length}`;
    }

    function open(i: number, trigger: HTMLElement) {
      lastTrigger = trigger;
      show(i);
      lightbox!.classList.add('open');
      lightbox!.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      closeBtn!.focus();
    }

    function close() {
      videoEl!.pause();
      lightbox!.classList.remove('open');
      lightbox!.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      lastTrigger?.focus();
    }

    items.forEach((item, i) => {
      item.addEventListener('click', () => open(i, item));
      item.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(i, item);
        }
      });
    });

    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', () => show(index - 1));
    nextBtn.addEventListener('click', () => show(index + 1));

    lightbox.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target === imgEl || target === videoEl) return;
      if (target.closest('#lightbox-prev, #lightbox-next, #lightbox-close')) return;
      close();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox!.classList.contains('open')) return;

      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key === 'ArrowRight') {
        show(index + 1);
        return;
      }
      if (e.key === 'ArrowLeft') {
        show(index - 1);
        return;
      }

      // Focus trap: cycle Tab/Shift+Tab between the three controls.
      if (e.key === 'Tab') {
        const active = document.activeElement;
        const currentIdx = focusable.indexOf(active as HTMLButtonElement);
        e.preventDefault();
        const dir = e.shiftKey ? -1 : 1;
        const nextIdx = ((currentIdx === -1 ? 0 : currentIdx) + dir + focusable.length) % focusable.length;
        focusable[nextIdx].focus();
      }
    });

    lightbox.addEventListener(
      'touchstart',
      (e) => {
        touchX = e.touches[0].clientX;
      },
      { passive: true }
    );
    lightbox.addEventListener('touchend', (e) => {
      if (!lightbox!.classList.contains('open')) return;
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
    });
  }

  setupGridVideoAutoplay();
  setupLightbox();
</script>
