---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const WA = 'https://wa.me/573163946401?text=' + encodeURIComponent('Hi, I am interested in Baru Beach House.');

// Real Baru Beach House photos from /public/images/
const photos = [
  { src: '/images/sunset.webp', alt: 'Sunset at Baru Beach House' },
  { src: '/images/IMG_1195-1536x1152.webp', alt: 'Private beach at Baru Beach House' },
  { src: '/images/IMG_1011-1536x863.webp', alt: 'Beach house exterior and social area' },
  { src: '/images/IMG_1216-1536x1152.webp', alt: 'Ocean view from the house' },
  { src: '/images/IMG_5390-1536x1024.webp', alt: 'Beach access at Baru Beach House' },
  { src: '/images/masterbedroom.webp', alt: 'Master bedroom' },
  { src: '/images/twinbedroom.webp', alt: 'Twin bedroom' },
  { src: '/images/IMG_1205-1536x1152.webp', alt: 'Social area at Baru Beach House' },
  { src: '/images/IMG_1206-1536x975.webp', alt: 'Interior social space' },
  { src: '/images/IMG_1213-768x511.webp', alt: 'Beach and sea view from Baru Beach House' },
  { src: '/images/IMG_1214-768x576.webp', alt: 'The house surrounded by nature' },
  { src: '/images/IMG_1220-768x576.webp', alt: 'Outdoor area at Baru Beach House' },
  { src: '/images/IMG_1222-768x512.webp', alt: 'View of the Barú coastline' },
  { src: '/images/IMG_0924-1536x1152.webp', alt: 'Guests enjoying the private beach' },
  { src: '/images/IMG_0928-768x432.webp', alt: 'Beach activities at Baru Beach House' },
  { src: '/images/IMG_0940-768x432.webp', alt: 'Natural surroundings at the beach house' },
  { src: '/images/IMG_1195-1536x1152.webp', alt: 'Beach at sunset — Isla Barú' },
  { src: '/images/IMG_3784-1536x1024.webp', alt: 'Beautiful view at Baru Beach House' },
  { src: '/images/IMG_6692.webp', alt: 'The beach house from the water' },
];
---

<Layout
  title="Gallery — Baru Beach House, Barú Colombia"
  description="Photos of Baru Beach House — a private beach house on Isla Barú near Cartagena. See the bedrooms, beach, social areas, and natural surroundings."
  lang="en"
>
  <Header lang="en" page="gallery" />

  <!-- Header -->
  <section class="py-20 text-center px-6 max-w-3xl mx-auto">
    <p class="text-sand text-xs uppercase tracking-widest font-medium mb-4">Photos</p>
    <h1 class="font-serif text-4xl sm:text-5xl font-semibold mb-4">The House &amp; The Beach</h1>
    <p class="text-ink/60 text-base sm:text-lg">A private beach house in Barú — simple, natural, and surrounded by sea.</p>
  </section>

  <!-- Photo grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-20">
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4">
      {photos.map(({ src, alt }) => (
        <div class="break-inside-avoid">
          <img
            src={src}
            alt={alt}
            loading="lazy"
            class="rounded-2xl w-full object-cover"
          />
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 text-center px-6">
    <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-4">Looks like your kind of place?</h2>
    <p class="text-ink/60 mb-8 text-base">Message us on WhatsApp and we'll help you plan a stay or day trip.</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={WA}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 bg-whatsapp text-white px-7 py-4 rounded-full text-sm font-medium hover:opacity-90 transition shadow-md"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        Message us on WhatsApp
      </a>
      <a href="/#book" class="inline-flex items-center justify-center gap-2 border border-ocean/30 text-ocean px-7 py-4 rounded-full text-sm font-medium hover:bg-ocean/5 transition">
        Book a stay
      </a>
    </div>
  </section>

  <Footer lang="en" />
  <WhatsAppButton lang="en" page="gallery" />
</Layout>
