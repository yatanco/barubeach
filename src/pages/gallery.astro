---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

const images = [
  { src: '/images/hero-1.jpg', alt: 'Casa Gaviota beach house exterior' },
  { src: '/images/beach-1.jpg', alt: 'Private beach at Casa Gaviota' },
  { src: '/images/house-1.jpg', alt: 'Social area at Casa Gaviota' },
  { src: '/images/beach-2.jpg', alt: 'Beach and ocean view' },
  { src: '/images/food-1.jpg', alt: 'Caribbean food at Casa Gaviota' },
  { src: '/images/house-2.jpg', alt: 'Bedroom at Casa Gaviota' },
  { src: '/images/daytrip-1.jpg', alt: 'Private day trip to Barú' },
  { src: '/images/beach-3.jpg', alt: 'Ocean and coastline' },
  { src: '/images/house-3.jpg', alt: 'Terrace and outdoor space' },
  { src: '/images/food-2.jpg', alt: 'Fresh lunch at Casa Gaviota' },
  { src: '/images/house-4.jpg', alt: 'Private bathroom' },
  { src: '/images/daytrip-2.jpg', alt: 'Arriving by boat' },
  { src: '/images/hero-2.jpg', alt: 'Casa Gaviota from the beach' },
  { src: '/images/hero-3.jpg', alt: 'Sunset at Casa Gaviota' },
];
---

<Layout
  title="Photos — Casa Gaviota Baru Private Beach House"
  description="Photos of Casa Gaviota, a private beach house in Barú, Colombia. Beach, house, food, and nature."
  lang="en"
>
  <Header lang="en" altHref="/gallery" />

  <section class="py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-14">
        <h1 class="font-serif text-3xl sm:text-4xl font-semibold mb-3">La Casa & La Playa</h1>
        <p class="text-muted">A private beach house in Barú — simple, natural, and surrounded by sea.</p>
      </div>

      <div class="columns-1 sm:columns-2 lg:columns-3 gap-4 space-y-4">
        {images.map(({ src, alt }) => (
          <div class="break-inside-avoid">
            <img
              src={src}
              alt={alt}
              class="w-full rounded-xl object-cover shadow-sm hover:shadow-md transition-shadow"
              loading="lazy"
              width="500"
              height="400"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer lang="en" />
  <WhatsAppButton text="gaviotastay" />
</Layout>
