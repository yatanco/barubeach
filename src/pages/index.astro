---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WAInlineForm from '../components/WAInlineForm.tsx';

const MAPS = 'https://share.google/SHahHFkk8vXJIW7hH';
---

<Layout
  title="Casa Gaviota Baru — Private Beach House in Barú, Colombia"
  description="A private beach house on Isla Barú near Cartagena. 80 meters of private beach, no vendors, no crowds. Full service, total privacy. Book a stay or day trip."
  lang="en"
  defaultPopupType="stay"
>
  <Header lang="en" altHref="/es" />

  <!-- HERO -->
  <section class="relative min-h-screen flex items-center justify-center">
    <img
      src="/images/hero-1.jpg"
      alt="Casa Gaviota private beach in Barú, Colombia"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      width="1280"
      height="720"
    />
    <div class="absolute inset-0" style="background: rgba(87,57,46,0.50);"></div>
    <div class="relative z-10 text-center text-white px-6 max-w-3xl mx-auto py-24">
      <p class="text-sand text-xs sm:text-sm uppercase tracking-widest font-medium mb-5">Barú · Colombia</p>
      <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl font-semibold leading-tight mb-4">
        Casa Gaviota Baru
      </h1>
      <h2 class="text-xl sm:text-2xl font-light mb-3">A Private Beach House in Barú</h2>
      <p class="text-sm sm:text-base text-white/70 mb-12 uppercase tracking-wider">
        80 meters of private beach · no crowds · just your group
      </p>

      <button
        onclick="window.dispatchEvent(new CustomEvent('open-wa-popup', {detail:{type:'stay'}}))"
        class="bg-sand text-brown font-semibold px-8 py-4 rounded-full text-base hover:opacity-90 transition-opacity cursor-pointer mb-10"
      >
        Plan on WhatsApp →
      </button>
      <a href="#experience" class="block text-white/45 text-sm hover:text-white/70 transition-colors">
        Scroll to explore ↓
      </a>
    </div>
  </section>

  <!-- REVIEWS -->
  <section id="reviews" class="py-20 bg-rose/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-3 text-brown">What 200+ guests say</h2>
        <p class="text-muted text-sm">⭐ 4.8 · Airbnb, Booking.com &amp; Google</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="reviews-initial">
        {[
          'Insanely beautiful and peaceful, the ideal place to unwind.',
          "A slice of heaven… we can't wait to go back.",
          'Perfect to relax and disconnect from everything.',
          'The food was better than restaurants.',
        ].map(quote => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-terracotta/15">
            <p class="text-terracotta text-3xl leading-none mb-3">"</p>
            <p class="text-ink/75 text-sm leading-relaxed">{quote}</p>
          </div>
        ))}
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-4 hidden" id="reviews-extra">
        {[
          'Manuel and his team are incredibly attentive. We felt completely taken care of.',
          'The most beautiful and peaceful place we have ever stayed in Colombia.',
          'Perfect for our family trip. Kids loved it, adults finally relaxed.',
          'Worth every peso. We are already planning our next visit.',
        ].map(quote => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-terracotta/15">
            <p class="text-terracotta text-3xl leading-none mb-3">"</p>
            <p class="text-ink/75 text-sm leading-relaxed">{quote}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 text-center">
        <button
          id="show-more-reviews"
          class="border border-brown text-brown font-medium text-sm px-6 py-3 rounded-full hover:bg-brown/5 transition"
        >
          Show more reviews
        </button>
      </div>
      <div class="mt-10 text-center">
        <p class="text-sm text-ink/50 mb-4">200+ verified reviews across platforms</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="http://airbnb.com/h/casagaviotabaru"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border border-brown text-brown font-medium text-sm px-6 py-3 rounded-full hover:bg-brown/5 transition"
          >
            Read all reviews on Airbnb →
          </a>
          <a
            href="https://share.google/SHahHFkk8vXJIW7hH"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border border-brown text-brown font-medium text-sm px-6 py-3 rounded-full hover:bg-brown/5 transition"
          >
            Read all reviews on Google →
          </a>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    document.getElementById('show-more-reviews')?.addEventListener('click', function() {
      document.getElementById('reviews-extra')?.classList.remove('hidden');
      this.style.display = 'none';
    });
  </script>

  <!-- EXPERIENCE CARDS -->
  <section id="experience" class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-brown text-center mb-3">What are you looking for?</h2>
      <p class="text-center text-ink/55 text-sm mb-10">Two ways to experience Casa Gaviota — both private, both unforgettable.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

        <!-- Day Trip card -->
        <div class="bg-white rounded-2xl border border-terracotta/15 p-7 shadow-sm flex flex-col">
          <div class="text-3xl mb-4">☀️</div>
          <h3 class="font-serif text-xl font-semibold text-brown mb-2">Day Trip <span class="font-sans font-normal text-sm text-ink/50">(Pasadía)</span></h3>
          <p class="text-ink/65 text-sm leading-relaxed mb-6 flex-1">Arrive in the morning, leave by sunset. Private beach, fresh food, and total freedom from crowds.</p>
          <a
            href="/daytrip"
            class="inline-flex items-center gap-1.5 bg-sand text-brown font-semibold text-sm px-5 py-3 rounded-full hover:opacity-90 transition-opacity self-start"
          >
            See Day Trip →
          </a>
        </div>

        <!-- Overnight Stay card -->
        <div class="bg-white rounded-2xl border border-terracotta/15 p-7 shadow-sm flex flex-col">
          <div class="text-3xl mb-4">🌙</div>
          <h3 class="font-serif text-xl font-semibold text-brown mb-2">Overnight Stay <span class="font-sans font-normal text-sm text-ink/50">(Estadía)</span></h3>
          <p class="text-ink/65 text-sm leading-relaxed mb-6 flex-1">Sleep to the sound of waves. Wake up with the ocean. 3 bedrooms, up to 8 guests, fully private.</p>
          <div class="flex flex-wrap gap-2">
            <a
              href="http://airbnb.com/h/casagaviotabaru"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 bg-sand text-brown font-semibold text-sm px-5 py-3 rounded-full hover:opacity-90 transition-opacity"
            >
              Book on Airbnb →
            </a>
            <button
              onclick="window.dispatchEvent(new CustomEvent('open-wa-popup', {detail:{type:'stay'}}))"
              class="inline-flex items-center gap-1.5 border border-brown text-brown font-semibold text-sm px-5 py-3 rounded-full hover:bg-brown/5 transition cursor-pointer"
            >
              Plan directly →
            </button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- NOT A HOTEL -->
  <section id="house" class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div data-lightbox="not-hotel" class="grid grid-cols-2 gap-3">
          <img
            src="/images/beach-1.jpg"
            alt="Private beach at Casa Gaviota"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="300"
            height="225"
          />
          <img
            src="/images/beach-2.jpg"
            alt="Natural beach at Casa Gaviota"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="300"
            height="225"
          />
        </div>
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 leading-snug text-brown">
            Casa Gaviota is not a beach club or a hotel.
          </h2>
          <p class="text-ink/70 leading-relaxed mb-6">
            It is a private beach house designed for people who want to slow down, disconnect, and experience nature without distractions.
          </p>
          <ul class="space-y-3 mb-8">
            {['No beach clubs.', 'No vendors.', 'No crowds.'].map(item => (
              <li class="flex items-center gap-3 font-medium text-ink/80">
                <span class="text-terracotta text-lg">—</span>
                {item}
              </li>
            ))}
          </ul>
          <p class="text-ink/70 leading-relaxed">Just your group, the ocean, and time to relax.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- THE EXPERIENCE -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div class="order-2 md:order-1">
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 leading-snug text-brown">
            You are taken care of from the moment you arrive.
          </h2>
          <p class="text-ink/70 leading-relaxed mb-4">
            Manuel and the house team help with everything — transport, meals, logistics, and anything you need during your stay.
          </p>
          <p class="text-ink/70 leading-relaxed">
            Fresh Caribbean food is prepared on-site, and many guests say it is one of the highlights of the experience.
          </p>
        </div>
        <div class="order-1 md:order-2">
          <div data-lightbox="experience" class="grid grid-cols-2 gap-3">
            <img
              src="/images/food-1.jpg"
              alt="Fresh Caribbean food at Casa Gaviota"
              class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
              loading="lazy"
              width="300"
              height="225"
            />
            <img
              src="/images/food-2.jpg"
              alt="Fresh lunch prepared at Casa Gaviota"
              class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
              loading="lazy"
              width="300"
              height="225"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- A DAY AT CASA GAVIOTA -->
  <section class="py-24 md:py-32 bg-brown text-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-sand text-xs uppercase tracking-widest mb-12">A Day at Casa Gaviota</p>
      <div class="space-y-5 font-serif">
        {[
          'Wake up with the ocean',
          'Swim, rest, read, disconnect',
          'Eat fresh, simple, delicious food',
          'Watch the sunset',
          'Fall asleep to the sound of waves',
        ].map((line, i) => (
          <p class={`text-2xl sm:text-3xl md:text-4xl font-medium ${i % 2 === 1 ? 'text-white/60' : 'text-white'}`}>
            {line}
          </p>
        ))}
      </div>
      <p class="text-white/40 mt-12 text-lg">No schedule. No pressure.</p>
      <div data-lightbox="day-timeline" class="grid grid-cols-2 gap-3 mt-10 max-w-sm mx-auto">
        <img
          src="/images/beach-3.jpg"
          alt="Arriving at Casa Gaviota by boat"
          class="rounded-xl w-full aspect-square object-cover opacity-80"
          loading="lazy"
          width="200"
          height="200"
        />
        <img
          src="/images/hero-2.jpg"
          alt="Casa Gaviota beach"
          class="rounded-xl w-full aspect-square object-cover opacity-80"
          loading="lazy"
          width="200"
          height="200"
        />
      </div>
    </div>
  </section>

  <!-- THE HOUSE -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-8 text-brown">The House</h2>
          <ul class="space-y-4 mb-8">
            {[
              '3 bedrooms · up to 8 guests',
              'Each room with private bathroom',
              'Spacious social areas',
              'Direct access to 80m private beach',
              'Starlink Wi-Fi',
              'Fans in all rooms',
            ].map(item => (
              <li class="flex items-start gap-3 text-ink/70">
                <span class="text-terracotta font-bold mt-0.5">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="text-ink/50 italic text-sm border-l-2 border-terracotta/40 pl-4">
            "Simple, comfortable, and fully integrated with nature."
          </p>
        </div>
        <div data-lightbox="house" class="grid grid-cols-2 gap-3">
          {['house-1.jpg', 'house-2.jpg', 'house-3.jpg', 'house-4.jpg'].map((img, i) => (
            <img
              src={`/images/${img}`}
              alt={`Casa Gaviota house photo ${i + 1}`}
              class="rounded-xl w-full aspect-square object-cover"
              loading="lazy"
              width="300"
              height="300"
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- OVERNIGHT STAY PRICING -->
  <section class="py-20 md:py-28" style="background: #FAFAF5;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-3 text-brown">How pricing works</h2>
        <p class="text-ink/60">The house is yours — add what you need.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        <div class="bg-white rounded-2xl p-6 border border-terracotta/15 shadow-sm">
          <div class="text-3xl mb-3">🏠</div>
          <h3 class="font-semibold text-brown text-lg mb-1">The house</h3>
          <p class="text-2xl font-bold text-brown mb-2">$350 USD <span class="text-base font-normal text-ink/50">/night</span></p>
          <p class="text-sm text-ink/60">Up to 8 guests · minimum 2 nights · 3 bedrooms each with private bathroom</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-terracotta/15 shadow-sm">
          <div class="text-3xl mb-3">🚤</div>
          <h3 class="font-semibold text-brown text-lg mb-3">Transport <span class="text-sm font-normal text-ink/50">(choose one)</span></h3>
          <div class="space-y-3">
            <div>
              <p class="font-semibold text-sm text-ink">Private boat: $250 USD each way</p>
              <p class="text-sm text-ink/55">Direct from Cartagena · up to 10 people</p>
            </div>
            <div>
              <p class="font-semibold text-sm text-ink">Car + boat: $200 USD each way</p>
              <p class="text-sm text-ink/55">Drive to Barú + short boat to the house</p>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-terracotta/15 shadow-sm">
          <div class="text-3xl mb-3">🍽️</div>
          <h3 class="font-semibold text-brown text-lg mb-3">Food <span class="text-sm font-normal text-ink/50">(choose one)</span></h3>
          <div class="space-y-3">
            <div>
              <p class="font-semibold text-sm text-ink">Casa Gaviota food service: $50 USD/person/day</p>
              <p class="text-sm text-ink/55">Fresh Caribbean meals prepared at the house</p>
            </div>
            <div>
              <p class="font-semibold text-sm text-ink">Luxury with lobster: $80 USD/person/day</p>
            </div>
            <div>
              <p class="font-semibold text-sm text-ink">Bring your own groceries: $0</p>
              <p class="text-sm text-ink/55">Buy in Cartagena before arriving</p>
            </div>
          </div>
        </div>
      </div>

      <div class="rounded-2xl p-7 mb-8" style="background: #E6C497;">
        <p class="font-semibold text-brown text-sm uppercase tracking-wide mb-5">Example: 2 nights · 4 guests · private boat · food service</p>
        <div class="space-y-2 text-sm text-ink/80 mb-4">
          <div class="flex justify-between">
            <span>🏠 House (2 nights)</span>
            <span class="font-semibold">$700 USD</span>
          </div>
          <div class="flex justify-between">
            <span>🚤 Transport (boat, both ways)</span>
            <span class="font-semibold">$500 USD</span>
          </div>
          <div class="flex justify-between">
            <span>🍽️ Food (4 guests × $50 × 2 nights)</span>
            <span class="font-semibold">$400 USD</span>
          </div>
          <div class="border-t border-ink/20 pt-3 flex justify-between font-bold text-base">
            <span>Total</span>
            <span>~$1,600 USD</span>
          </div>
          <div class="flex justify-between text-ink/55">
            <span>Per person</span>
            <span>~$400 USD</span>
          </div>
        </div>
      </div>

      <p class="text-center text-sm text-ink/50 mb-8">Final price confirmed on WhatsApp. 50% deposit required to hold your dates.</p>
      <div class="text-center">
        <button
          onclick="window.dispatchEvent(new CustomEvent('open-wa-popup', {detail:{type:'stay'}}))"
          class="inline-flex items-center gap-2.5 bg-sand text-brown px-8 py-4 rounded-full text-sm font-semibold hover:opacity-90 transition shadow-md cursor-pointer"
        >
          Plan your stay on WhatsApp →
        </button>
      </div>
    </div>
  </section>

  <!-- HONEST EXPECTATIONS -->
  <section class="py-20 md:py-28 bg-rose/15">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <div data-lightbox="expectations" class="grid grid-cols-2 gap-3">
            <img
              src="/images/house-1.jpg"
              alt="Casa Gaviota interior"
              class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
              loading="lazy"
              width="300"
              height="225"
            />
            <img
              src="/images/house-2.jpg"
              alt="Casa Gaviota bedroom"
              class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
              loading="lazy"
              width="300"
              height="225"
            />
          </div>
        </div>
        <div>
          <h2 class="font-serif text-2xl sm:text-3xl font-semibold mb-5 text-brown">Honest Expectations</h2>
          <p class="text-ink/70 leading-relaxed mb-6">
            Casa Gaviota is a rustic beach house in a remote natural environment. This is part of what makes it special — but it is important to know what to expect:
          </p>
          <ul class="space-y-3 mb-8">
            {[
              'No air conditioning (fans instead)',
              'Nature is present: insects, humidity, sea conditions vary',
              'Some areas of the house are simple, not luxury',
              'Getting here requires planning: car + boat or private boat',
            ].map(item => (
              <li class="flex items-start gap-3 text-sm text-ink/65">
                <span class="text-terracotta mt-0.5 flex-shrink-0">—</span>
                {item}
              </li>
            ))}
          </ul>
          <p class="text-sm text-ink/50 border-l-2 border-terracotta/30 pl-4 mb-4">
            If you are looking for a luxury hotel, this is not the right place.
          </p>
          <p class="text-sm text-ink/70 font-medium">
            If you are looking for a peaceful, authentic, private experience in nature, you will love it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- LOCATION -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 text-brown">Location & Access</h2>
          <p class="text-ink/70 leading-relaxed mb-8">
            Casa Gaviota is in Barú, about 1–2 hours from Cartagena depending on transport.
          </p>
          <div class="space-y-3 mb-8">
            <div class="flex items-start gap-4 p-4 bg-sand/20 rounded-xl">
              <span class="text-xl flex-shrink-0">🚤</span>
              <div>
                <p class="font-medium text-sm mb-0.5">Private boat from Cartagena</p>
                <p class="text-muted text-sm">$250 USD each way · up to 10 people</p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-4 bg-sand/20 rounded-xl">
              <span class="text-xl flex-shrink-0">🚗</span>
              <div>
                <p class="font-medium text-sm mb-0.5">Car + boat</p>
                <p class="text-muted text-sm">$200 USD each way. The final stretch is always by boat.</p>
              </div>
            </div>
          </div>
          <p class="text-ink/50 text-sm mb-5">We help coordinate everything.</p>
          <a
            href={MAPS}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-steel font-medium text-sm hover:underline"
          >
            View on Google Maps →
          </a>
        </div>
        <div data-lightbox="location">
          <img
            src="/images/beach-3.jpg"
            alt="Arriving at Casa Gaviota by boat"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="600"
            height="450"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-20 bg-rose/15">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-12 text-center text-brown">Frequently Asked Questions</h2>
      <div class="space-y-2">
        {[
          {
            q: 'What kind of place is Casa Gaviota?',
            a: 'A private, rustic beach house in a natural setting. Not a hotel or resort. For guests who want to disconnect, enjoy privacy, and slow down by the sea.',
          },
          {
            q: 'What is included in the stay?',
            a: 'Private use of the house, 80m private beach, daily cleaning, towels and sheets, Starlink Wi-Fi with backup power. Food and transport arranged separately.',
          },
          {
            q: 'How do I get there?',
            a: 'For day trips, transport from Cartagena is included in the package price. For overnight stays, we coordinate a private boat ($250 USD each way, up to 10 people) or car + boat ($200 USD each way). The final stretch is always by boat.',
          },
          {
            q: 'How does food work?',
            a: 'For day trips, a fresh Caribbean lunch is included in the package price. For overnight stays, you can add our food service ($50 USD/person/day), upgrade to the lobster package ($80 USD/person/day), or bring your own groceries from Cartagena.',
          },
          {
            q: 'Do you have air conditioning?',
            a: 'No. Naturally ventilated with fans. The sea breeze and open design keep it comfortable, especially in the evenings.',
          },
          {
            q: 'Is there Wi-Fi?',
            a: 'Yes — Starlink with backup power. Good for messaging and work. We recommend coming ready to disconnect though.',
          },
          {
            q: 'Can I visit just for the day?',
            a: 'Yes — see our Day Trip page for private day experiences with transport and lunch.',
