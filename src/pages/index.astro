---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import BookingForm from '../components/BookingForm.tsx';

const WA_STAY = 'https://wa.me/573163946401?text=' + encodeURIComponent('Hi, I am interested in planning a stay at Baru Beach House.');
---

<Layout
  title="Baru Beach House — Private Beach House in Barú, Colombia"
  description="A private beach house on Isla Barú near Cartagena. 80 meters of private beach, no vendors, no crowds. Full service, total privacy. Book a stay or day trip."
  lang="en"
>
  <Header lang="en" page="stay" />

  <!-- ─────────────────────── HERO ─────────────────────── -->
  <section class="relative min-h-[88vh] flex items-end pb-20 md:items-center md:pb-0">
    <!-- Real Baru Beach House photo -->
    <img
      src="/images/sunset.webp"
      alt="Sunset over the private beach at Baru Beach House"
      class="absolute inset-0 w-full h-full object-cover"
      fetchpriority="high"
      decoding="async"
      width="1280"
      height="720"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-black/10"></div>
    <div class="relative z-10 w-full max-w-4xl mx-auto px-6 text-white">
      <p class="text-sand text-xs sm:text-sm uppercase tracking-widest font-medium mb-4">Barú · Colombia</p>
      <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl font-semibold leading-none mb-5">
        Baru Beach House
      </h1>
      <h2 class="text-lg sm:text-xl md:text-2xl font-light mb-3 max-w-xl">
        A Private Beach House to Disconnect in Barú
      </h2>
      <p class="text-sm sm:text-base text-white/80 mb-2 max-w-lg">
        Peaceful, raw, and surrounded by nature — no crowds, just your group.
      </p>
      <p class="text-xs sm:text-sm text-white/60 uppercase tracking-wider mb-10">
        80 meters of private beach &middot; full service &middot; total privacy
      </p>
      <a
        href={WA_STAY}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-whatsapp text-white px-7 py-4 rounded-full text-sm sm:text-base font-medium hover:opacity-90 transition shadow-lg"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        Plan your stay on WhatsApp
      </a>
    </div>
  </section>

  <!-- ─────────────────────── NOT A HOTEL ─────────────────────── -->
  <section class="py-20 max-w-3xl mx-auto px-6 text-center">
    <p class="text-sand text-xs uppercase tracking-widest font-medium mb-4">What this place is</p>
    <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6">Baru Beach House is not a hotel</h2>
    <p class="text-ink/70 text-base sm:text-lg leading-relaxed">
      A beach club or a hotel. It is a private beach house designed for people who want to slow down, disconnect, and experience nature without distractions.
      No beach clubs. No vendors. No crowds. Just your group, the ocean, and time to relax.
    </p>
  </section>

  <!-- ─────────────────────── PHOTO STRIP ─────────────────────── -->
  <section class="px-4 sm:px-6 pb-16">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-3">
      <!-- Real Baru Beach House photos -->
      <img src="/images/IMG_1195-1536x1152.webp" alt="Private beach at Baru Beach House" class="rounded-2xl w-full aspect-square object-cover" loading="lazy" decoding="async" width="1536" height="1152" />
      <img src="/images/IMG_1011-1536x863.webp" alt="Beach house exterior" class="rounded-2xl w-full aspect-square object-cover" loading="lazy" decoding="async" width="1536" height="863" />
      <img src="/images/IMG_1216-1536x1152.webp" alt="Ocean view from the house" class="rounded-2xl w-full aspect-square object-cover" loading="lazy" decoding="async" width="1536" height="1152" />
      <img src="/images/IMG_5390-1536x1024.webp" alt="Beach access at Baru Beach House" class="rounded-2xl w-full aspect-square object-cover" loading="lazy" decoding="async" width="1536" height="1024" />
    </div>
  </section>

  <!-- ─────────────────────── REVIEWS ─────────────────────── -->
  <section id="reviews" class="py-20 bg-ink/[0.03]">
    <div class="max-w-7xl mx-auto px-6">
      <p class="text-sand text-xs uppercase tracking-widest font-medium mb-4 text-center">What guests say</p>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold text-center mb-12">Loved by those who stay</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {[
          { quote: 'Insanely beautiful and peaceful, the ideal place to unwind.', name: 'Airbnb guest' },
          { quote: 'A slice of heaven… we can\'t wait to go back.', name: 'Booking.com guest' },
          { quote: 'Perfect to relax and disconnect from everything.', name: 'Google review' },
          { quote: 'The food was better than restaurants.', name: 'Airbnb guest' },
        ].map(({ quote, name }) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-sand/20 flex flex-col gap-4">
            <div class="flex gap-0.5">
              {Array.from({ length: 5 }).map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-sand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              ))}
            </div>
            <p class="text-ink/80 text-sm leading-relaxed flex-1">"{quote}"</p>
            <p class="text-xs text-ink/40 font-medium">{name}</p>
          </div>
        ))}
      </div>
      <p class="text-center text-sm text-ink/50 mt-8">Rated highly across Airbnb, Booking.com, and Google.</p>
    </div>
  </section>

  <!-- ─────────────────────── THE EXPERIENCE ─────────────────────── -->
  <section class="py-20 max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Real Baru Beach House photo -->
      <img
        src="/images/IMG_1205-1536x1152.webp"
        alt="Team at Baru Beach House serving guests"
        class="rounded-3xl w-full aspect-[4/3] object-cover"
        loading="lazy"
        decoding="async"
        width="1536"
        height="1152"
      />
      <div>
        <p class="text-sand text-xs uppercase tracking-widest font-medium mb-4">The Experience</p>
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6">You are taken care of</h2>
        <p class="text-ink/70 text-base leading-relaxed mb-6">
          You are taken care of from the moment you arrive. Manuel and the house team help with transport, meals, logistics, and anything you need during your stay.
        </p>
        <p class="text-ink/70 text-base leading-relaxed">
          Fresh Caribbean food is prepared on-site, and many guests say it is one of the highlights of the experience.
        </p>
      </div>
    </div>
  </section>

  <!-- ─────────────────────── A DAY AT THE HOUSE ─────────────────────── -->
  <section class="py-20 bg-ocean/5">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-sand text-xs uppercase tracking-widest font-medium mb-4">The rhythm</p>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-12">A day at Baru Beach House</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
        {[
          { icon: '🌅', text: 'Wake up with the ocean' },
          { icon: '🌊', text: 'Swim, rest, read, disconnect' },
          { icon: '🐟', text: 'Eat fresh, simple, delicious food' },
          { icon: '🌇', text: 'Watch the sunset' },
          { icon: '🌙', text: 'Fall asleep to the sound of waves' },
          { icon: '✨', text: 'No schedule. No pressure.' },
        ].map(({ icon, text }) => (
          <div class="flex items-center gap-4 bg-white rounded-2xl px-5 py-4 shadow-sm border border-sand/10">
            <span class="text-2xl">{icon}</span>
            <p class="text-sm sm:text-base text-ink/80">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────────────── THE HOUSE ─────────────────────── -->
  <section class="py-20 max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-sand text-xs uppercase tracking-widest font-medium mb-4">The House</p>
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6">Simple, comfortable, and fully integrated with nature</h2>
        <ul class="space-y-3">
          {[
            '3 bedrooms, up to 8 guests',
            'Each room with private bathroom',
            'Spacious social areas',
            'Direct access to private beach',
            'Wi-Fi with Starlink',
            'Fans in all rooms',
          ].map(item => (
            <li class="flex items-start gap-3 text-ink/70 text-sm sm:text-base">
              <span class="text-ocean mt-1 shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <!-- Real Baru Beach House photos -->
        <img src="/images/masterbedroom.webp" alt="Master bedroom at Baru Beach House" class="rounded-2xl w-full aspect-[4/3] object-cover" loading="lazy" decoding="async" />
        <img src="/images/twinbedroom.webp" alt="Twin bedroom at Baru Beach House" class="rounded-2xl w-full aspect-[4/3] object-cover" loading="lazy" decoding="async" />
        <img src="/images/IMG_1206-1536x975.webp" alt="Social area at Baru Beach House" class="rounded-2xl w-full aspect-[4/3] object-cover col-span-2" loading="lazy" decoding="async" width="1536" height="975" />
      </div>
    </div>
  </section>

  <!-- ─────────────────────── WHAT TO EXPECT ─────────────────────── -->
  <section class="py-20 bg-sand/10">
    <div class="max-w-3xl mx-auto px-6">
      <p class="text-sand text-xs uppercase tracking-widest font-medium mb-4">Honest about what this is</p>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-4">What to expect</h2>
      <p class="text-ink/70 text-base leading-relaxed mb-8">
        Baru Beach House is a rustic beach house in a remote natural environment. This is part of what makes it special — but it is important to understand what to expect:
      </p>
      <ul class="space-y-3 mb-8">
        {[
          'No air conditioning — fans and natural sea breeze instead',
          'Presence of nature: insects, changing sea conditions, open spaces',
          'Some areas of the house are simple and not luxury hotel standard',
          'Transportation requires planning: car + boat or private boat from Cartagena',
        ].map(item => (
          <li class="flex items-start gap-3 text-ink/70 text-sm sm:text-base">
            <span class="text-sand mt-1 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            </span>
            {item}
          </li>
        ))}
      </ul>
      <div class="bg-white rounded-2xl p-6 border border-sand/30">
        <p class="text-ink/80 text-sm sm:text-base leading-relaxed">
          <strong class="text-ink">If you are looking for a luxury hotel, this is not the right place.</strong><br/>
          If you are looking for a peaceful, authentic, and private experience in nature, you will love it.
        </p>
      </div>
    </div>
  </section>

  <!-- ─────────────────────── LOCATION ─────────────────────── -->
  <section class="py-20 max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-sand text-xs uppercase tracking-widest font-medium mb-4">Getting There</p>
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6">Location &amp; Access</h2>
        <p class="text-ink/70 text-base leading-relaxed mb-4">
          Baru Beach House is located in Barú, about 1–2 hours from Cartagena depending on transport. The journey is part of the experience.
        </p>
        <p class="text-ink/70 text-base leading-relaxed mb-8">
          We help coordinate everything — from pickup in Cartagena to arrival at the house.
        </p>
        <a
          href="https://share.google/SHahHFkk8vXJIW7hH"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border border-ocean/30 text-ocean px-5 py-3 rounded-full text-sm font-medium hover:bg-ocean/5 transition"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
          View on Google Maps
        </a>
      </div>
      <!-- Real Baru Beach House photo -->
      <img
        src="/images/IMG_1222-768x512.webp"
        alt="Aerial view of the beach at Barú"
        class="rounded-3xl w-full aspect-[4/3] object-cover"
        loading="lazy"
        decoding="async"
        width="768"
        height="512"
      />
    </div>
  </section>

  <!-- ─────────────────────── FAQ ─────────────────────── -->
  <section id="faq" class="py-20 bg-ink/[0.02]">
    <div class="max-w-3xl mx-auto px-6">
      <p class="text-sand text-xs uppercase tracking-widest font-medium mb-4 text-center">FAQ</p>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-12 text-center">Common questions</h2>
      <div class="space-y-4">
        {[
          {
            q: 'What kind of place is Baru Beach House?',
            a: 'A private, rustic beach house in a natural setting. Not a hotel or luxury resort. Designed for guests who want to disconnect, enjoy privacy, and experience a slower rhythm by the sea.',
          },
          {
            q: 'How do I get there?',
            a: 'Located in Barú — requires car + boat or private boat from Cartagena. We help coordinate everything. Car + boat usually costs around $200–250 USD one way depending on group size. A private boat is around $300 USD one way for up to 10 people. The final stretch is always by boat.',
          },
          {
            q: 'What is included in the stay?',
            a: 'Private use of the house, 80 meters of private beach, cleaning service, towels and sheets, and Wi-Fi with Starlink. Food and transport are arranged separately.',
          },
          {
            q: 'How does food work?',
            a: 'Caribbean food package: $50 USD/person/day. Luxury package with lobster: $80 USD/person/day. Guests may also bring their own groceries.',
          },
          {
            q: 'Can I bring my own food and drinks?',
            a: 'Yes. We recommend buying groceries in Cartagena before arriving.',
          },
          {
            q: 'Do you have air conditioning?',
            a: 'No. The house is naturally ventilated and has fans. The open design and sea breeze keep the space comfortable.',
          },
          {
            q: 'Is there Wi-Fi?',
            a: 'Yes. Starlink internet with backup power. Good for messaging, work, and browsing.',
          },
          {
            q: 'Can I visit just for the day?',
            a: 'Yes. We offer private day experiences with transport and lunch. See the Day Trip page.',
          },
          {
            q: 'What activities can we do?',
            a: 'Boat trips to the Rosario Islands, snorkeling, Oceanarium or Aviary visits, nature walks, and live music such as a papayera band. We can help organize everything.',
          },
          {
            q: 'How do I book and pay?',
            a: 'Direct bookings usually require a deposit by card or payment link. The remaining balance can be paid at the house by cash or card. Airbnb bookings are handled through Airbnb.',
          },
        ].map(({ q, a }) => (
          <details class="group bg-white rounded-2xl border border-sand/20 overflow-hidden">
            <summary class="flex items-center justify-between px-6 py-5 cursor-pointer list-none select-none font-medium text-sm sm:text-base text-ink/90 hover:text-ocean transition-colors">
              {q}
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0 ml-4 text-sand transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
            </summary>
            <div class="px-6 pb-5 text-sm sm:text-base text-ink/70 leading-relaxed border-t border-sand/20 pt-4">
              {a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────────────── BOOKING FORM ─────────────────────── -->
  <section id="book" class="py-20 bg-ocean/5">
    <div class="max-w-2xl mx-auto px-6">
      <p class="text-sand text-xs uppercase tracking-widest font-medium mb-4 text-center">Book Your Stay</p>
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold text-center mb-3">Send a booking inquiry</h2>
      <p class="text-center text-ink/60 text-sm mb-10">We'll reply on WhatsApp or email within a few hours.</p>
      <div class="bg-white rounded-3xl shadow-sm border border-sand/20 p-6 sm:p-8">
        <BookingForm
          accessKey={import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY}
          lang="en"
          client:load
        />
      </div>
    </div>
  </section>

  <!-- ─────────────────────── FINAL CTA ─────────────────────── -->
  <section class="py-24 relative overflow-hidden">
    <!-- Real Baru Beach House photo -->
    <img
      src="/images/IMG_3784-1536x1024.webp"
      alt="Beautiful beach view at Baru Beach House"
      class="absolute inset-0 w-full h-full object-cover"
      loading="lazy"
      decoding="async"
      width="1536"
      height="1024"
    />
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="relative z-10 text-center text-white px-6 max-w-2xl mx-auto">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-4">Ready to disconnect?</h2>
      <p class="text-white/80 mb-8 text-base sm:text-lg">
        Message us on WhatsApp and we'll help you plan the perfect stay.
      </p>
      <a
        href={WA_STAY}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-whatsapp text-white px-8 py-4 rounded-full text-base font-medium hover:opacity-90 transition shadow-lg"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        Plan your stay on WhatsApp
      </a>
    </div>
  </section>

  <Footer lang="en" />
  <WhatsAppButton lang="en" page="stay" />
</Layout>
