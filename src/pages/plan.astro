---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EscapePlanner from '../components/EscapePlanner.tsx';

const KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<Layout
  title="Plan Your Visit — Casa Gaviota Baru"
  description="Get an instant price estimate for your day trip or overnight stay at Casa Gaviota. Plan your visit and book directly via WhatsApp."
  lang="en"
>
  <Header lang="en" altHref="/es/plan" />

  <section class="py-16 md:py-24">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-terracotta text-xs uppercase tracking-widest font-medium mb-4">Barú · Colombia</p>
        <h1 class="font-serif text-4xl sm:text-5xl font-semibold text-brown mb-4">Plan Your Visit</h1>
        <p class="text-ink/60 text-base leading-relaxed">
          Get an instant price estimate.
        </p>
      </div>

      <EscapePlanner accessKey={KEY} lang="en" client:visible />
    </div>
  </section>

  <Footer lang="en" />
</Layout>
