---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WAInlineForm from '../../components/WAInlineForm.tsx';
---

<Layout
  title="Pasadía a Barú — Casa de Playa Privada | Casa Gaviota"
  description="Un pasadía privado a una casa de playa en Isla Barú cerca de Cartagena. Transporte, playa privada y almuerzo caribeño fresco — todo incluido. Sin beach clubs, sin multitudes."
  lang="es"
  altHref="/daytrip"
  defaultPopupType="daytrip"
  heroImage="/images/daytrip-1.webp"
>
  <Header lang="es" altHref="/daytrip" />

  <!-- HERO -->
  <section class="relative min-h-screen flex items-center justify-center">
    <img
      src="/images/daytrip-1.webp"
      alt="Pasadía a la playa privada de Casa Gaviota en Barú"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      width="1280"
      height="720"
    />
    <div class="absolute inset-0" style="background: rgba(87,57,46,0.50);"></div>
    <div class="relative z-10 text-center text-white px-6 max-w-3xl mx-auto py-24">
      <p class="text-sand text-xs sm:text-sm uppercase tracking-widest font-medium mb-5">Barú · Colombia</p>
      <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl font-semibold leading-tight mb-4">
        Pasadía Privado
      </h1>
      <h2 class="text-xl sm:text-2xl font-light mb-3">Tu playa. Tu grupo. Tu día.</h2>
      <p class="text-sm sm:text-base text-white/70 mb-2 uppercase tracking-wider">
        Transporte · playa privada · almuerzo fresco · todo incluido
      </p>
      <p class="text-white/60 text-sm mb-8">Recibimos un grupo a la vez.</p>

      <button
        onclick="window.dispatchEvent(new CustomEvent('open-wa-popup', {detail:{type:'daytrip'}}))"
        class="bg-sand text-brown font-semibold px-8 py-4 rounded-full text-base hover:opacity-90 transition-opacity cursor-pointer mb-4"
      >
        Verificar Disponibilidad →
      </button>
      <p class="text-white/60 text-sm italic mb-6">Un grupo a la vez — tu playa, en exclusiva.</p>
      <a href="#precio" class="block text-white/45 text-sm hover:text-white/70 transition-colors">
        Ver precios ↓
      </a>
    </div>
  </section>

  <!-- RESEÑAS -->
  <section id="resenas" class="py-20 bg-rose/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-3 text-brown">Lo que dicen nuestros huéspedes</h2>
        <p class="text-muted text-sm">⭐ 4.8 · Airbnb, Booking.com y Google</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="reviews-initial">
        {[
          'El mejor pasadía que hicimos en Colombia. Playa privada, comida increíble y sin turistas.',
          'El paseo en lancha ya valió la pena. Y la casa de playa nos dejó sin palabras.',
          'Queríamos total privacidad y eso fue exactamente lo que recibimos. Solo nuestro grupo y el océano.',
          'El almuerzo estaba mejor que cualquier restaurante en Cartagena. Y no compartimos la playa con nadie.',
        ].map(quote => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-terracotta/15">
            <p class="text-terracotta text-3xl leading-none mb-3">"</p>
            <p class="text-ink/75 text-sm leading-relaxed">{quote}</p>
          </div>
        ))}
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-4 hidden" id="reviews-extra">
        {[
          'He ido a beach clubs en Cartagena. Esto no es eso. Esto es mucho mejor.',
          'Nuestros hijos podían correr, nadar y jugar libres. Nosotros pudimos relajarnos de verdad.',
          'Manuel y su equipo son increíbles. Comida, servicio, todo fue perfecto.',
          'Honestamente uno de los mejores momentos de todo nuestro viaje a Colombia.',
          'Vinimos un día y ya reservamos una estadía completa para el año próximo.',
        ].map(quote => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-terracotta/15">
            <p class="text-terracotta text-3xl leading-none mb-3">"</p>
            <p class="text-ink/75 text-sm leading-relaxed">{quote}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 text-center">
        <button
          id="show-more-reviews"
          class="border border-brown text-brown font-medium text-sm px-6 py-3 rounded-full hover:bg-brown/5 transition"
        >
          Ver más reseñas
        </button>
      </div>
    </div>
  </section>
  <script is:inline>
    document.getElementById('show-more-reviews')?.addEventListener('click', function() {
      document.getElementById('reviews-extra')?.classList.remove('hidden');
      this.style.display = 'none';
    });
  </script>

  <!-- PRECIO TODO INCLUIDO -->
  <section id="precio" class="py-20 md:py-28" style="background: #E6C497;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-3 text-brown">Precio todo incluido</h2>
        <p class="text-ink/70">Transporte, casa, playa y almuerzo — todo incluido. Sin sorpresas.</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
        {[
          { group: 'Pareja', people: '2 personas', price: '$300 USD' },
          { group: 'Familia', people: '4 personas', price: '$500 USD' },
          { group: 'Grupo de 6', people: '6 personas', price: '$700 USD' },
          { group: 'Grupo de 8', people: '8 personas', price: '$900 USD' },
        ].map(({ group, people, price }) => (
          <div class="bg-white rounded-2xl p-5 text-center shadow-sm">
            <p class="font-semibold text-brown text-sm mb-1">{group}</p>
            <p class="text-xs text-ink/50 mb-3">{people}</p>
            <p class="text-xl font-bold text-brown">{price}</p>
          </div>
        ))}
      </div>

      <div class="bg-white/60 rounded-2xl p-6 text-center mb-8">
        <p class="text-sm text-ink/70 font-medium">Precio todo incluido. Incluye transporte desde Cartagena, acceso a playa privada y almuerzo caribeño fresco.</p>
      </div>

      <div class="text-center">
        <button
          onclick="window.dispatchEvent(new CustomEvent('open-wa-popup', {detail:{type:'daytrip'}}))"
          class="inline-flex items-center gap-2 bg-brown text-white px-8 py-4 rounded-full text-sm font-semibold hover:opacity-90 transition cursor-pointer"
        >
          Verificar Disponibilidad →
        </button>
      </div>
    </div>
  </section>

  <!-- VERSIÓN PRIVADA -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div data-lightbox="privado" class="grid grid-cols-2 gap-3">
          <img
            src="/images/beach-1.webp"
            alt="Playa privada en Casa Gaviota"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="300"
            height="225"
          />
          <img
            src="/images/beach-2.webp"
            alt="Acceso exclusivo a la playa en Casa Gaviota"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="300"
            height="225"
          />
        </div>
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 leading-snug text-brown">
            Una versión privada de la playa.
          </h2>
          <p class="text-ink/70 leading-relaxed mb-4">
            Esto no es un beach club. No compartes con 50 desconocidos en un bar con reggaeton. Esta es una casa de playa real en 80 metros de playa privada, reservada completamente para tu grupo.
          </p>
          <p class="text-ink/70 leading-relaxed">Manuel y el equipo se encargan de todo — recogida, llegada, comida y regreso. Tú solo llega.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- QUÉ ESTÁS RESERVANDO -->
  <section class="py-16 md:py-20" style="background: #FAFAF5;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-brown text-center mb-10">Qué estás reservando</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {[
          { icon: '🌊', title: 'Playa privada', desc: '80 metros de playa — solo tu grupo. Sin vendedores, sin música de los vecinos.' },
          { icon: '🏠', title: 'La casa completa', desc: 'Casa de playa privada, zonas con sombra, hamacas, duchas exteriores. Todo para ti.' },
          { icon: '🍽️', title: 'Almuerzo caribeño fresco', desc: 'Preparado en el lugar por el equipo de la casa. Pescado, arroz, patacones, fruta fresca. Incluido.' },
        ].map(({ icon, title, desc }) => (
          <div class="text-center p-6">
            <div class="text-4xl mb-4">{icon}</div>
            <h3 class="font-semibold text-brown mb-2">{title}</h3>
            <p class="text-sm text-ink/65 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- QUÉ INCLUYE -->
  <section class="py-20 md:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold text-brown text-center mb-12">Qué incluye</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          'Transporte de ida y vuelta desde Cartagena',
          'Casa de playa privada por el día',
          '80 metros de playa privada, solo para tu grupo',
          'Almuerzo caribeño fresco',
          'Bebidas no alcohólicas',
          'Hamacas y zonas de descanso exterior',
          'Duchas y vestuarios',
          'Servicio del equipo de la casa durante todo el día',
        ].map(item => (
          <div class="flex items-center gap-3 p-4 bg-sand/20 rounded-xl">
            <span class="text-terracotta font-bold flex-shrink-0">✓</span>
            <span class="text-sm text-ink/80">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- UN DÍA TÍPICO -->
  <section class="py-24 md:py-32 bg-brown text-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-sand text-xs uppercase tracking-widest mb-12">Un Día Típico</p>
      <div class="space-y-6">
        {[
          { time: '7:30 AM', label: '🌅 Recogida en Cartagena' },
          { time: '9:00 AM', label: '🚤 Llegada a Casa Gaviota' },
          { time: '9:00 – 1:00', label: 'Nadar, explorar, relajarse en la playa' },
          { time: '1:00 PM', label: '🍽️ Almuerzo caribeño fresco' },
          { time: '1:00 – 3:00', label: '🌴 Más playa, hamacas, descanso' },
          { time: '3:00 PM', label: '🌇 Regreso a Cartagena' },
          { time: '~5:00 PM', label: '🏙️ Llegada a Cartagena' },
        ].map(({ time, label }, i) => (
          <div class={`flex items-center gap-4 ${i % 2 === 1 ? 'opacity-60' : ''}`}>
            <span class="text-sand text-sm w-28 text-right flex-shrink-0">{time}</span>
            <span class="w-2 h-2 rounded-full bg-sand/60 flex-shrink-0"></span>
            <span class="font-serif text-xl text-left">{label}</span>
          </div>
        ))}
      </div>
      <p class="text-white/40 mt-12 text-base">Los horarios son aproximados. El día se adapta a ti.</p>
      <div data-lightbox="dia-tipico" class="grid grid-cols-2 gap-3 mt-10 max-w-sm mx-auto">
        <img
          src="/images/daytrip-2.webp"
          alt="Pasadía en Casa Gaviota"
          class="rounded-xl w-full aspect-square object-cover opacity-80"
          loading="lazy"
          width="200"
          height="200"
        />
        <img
          src="/images/beach-3.webp"
          alt="Playa de Casa Gaviota"
          class="rounded-xl w-full aspect-square object-cover opacity-80"
          loading="lazy"
          width="200"
          height="200"
        />
      </div>
    </div>
  </section>

  <!-- COMIDA -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 leading-snug text-brown">
            Comida fresca, preparada en la casa.
          </h2>
          <p class="text-ink/70 leading-relaxed mb-4">
            El almuerzo caribeño se prepara en el lugar por el equipo de la casa. Pescado a la brasa, arroz con coco, patacones, ensaladas frescas, fruta tropical. Simple, fresco y genuinamente delicioso.
          </p>
          <p class="text-ink/70 leading-relaxed mb-8">
            Muchos huéspedes dicen que es una de las mejores comidas de su viaje a Colombia.
          </p>
          <p class="text-sm font-medium text-ink/50 border-l-2 border-terracotta/40 pl-4 italic">
            "La comida estaba mejor que en los restaurantes." — Reseña de huésped
          </p>
        </div>
        <div data-lightbox="comida" class="grid grid-cols-2 gap-3">
          <img
            src="/images/food-1.webp"
            alt="Almuerzo caribeño fresco en Casa Gaviota"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="300"
            height="225"
          />
          <img
            src="/images/food-2.webp"
            alt="Comida preparada en Casa Gaviota"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="300"
            height="225"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ELIGE TU DÍA -->
  <section class="py-16 md:py-20 bg-sand/30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-brown mb-4">Elige tu día</h2>
      <p class="text-ink/60 text-sm mb-10">Hacemos pasadías privados de jueves a domingo. Solo un grupo por día.</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {['Jueves', 'Viernes', 'Sábado', 'Domingo'].map(day => (
          <div class="bg-white border border-terracotta/20 rounded-xl py-5 px-4 text-center">
            <p class="font-semibold text-brown text-sm">{day}</p>
            <p class="text-xs text-ink/45 mt-1">Disponible</p>
          </div>
        ))}
      </div>
      <p class="text-xs text-ink/40 mt-6">Disponibilidad sujeta a confirmación. Contáctanos para fechas específicas.</p>
    </div>
  </section>

  <!-- ¿BEACH CLUB O CASA DE PLAYA PRIVADA? -->
  <section class="py-20 md:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold text-brown text-center mb-12">
        ¿Beach club o casa de playa privada?
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="rounded-2xl p-7 border-2 border-red-200 bg-red-50/50">
          <h3 class="font-semibold text-red-700 text-sm uppercase tracking-wide mb-5">Beach Club</h3>
          <ul class="space-y-3">
            {[
              'Compartido con decenas de desconocidos',
              'Vendedores caminando la playa todo el día',
              'Música alta de las fiestas vecinas',
              'Comida genérica de una cocina compartida',
              'Sin privacidad ni sensación de pertenencia',
              'Tienes que pelear por un buen lugar',
            ].map(item => (
              <li class="flex items-start gap-2.5 text-sm text-red-800/80">
                <span class="flex-shrink-0 font-bold text-red-400 mt-0.5">✗</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl p-7" style="background: #57392E;">
          <h3 class="font-semibold text-sand text-sm uppercase tracking-wide mb-5">Casa Gaviota</h3>
          <ul class="space-y-3">
            {[
              'Playa completa reservada para tu grupo',
              'Sin vendedores, sin extraños, sin ruido',
              'Silencio total excepto el océano',
              'Almuerzo caribeño fresco preparado en la casa',
              'Privacidad total desde que llegas hasta que sales',
              'Toda la playa es tuya durante todo el día',
            ].map(item => (
              <li class="flex items-start gap-2.5 text-sm text-white/85">
                <span class="flex-shrink-0 font-bold text-sand mt-0.5">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- PARA QUIÉN ES ESTO -->
  <section class="py-20 md:py-28 bg-rose/15">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold text-brown text-center mb-12">Para quién es esto</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {[
          { icon: '👨‍👩‍👧‍👦', title: 'Familias', desc: 'Playa segura y tranquila. Los niños corren libres. Los papás finalmente descansan.' },
          { icon: '🎂', title: 'Grupos de cumpleaños', desc: 'Un ambiente privado para una celebración que se siente verdaderamente especial.' },
          { icon: '💑', title: 'Parejas', desc: 'Aislamiento total. Sin otras personas. Solo ustedes dos y el mar.' },
          { icon: '🥂', title: 'Grupos de amigos', desc: 'Grupos de hasta 10 personas. Un día que todos van a recordar.' },
          { icon: '💼', title: 'Equipos corporativos', desc: 'Offsite o team building con un escenario que nadie olvida.' },
        ].map(({ icon, title, desc }) => (
          <div class="bg-white rounded-2xl p-6 border border-terracotta/15 shadow-sm">
            <div class="text-3xl mb-3">{icon}</div>
            <h3 class="font-semibold text-brown mb-2">{title}</h3>
            <p class="text-sm text-ink/65 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-20 bg-rose/15">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-12 text-center text-brown">Preguntas Frecuentes</h2>
      <div class="space-y-2">
        {[
          {
            q: '¿El transporte está incluido?',
            a: 'Sí — incluido en todos los paquetes de pasadía. Te recogemos en Cartagena y te regresamos. El paseo en lancha hasta la casa también está incluido.',
          },
          {
            q: '¿La comida está incluida?',
            a: 'Sí — un almuerzo caribeño fresco está incluido en todos los paquetes de pasadía. Pescado a la brasa, arroz con coco, patacones, ensalada fresca y fruta tropical. Preparado en la casa por el equipo.',
          },
          {
            q: '¿A qué hora empieza y termina el día?',
            a: 'Recogida en Cartagena alrededor de las 7:30 AM. Llegada a la casa alrededor de las 9:00 AM. Regreso a Cartagena a las 3:00 PM, con llegada alrededor de las 5:00 PM. Los horarios se pueden ajustar según tu grupo.',
          },
          {
            q: '¿Podemos llevar alcohol o comida extra?',
            a: 'Sí — pueden traer bebidas. Las bebidas alcohólicas no están incluidas en el paquete pero son bienvenidas. Avísanos con anticipación si tienen solicitudes especiales.',
          },
          {
            q: '¿Cuántas personas pueden venir?',
            a: 'La casa recibe hasta 8 personas para un pasadía. Para grupos de hasta 10, escríbenos para coordinar.',
          },
          {
            q: '¿Qué pasa si el clima está malo?',
            a: 'En caso de mal clima coordinamos reprogramación o reembolso completo. Siempre te avisamos con anticipación si las condiciones se ven problemáticas.',
          },
          {
            q: '¿Qué actividades hay?',
            a: 'Natación, snorkel, hamacas, caminatas, paseos en lancha a islas cercanas. También podemos organizar una banda de papayera en vivo, kayaks u otras actividades bajo pedido.',
          },
          {
            q: '¿Cómo reservo?',
            a: 'Escríbenos por WhatsApp con tu fecha preferida y número de personas. Confirmamos disponibilidad y enviamos detalles de pago. Se requiere un depósito para reservar la fecha.',
          },
        ].map(({ q, a }) => (
          <details class="group bg-white rounded-xl border border-terracotta/20 overflow-hidden">
            <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none font-medium text-sm sm:text-base hover:bg-rose/10 transition-colors">
              <span>{q}</span>
              <span class="text-terracotta flex-shrink-0 text-xl leading-none group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="px-5 pb-5 text-ink/65 text-sm leading-relaxed border-t border-terracotta/10 pt-4">
              {a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FORMULARIO PASADÍA -->
  <section id="book" class="py-20 md:py-28" style="background: #E6C497;">
    <div class="max-w-xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-3 text-brown">Reserva tu pasadía privado</h2>
        <p class="text-muted">Elige tu fecha y tamaño del grupo. Confirmamos y enviamos detalles en pocas horas.</p>
      </div>
      <WAInlineForm lang="es" defaultType="daytrip" client:visible />
    </div>
  </section>

  <Footer lang="es" />
</Layout>
