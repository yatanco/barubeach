---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import EscapePlanner from '../../components/EscapePlanner.tsx';
---

<Layout
  title="Planea Tu Visita — Casa Gaviota Barú"
  description="Obtén un precio estimado al instante para tu pasadía o estadía en Casa Gaviota. Planea tu visita y reserva directamente por WhatsApp."
  lang="es"
  canonical="https://casagaviota.com/es/plan"
>
  <Header lang="es" altHref="/plan" />

  <section class="py-16 md:py-24">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <p class="text-terracotta text-xs uppercase tracking-widest font-medium mb-4">Barú · Colombia</p>
        <h1 class="font-serif text-4xl sm:text-5xl font-semibold text-brown mb-4">Planea Tu Visita</h1>
        <p class="text-ink/60 text-base leading-relaxed">
          Obtén un precio estimado al instante.
        </p>
      </div>

      <EscapePlanner lang="es" client:visible />
    </div>
  </section>

  <Footer lang="es" />
</Layout>
