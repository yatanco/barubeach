---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import InquiryForm from '../../components/InquiryForm.tsx';

const MAPS = 'https://share.google/SHahHFkk8vXJIW7hH';
const KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<Layout
  title="Casa Gaviota Baru — Casa de Playa Privada en Barú, Colombia"
  description="Una casa de playa privada en Isla Barú cerca de Cartagena. 80 metros de playa privada, sin vendedores, sin multitudes. Servicio completo, privacidad total."
  lang="es"
  canonical="https://casagaviota.com/es"
>
  <Header lang="es" altHref="/" />

  <!-- HERO -->
  <section class="relative min-h-screen flex items-center justify-center">
    <img
      src="/images/hero-1.jpg"
      alt="Casa Gaviota playa privada en Barú, Colombia"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      width="1280"
      height="720"
    />
    <div class="absolute inset-0" style="background: rgba(87,57,46,0.50);"></div>
    <div class="relative z-10 text-center text-white px-6 max-w-3xl mx-auto py-24">
      <p class="text-sand text-xs sm:text-sm uppercase tracking-widest font-medium mb-5">Barú · Colombia</p>
      <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl font-semibold leading-tight mb-4">
        Casa Gaviota Baru
      </h1>
      <h2 class="text-xl sm:text-2xl font-light mb-3">Una casa de playa privada para desconectarse en Barú</h2>
      <p class="text-sm sm:text-base text-white/70 mb-12 uppercase tracking-wider">
        80 metros de playa privada · servicio completo · privacidad total
      </p>

      <button
        onclick="window.dispatchEvent(new CustomEvent('open-wa-popup'))"
        class="bg-sand text-brown font-semibold px-8 py-4 rounded-full text-base hover:opacity-90 transition-opacity cursor-pointer mb-10"
      >
        Planear por WhatsApp →
      </button>
      <a href="#experiencia" class="block text-white/45 text-sm hover:text-white/70 transition-colors">
        Descubrir más ↓
      </a>
    </div>
  </section>

  <!-- TARJETAS DE EXPERIENCIA -->
  <section id="experiencia" class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-brown text-center mb-3">¿Qué estás buscando?</h2>
      <p class="text-center text-ink/55 text-sm mb-10">Dos formas de vivir Casa Gaviota — ambas privadas, ambas únicas.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

        <!-- Pasadía -->
        <div class="bg-white rounded-2xl border border-terracotta/15 p-7 shadow-sm flex flex-col">
          <div class="text-3xl mb-4">☀️</div>
          <h3 class="font-serif text-xl font-semibold text-brown mb-2">Pasadía Privado</h3>
          <p class="text-ink/65 text-sm leading-relaxed mb-6 flex-1">Llega en la mañana, regresa al atardecer. Playa privada, comida fresca, y total libertad sin multitudes.</p>
          <a
            href="/es/pasadia"
            class="inline-flex items-center gap-1.5 bg-sand text-brown font-semibold text-sm px-5 py-3 rounded-full hover:opacity-90 transition-opacity self-start"
          >
            Ver Pasadía →
          </a>
        </div>

        <!-- Estadía -->
        <div class="bg-white rounded-2xl border border-terracotta/15 p-7 shadow-sm flex flex-col">
          <div class="text-3xl mb-4">🌙</div>
          <h3 class="font-serif text-xl font-semibold text-brown mb-2">Estadía Nocturna</h3>
          <p class="text-ink/65 text-sm leading-relaxed mb-6 flex-1">Duerme al son de las olas. Despierta frente al mar. 3 habitaciones, hasta 8 personas, privacidad total.</p>
          <div class="flex flex-wrap gap-2">
            <a
              href="http://airbnb.com/h/casagaviotabaru"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 bg-sand text-brown font-semibold text-sm px-5 py-3 rounded-full hover:opacity-90 transition-opacity"
            >
              Reservar en Airbnb →
            </a>
            <button
              onclick="window.dispatchEvent(new CustomEvent('open-wa-popup', {detail:{type:'stay'}}))"
              class="inline-flex items-center gap-1.5 border border-brown text-brown font-semibold text-sm px-5 py-3 rounded-full hover:bg-brown/5 transition cursor-pointer"
            >
              Planear directamente →
            </button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- BARRA DE CONFIANZA -->
  <section class="py-10 border-b border-terracotta/10">
    <div class="max-w-lg mx-auto px-4 sm:px-6 text-center">
      <p class="text-2xl font-bold text-brown tracking-tight">⭐ 4.8 · 200+ reseñas</p>
      <p class="text-sm text-ink/55 mt-1">En Airbnb, Booking.com y Google</p>
    </div>
  </section>

  <!-- NO ES UN HOTEL -->
  <section id="casa" class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <img
            src="/images/beach-1.jpg"
            alt="Playa privada de Casa Gaviota"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="600"
            height="450"
          />
        </div>
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 leading-snug text-brown">
            Casa Gaviota no es un beach club ni un hotel.
          </h2>
          <p class="text-ink/70 leading-relaxed mb-6">
            Es una casa de playa privada diseñada para personas que quieren bajar el ritmo, desconectarse y vivir la naturaleza sin distracciones.
          </p>
          <ul class="space-y-3 mb-8">
            {['Sin beach clubs.', 'Sin vendedores.', 'Sin multitudes.'].map(item => (
              <li class="flex items-center gap-3 font-medium text-ink/80">
                <span class="text-terracotta text-lg">—</span>
                {item}
              </li>
            ))}
          </ul>
          <p class="text-ink/70 leading-relaxed">Solo tu grupo, el mar y tiempo para descansar.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- RESEÑAS -->
  <section id="reviews" class="py-20 bg-rose/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-3 text-brown">Lo que dicen más de 200 huéspedes</h2>
        <p class="text-muted text-sm">⭐ 4.8 de promedio en Airbnb, Booking.com y Google</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          'Un lugar increíblemente hermoso y tranquilo, ideal para desconectarse.',
          'Un pedacito de paraíso… queremos volver.',
          'Perfecto para relajarse y desconectarse de todo.',
          'La comida fue mejor que en muchos restaurantes.',
        ].map(quote => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-terracotta/15">
            <p class="text-terracotta text-3xl leading-none mb-3">"</p>
            <p class="text-ink/75 text-sm leading-relaxed">{quote}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LA EXPERIENCIA -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div class="order-2 md:order-1">
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 leading-snug text-brown">
            Te atendemos desde el momento en que llegas.
          </h2>
          <p class="text-ink/70 leading-relaxed mb-4">
            Manuel y el equipo de la casa ayudan con todo: transporte, comidas, logística y cualquier cosa que necesites durante tu estadía.
          </p>
          <p class="text-ink/70 leading-relaxed">
            La comida caribeña se prepara fresca en la casa, y muchos huéspedes dicen que es una de las mejores partes de la experiencia.
          </p>
        </div>
        <div class="order-1 md:order-2">
          <img
            src="/images/food-1.jpg"
            alt="Comida caribeña fresca en Casa Gaviota"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="600"
            height="450"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- UN DÍA EN CASA GAVIOTA -->
  <section class="py-24 md:py-32 bg-brown text-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-sand text-xs uppercase tracking-widest mb-12">Un día en Casa Gaviota</p>
      <div class="space-y-5 font-serif">
        {[
          'Despertar frente al mar',
          'Nadar, descansar, leer y desconectarte',
          'Comer comida fresca, sencilla y deliciosa',
          'Ver el atardecer',
          'Dormirte con el sonido de las olas',
        ].map((line, i) => (
          <p class={`text-2xl sm:text-3xl md:text-4xl font-medium ${i % 2 === 1 ? 'text-white/60' : 'text-white'}`}>
            {line}
          </p>
        ))}
      </div>
      <p class="text-white/40 mt-12 text-lg">Sin horario. Sin presión.</p>
    </div>
  </section>

  <!-- LA CASA -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-8 text-brown">La casa</h2>
          <ul class="space-y-4 mb-8">
            {[
              '3 habitaciones, para hasta 8 huéspedes',
              'Cada habitación con baño privado',
              'Zonas sociales amplias',
              'Acceso directo a 80m de playa privada',
              'Wi-Fi con Starlink',
              'Ventiladores en todas las habitaciones',
            ].map(item => (
              <li class="flex items-start gap-3 text-ink/70">
                <span class="text-terracotta font-bold mt-0.5">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="text-ink/50 italic text-sm border-l-2 border-terracotta/40 pl-4">
            "Sencilla, cómoda y completamente integrada con la naturaleza."
          </p>
        </div>
        <div class="grid grid-cols-2 gap-3">
          {['house-1.jpg', 'house-2.jpg', 'house-3.jpg', 'house-4.jpg'].map((img, i) => (
            <img
              src={`/images/${img}`}
              alt={`Casa Gaviota foto ${i + 1}`}
              class="rounded-xl w-full aspect-square object-cover"
              loading="lazy"
              width="300"
              height="300"
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- QUÉ ESPERAR -->
  <section class="py-20 md:py-28 bg-rose/15">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <img
            src="/images/beach-2.jpg"
            alt="Entorno natural en Casa Gaviota"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="600"
            height="450"
          />
        </div>
        <div>
          <h2 class="font-serif text-2xl sm:text-3xl font-semibold mb-5 text-brown">Qué esperar</h2>
          <p class="text-ink/70 leading-relaxed mb-6">
            Casa Gaviota es una casa de playa rústica en un entorno natural y remoto. Eso es parte de lo que la hace especial, pero es importante saber qué esperar:
          </p>
          <ul class="space-y-3 mb-8">
            {[
              'No hay aire acondicionado; usamos ventiladores',
              'Hay presencia de naturaleza: insectos, brisa, arena y condiciones del mar que pueden variar',
              'Algunas zonas de la casa son sencillas y no de lujo',
              'El transporte requiere planificación: carro + lancha, o lancha directa',
            ].map(item => (
              <li class="flex items-start gap-3 text-sm text-ink/65">
                <span class="text-terracotta mt-0.5 flex-shrink-0">—</span>
                {item}
              </li>
            ))}
          </ul>
          <p class="text-sm text-ink/50 border-l-2 border-terracotta/30 pl-4 mb-4">
            Si estás buscando un hotel de lujo, este no es el lugar indicado.
          </p>
          <p class="text-sm text-ink/70 font-medium">
            Si estás buscando una experiencia tranquila, auténtica y privada en la naturaleza, te va a encantar.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- UBICACIÓN -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 text-brown">Ubicación y acceso</h2>
          <p class="text-ink/70 leading-relaxed mb-8">
            Casa Gaviota está ubicada en Barú, aproximadamente a 1–2 horas de Cartagena, dependiendo del tipo de transporte.
          </p>
          <div class="space-y-3 mb-8">
            <div class="flex items-start gap-4 p-4 bg-sand/20 rounded-xl">
              <span class="text-xl flex-shrink-0">🚤</span>
              <div>
                <p class="font-medium text-sm mb-0.5">Lancha privada desde Cartagena</p>
                <p class="text-muted text-sm">~$300 USD por trayecto, hasta 10 personas</p>
              </div>
            </div>
            <div class="flex items-start gap-4 p-4 bg-sand/20 rounded-xl">
              <span class="text-xl flex-shrink-0">🚗</span>
              <div>
                <p class="font-medium text-sm mb-0.5">Carro + lancha</p>
                <p class="text-muted text-sm">~$200–250 USD por trayecto. El tramo final siempre es en lancha.</p>
              </div>
            </div>
          </div>
          <p class="text-ink/50 text-sm mb-5">Nosotros te ayudamos a coordinar todo.</p>
          <a
            href={MAPS}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-steel font-medium text-sm hover:underline"
          >
            Ver en Google Maps →
          </a>
        </div>
        <div>
          <img
            src="/images/beach-3.jpg"
            alt="Llegada a Casa Gaviota en lancha"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="600"
            height="450"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- PREGUNTAS FRECUENTES -->
  <section id="faq" class="py-20 bg-rose/15">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-12 text-center text-brown">Preguntas frecuentes</h2>
      <div class="space-y-2">
        {[
          {
            q: '¿Qué tipo de lugar es Casa Gaviota?',
            a: 'Casa Gaviota es una casa de playa privada en Barú, cerca de Cartagena. No es un hotel grande ni un beach club. Es un lugar tranquilo, natural y privado para descansar, compartir y desconectarse.',
          },
          {
            q: '¿Cómo llego?',
            a: 'Casa Gaviota está ubicada en Barú y requiere una combinación de carro y lancha, o una lancha privada desde Cartagena. Nosotros te ayudamos a coordinar todo. Opciones: carro + lancha (~$200 USD) o lancha privada (~$300 USD, hasta 10 personas).',
          },
          {
            q: '¿Qué incluye la estadía?',
            a: 'Acceso privado a la casa, habitaciones, baños privados, zonas sociales, playa, Wi-Fi, apoyo del equipo en sitio y coordinación de comida, limpieza y transporte, según el tipo de reserva.',
          },
          {
            q: '¿Cómo funciona la comida?',
            a: 'Paquete de comida caribeña: USD $50 por persona por día. Paquete luxury con langosta: USD $80 por persona por día. O traer tus propios víveres. Muchos huéspedes destacan la comida como una de las mejores partes de la experiencia.',
          },
          {
            q: '¿Puedo llevar mi propia comida y bebidas?',
            a: 'Sí. Puedes traer tu propia comida, bebidas o snacks. También podemos ayudarte con compras, hielo, neveras o preparación, dependiendo de lo que necesite tu grupo.',
          },
          {
            q: '¿Tienen aire acondicionado?',
            a: 'No. Casa Gaviota no tiene aire acondicionado. Las habitaciones tienen ventiladores. La casa está pensada para una experiencia más natural, abierta y conectada con el entorno.',
          },
          {
            q: '¿Hay Wi-Fi?',
            a: 'Sí. Tenemos Wi-Fi con Starlink. Aun así, estamos en una zona natural y remota, así que pueden existir interrupciones ocasionales. Para el que quiera trabajar remoto lo puede hacer sin problema con nuestro Wi-Fi, baterías y generador.',
          },
          {
            q: '¿Puedo visitar solo por el día?',
            a: 'Sí. También ofrecemos pasadías privados para grupos, ideales para familias, cumpleaños, amigos y ocasiones especiales.',
          },
          {
            q: '¿Cómo reservo y pago?',
            a: 'Escríbenos por WhatsApp con la fecha, número de personas y el tipo de experiencia que buscas. Te confirmamos disponibilidad, opciones de transporte, comida y precio. Para reservar, normalmente se requiere un anticipo.',
          },
        ].map(({ q, a }) => (
          <details class="group bg-white rounded-xl border border-terracotta/20 overflow-hidden">
            <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none font-medium text-sm sm:text-base hover:bg-rose/10 transition-colors">
              <span>{q}</span>
              <span class="text-terracotta flex-shrink-0 text-xl leading-none group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="px-5 pb-5 text-ink/65 text-sm leading-relaxed border-t border-terracotta/10 pt-4">
              {a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FORMULARIO -->
  <section id="book" class="py-20 md:py-28">
    <div class="max-w-xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-3 text-brown">¿Listo para planear tu escape?</h2>
        <p class="text-muted">Cuéntanos tus fechas y tamaño del grupo. Te respondemos en pocas horas.</p>
      </div>
      <InquiryForm accessKey={KEY} lang="es" client:load />
    </div>
  </section>

  <Footer lang="es" />
</Layout>
