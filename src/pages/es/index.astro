---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const MAPS = 'https://share.google/SHahHFkk8vXJIW7hH';

const lodgingJsonLd = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  "name": "Casa Gaviota Baru",
  "description": "Una casa de playa privada en Isla Barú, cerca de Cartagena. 80 metros de playa privada, sin vendedores, sin multitudes. Servicio completo, privacidad total. Reserva estadía o pasadía.",
  "url": "https://casagaviota.com/es",
  "telephone": "+573163946401",
  "image": "https://casagaviota.com/images/og-image.jpg",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Barú",
    "addressRegion": "Bolívar",
    "addressCountry": "CO"
  },
  "priceRange": "$300-$1600 USD",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.8",
    "reviewCount": "200"
  }
};
---

<Layout
  title="Casa Gaviota Barú — Casa de Playa Privada en Barú, Colombia"
  description="Una casa de playa privada en Isla Barú, cerca de Cartagena. 80 metros de playa privada, sin vendedores, sin multitudes. Servicio completo, privacidad total. Reserva estadía o pasadía."
  lang="es"
  altHref="/"
  defaultPopupType="stay"
  jsonLd={lodgingJsonLd}
  heroImage="/images/hero-1.webp"
>
  <Header lang="es" altHref="/" />

  <!-- HERO -->
  <section class="relative min-h-screen flex items-center justify-center">
    <img
      src="/images/hero-1.webp"
      alt="Casa Gaviota playa privada en Barú, Colombia"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      width="1280"
      height="720"
    />
    <div class="absolute inset-0" style="background: rgba(87,57,46,0.50);"></div>
    <div class="relative z-10 text-center text-white px-6 max-w-3xl mx-auto py-24">
      <p class="text-sand text-xs sm:text-sm uppercase tracking-widest font-medium mb-5">Barú · Colombia</p>
      <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl font-semibold leading-tight mb-4">
        Casa Gaviota Barú
      </h1>
      <h2 class="text-xl sm:text-2xl font-light mb-3">Tu propia playa en Barú.</h2>
      <p class="text-sm sm:text-base text-white/70 mb-12 uppercase tracking-wider">
        Barú sin multitudes — un grupo a la vez.
      </p>

      <button
        onclick="window.dispatchEvent(new CustomEvent('open-wa-popup', {detail:{type:'stay'}}))"
        class="bg-sand text-brown font-semibold px-8 py-4 rounded-full text-base hover:opacity-90 transition-opacity cursor-pointer mb-4"
      >
        Verificar Disponibilidad →
      </button>
      <p class="text-white/60 text-sm italic mb-6">Solo recibimos un grupo a la vez.</p>
      <a href="#experiencia" class="block text-white/45 text-sm hover:text-white/70 transition-colors">
        Explorar ↓
      </a>
    </div>
  </section>

  <!-- REVIEWS -->
  <section id="resenas" class="py-20 bg-rose/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-3 text-brown">Lo que dicen 200+ huéspedes</h2>
        <p class="text-muted text-sm">⭐ 4.8 · Airbnb, Booking.com y Google</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="reviews-initial">
        {[
          'Insanamente hermoso y tranquilo, el lugar ideal para descansar.',
          'Un pedazo de cielo… ya estamos planeando volver.',
          'Perfecto para relajarse y desconectarse de todo.',
          'La comida estaba mejor que en los restaurantes.',
        ].map(quote => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-terracotta/15">
            <p class="text-terracotta text-3xl leading-none mb-3">"</p>
            <p class="text-ink/75 text-sm leading-relaxed">{quote}</p>
          </div>
        ))}
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-4 hidden" id="reviews-extra">
        {[
          'Manuel y su equipo son increíblemente atentos. Nos sentimos completamente cuidados.',
          'El lugar más hermoso y tranquilo que hemos visitado en Colombia.',
          'Perfecto para el viaje familiar. Los niños lo amaron, los adultos finalmente descansamos.',
          'Vale cada peso. Ya estamos planeando la próxima visita.',
        ].map(quote => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-terracotta/15">
            <p class="text-terracotta text-3xl leading-none mb-3">"</p>
            <p class="text-ink/75 text-sm leading-relaxed">{quote}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 text-center">
        <button
          id="show-more-reviews"
          class="border border-brown text-brown font-medium text-sm px-6 py-3 rounded-full hover:bg-brown/5 transition"
        >
          Ver más reseñas
        </button>
      </div>
      <div class="mt-10 text-center">
        <p class="text-sm text-ink/50 mb-4">200+ reseñas verificadas en múltiples plataformas</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="http://airbnb.com/h/casagaviotabaru"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border border-brown text-brown font-medium text-sm px-6 py-3 rounded-full hover:bg-brown/5 transition"
          >
            Leer todas las reseñas en Airbnb →
          </a>
          <a
            href="https://share.google/SHahHFkk8vXJIW7hH"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border border-brown text-brown font-medium text-sm px-6 py-3 rounded-full hover:bg-brown/5 transition"
          >
            Leer todas las reseñas en Google →
          </a>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    document.getElementById('show-more-reviews')?.addEventListener('click', function() {
      document.getElementById('reviews-extra')?.classList.remove('hidden');
      this.style.display = 'none';
    });
  </script>

  <!-- EXPERIENCE CARDS -->
  <section id="experiencia" class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-brown text-center mb-3">¿Qué estás buscando?</h2>
      <p class="text-center text-ink/55 text-sm mb-10">Dos formas de vivir Casa Gaviota — ambas privadas, ambas inolvidables.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

        <!-- Pasadía card -->
        <div class="bg-white rounded-2xl border border-terracotta/15 p-7 shadow-sm flex flex-col">
          <div class="text-3xl mb-4">☀️</div>
          <h3 class="font-serif text-xl font-semibold text-brown mb-2">Pasadía</h3>
          <p class="text-ink/65 text-sm leading-relaxed mb-2">Llega en la mañana, sal al atardecer. Playa privada, comida fresca y total libertad sin multitudes.</p>
          <p class="text-ink/50 text-xs italic mb-6 flex-1">Precio todo incluido. Un grupo. Sin tours compartidos.</p>
          <a
            href="/es/pasadia"
            class="inline-flex items-center gap-1.5 bg-sand text-brown font-semibold text-sm px-5 py-3 rounded-full hover:opacity-90 transition-opacity self-start"
          >
            Ver Pasadía →
          </a>
        </div>

        <!-- Estadía card -->
        <div class="bg-white rounded-2xl border border-terracotta/15 p-7 shadow-sm flex flex-col">
          <div class="text-3xl mb-4">🌙</div>
          <h3 class="font-serif text-xl font-semibold text-brown mb-2">Estadía</h3>
          <p class="text-ink/65 text-sm leading-relaxed mb-2">Duerme con el sonido de las olas. Despierta con el océano. 3 habitaciones, hasta 8 personas, total privacidad.</p>
          <p class="text-ink/50 text-xs italic mb-6 flex-1">La casa es tuya. En exclusiva.</p>
          <div class="flex flex-wrap gap-2">
            <a
              href="http://airbnb.com/h/casagaviotabaru"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 bg-sand text-brown font-semibold text-sm px-5 py-3 rounded-full hover:opacity-90 transition-opacity"
            >
              Reservar en Airbnb →
            </a>
            <button
              onclick="window.dispatchEvent(new CustomEvent('open-wa-popup', {detail:{type:'stay'}}))"
              class="inline-flex items-center gap-1.5 border border-brown text-brown font-semibold text-sm px-5 py-3 rounded-full hover:bg-brown/5 transition cursor-pointer"
            >
              Verificar Disponibilidad →
            </button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- NOT A HOTEL -->
  <section id="casa" class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div data-lightbox="no-hotel" class="grid grid-cols-2 gap-3">
          <img
            src="/images/beach-1.webp"
            alt="Playa privada en Casa Gaviota"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="300"
            height="225"
          />
          <img
            src="/images/beach-2.webp"
            alt="Playa natural en Casa Gaviota"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="300"
            height="225"
          />
        </div>
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 leading-snug text-brown">
            Casa Gaviota no es un beach club ni un hotel.
          </h2>
          <p class="text-ink/70 leading-relaxed mb-6">
            Es una casa de playa privada diseñada para personas que quieren descansar, desconectarse y vivir la naturaleza sin distracciones.
          </p>
          <ul class="space-y-3 mb-8">
            {['Sin beach clubs compitiendo por tu espacio.', 'Sin vendedores acercándose cada 10 minutos.', 'Sin extraños compartiendo tu playa.'].map(item => (
              <li class="flex items-center gap-3 font-medium text-ink/80">
                <span class="text-terracotta text-lg">—</span>
                {item}
              </li>
            ))}
          </ul>
          <p class="text-ink/70 leading-relaxed">Solo tu grupo, el océano y silencio.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- THE EXPERIENCE -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div class="order-2 md:order-1">
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 leading-snug text-brown">
            Te cuidamos desde que llegas.
          </h2>
          <p class="text-ink/70 leading-relaxed mb-4">
            Manuel y el equipo de la casa ayudan con todo — transporte, comidas, logística y lo que necesites durante tu estadía.
          </p>
          <p class="text-ink/70 leading-relaxed">
            La comida caribeña fresca se prepara en el lugar, y muchos huéspedes dicen que es uno de los momentos más destacados de la experiencia.
          </p>
        </div>
        <div class="order-1 md:order-2">
          <div data-lightbox="experiencia" class="grid grid-cols-2 gap-3">
            <img
              src="/images/food-1.webp"
              alt="Comida caribeña fresca en Casa Gaviota"
              class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
              loading="lazy"
              width="300"
              height="225"
            />
            <img
              src="/images/food-2.webp"
              alt="Almuerzo preparado en Casa Gaviota"
              class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
              loading="lazy"
              width="300"
              height="225"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- UN DÍA EN CASA GAVIOTA -->
  <section class="py-24 md:py-32 bg-brown text-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-sand text-xs uppercase tracking-widest mb-12">Un Día en Casa Gaviota</p>
      <div class="space-y-5 font-serif">
        {[
          'Despertar con el océano',
          'Nadar sin extraños en el agua',
          'Comer fresco, simple y delicioso',
          'Ver el atardecer sin vendedores preguntando si quieres una foto',
          'Dormir con el sonido de las olas',
        ].map((line, i) => (
          <p class={`text-2xl sm:text-3xl md:text-4xl font-medium ${i % 2 === 1 ? 'text-white/60' : 'text-white'}`}>
            {line}
          </p>
        ))}
      </div>
      <p class="text-white/40 mt-12 text-lg">Sin horarios. Sin extraños. Sin ruido que no sea el océano.</p>
      <div data-lightbox="dia-timeline" class="grid grid-cols-2 gap-3 mt-10 max-w-sm mx-auto">
        <img
          src="/images/beach-3.webp"
          alt="Llegando a Casa Gaviota en lancha"
          class="rounded-xl w-full aspect-square object-cover opacity-80"
          loading="lazy"
          width="200"
          height="200"
        />
        <img
          src="/images/hero-2.webp"
          alt="Playa de Casa Gaviota"
          class="rounded-xl w-full aspect-square object-cover opacity-80"
          loading="lazy"
          width="200"
          height="200"
        />
      </div>
    </div>
  </section>

  <!-- LA CASA -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-8 text-brown">La Casa</h2>
          <ul class="space-y-4 mb-8">
            {[
              '3 habitaciones · hasta 8 huéspedes',
              'Cada habitación con baño privado',
              'Amplias áreas sociales',
              'Acceso directo a 80m de playa privada',
              'Ventiladores en todas las habitaciones',
            ].map(item => (
              <li class="flex items-start gap-3 text-ink/70">
                <span class="text-terracotta font-bold mt-0.5">✓</span>
                <span>{item}</span>
              </li>
            ))}
            <li class="flex items-start gap-3 text-ink/70">
              <span class="text-terracotta font-bold mt-0.5">✓</span>
              <span>
                <span class="inline-block bg-[#7D98AB] text-white text-xs font-semibold px-2.5 py-1 rounded-full mr-2">Wi-Fi Starlink</span>
                <span class="block text-sm text-ink/60 mt-1">Internet de alta velocidad con Starlink — poco común en Barú. Funciona para trabajo remoto y videollamadas.</span>
              </span>
            </li>
          </ul>
          <p class="text-ink/50 italic text-sm border-l-2 border-terracotta/40 pl-4">
            "Simple, cómoda y completamente integrada con la naturaleza."
          </p>
        </div>
        <div data-lightbox="casa" class="grid grid-cols-2 gap-3">
          {['house-1.webp', 'house-2.webp', 'house-3.webp', 'house-4.webp'].map((img, i) => (
            <img
              src={`/images/${img}`}
              alt={`Foto de la casa ${i + 1}`}
              class="rounded-xl w-full aspect-square object-cover"
              loading="lazy"
              width="300"
              height="300"
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PRECIOS DE ESTADÍA -->
  <section class="py-20 md:py-28" style="background: #FAFAF5;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-3 text-brown">Cómo funciona el precio</h2>
        <p class="text-ink/60">La casa es tuya — agrega lo que necesitas.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        <div class="bg-white rounded-2xl p-6 border border-terracotta/15 shadow-sm">
          <div class="text-3xl mb-3">🏠</div>
          <h3 class="font-semibold text-brown text-lg mb-1">La casa</h3>
          <p class="text-2xl font-bold text-brown mb-2">$350 USD <span class="text-base font-normal text-ink/50">/noche</span></p>
          <p class="text-sm text-ink/60">Hasta 8 personas · mínimo 2 noches · 3 habitaciones con baño privado</p>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-terracotta/15 shadow-sm">
          <div class="text-3xl mb-3">🚤</div>
          <h3 class="font-semibold text-brown text-lg mb-3">Transporte <span class="text-sm font-normal text-ink/50">(elige uno)</span></h3>
          <div class="space-y-3">
            <div>
              <p class="font-semibold text-sm text-ink">Lancha privada: $250 USD cada trayecto</p>
              <p class="text-sm text-ink/55">Directo desde Cartagena · hasta 10 personas</p>
            </div>
            <div>
              <p class="font-semibold text-sm text-ink">Carro + lancha: $200 USD cada trayecto</p>
              <p class="text-sm text-ink/55">Drive a Barú + lancha corta hasta la casa</p>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-2xl p-6 border border-terracotta/15 shadow-sm">
          <div class="text-3xl mb-3">🍽️</div>
          <h3 class="font-semibold text-brown text-lg mb-3">Comida <span class="text-sm font-normal text-ink/50">(elige una)</span></h3>
          <div class="space-y-3">
            <div>
              <p class="font-semibold text-sm text-ink">Servicio de comida: $50 USD/persona/día</p>
              <p class="text-sm text-ink/55">Comidas caribeñas frescas preparadas en la casa</p>
              <p class="text-xs text-ink/60 italic mt-1">Tu cocina privada, atendiendo solo a tu grupo.</p>
            </div>
            <div>
              <p class="font-semibold text-sm text-ink">Lujo con langosta: $80 USD/persona/día</p>
            </div>
            <div>
              <p class="font-semibold text-sm text-ink">Traer tus propios víveres: $0</p>
              <p class="text-sm text-ink/55">Compra en Cartagena antes de llegar</p>
            </div>
          </div>
        </div>
      </div>

      <div class="rounded-2xl p-7 mb-8" style="background: #E6C497;">
        <p class="font-semibold text-brown text-sm uppercase tracking-wide mb-5">Ejemplo: 2 noches · 4 personas · lancha privada · servicio de comida</p>
        <div class="space-y-2 text-sm text-ink/80 mb-4">
          <div class="flex justify-between">
            <span>🏠 Casa (2 noches)</span>
            <span class="font-semibold">$700 USD</span>
          </div>
          <div class="flex justify-between">
            <span>🚤 Transporte (lancha, ida y vuelta)</span>
            <span class="font-semibold">$500 USD</span>
          </div>
          <div class="flex justify-between">
            <span>🍽️ Comida (4 personas × $50 × 2 noches)</span>
            <span class="font-semibold">$400 USD</span>
          </div>
          <div class="border-t border-ink/20 pt-3 flex justify-between font-bold text-base">
            <span>Total</span>
            <span>~$1,600 USD</span>
          </div>
          <div class="flex justify-between text-ink/55">
            <span>Por persona</span>
            <span>~$400 USD</span>
          </div>
        </div>
      </div>

      <p class="text-center text-sm text-ink/50 mb-8">Precio final confirmado por WhatsApp. Se requiere 50% de depósito para reservar las fechas.</p>
      <div class="text-center">
        <button
          onclick="window.dispatchEvent(new CustomEvent('open-wa-popup', {detail:{type:'stay'}}))"
          class="inline-flex items-center gap-2.5 bg-sand text-brown px-8 py-4 rounded-full text-sm font-semibold hover:opacity-90 transition shadow-md cursor-pointer"
        >
          Verificar Disponibilidad →
        </button>
      </div>
    </div>
  </section>

  <!-- EXPECTATIVAS HONESTAS -->
  <section class="py-20 md:py-28 bg-rose/15">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <div data-lightbox="expectativas" class="grid grid-cols-2 gap-3">
            <img
              src="/images/house-3.webp"
              alt="Interior de Casa Gaviota"
              class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
              loading="lazy"
              width="300"
              height="225"
            />
            <img
              src="/images/house-4.webp"
              alt="Habitación de Casa Gaviota"
              class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
              loading="lazy"
              width="300"
              height="225"
            />
          </div>
        </div>
        <div>
          <h2 class="font-serif text-2xl sm:text-3xl font-semibold mb-5 text-brown">Expectativas honestas</h2>
          <p class="text-ink/70 leading-relaxed mb-4">
            Barú es un entorno natural y remoto. Eso es exactamente lo que lo hace especial. Esto es lo que puedes esperar:
          </p>
          <p class="text-ink/70 leading-relaxed mb-6">
            Te lo decimos porque los huéspedes que llegan con las expectativas correctas tienen la mejor experiencia — y regresan.
          </p>
          <ul class="space-y-3 mb-8">
            {[
              'Sin aire acondicionado (ventiladores en lugar)',
              'La naturaleza está presente: insectos, humedad, condiciones del mar variables',
              'Algunas áreas de la casa son simples, no de lujo',
              'Llegar requiere planificación: carro + lancha o lancha privada',
            ].map(item => (
              <li class="flex items-start gap-3 text-sm text-ink/65">
                <span class="text-terracotta mt-0.5 flex-shrink-0">—</span>
                {item}
              </li>
            ))}
          </ul>
          <p class="text-sm text-ink/50 border-l-2 border-terracotta/30 pl-4 mb-4">
            Si buscas un hotel de lujo, este no es el lugar indicado.
          </p>
          <p class="text-sm text-ink/70 font-medium">
            Si buscas una experiencia auténtica, tranquila y privada en la naturaleza, lo vas a amar.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- UBICACIÓN -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 text-brown">Ubicación y acceso</h2>
