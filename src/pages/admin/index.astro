---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db';
import {
  money, shortDate, timeAgo, GUEST_INTENTS, channelBadgeClass, CHANNEL_PILL_LABELS, BOOKING_CHANNELS,
  STATUS_LABELS, STATUS_COLORS, DIRECT_PIPELINE, AIRBNB_PIPELINE, LEAD_PIPELINE, normalizeStatus,
} from '../../lib/crm';
import {
  HARD_CONFLICT_CANDIDATES_SQL, SOFT_CONFLICT_CANDIDATES_SQL, mapConflictRow, findConflicts,
  type ConflictInfo,
} from '../../lib/crm-availability';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

interface BookingRow {
  id: string; guest_name: string; guest_phone: string | null; date_from: string; date_to: string;
  adults: number; children: number; status: string; channel: string;
  food_amount: number; food_confirmed: number; transport_amount: number; transport_confirmed: number;
  accommodation_cents: number; paid_cents: number; source: string; updated_at: string;
}
interface LeadRow {
  id: string; guest_name: string | null; whatsapp: string | null; date_from: string | null; date_to: string | null;
  adults: number; children: number; status: string; created_at: string;
  next_followup_date: string | null; followup_count: number;
  guest_intent: string | null;
  accommodation_amount: number; food_amount: number; food_confirmed: number; transport_amount: number; transport_confirmed: number;
  paid_cents: number;
}
interface SyncLogRow {
  synced_at: string; processed: number; inserted: number; updated: number; skipped: number; error: string | null; duration_ms: number;
}
interface DrinksOrderRow {
  id: number; booking_id: string | null; guest_name: string; items: string; total: number; status: string; created_at: string;
}
interface ListItem {
  kind: 'booking' | 'lead';
  id: string;
  name: string;
  dateFrom: string | null;
  dateTo: string | null;
  guests: number;
  status: string;
  phone: string | null;
  balanceLabel: string;
  balanceClass: string;
  isUpcoming: boolean;
  channel: string | null;
  createdAt: string | null;
  avail: 'clear' | 'soft' | 'hard' | null;
  urgency: 'red' | 'amber' | null;
  urgencyLabel: string | null;
  urgencyScore: number;
  totalCents: number;
  nextAction: string;
}

const BOOKING_SELECT = `SELECT b.id, b.guest_name, b.guest_phone, b.date_from, b.date_to, b.adults, b.children, b.status, b.channel,
    b.food_amount, b.food_confirmed, b.transport_amount, b.transport_confirmed, b.source, b.updated_at,
    COALESCE((SELECT amount_cents FROM charges WHERE booking_id = b.id AND category = 'accommodation' LIMIT 1), 0) AS accommodation_cents,
    COALESCE((SELECT SUM(p.amount_cents) FROM payments p JOIN charges c ON c.id = p.charge_id WHERE c.booking_id = b.id), 0) AS paid_cents
  FROM bookings b WHERE b.status NOT IN ('cancelled','completed')`;
const LEAD_SELECT = `SELECT id, guest_name, whatsapp, date_from, date_to, adults, children, status, created_at,
    next_followup_date, followup_count, guest_intent,
    accommodation_amount, food_amount, food_confirmed, transport_amount, transport_confirmed,
    COALESCE((SELECT SUM(p.amount_cents) FROM payments p JOIN charges c ON c.id = p.charge_id WHERE c.lead_id = leads.id), 0) AS paid_cents
  FROM leads WHERE status NOT IN ('lost','cancelled','completed') AND NOT EXISTS (SELECT 1 FROM bookings WHERE bookings.lead_id = leads.id)`;
const COMPLETED_BOOKING_SELECT = `SELECT b.id, b.guest_name, b.guest_phone, b.date_from, b.date_to, b.adults, b.children, b.status, b.channel,
    b.food_amount, b.food_confirmed, b.transport_amount, b.transport_confirmed,
    COALESCE((SELECT amount_cents FROM charges WHERE booking_id = b.id AND category = 'accommodation' LIMIT 1), 0) AS accommodation_cents,
    COALESCE((SELECT SUM(p.amount_cents) FROM payments p JOIN charges c ON c.id = p.charge_id WHERE c.booking_id = b.id), 0) AS paid_cents
  FROM bookings b WHERE b.status = 'completed' OR (b.date_to < date('now') AND b.status NOT IN ('cancelled','lost'))
  ORDER BY b.date_to DESC`;

const db = getDb(Astro.locals);
let bookings: BookingRow[] = [];
let completedBookings: BookingRow[] = [];
let leads: LeadRow[] = [];
let hardConflictCandidates: ConflictInfo[] = [];
let softConflictCandidates: ConflictInfo[] = [];
let newLeadsCount = 0;
let weekLeadsCount = 0;
let outstandingCents = 0;
let arrivalsThisWeek = 0;
let inHouseCount = 0;
let lastSync: SyncLogRow | null = null;
let drinksOrders: DrinksOrderRow[] = [];
let staleHostHubBookings: BookingRow[] = [];
let error = '';

const now = new Date();
const todayStr = now.toISOString().slice(0, 10);
const upcomingBoundStr = new Date(now.getTime() + 14 * 86_400_000).toISOString().slice(0, 10);
const weekBoundStr = new Date(now.getTime() + 7 * 86_400_000).toISOString().slice(0, 10);

if (!db) {
  error = 'D1 is not configured yet. Bind the database as DB and run the migration.';
} else {
  try {
    const [
      bookingResult, completedBookingResult, leadsResult,
      hardConflictCandidatesResult, softConflictCandidatesResult,
      newCountResult, weekCountResult, outstandingResult, arrivalsResult, inHouseResult, lastSyncResult,
    ] = await Promise.all([
      db.prepare(`${BOOKING_SELECT} ORDER BY b.date_from ASC`).all<BookingRow>(),
      db.prepare(COMPLETED_BOOKING_SELECT).all<BookingRow>(),
      db.prepare(`${LEAD_SELECT} ORDER BY created_at DESC`).all<LeadRow>(),
      db.prepare(HARD_CONFLICT_CANDIDATES_SQL).all<any>(),
      db.prepare(SOFT_CONFLICT_CANDIDATES_SQL).all<any>(),
      db.prepare(`SELECT COUNT(*) AS count FROM leads WHERE status = 'new'`).first<{ count: number }>(),
      db.prepare(`SELECT COUNT(*) AS count FROM leads WHERE created_at >= datetime('now', '-7 days')`).first<{ count: number }>(),
      db.prepare(`WITH booking_totals AS (
        SELECT b.id,
          (CASE WHEN b.channel = 'airbnb' THEN 0 ELSE COALESCE((SELECT amount_cents FROM charges WHERE booking_id = b.id AND category = 'accommodation' LIMIT 1), 0) END)
            + (CASE WHEN b.food_confirmed THEN b.food_amount ELSE 0 END)
            + (CASE WHEN b.transport_confirmed THEN b.transport_amount ELSE 0 END) AS total_cents,
          COALESCE((SELECT SUM(p.amount_cents) FROM payments p JOIN charges c ON c.id = p.charge_id WHERE c.booking_id = b.id), 0) AS paid_cents
        FROM bookings b WHERE b.status != 'cancelled'
      ) SELECT COALESCE(SUM(MAX(total_cents - paid_cents, 0)), 0) AS outstanding FROM booking_totals`).first<{ outstanding: number }>(),
      db.prepare(`SELECT COUNT(*) AS count FROM bookings WHERE date_from BETWEEN date('now') AND date('now', '+7 days') AND status != 'cancelled'`).first<{ count: number }>(),
      db.prepare(`SELECT COUNT(*) AS count FROM bookings WHERE date_from <= date('now') AND date_to >= date('now') AND status IN ('in_house','checked_in')`).first<{ count: number }>(),
      db.prepare(`SELECT synced_at, processed, inserted, updated, skipped, error, duration_ms FROM sync_log ORDER BY synced_at DESC LIMIT 1`).first<SyncLogRow>(),
    ]);
    bookings = bookingResult.results;
    completedBookings = completedBookingResult.results;
    leads = leadsResult.results;
    hardConflictCandidates = hardConflictCandidatesResult.results.map(mapConflictRow);
    softConflictCandidates = softConflictCandidatesResult.results.map(mapConflictRow);
    newLeadsCount = newCountResult?.count ?? 0;
    weekLeadsCount = weekCountResult?.count ?? 0;
    outstandingCents = outstandingResult?.outstanding ?? 0;
    arrivalsThisWeek = arrivalsResult?.count ?? 0;
    inHouseCount = inHouseResult?.count ?? 0;
    lastSync = lastSyncResult ?? null;

    // syncHostHub() only ever upserts what's currently in the feed — a
    // reservation edited in HostHub in a way that reissues its UID leaves
    // the old row orphaned, still showing as an active booking. Anything
    // HostHub-sourced that wasn't touched by the most recent sync run is
    // worth a human look (not auto-cancelled — that's a business call).
    // sync_log.synced_at is logged *after* the whole run finishes, while
    // each booking's own updated_at is stamped as it's processed mid-loop —
    // comparing against synced_at directly would flag everything touched
    // before the run's final moment. Use the run's start time instead.
    if (lastSync) {
      const syncStartedAt = new Date(new Date(lastSync.synced_at).getTime() - lastSync.duration_ms).toISOString();
      staleHostHubBookings = bookings.filter((b) => b.source === 'hosthub_ical' && b.updated_at < syncStartedAt);
    }
  } catch (cause) {
    console.error('[admin] failed to load CRM', cause);
    error = 'The CRM database could not be read. Confirm that migrations 0001_crm.sql through 0010 have run.';
  }

  // Isolated from the query batch above: drinks_orders is a newer table
  // (migration 0011) that may not exist yet in every environment — a missing
  // table here should hide the Drinks tab, not take down the whole dashboard.
  try {
    const drinksOrdersResult = await db.prepare(
      `SELECT id, booking_id, guest_name, items, total, status, created_at FROM drinks_orders WHERE status != 'cancelled' ORDER BY created_at DESC`,
    ).all<DrinksOrderRow>();
    drinksOrders = drinksOrdersResult.results;
  } catch (cause) {
    console.error('[admin] failed to load drinks orders', cause);
  }
}

function hoursSince(iso: string): number {
  return Math.max(0, Math.floor((now.getTime() - new Date(iso).getTime()) / 3_600_000));
}
// Same rules that used to drive the standalone "Follow up today" section:
// a 'new' lead untouched 4+ hours is red (nobody has replied at all yet);
// a 'replied' lead whose Day 3 / Day 7 cadence (next_followup_date, set by
// the status API and POST .../log-followup) is due today or overdue is amber.
// Bookings never carry urgency — this cadence is lead-only by design.
function leadUrgency(lead: LeadRow): Pick<ListItem, 'urgency' | 'urgencyLabel' | 'urgencyScore'> {
  if (lead.status === 'new') {
    const hours = hoursSince(lead.created_at);
    if (hours > 4) return { urgency: 'red', urgencyLabel: `${hours}h untouched`, urgencyScore: 1_000_000 + hours };
  } else if (lead.status === 'replied' && lead.next_followup_date && lead.next_followup_date.slice(0, 10) <= todayStr) {
    // A lead whose stay dates are already gone isn't an active follow-up
    // candidate anymore (there are no dates left to fill) — checkout date
    // takes priority since it's the later boundary, falling back to checkin
    // for a lead with only one date set.
    const lastRelevantDate = lead.date_to || lead.date_from;
    if (lastRelevantDate && lastRelevantDate.slice(0, 10) < todayStr) {
      return { urgency: null, urgencyLabel: null, urgencyScore: -1 };
    }
    const daysOverdue = Math.max(0, Math.round((Date.parse(todayStr) - Date.parse(lead.next_followup_date.slice(0, 10))) / 86_400_000));
    const dayLabel = (lead.followup_count ?? 0) === 0 ? 'Day 3' : 'Day 7';
    return { urgency: 'amber', urgencyLabel: `Follow up: ${dayLabel}`, urgencyScore: daysOverdue };
  }
  return { urgency: null, urgencyLabel: null, urgencyScore: -1 };
}
function bookingToItem(b: BookingRow): ListItem {
  const totalCents = (b.channel === 'airbnb' ? 0 : b.accommodation_cents)
    + (b.food_confirmed ? b.food_amount : 0)
    + (b.transport_confirmed ? b.transport_amount : 0);
  const balance = totalCents - b.paid_cents;
  const from = b.date_from.slice(0, 10);
  return {
    kind: 'booking', id: b.id, name: b.guest_name, dateFrom: b.date_from, dateTo: b.date_to,
    guests: b.adults + b.children, status: b.status, phone: b.guest_phone,
    balanceLabel: totalCents <= 0 ? '—' : balance > 0 ? `Balance: ${money(balance)}` : 'Paid ✓',
    balanceClass: totalCents > 0 && balance <= 0 ? 'positive' : balance > 0 ? 'negative' : '',
    isUpcoming: from >= todayStr && from <= upcomingBoundStr,
    channel: b.channel,
    createdAt: null,
    avail: null,
    urgency: null,
    urgencyLabel: null,
    urgencyScore: -1,
    totalCents,
    nextAction: b.status === 'deposit_requested' ? 'Awaiting payment'
      : b.status === 'deposit_paid' ? 'Confirm reservation'
      : b.status === 'in_house' || b.status === 'checked_in' ? 'Support guest'
      : b.status === 'balance_requested' ? 'Collect balance'
      : 'Review booking',
  };
}
function leadToItem(lead: LeadRow): ListItem {
  const totalCents = lead.accommodation_amount + (lead.food_confirmed ? lead.food_amount : 0) + (lead.transport_confirmed ? lead.transport_amount : 0);
  const balance = totalCents - lead.paid_cents;
  const from = lead.date_from ? lead.date_from.slice(0, 10) : null;
  return {
    kind: 'lead', id: lead.id, name: lead.guest_name || 'Unnamed inquiry', dateFrom: lead.date_from, dateTo: lead.date_to,
    guests: lead.adults + lead.children, status: lead.status, phone: lead.whatsapp,
    balanceLabel: totalCents <= 0 ? '—' : balance > 0 ? `Balance: ${money(balance)}` : 'Paid ✓',
    balanceClass: totalCents > 0 && balance <= 0 ? 'positive' : balance > 0 ? 'negative' : '',
    isUpcoming: !!from && from >= todayStr && from <= upcomingBoundStr,
    channel: null,
    createdAt: lead.created_at,
    avail: null,
    ...leadUrgency(lead),
    totalCents,
    nextAction: lead.status === 'new' ? 'Reply'
      : lead.status === 'replied' ? (lead.next_followup_date?.slice(0, 10) <= todayStr ? 'Follow up' : 'Await guest')
      : lead.status === 'quoted' ? 'Follow up on quote'
      : lead.status === 'deposit_requested' ? 'Awaiting payment'
      : lead.status === 'deposit_paid' ? 'Confirm reservation'
      : !lead.date_from ? 'Confirm dates'
      : 'Review lead',
  };
}
function datesLabel(item: ListItem): string {
  if (item.dateFrom && item.dateTo) return `${shortDate(item.dateFrom)} → ${shortDate(item.dateTo)}`;
  if (item.dateFrom) return shortDate(item.dateFrom);
  return 'No dates yet';
}

const items: ListItem[] = [
  ...bookings.map(bookingToItem),
  ...leads.map(leadToItem),
];
items.forEach((item) => {
  if (!item.dateFrom || !item.dateTo) return;
  const hard = findConflicts(hardConflictCandidates, item.dateFrom, item.dateTo, item.kind === 'booking' ? item.id : '');
  const soft = findConflicts(softConflictCandidates, item.dateFrom, item.dateTo, item.kind === 'lead' ? item.id : '');
  item.avail = hard.length > 0 ? 'hard' : soft.length > 0 ? 'soft' : 'clear';
});
// Urgent cards (red, then amber, most severe first) float to the top; everything
// else keeps its prior relative order (stable sort — all tie at urgencyScore -1).
items.sort((a, b) => b.urgencyScore - a.urgencyScore);
const newLeadsToday = leads.filter((lead) => lead.created_at.slice(0, 10) === todayStr).length;
const leadsNeedingReply = leads.filter((lead) => lead.status === 'new').length;
const followupsDue = leads.filter((lead) => leadUrgency(lead).urgency !== null && lead.status === 'replied').length;
// Leads leadUrgency() now excludes from follow-up because their stay dates
// already passed — correctly stops them reading as actionable, but they'd
// otherwise vanish from view silently. Keep this leakage visible.
const expiredLeadsCount = leads.filter((lead) => {
  if (lead.status !== 'replied') return false;
  const lastRelevantDate = lead.date_to || lead.date_from;
  return !!lastRelevantDate && lastRelevantDate.slice(0, 10) < todayStr;
}).length;
const quotesAwaitingPayment = items.filter((item) => (item.status === 'quoted' || item.status === 'deposit_requested') && item.totalCents > 0 && item.balanceClass === 'negative').length;
const openPipelineCents = items.filter((item) => item.kind === 'lead').reduce((sum, item) => sum + item.totalCents, 0);
const weekArrivals = bookings.filter((booking) => {
  const from = booking.date_from.slice(0, 10);
  return from >= todayStr && from <= weekBoundStr;
});
const completedBookingItems: ListItem[] = completedBookings.map(bookingToItem);

// `primary` filters are the four reached for daily; the rest stay fully
// functional but read as lighter-weight so the row doesn't compete for
// attention with itself.
// 'all' stays a valid filter value (the show/hide switch below still
// understands it, and dropping it would mean re-typing filterCounts) but
// isn't rendered as a chip — "everything, unprioritized" isn't a useful
// default next to a list that's already urgency-sorted. Follow up opens by
// default instead; see the client script's initial applyFilterWithSearch call.
const FILTERS = [
  { value: 'all', label: 'All', primary: true, hidden: true },
  { value: 'followup', label: 'Follow up', primary: true },
  { value: 'bookings', label: 'Bookings', primary: true },
  { value: 'leads', label: 'Leads', primary: true },
  { value: 'deposit', label: 'Deposit Pending', primary: false },
  { value: 'inhouse', label: 'In House', primary: false },
  { value: 'completed', label: 'Completed', primary: false },
  { value: 'upcoming', label: 'Upcoming', primary: false },
  { value: 'drinks', label: '🍹 Drinks', primary: false },
] as const;
const filterCounts: Record<typeof FILTERS[number]['value'], number> = {
  all: items.length,
  followup: items.filter((item) => item.urgency !== null).length,
  bookings: items.filter((item) => item.kind === 'booking').length,
  leads: items.filter((item) => item.kind === 'lead').length,
  deposit: items.filter((item) => item.status === 'deposit_requested').length,
  inhouse: items.filter((item) => item.status === 'in_house' || item.status === 'checked_in').length,
  completed: completedBookingItems.length,
  upcoming: items.filter((item) => item.kind === 'booking' && item.isUpcoming).length,
  drinks: drinksOrders.length,
};

// drinks_orders.total / items[].price are stored as plain COP pesos, not
// cents like the rest of this schema — format directly rather than money().
function pesos(amount: number): string {
  return `$${Math.round(amount).toLocaleString('es-CO')}`;
}
const drinksOrderItems = drinksOrders.map((order) => ({
  ...order,
  parsedItems: JSON.parse(order.items) as { name: string; qty: number; price: number }[],
}));
const DRINKS_STATUS_COLORS: Record<string, string> = {
  pending: '#F59E0B',
  confirmed: '#3B82F6',
  delivered: '#22C55E',
  cancelled: '#6B7280',
};

const notice = Astro.url.searchParams.get('saved');
const leadError = Astro.url.searchParams.get('leadError');
---
<AdminLayout title="Dashboard">
  <div class="actions dashboard-head" style="justify-content:space-between;margin-bottom:6px">
    <h1>Bookings & inquiries</h1>
    <div class="actions dashboard-tools">
      <button type="button" class="secondary" id="open-add-lead" aria-label="Add Lead">
        <span class="btn-icon" aria-hidden="true">➕</span><span class="btn-label">Add Lead</span>
      </button>
      <button type="button" class="secondary" id="sync-hosthub-btn" aria-label="Sync HostHub">
        <span class="btn-icon" aria-hidden="true">🔄</span><span class="btn-label">Sync HostHub</span>
      </button>
    </div>
  </div>
  <p class="muted dashboard-intro">HostHub owns reservations. This dashboard owns follow-up, charges and payments.</p>
  <p class="muted sync-line">
    <span id="last-sync-info">Last sync: {lastSync ? `${timeAgo(lastSync.synced_at)} · ${lastSync.processed} reservations` : 'never'}</span>
    <span id="sync-feedback" role="status" aria-live="polite"></span>
  </p>
  {error && <div class="alert">{error}</div>}
  {notice && <div class="alert">Saved successfully.</div>}
  {leadError && <div class="alert">{leadError}</div>}
  {!error && (
    <p class="summary-line">{newLeadsCount} open new leads · {weekLeadsCount} created this week · {arrivalsThisWeek} arrivals this week · {inHouseCount} in house · {money(outstandingCents)} outstanding{expiredLeadsCount > 0 && <> · {expiredLeadsCount} inquiries expired without booking</>}</p>
  )}
  {!error && staleHostHubBookings.length > 0 && (
    <div class="alert">
      🔄 {staleHostHubBookings.length} HostHub-synced booking{staleHostHubBookings.length > 1 ? 's' : ''} weren't touched by the last sync — worth checking they're still current: {staleHostHubBookings.map((b, i) => (
        <>{i > 0 && ', '}<a href={`/admin/bookings/${b.id}`}>{b.guest_name || 'Unnamed'}</a></>
      ))}
    </div>
  )}
  {!error && (
    <section class="sales-today" aria-labelledby="sales-today-title">
      <div class="sales-today-head"><h2 id="sales-today-title">Sales today</h2><span class="muted">Action first</span></div>
      <div class="today-metrics">
        <div data-warn={newLeadsToday > 0 ? '1' : '0'}><strong>{newLeadsToday}</strong><span>New today</span></div>
        <div data-warn={leadsNeedingReply > 0 ? '1' : '0'}><strong>{leadsNeedingReply}</strong><span>Need reply</span></div>
        <div data-warn={followupsDue > 0 ? '1' : '0'}><strong>{followupsDue}</strong><span>Follow-ups due</span></div>
        <div data-warn={quotesAwaitingPayment > 0 ? '1' : '0'}><strong>{quotesAwaitingPayment}</strong><span>Quotes unpaid</span></div>
        {openPipelineCents > 0 && <div><strong>{money(openPipelineCents)}</strong><span>Open lead value</span></div>}
      </div>
    </section>
  )}
  {!error && (
    <section class="card arrivals-card">
      <h2>Arriving this week</h2>
      {weekArrivals.length === 0 && <p class="muted">No arrivals in the next 7 days.</p>}
      {weekArrivals.map((booking) => (
        <a class="arrival-row" href={`/admin/bookings/${booking.id}`}>
          <strong>{shortDate(booking.date_from)} · {booking.guest_name}</strong>
          <span>{booking.adults + booking.children} guests →</span>
        </a>
      ))}
    </section>
  )}

  {!error && (
    <>
      <div class="pipeline" id="filter-bar">
        {FILTERS.filter((f) => !f.hidden).map((f) => (
          <a href="#" data-filter={f.value} class={f.value === 'followup' ? 'active' : f.primary ? '' : 'secondary-filter'} aria-current={f.value === 'followup' ? 'page' : undefined}>
            <span>{f.label}</span><span class="count">{filterCounts[f.value]}</span>
          </a>
        ))}
      </div>

      <div class="leads-sort-toggle" id="leads-sort-toggle" style="display:none">
        <span class="muted" style="font-size:12px">Sort:</span>
        <button type="button" data-sort="created" class="sort-pill">Newest inquiry</button>
        <button type="button" data-sort="checkin" class="sort-pill">Soonest check-in</button>
      </div>

      <div class="list-search-bar">
        <input type="search" id="list-search" placeholder="Search by name or phone…" autocomplete="off" spellcheck="false" />
      </div>

      <div class="card" id="unified-list-card">
        <div class="sync-skeleton" id="sync-skeleton" hidden aria-hidden="true">
          {[1,2,3,4].map(() => <div class="skeleton-row"><span></span><span></span></div>)}
        </div>
        <div class="list" id="unified-list">
          {items.length === 0 && <div class="empty-state"><span aria-hidden="true">⌁</span><strong>No bookings or leads yet</strong><p>New inquiries and synced reservations will appear here.</p></div>}
          {items.map((item) => (
            <div
              class="row clickable-row"
              data-href={`/admin/${item.kind === 'booking' ? 'bookings' : 'leads'}/${item.id}`}
              data-kind={item.kind}
              data-id={item.id}
              data-status={item.status}
              data-channel={item.channel || ''}
              data-upcoming={item.isUpcoming ? '1' : '0'}
              data-created-at={item.createdAt || ''}
              data-date-from={item.dateFrom || ''}
              data-urgent={item.urgency ? '1' : '0'}
              data-urgency={item.urgency || ''}
              data-name={item.name.toLowerCase()}
              data-phone={(item.phone || '').replace(/\D/g, '')}
            >
              <div class="stack record-main">
                <h3>{item.name}</h3>
                <div class="actions record-tags">
                  <span class={`type-pill ${item.kind}`}>{item.kind === 'booking' ? 'BOOKING' : 'LEAD'}</span>
                  {item.channel && <span class={`channel-pill ${channelBadgeClass(item.channel)}`}>{CHANNEL_PILL_LABELS[item.channel as typeof BOOKING_CHANNELS[number]] || item.channel}</span>}
                </div>
                {item.urgency && (
                  <span class={`record-urgency urgency-${item.urgency}`}>
                    <span class="urgency-dot"></span>{item.urgencyLabel}
                  </span>
                )}
                <span class="muted record-meta">
                  {item.avail && <span class={`avail-dot avail-${item.avail}`} title={item.avail === 'hard' ? 'Dates unavailable — hard conflict' : item.avail === 'soft' ? 'Other leads interested in these dates' : 'Dates available'}></span>}
                  {datesLabel(item)}{item.guests > 0 && <> · {item.guests} guests</>}
                  {item.kind === 'lead' && item.createdAt && <> · First contact: {shortDate(item.createdAt)}</>}
                </span>
                <span class={`amount ${item.balanceClass}`}>{item.balanceLabel}</span>
                <span class="next-action">Next: {item.nextAction}</span>
              </div>
              <div class="actions record-actions">
                <button type="button" class="status-badge-btn badge" data-status={item.status} style={`--pill-color:${STATUS_COLORS[normalizeStatus(item.status)]}`}>{STATUS_LABELS[normalizeStatus(item.status)]}</button>
                {item.phone && <a class="button whatsapp" href={`https://wa.me/${item.phone.replace(/\D/g,'')}`} target="_blank" rel="noopener" title="Open WhatsApp">💬</a>}
              </div>
            </div>
          ))}
          <div class="empty-state" id="no-filter-matches" style="display:none"><span aria-hidden="true">⌁</span><strong>Nothing in this view</strong><p>Try another filter or add a new lead.</p></div>
        </div>
      </div>

      <div class="card" id="completed-list-card" style="display:none">
        <div class="list" id="completed-list">
          {completedBookingItems.length === 0 && <div class="empty-state"><span aria-hidden="true">✓</span><strong>No completed stays yet</strong><p>Finished bookings will collect here.</p></div>}
          {completedBookingItems.map((item) => (
            <div
              class="row clickable-row"
              data-href={`/admin/bookings/${item.id}`}
              data-kind={item.kind}
              data-id={item.id}
              data-status={item.status}
              data-channel={item.channel || ''}
            >
              <div class="stack record-main">
                <h3>{item.name}</h3>
                <div class="actions record-tags">
                  <span class="type-pill booking">BOOKING</span>
                  {item.channel && <span class={`channel-pill ${channelBadgeClass(item.channel)}`}>{CHANNEL_PILL_LABELS[item.channel as typeof BOOKING_CHANNELS[number]] || item.channel}</span>}
                </div>
                <span class="muted record-meta">{datesLabel(item)}{item.guests > 0 && <> · {item.guests} guests</>}</span>
                <span class={`amount ${item.balanceClass}`}>{item.balanceLabel}</span>
              </div>
              <div class="actions record-actions">
                <button type="button" class="status-badge-btn badge" data-status={item.status} style={`--pill-color:${STATUS_COLORS[normalizeStatus(item.status)]}`}>{STATUS_LABELS[normalizeStatus(item.status)]}</button>
                {item.phone && <a class="button whatsapp" href={`https://wa.me/${item.phone.replace(/\D/g,'')}`} target="_blank" rel="noopener" title="Open WhatsApp">💬</a>}
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="card" id="drinks-list-card" style="display:none">
        <div class="list">
          {drinksOrderItems.length === 0 && <div class="empty-state"><span aria-hidden="true">🍹</span><strong>No drinks orders</strong><p>Guest drink orders will appear here.</p></div>}
          {drinksOrderItems.map((order) => (
            <div class="row drinks-order-row" data-order-id={order.id} style="flex-direction:column;align-items:stretch;gap:6px">
              <div class="actions" style="justify-content:space-between">
                <div class="stack" style="gap:2px">
                  <strong>{order.guest_name}</strong>
                  {order.booking_id && <a href={`/admin/bookings/${order.booking_id}`} class="muted" style="font-size:12px">Booking: {order.booking_id}</a>}
                </div>
                <span class="badge" style={`--pill-color:${DRINKS_STATUS_COLORS[order.status] || '#6B7280'}`}>{order.status}</span>
              </div>
              <span class="muted">{shortDate(order.created_at)} · {pesos(order.total)} COP</span>
              <span class="muted" style="font-size:12px">Items: {order.parsedItems.map((i) => `${i.name} ×${i.qty}`).join(', ')}</span>
              {order.status !== 'delivered' && order.status !== 'cancelled' && (
                <button type="button" class="secondary drinks-mark-delivered" data-id={order.id} style="align-self:flex-start;margin-top:4px">Mark delivered ✓</button>
              )}
            </div>
          ))}
        </div>
      </div>
    </>
  )}

  <div class="status-popover" id="status-popover" hidden>
    <div id="status-popover-options"></div>
    <p class="field-error" id="status-popover-error" style="display:none"></p>
  </div>

  <dialog id="add-lead-dialog">
    <form method="POST" action="/admin/api/leads/create">
      <div class="actions" style="justify-content:space-between;margin-bottom:14px">
        <h2 style="margin:0">Add lead</h2>
        <button type="button" class="secondary" data-close-dialog>Close</button>
      </div>
      <div class="form-grid">
        <label>Name<input name="guest_name" required /></label>
        <label>WhatsApp<input name="whatsapp" type="tel" required placeholder="+57 300 000 0000" /></label>
        <label>Email<input name="email" type="email" /></label>
        <label>Type
          <select name="experience_type" id="lead-type-select">
            <option value="daytrip">Day Trip</option>
            <option value="stay">Stay</option>
          </select>
        </label>
        <label>Guest intent
          <select name="guest_intent">
            <option value="">—</option>
            {GUEST_INTENTS.map((intent) => <option value={intent.value}>{intent.label}</option>)}
          </select>
        </label>
        <label>Check-in<input name="date_from" type="date" id="lead-date-from" /></label>
        <label id="checkout-label">Checkout<input name="date_to" type="date" id="lead-date-to" /></label>
        <div class="span-2 field-error" id="lead-date-error" style="display:none">Check-out must be after check-in</div>
        <label>Adults<input name="adults" type="number" min="1" value="2" /></label>
        <label>Children<input name="children" type="number" min="0" value="0" /></label>
        <label class="span-2">Notes<textarea name="notes" placeholder="What were they asking about?"></textarea></label>
      </div>
      <div class="actions" style="justify-content:flex-end;margin-top:16px">
        <button type="button" class="secondary" data-close-dialog>Cancel</button>
        <button type="submit" id="add-lead-save-btn">Add lead</button>
      </div>
    </form>
  </dialog>
</AdminLayout>

<script define:vars={{ STATUS_LABELS, STATUS_COLORS, DIRECT_PIPELINE, AIRBNB_PIPELINE, LEAD_PIPELINE }}>
  document.querySelectorAll('.clickable-row').forEach((row) => {
    row.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a, button')) return;
      const href = row.getAttribute('data-href');
      if (href) window.location.href = href;
    });
  });

  const filterBar = document.getElementById('filter-bar');
  const listRows = document.querySelectorAll('#unified-list .clickable-row');
  const noMatches = document.getElementById('no-filter-matches');
  const unifiedListCard = document.getElementById('unified-list-card');
  const drinksListCard = document.getElementById('drinks-list-card');
  const completedListCard = document.getElementById('completed-list-card');
  const leadsSortToggle = document.getElementById('leads-sort-toggle');
  const unifiedList = document.getElementById('unified-list');

  const LEADS_SORT_KEY = 'admin-leads-sort';
  function getLeadsSort() {
    return localStorage.getItem(LEADS_SORT_KEY) === 'checkin' ? 'checkin' : 'created';
  }
  // Urgent cards (red/amber dot) always float to the top of the list,
  // regardless of kind — the server already ordered them that way, but this
  // toggle's re-sort (below) moves lead rows around, so re-promote urgent
  // rows after every re-sort to keep them pinned above everything else.
  function promoteUrgentRows() {
    if (!unifiedList) return;
    const urgentRows = Array.from(unifiedList.querySelectorAll('.clickable-row[data-urgent="1"]'));
    const frag = document.createDocumentFragment();
    urgentRows.forEach((row) => frag.appendChild(row));
    unifiedList.insertBefore(frag, unifiedList.firstChild);
  }
  function sortLeadRows(mode) {
    if (!unifiedList) return;
    // Sort ALL lead rows (urgent and non-urgent) so the toggle is always
    // meaningful. promoteUrgentRows() keeps urgent leads at the top, but
    // within that tier they now respect the user's chosen sort order.
    const leadRows = Array.from(unifiedList.querySelectorAll('.clickable-row[data-kind="lead"]'));
    leadRows.sort((a, b) => {
      if (mode === 'checkin') {
        const aDate = a.dataset.dateFrom || '';
        const bDate = b.dataset.dateFrom || '';
        if (!aDate && !bDate) return 0;
        if (!aDate) return 1;
        if (!bDate) return -1;
        return aDate < bDate ? -1 : aDate > bDate ? 1 : 0;
      }
      const aCreated = a.dataset.createdAt || '';
      const bCreated = b.dataset.createdAt || '';
      return aCreated < bCreated ? 1 : aCreated > bCreated ? -1 : 0;
    });
    leadRows.forEach((row) => unifiedList.appendChild(row));
    promoteUrgentRows();
  }
  function setLeadsSortUI(mode) {
    leadsSortToggle?.querySelectorAll('button[data-sort]').forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.sort === mode);
    });
  }
  leadsSortToggle?.querySelectorAll('button[data-sort]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.sort;
      localStorage.setItem(LEADS_SORT_KEY, mode);
      setLeadsSortUI(mode);
      sortLeadRows(mode);
    });
  });
  setLeadsSortUI(getLeadsSort());
  sortLeadRows(getLeadsSort());

  function applyFilter(filter) {
    if (filter === 'drinks') {
      if (unifiedListCard) unifiedListCard.style.display = 'none';
      if (drinksListCard) drinksListCard.style.display = '';
      if (completedListCard) completedListCard.style.display = 'none';
      if (leadsSortToggle) leadsSortToggle.style.display = 'none';
      return;
    }
    if (filter === 'completed') {
      if (unifiedListCard) unifiedListCard.style.display = 'none';
      if (drinksListCard) drinksListCard.style.display = 'none';
      if (completedListCard) completedListCard.style.display = '';
      if (leadsSortToggle) leadsSortToggle.style.display = 'none';
      return;
    }
    if (unifiedListCard) unifiedListCard.style.display = '';
    if (drinksListCard) drinksListCard.style.display = 'none';
    if (completedListCard) completedListCard.style.display = 'none';
    if (leadsSortToggle) leadsSortToggle.style.display = filter === 'leads' ? '' : 'none';
    let visibleCount = 0;
    listRows.forEach((row) => {
      const kind = row.dataset.kind;
      const status = row.dataset.status;
      const upcoming = row.dataset.upcoming === '1';
      let show = true;
      if (filter === 'all') show = true;
      else if (filter === 'followup') show = row.dataset.urgent === '1';
      else if (filter === 'bookings') show = kind === 'booking';
      else if (filter === 'leads') show = kind === 'lead';
      else if (filter === 'deposit') show = status === 'deposit_requested';
      else if (filter === 'inhouse') show = status === 'in_house' || status === 'checked_in';
      else if (filter === 'upcoming') show = kind === 'booking' && upcoming;
      row.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });
    if (noMatches) noMatches.style.display = visibleCount === 0 ? '' : 'none';
  }
  // ── Search ────────────────────────────────────────────────────────────────
  const searchInput = document.getElementById('list-search');
  let activeFilter = 'followup';

  function applySearchOverlay() {
    const raw = (searchInput?.value || '').trim().toLowerCase();
    if (!raw) return; // nothing to hide — applyFilter already set visibility
    const digits = raw.replace(/\D/g, '');
    let anyVisible = false;
    listRows.forEach((row) => {
      if (row.style.display === 'none') return; // already hidden by filter
      const nameMatch = (row.dataset.name || '').includes(raw);
      const phoneMatch = digits.length >= 3 && (row.dataset.phone || '').includes(digits);
      if (!nameMatch && !phoneMatch) { row.style.display = 'none'; return; }
      anyVisible = true;
    });
    if (noMatches) noMatches.style.display = anyVisible ? 'none' : '';
  }

  const _origApplyFilter = applyFilter;
  function applyFilterWithSearch(filter) {
    activeFilter = filter;
    _origApplyFilter(filter);
    applySearchOverlay();
  }

  searchInput?.addEventListener('input', () => applyFilterWithSearch(activeFilter));

  filterBar?.querySelectorAll('a[data-filter]').forEach((pill) => {
    pill.addEventListener('click', (event) => {
      event.preventDefault();
      filterBar.querySelectorAll('a[data-filter]').forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      filterBar.querySelectorAll('a[data-filter]').forEach((p) => p.removeAttribute('aria-current'));
      pill.setAttribute('aria-current', 'page');
      applyFilterWithSearch(pill.dataset.filter || 'followup');
    });
  });
  applyFilterWithSearch('followup');

  // Only show the trailing scroll fade on #filter-bar when there's actually
  // more to scroll to — avoids implying hidden content when everything fits.
  function updateFilterBarFade() {
    if (!filterBar) return;
    const hasMore = filterBar.scrollWidth - filterBar.clientWidth - filterBar.scrollLeft > 4;
    filterBar.classList.toggle('has-scroll-fade', hasMore);
  }
  filterBar?.addEventListener('scroll', updateFilterBarFade);
  window.addEventListener('resize', updateFilterBarFade);
  updateFilterBarFade();

  document.querySelectorAll('.drinks-mark-delivered').forEach((btn) => {
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      try {
        const res = await fetch(`/admin/api/drinks-orders/${btn.dataset.id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: 'delivered' }),
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error();
        window.location.reload();
      } catch {
        btn.disabled = false;
      }
    });
  });

  // ---- Status popover (tap a row's status badge to change it inline) ----
  function pipelineFor(kind, channel) {
    if (kind === 'lead') return LEAD_PIPELINE;
    return channel === 'airbnb' ? AIRBNB_PIPELINE : DIRECT_PIPELINE;
  }
  const popover = document.getElementById('status-popover');
  const popoverOptions = document.getElementById('status-popover-options');
  const popoverError = document.getElementById('status-popover-error');
  function closePopover() { popover.hidden = true; }
  function openPopover(btn) {
    const row = btn.closest('.clickable-row');
    const kind = row.dataset.kind;
    const channel = row.dataset.channel;
    const id = row.dataset.id;
    const currentStatus = row.dataset.status === 'checked_in' ? 'in_house' : row.dataset.status;
    popoverOptions.innerHTML = '';
    popoverError.style.display = 'none';
    pipelineFor(kind, channel).forEach((status) => {
      const opt = document.createElement('button');
      opt.type = 'button';
      opt.className = 'status-pill' + (status === currentStatus ? ' active' : '');
      opt.dataset.status = status;
      opt.style.setProperty('--pill-color', STATUS_COLORS[status]);
      opt.textContent = STATUS_LABELS[status];
      opt.addEventListener('click', async (e) => {
        e.stopPropagation();
        const url = kind === 'lead' ? `/admin/api/leads/${id}/status` : `/admin/api/bookings/${id}/status`;
        try {
          const res = await fetch(url, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status }) });
          const data = await res.json();
          if (!res.ok || !data.success) throw new Error();
          row.dataset.status = status;
          btn.dataset.status = status;
          btn.style.setProperty('--pill-color', STATUS_COLORS[status]);
          btn.textContent = STATUS_LABELS[status];
          closePopover();
        } catch {
          popoverError.textContent = 'Could not update status.';
          popoverError.style.display = '';
        }
      });
      popoverOptions.appendChild(opt);
    });
    const rect = btn.getBoundingClientRect();
    popover.style.top = `${rect.bottom + window.scrollY + 6}px`;
    popover.style.left = `${Math.max(8, Math.min(rect.left + window.scrollX, window.innerWidth - 232))}px`;
    popover.hidden = false;
  }
  document.querySelectorAll('.status-badge-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!popover.hidden && popover.dataset.forBtn === btn.dataset.status + btn.closest('.clickable-row').dataset.id) {
        closePopover();
        return;
      }
      popover.dataset.forBtn = btn.dataset.status + btn.closest('.clickable-row').dataset.id;
      openPopover(btn);
    });
  });
  document.addEventListener('click', (e) => {
    if (!popover.hidden && !popover.contains(e.target)) closePopover();
  });

  const dialog = document.getElementById('add-lead-dialog');
  document.getElementById('open-add-lead')?.addEventListener('click', () => {
    if (dialog instanceof HTMLDialogElement) dialog.showModal();
  });
  dialog?.querySelectorAll('[data-close-dialog]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });
  });

  const typeSelect = document.getElementById('lead-type-select');
  const checkoutLabel = document.getElementById('checkout-label');
  const syncCheckout = () => {
    if (checkoutLabel) checkoutLabel.style.display = typeSelect && 'value' in typeSelect && typeSelect.value === 'stay' ? '' : 'none';
  };
  typeSelect?.addEventListener('change', syncCheckout);
  syncCheckout();

  if (new URLSearchParams(window.location.search).get('leadError') && dialog instanceof HTMLDialogElement) {
    dialog.showModal();
  }

  function wireDateValidation(checkinId, checkoutId, errorId, submitId) {
    const checkin = document.getElementById(checkinId);
    const checkout = document.getElementById(checkoutId);
    const error = document.getElementById(errorId);
    const submit = document.getElementById(submitId);
    if (!checkin || !checkout) return;

    function addDay(dateStr) {
      const d = new Date(`${dateStr}T00:00:00Z`);
      d.setUTCDate(d.getUTCDate() + 1);
      return d.toISOString().slice(0, 10);
    }
    function isInvalid() {
      return !!(checkin.value && checkout.value && checkout.value <= checkin.value);
    }
    function refresh() {
      const invalid = isInvalid();
      if (error) error.style.display = invalid ? '' : 'none';
      if (submit) submit.disabled = invalid;
    }

    checkin.addEventListener('change', () => {
      checkout.min = checkin.value ? addDay(checkin.value) : '';
      if (isInvalid()) checkout.value = '';
      refresh();
    });
    checkout.addEventListener('change', refresh);

    if (checkin.value) checkout.min = addDay(checkin.value);
    refresh();
  }

  wireDateValidation('lead-date-from', 'lead-date-to', 'lead-date-error', 'add-lead-save-btn');

  // Auto-reload every 2 minutes so new leads appear without a manual refresh.
  // Skipped if the status popover is open (mid-action) or the add-lead dialog is open.
  let autoRefreshTimer = setTimeout(function tick() {
    const popoverOpen = !document.getElementById('status-popover')?.hidden;
    const dialogOpen = document.getElementById('add-lead-dialog')?.hasAttribute('open');
    if (!popoverOpen && !dialogOpen) { window.location.reload(); return; }
    autoRefreshTimer = setTimeout(tick, 30_000);
  }, 120_000);

  const syncBtn = document.getElementById('sync-hosthub-btn');
  const syncBtnIcon = syncBtn?.querySelector('.btn-icon');
  const syncBtnLabel = syncBtn?.querySelector('.btn-label');
  const syncFeedback = document.getElementById('sync-feedback');
  const syncSkeleton = document.getElementById('sync-skeleton');
  const visibleList = document.getElementById('unified-list');
  syncBtn?.addEventListener('click', async () => {
    if (!(syncBtn instanceof HTMLButtonElement)) return;
    syncBtn.disabled = true;
    const originalIcon = syncBtnIcon?.textContent;
    const originalLabel = syncBtnLabel?.textContent;
    if (syncBtnIcon) syncBtnIcon.textContent = '⏳';
    if (syncBtnLabel) syncBtnLabel.textContent = 'Syncing…';
    if (syncFeedback) syncFeedback.textContent = '';
    if (syncSkeleton) syncSkeleton.hidden = false;
    if (visibleList) { visibleList.style.display = 'none'; visibleList.setAttribute('aria-busy', 'true'); }
    try {
      const res = await fetch('/admin/api/sync-hosthub');
      const data = await res.json();
      if (syncFeedback) {
        syncFeedback.textContent = data.success
          ? ` · Synced — ${data.result.inserted} new, ${data.result.updated} updated`
          : ' · Sync failed';
      }
      if (data.success) setTimeout(() => window.location.reload(), 1200);
    } catch {
      if (syncFeedback) syncFeedback.textContent = ' · Sync failed';
    } finally {
      syncBtn.disabled = false;
      if (syncSkeleton) syncSkeleton.hidden = true;
      if (visibleList) { visibleList.style.display = ''; visibleList.removeAttribute('aria-busy'); }
      if (syncBtnIcon && originalIcon != null) syncBtnIcon.textContent = originalIcon;
      if (syncBtnLabel && originalLabel != null) syncBtnLabel.textContent = originalLabel;
    }
  });
</script>

<style>
  .dashboard-intro { margin-bottom:12px; }
  .sync-line { margin:-6px 0 16px; font-size:12px; }
  #sync-feedback:not(:empty) { display:inline-flex; margin-left:6px; padding:3px 8px; border-radius:999px; background:#e4f3ee; color:#17614f; font-weight:750; }
  .summary-line { font-weight:750; margin:0 0 18px; color:var(--label); font-variant-numeric:tabular-nums; }
  .sales-today { margin:16px 0; border:1px solid var(--line); border-radius:14px; padding:16px; background:var(--surface); box-shadow:var(--shadow); }
  .sales-today-head { display:flex; align-items:baseline; justify-content:space-between; }
  .sales-today-head h2 { margin:0 0 12px; }
  .today-metrics { display:flex; gap:8px; overflow-x:auto; padding-bottom:4px; scrollbar-width:none; }
  .today-metrics > div { min-width:118px; display:grid; gap:2px; border-radius:10px; padding:10px 12px; background:var(--surface-soft); }
  .today-metrics strong { color:var(--muted); font-size:18px; white-space:nowrap; font-variant-numeric:tabular-nums; }
  .today-metrics span { color:var(--muted); font-size:11px; font-weight:700; }
  .today-metrics > div[data-warn="1"] strong { color:var(--red); }
  .today-metrics > div[data-warn="1"] span { color:color-mix(in srgb,var(--red) 65%,var(--muted)); }
  .arrivals-card { margin:16px 0; border-left:5px solid var(--mint); }
  .arrival-row { min-height:52px; display:flex; align-items:center; justify-content:space-between; gap:12px; border-top:1px solid var(--line); color:var(--ink); text-decoration:none; }
  .arrival-row:first-of-type { border-top:0; }
  .record-urgency { order:2; display:flex; align-items:center; gap:6px; font-size:12px; font-weight:700; }
  .urgency-dot { flex-shrink:0; width:8px; height:8px; border-radius:50%; }
  .record-urgency.urgency-red { color:#B91C1C; }
  .record-urgency.urgency-red .urgency-dot { background:#EF4444; }
  .record-urgency.urgency-amber { color:#92400E; }
  .record-urgency.urgency-amber .urgency-dot { background:#F59E0B; }
  .amount.positive { color:#166534; }
  .amount.negative { color:var(--red); }
  #filter-bar { position:sticky; top:62px; z-index:20; margin:0 -8px 16px; padding:10px 8px; background:color-mix(in srgb,var(--bg) 94%,transparent); backdrop-filter:blur(10px); }
  .avail-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:5px; vertical-align:middle; }
  .avail-dot.avail-clear { background:#22C55E; }
  .avail-dot.avail-soft { background:#F59E0B; }
  .avail-dot.avail-hard { background:#EF4444; }
  .leads-sort-toggle { display:flex; align-items:center; gap:8px; margin:-10px 0 10px; }
