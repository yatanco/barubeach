---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db';
import {
  money, shortDate, timeAgo, GUEST_INTENTS, channelBadgeClass, CHANNEL_PILL_LABELS, BOOKING_CHANNELS,
  STATUS_LABELS, STATUS_COLORS, DIRECT_PIPELINE, AIRBNB_PIPELINE, normalizeStatus,
} from '../../lib/crm';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');

interface BookingRow {
  id: string; guest_name: string; guest_phone: string | null; date_from: string; date_to: string;
  adults: number; children: number; status: string; channel: string;
  food_amount: number; food_confirmed: number; transport_amount: number; transport_confirmed: number;
  accommodation_cents: number; paid_cents: number;
}
interface LeadRow {
  id: string; guest_name: string | null; whatsapp: string | null; date_from: string | null; date_to: string | null;
  adults: number; children: number; status: string; created_at: string;
  accommodation_amount: number; food_amount: number; food_confirmed: number; transport_amount: number; transport_confirmed: number;
  paid_cents: number;
}
interface SyncLogRow {
  synced_at: string; processed: number; inserted: number; updated: number; skipped: number; error: string | null;
}
interface DrinksOrderRow {
  id: number; booking_id: string | null; guest_name: string; items: string; total: number; status: string; created_at: string;
}
interface ListItem {
  kind: 'booking' | 'lead';
  id: string;
  name: string;
  dateFrom: string | null;
  dateTo: string | null;
  guests: number;
  status: string;
  phone: string | null;
  balanceLabel: string;
  balanceClass: string;
  isUpcoming: boolean;
  channel: string | null;
}

const BOOKING_SELECT = `SELECT b.id, b.guest_name, b.guest_phone, b.date_from, b.date_to, b.adults, b.children, b.status, b.channel,
    b.food_amount, b.food_confirmed, b.transport_amount, b.transport_confirmed,
    COALESCE((SELECT amount_cents FROM charges WHERE booking_id = b.id AND category = 'accommodation' LIMIT 1), 0) AS accommodation_cents,
    COALESCE((SELECT SUM(p.amount_cents) FROM payments p JOIN charges c ON c.id = p.charge_id WHERE c.booking_id = b.id), 0) AS paid_cents
  FROM bookings b WHERE b.status NOT IN ('cancelled','completed')`;
const LEAD_SELECT = `SELECT id, guest_name, whatsapp, date_from, date_to, adults, children, status, created_at,
    accommodation_amount, food_amount, food_confirmed, transport_amount, transport_confirmed,
    COALESCE((SELECT SUM(p.amount_cents) FROM payments p JOIN charges c ON c.id = p.charge_id WHERE c.lead_id = leads.id), 0) AS paid_cents
  FROM leads WHERE status NOT IN ('lost','cancelled','completed') AND NOT EXISTS (SELECT 1 FROM bookings WHERE bookings.lead_id = leads.id)`;

const db = getDb(Astro.locals);
let bookings: BookingRow[] = [];
let leadsWithDates: LeadRow[] = [];
let leadsWithoutDates: LeadRow[] = [];
let newLeadsCount = 0;
let weekLeadsCount = 0;
let outstandingCents = 0;
let arrivalsThisWeek = 0;
let inHouseCount = 0;
let lastSync: SyncLogRow | null = null;
let drinksOrders: DrinksOrderRow[] = [];
let error = '';

const now = new Date();
const todayStr = now.toISOString().slice(0, 10);
const upcomingBoundStr = new Date(now.getTime() + 14 * 86_400_000).toISOString().slice(0, 10);
const weekBoundStr = new Date(now.getTime() + 7 * 86_400_000).toISOString().slice(0, 10);

if (!db) {
  error = 'D1 is not configured yet. Bind the database as DB and run the migration.';
} else {
  try {
    const [
      bookingResult, leadsWithDatesResult, leadsWithoutDatesResult,
      newCountResult, weekCountResult, outstandingResult, arrivalsResult, inHouseResult, lastSyncResult,
    ] = await Promise.all([
      db.prepare(`${BOOKING_SELECT} ORDER BY b.date_from ASC`).all<BookingRow>(),
      db.prepare(`${LEAD_SELECT} AND date_from IS NOT NULL ORDER BY date_from ASC`).all<LeadRow>(),
      db.prepare(`${LEAD_SELECT} AND date_from IS NULL ORDER BY created_at DESC`).all<LeadRow>(),
      db.prepare(`SELECT COUNT(*) AS count FROM leads WHERE status = 'new'`).first<{ count: number }>(),
      db.prepare(`SELECT COUNT(*) AS count FROM leads WHERE created_at >= datetime('now', '-7 days')`).first<{ count: number }>(),
      db.prepare(`WITH booking_totals AS (
        SELECT b.id,
          (CASE WHEN b.channel = 'airbnb' THEN 0 ELSE COALESCE((SELECT amount_cents FROM charges WHERE booking_id = b.id AND category = 'accommodation' LIMIT 1), 0) END)
            + (CASE WHEN b.food_confirmed THEN b.food_amount ELSE 0 END)
            + (CASE WHEN b.transport_confirmed THEN b.transport_amount ELSE 0 END) AS total_cents,
          COALESCE((SELECT SUM(p.amount_cents) FROM payments p JOIN charges c ON c.id = p.charge_id WHERE c.booking_id = b.id), 0) AS paid_cents
        FROM bookings b WHERE b.status != 'cancelled'
      ) SELECT COALESCE(SUM(MAX(total_cents - paid_cents, 0)), 0) AS outstanding FROM booking_totals`).first<{ outstanding: number }>(),
      db.prepare(`SELECT COUNT(*) AS count FROM bookings WHERE date_from BETWEEN date('now') AND date('now', '+7 days') AND status != 'cancelled'`).first<{ count: number }>(),
      db.prepare(`SELECT COUNT(*) AS count FROM bookings WHERE date_from <= date('now') AND date_to >= date('now') AND status IN ('in_house','checked_in')`).first<{ count: number }>(),
      db.prepare(`SELECT synced_at, processed, inserted, updated, skipped, error FROM sync_log ORDER BY synced_at DESC LIMIT 1`).first<SyncLogRow>(),
    ]);
    bookings = bookingResult.results;
    leadsWithDates = leadsWithDatesResult.results;
    leadsWithoutDates = leadsWithoutDatesResult.results;
    newLeadsCount = newCountResult?.count ?? 0;
    weekLeadsCount = weekCountResult?.count ?? 0;
    outstandingCents = outstandingResult?.outstanding ?? 0;
    arrivalsThisWeek = arrivalsResult?.count ?? 0;
    inHouseCount = inHouseResult?.count ?? 0;
    lastSync = lastSyncResult ?? null;
  } catch (cause) {
    console.error('[admin] failed to load CRM', cause);
    error = 'The CRM database could not be read. Confirm that migrations 0001_crm.sql through 0010 have run.';
  }

  // Isolated from the query batch above: drinks_orders is a newer table
  // (migration 0011) that may not exist yet in every environment — a missing
  // table here should hide the Drinks tab, not take down the whole dashboard.
  try {
    const drinksOrdersResult = await db.prepare(
      `SELECT id, booking_id, guest_name, items, total, status, created_at FROM drinks_orders WHERE status != 'cancelled' ORDER BY created_at DESC`,
    ).all<DrinksOrderRow>();
    drinksOrders = drinksOrdersResult.results;
  } catch (cause) {
    console.error('[admin] failed to load drinks orders', cause);
  }
}

function bookingToItem(b: BookingRow): ListItem {
  const totalCents = (b.channel === 'airbnb' ? 0 : b.accommodation_cents)
    + (b.food_confirmed ? b.food_amount : 0)
    + (b.transport_confirmed ? b.transport_amount : 0);
  const balance = totalCents - b.paid_cents;
  const from = b.date_from.slice(0, 10);
  return {
    kind: 'booking', id: b.id, name: b.guest_name, dateFrom: b.date_from, dateTo: b.date_to,
    guests: b.adults + b.children, status: b.status, phone: b.guest_phone,
    balanceLabel: totalCents <= 0 ? '—' : balance > 0 ? `Balance: ${money(balance)}` : 'Paid ✓',
    balanceClass: totalCents > 0 && balance <= 0 ? 'positive' : balance > 0 ? 'negative' : '',
    isUpcoming: from >= todayStr && from <= upcomingBoundStr,
    channel: b.channel,
  };
}
function leadToItem(lead: LeadRow): ListItem {
  const totalCents = lead.accommodation_amount + (lead.food_confirmed ? lead.food_amount : 0) + (lead.transport_confirmed ? lead.transport_amount : 0);
  const balance = totalCents - lead.paid_cents;
  const from = lead.date_from ? lead.date_from.slice(0, 10) : null;
  return {
    kind: 'lead', id: lead.id, name: lead.guest_name || 'Unnamed inquiry', dateFrom: lead.date_from, dateTo: lead.date_to,
    guests: lead.adults + lead.children, status: lead.status, phone: lead.whatsapp,
    balanceLabel: totalCents <= 0 ? '—' : balance > 0 ? `Balance: ${money(balance)}` : 'Paid ✓',
    balanceClass: totalCents > 0 && balance <= 0 ? 'positive' : balance > 0 ? 'negative' : '',
    isUpcoming: !!from && from >= todayStr && from <= upcomingBoundStr,
    channel: null,
  };
}
function datesLabel(item: ListItem): string {
  if (item.dateFrom && item.dateTo) return `${shortDate(item.dateFrom)} → ${shortDate(item.dateTo)}`;
  if (item.dateFrom) return shortDate(item.dateFrom);
  return 'No dates yet';
}

const items: ListItem[] = [
  ...bookings.map(bookingToItem),
  ...leadsWithDates.map(leadToItem),
  ...leadsWithoutDates.map(leadToItem),
];
const weekArrivals = bookings.filter((booking) => {
  const from = booking.date_from.slice(0, 10);
  return from >= todayStr && from <= weekBoundStr;
});

const FILTERS = [
  { value: 'all', label: 'All' },
  { value: 'bookings', label: 'Bookings' },
  { value: 'leads', label: 'Leads' },
  { value: 'deposit', label: 'Deposit Pending' },
  { value: 'inhouse', label: 'In House' },
  { value: 'upcoming', label: 'Upcoming' },
  { value: 'drinks', label: '🍹 Drinks' },
] as const;

// drinks_orders.total / items[].price are stored as plain COP pesos, not
// cents like the rest of this schema — format directly rather than money().
function pesos(amount: number): string {
  return `$${Math.round(amount).toLocaleString('es-CO')}`;
}
const drinksOrderItems = drinksOrders.map((order) => ({
  ...order,
  parsedItems: JSON.parse(order.items) as { name: string; qty: number; price: number }[],
}));
const DRINKS_STATUS_COLORS: Record<string, string> = {
  pending: '#F59E0B',
  confirmed: '#3B82F6',
  delivered: '#22C55E',
  cancelled: '#6B7280',
};

const notice = Astro.url.searchParams.get('saved');
const leadAdded = Astro.url.searchParams.get('leadAdded');
const leadError = Astro.url.searchParams.get('leadError');
---
<AdminLayout title="Dashboard">
  <div class="actions dashboard-head" style="justify-content:space-between;margin-bottom:6px">
    <h1>Bookings & inquiries</h1>
    <div class="actions dashboard-tools">
      <button type="button" class="secondary" id="open-add-lead">Add Lead</button>
      <button type="button" class="secondary" id="sync-hosthub-btn">🔄 Sync HostHub</button>
    </div>
  </div>
  <p class="muted">Hosthub owns reservations. This dashboard owns follow-up, charges and payments.</p>
  <p class="muted" style="margin-top:-8px;font-size:12px">
    <span id="last-sync-info">Last sync: {lastSync ? `${timeAgo(lastSync.synced_at)} · ${lastSync.processed} reservations` : 'never'}</span>
    <span id="sync-feedback"></span>
  </p>
  {error && <div class="alert">{error}</div>}
  {notice && <div class="alert">Saved successfully.</div>}
  {leadAdded && <div class="alert">Lead added.</div>}
  {leadError && <div class="alert">{leadError}</div>}
  {!error && (
    <p class="summary-line">{newLeadsCount} new leads · {weekLeadsCount} this week · {arrivalsThisWeek} arrivals this week · {inHouseCount} in house · {money(outstandingCents)} outstanding</p>
  )}
  {!error && (
    <section class="card arrivals-card">
      <h2>Arriving this week</h2>
      {weekArrivals.length === 0 && <p class="muted">No arrivals in the next 7 days.</p>}
      {weekArrivals.map((booking) => (
        <a class="arrival-row" href={`/admin/bookings/${booking.id}`}>
          <strong>{shortDate(booking.date_from)} · {booking.guest_name}</strong>
          <span>{booking.adults + booking.children} guests →</span>
        </a>
      ))}
    </section>
  )}

  {!error && (
    <>
      <div class="pipeline" id="filter-bar">
        {FILTERS.map((f) => (
          <a href="#" data-filter={f.value} class={f.value === 'all' ? 'active' : ''}>{f.label}</a>
        ))}
      </div>

      <div class="card" id="unified-list-card">
        <div class="list" id="unified-list">
          {items.length === 0 && <p class="muted">Nothing to show yet.</p>}
          {items.map((item) => (
            <div
              class="row clickable-row"
              data-href={`/admin/${item.kind === 'booking' ? 'bookings' : 'leads'}/${item.id}`}
              data-kind={item.kind}
              data-id={item.id}
              data-status={item.status}
              data-channel={item.channel || ''}
              data-upcoming={item.isUpcoming ? '1' : '0'}
            >
              <div class="stack" style="min-width:0;flex:1">
                <div class="actions">
                  <span class={`type-pill ${item.kind}`}>{item.kind === 'booking' ? 'BOOKING' : 'LEAD'}</span>
                  {item.channel && <span class={`channel-pill ${channelBadgeClass(item.channel)}`}>{CHANNEL_PILL_LABELS[item.channel as typeof BOOKING_CHANNELS[number]] || item.channel}</span>}
                  <h3>{item.name}</h3>
                </div>
                <span class="muted">{datesLabel(item)}{item.guests > 0 && <> · {item.guests} guests</>}</span>
                <span class={`amount ${item.balanceClass}`}>{item.balanceLabel}</span>
              </div>
              <div class="actions" style="flex-shrink:0">
                <button type="button" class="status-badge-btn badge" data-status={item.status} style={`--pill-color:${STATUS_COLORS[normalizeStatus(item.status)]}`}>{STATUS_LABELS[normalizeStatus(item.status)]}</button>
                {item.phone && <a class="button whatsapp" href={`https://wa.me/${item.phone.replace(/\D/g,'')}`} target="_blank" rel="noopener" title="Open WhatsApp">💬</a>}
              </div>
            </div>
          ))}
          <p class="muted" id="no-filter-matches" style="display:none">No items match this filter.</p>
        </div>
      </div>

      <div class="card" id="drinks-list-card" style="display:none">
        <div class="list">
          {drinksOrderItems.length === 0 && <p class="muted">No drinks orders yet.</p>}
          {drinksOrderItems.map((order) => (
            <div class="row drinks-order-row" data-order-id={order.id} style="flex-direction:column;align-items:stretch;gap:6px">
              <div class="actions" style="justify-content:space-between">
                <div class="stack" style="gap:2px">
                  <strong>{order.guest_name}</strong>
                  {order.booking_id && <a href={`/admin/bookings/${order.booking_id}`} class="muted" style="font-size:12px">Booking: {order.booking_id}</a>}
                </div>
                <span class="badge" style={`--pill-color:${DRINKS_STATUS_COLORS[order.status] || '#6B7280'}`}>{order.status}</span>
              </div>
              <span class="muted">{shortDate(order.created_at)} · {pesos(order.total)} COP</span>
              <span class="muted" style="font-size:12px">Items: {order.parsedItems.map((i) => `${i.name} ×${i.qty}`).join(', ')}</span>
              {order.status !== 'delivered' && order.status !== 'cancelled' && (
                <button type="button" class="secondary drinks-mark-delivered" data-id={order.id} style="align-self:flex-start;margin-top:4px">Mark delivered ✓</button>
              )}
            </div>
          ))}
        </div>
      </div>
    </>
  )}

  <div class="status-popover" id="status-popover" hidden>
    <div id="status-popover-options"></div>
    <p class="field-error" id="status-popover-error" style="display:none"></p>
  </div>

  <dialog id="add-lead-dialog">
    <form method="POST" action="/admin/api/leads/create">
      <div class="actions" style="justify-content:space-between;margin-bottom:14px">
        <h2 style="margin:0">Add lead</h2>
        <button type="button" class="secondary" data-close-dialog>Close</button>
      </div>
      <div class="form-grid">
        <label>Name<input name="guest_name" required /></label>
        <label>WhatsApp<input name="whatsapp" type="tel" required placeholder="+57 300 000 0000" /></label>
        <label>Email<input name="email" type="email" /></label>
        <label>Type
          <select name="experience_type" id="lead-type-select">
            <option value="daytrip">Day Trip</option>
            <option value="stay">Stay</option>
          </select>
        </label>
        <label>Guest intent
          <select name="guest_intent">
            <option value="">—</option>
            {GUEST_INTENTS.map((intent) => <option value={intent.value}>{intent.label}</option>)}
          </select>
        </label>
        <label>Check-in<input name="date_from" type="date" id="lead-date-from" /></label>
        <label id="checkout-label">Checkout<input name="date_to" type="date" id="lead-date-to" /></label>
        <div class="span-2 field-error" id="lead-date-error" style="display:none">Check-out must be after check-in</div>
        <label>Adults<input name="adults" type="number" min="1" value="2" /></label>
        <label>Children<input name="children" type="number" min="0" value="0" /></label>
        <label class="span-2">Notes<textarea name="notes" placeholder="What were they asking about?"></textarea></label>
      </div>
      <div class="actions" style="justify-content:flex-end;margin-top:16px">
        <button type="button" class="secondary" data-close-dialog>Cancel</button>
        <button type="submit" id="add-lead-save-btn">Add lead</button>
      </div>
    </form>
  </dialog>
</AdminLayout>

<script define:vars={{ STATUS_LABELS, STATUS_COLORS, DIRECT_PIPELINE, AIRBNB_PIPELINE }}>
  document.querySelectorAll('.clickable-row').forEach((row) => {
    row.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a, button')) return;
      const href = row.getAttribute('data-href');
      if (href) window.location.href = href;
    });
  });

  const filterBar = document.getElementById('filter-bar');
  const listRows = document.querySelectorAll('#unified-list .clickable-row');
  const noMatches = document.getElementById('no-filter-matches');
  const unifiedListCard = document.getElementById('unified-list-card');
  const drinksListCard = document.getElementById('drinks-list-card');
  function applyFilter(filter) {
    if (filter === 'drinks') {
      if (unifiedListCard) unifiedListCard.style.display = 'none';
      if (drinksListCard) drinksListCard.style.display = '';
      return;
    }
    if (unifiedListCard) unifiedListCard.style.display = '';
    if (drinksListCard) drinksListCard.style.display = 'none';
    let visibleCount = 0;
    listRows.forEach((row) => {
      const kind = row.dataset.kind;
      const status = row.dataset.status;
      const upcoming = row.dataset.upcoming === '1';
      let show = true;
      if (filter === 'all') show = true;
      else if (filter === 'bookings') show = kind === 'booking';
      else if (filter === 'leads') show = kind === 'lead';
      else if (filter === 'deposit') show = status === 'deposit_requested';
      else if (filter === 'inhouse') show = status === 'in_house' || status === 'checked_in';
      else if (filter === 'upcoming') show = kind === 'booking' && upcoming;
      row.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });
    if (noMatches) noMatches.style.display = visibleCount === 0 ? '' : 'none';
  }
  filterBar?.querySelectorAll('a[data-filter]').forEach((pill) => {
    pill.addEventListener('click', (event) => {
      event.preventDefault();
      filterBar.querySelectorAll('a[data-filter]').forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      applyFilter(pill.dataset.filter || 'all');
    });
  });
  applyFilter('all');

  document.querySelectorAll('.drinks-mark-delivered').forEach((btn) => {
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      try {
        const res = await fetch(`/admin/api/drinks-orders/${btn.dataset.id}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: 'delivered' }),
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error();
        window.location.reload();
      } catch {
        btn.disabled = false;
      }
    });
  });

  // ---- Status popover (tap a row's status badge to change it inline) ----
  function pipelineFor(kind, channel) {
    if (kind === 'lead') return DIRECT_PIPELINE;
    return channel === 'airbnb' ? AIRBNB_PIPELINE : DIRECT_PIPELINE;
  }
  const popover = document.getElementById('status-popover');
  const popoverOptions = document.getElementById('status-popover-options');
  const popoverError = document.getElementById('status-popover-error');
  function closePopover() { popover.hidden = true; }
  function openPopover(btn) {
    const row = btn.closest('.clickable-row');
    const kind = row.dataset.kind;
    const channel = row.dataset.channel;
    const id = row.dataset.id;
    const currentStatus = row.dataset.status === 'checked_in' ? 'in_house' : row.dataset.status;
    popoverOptions.innerHTML = '';
    popoverError.style.display = 'none';
    pipelineFor(kind, channel).forEach((status) => {
      const opt = document.createElement('button');
      opt.type = 'button';
      opt.className = 'status-pill' + (status === currentStatus ? ' active' : '');
      opt.style.setProperty('--pill-color', STATUS_COLORS[status]);
      opt.textContent = STATUS_LABELS[status];
      opt.addEventListener('click', async (e) => {
        e.stopPropagation();
        const url = kind === 'lead' ? `/admin/api/leads/${id}/status` : `/admin/api/bookings/${id}/status`;
        try {
          const res = await fetch(url, { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ status }) });
          const data = await res.json();
          if (!res.ok || !data.success) throw new Error();
          row.dataset.status = status;
          btn.dataset.status = status;
          btn.style.setProperty('--pill-color', STATUS_COLORS[status]);
          btn.textContent = STATUS_LABELS[status];
          closePopover();
        } catch {
          popoverError.textContent = 'Could not update status.';
          popoverError.style.display = '';
        }
      });
      popoverOptions.appendChild(opt);
    });
    const rect = btn.getBoundingClientRect();
    popover.style.top = `${rect.bottom + window.scrollY + 6}px`;
    popover.style.left = `${Math.max(8, Math.min(rect.left + window.scrollX, window.innerWidth - 232))}px`;
    popover.hidden = false;
  }
  document.querySelectorAll('.status-badge-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!popover.hidden && popover.dataset.forBtn === btn.dataset.status + btn.closest('.clickable-row').dataset.id) {
        closePopover();
        return;
      }
      popover.dataset.forBtn = btn.dataset.status + btn.closest('.clickable-row').dataset.id;
      openPopover(btn);
    });
  });
  document.addEventListener('click', (e) => {
    if (!popover.hidden && !popover.contains(e.target)) closePopover();
  });

  const dialog = document.getElementById('add-lead-dialog');
  document.getElementById('open-add-lead')?.addEventListener('click', () => {
    if (dialog instanceof HTMLDialogElement) dialog.showModal();
  });
  dialog?.querySelectorAll('[data-close-dialog]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });
  });

  const typeSelect = document.getElementById('lead-type-select');
  const checkoutLabel = document.getElementById('checkout-label');
  const syncCheckout = () => {
    if (checkoutLabel) checkoutLabel.style.display = typeSelect && 'value' in typeSelect && typeSelect.value === 'stay' ? '' : 'none';
  };
  typeSelect?.addEventListener('change', syncCheckout);
  syncCheckout();

  if (new URLSearchParams(window.location.search).get('leadError') && dialog instanceof HTMLDialogElement) {
    dialog.showModal();
  }

  function wireDateValidation(checkinId, checkoutId, errorId, submitId) {
    const checkin = document.getElementById(checkinId);
    const checkout = document.getElementById(checkoutId);
    const error = document.getElementById(errorId);
    const submit = document.getElementById(submitId);
    if (!checkin || !checkout) return;

    function addDay(dateStr) {
      const d = new Date(`${dateStr}T00:00:00Z`);
      d.setUTCDate(d.getUTCDate() + 1);
      return d.toISOString().slice(0, 10);
    }
    function isInvalid() {
      return !!(checkin.value && checkout.value && checkout.value <= checkin.value);
    }
    function refresh() {
      const invalid = isInvalid();
      if (error) error.style.display = invalid ? '' : 'none';
      if (submit) submit.disabled = invalid;
    }

    checkin.addEventListener('change', () => {
      checkout.min = checkin.value ? addDay(checkin.value) : '';
      if (isInvalid()) checkout.value = '';
      refresh();
    });
    checkout.addEventListener('change', refresh);

    if (checkin.value) checkout.min = addDay(checkin.value);
    refresh();
  }

  wireDateValidation('lead-date-from', 'lead-date-to', 'lead-date-error', 'add-lead-save-btn');

  const syncBtn = document.getElementById('sync-hosthub-btn');
  const syncFeedback = document.getElementById('sync-feedback');
  syncBtn?.addEventListener('click', async () => {
    if (!(syncBtn instanceof HTMLButtonElement)) return;
    syncBtn.disabled = true;
    const original = syncBtn.textContent;
    syncBtn.textContent = '⏳ Syncing…';
    if (syncFeedback) syncFeedback.textContent = '';
    try {
      const res = await fetch('/admin/api/sync-hosthub');
      const data = await res.json();
      if (syncFeedback) {
        syncFeedback.textContent = data.success
          ? ` · Synced — ${data.result.inserted} new, ${data.result.updated} updated`
          : ' · Sync failed';
      }
      if (data.success) setTimeout(() => window.location.reload(), 1200);
    } catch {
      if (syncFeedback) syncFeedback.textContent = ' · Sync failed';
    } finally {
      syncBtn.disabled = false;
      syncBtn.textContent = original;
    }
  });
</script>

