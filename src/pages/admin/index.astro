---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db';
import {
  money, shortDate, timeAgo, isOneOf, PIPELINE_LABELS, GUEST_INTENTS, estimateLeadValue,
  LEAD_ACTION_LABELS, channelBadgeClass, BOOKING_CHANNEL_LABELS, BOOKING_CHANNELS, PIPELINE_STATUSES,
} from '../../lib/crm';

export const prerender = false;

interface AttentionLeadRow {
  id: string; guest_name: string | null; experience_type: string; date_from: string | null; date_to: string | null;
  adults: number; children: number; estimated_price: string | null; quote_total: number | null; quote_currency: string | null;
  status: string; whatsapp: string | null;
}
interface AttentionBookingRow {
  id: string; guest_name: string; date_from: string; date_to: string; outstanding_cents: number;
}
interface StayRow {
  id: string; guest_name: string; guest_phone: string | null; date_from: string; date_to: string; nights: number;
  channel: string; status: string; total_cents: number; paid_cents: number; has_food: number; has_transport: number;
}
interface LeadRow {
  id: string; created_at: string; status: string; experience_type: string;
  guest_name: string | null; whatsapp: string | null; date_from: string | null; date_to: string | null;
  adults: number; children: number; estimated_price: string | null; quote_total: number | null; quote_currency: string | null;
}
interface SyncLogRow {
  synced_at: string; processed: number; inserted: number; updated: number; skipped: number; error: string | null;
}
interface MonthSummaryRow {
  occupied_nights: number; revenue_cents: number; contribution_cents: number;
}

const db = getDb(Astro.locals);
let attentionLeads: AttentionLeadRow[] = [];
let attentionBookings: AttentionBookingRow[] = [];
let upcomingStays: StayRow[] = [];
let completedBookings: StayRow[] = [];
let leads: LeadRow[] = [];
let newLeadsCount = 0;
let weekLeadsCount = 0;
let outstandingCents = 0;
let arrivalsThisWeek = 0;
let inHouseCount = 0;
let lastSync: SyncLogRow | null = null;
let monthSummary: MonthSummaryRow = { occupied_nights: 0, revenue_cents: 0, contribution_cents: 0 };
let error = '';

const now = new Date();
const monthStart = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1));
const monthEnd = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() + 1, 1));
const monthStartStr = monthStart.toISOString().slice(0, 10);
const monthEndStr = monthEnd.toISOString().slice(0, 10);
const daysInMonth = Math.round((monthEnd.getTime() - monthStart.getTime()) / 86_400_000);

const LEADS_FILTERS = ['all', 'new', 'quoted', 'deposit', 'lost'] as const;
const filterParam = Astro.url.searchParams.get('leads');
const activeFilter = filterParam && isOneOf(filterParam, LEADS_FILTERS) ? filterParam : 'all';

if (!db) {
  error = 'D1 is not configured yet. Bind the database as DB and run the migration.';
} else {
  try {
    const leadsQuery = activeFilter === 'all'
      ? db.prepare(`SELECT id, created_at, status, experience_type, guest_name, whatsapp,
          date_from, date_to, adults, children, estimated_price, quote_total, quote_currency FROM leads ORDER BY created_at DESC LIMIT 200`)
      : db.prepare(`SELECT id, created_at, status, experience_type, guest_name, whatsapp,
          date_from, date_to, adults, children, estimated_price, quote_total, quote_currency FROM leads WHERE status = ?1 ORDER BY created_at DESC LIMIT 200`).bind(activeFilter);

    const [
      leadResult, attentionLeadResult, attentionBookingResult, upcomingResult, completedResult,
      newCountResult, weekCountResult, outstandingResult, arrivalsResult, inHouseResult, lastSyncResult, monthSummaryResult,
    ] = await Promise.all([
      leadsQuery.all<LeadRow>(),
      db.prepare(`SELECT id, guest_name, experience_type, date_from, date_to, adults, children,
          estimated_price, quote_total, quote_currency, status, whatsapp
        FROM leads WHERE status IN ('new','quoted','deposit_pending')
        ORDER BY CASE status WHEN 'deposit_pending' THEN 0 WHEN 'quoted' THEN 1 ELSE 2 END, created_at DESC`).all<AttentionLeadRow>(),
      db.prepare(`WITH booking_totals AS (
          SELECT b.id, b.guest_name, b.date_from, b.date_to,
            COALESCE((SELECT SUM(c.amount_cents) FROM charges c WHERE c.booking_id = b.id), 0) AS total_cents,
            COALESCE((SELECT SUM(p.amount_cents) FROM payments p JOIN charges c ON c.id = p.charge_id WHERE c.booking_id = b.id), 0) AS paid_cents
          FROM bookings b
          WHERE b.date_from BETWEEN date('now') AND date('now', '+7 days') AND b.status != 'cancelled'
        )
        SELECT id, guest_name, date_from, date_to, (total_cents - paid_cents) AS outstanding_cents
        FROM booking_totals WHERE (total_cents - paid_cents) > 0 ORDER BY date_from ASC`).all<AttentionBookingRow>(),
      db.prepare(`SELECT b.id, b.guest_name, b.guest_phone, b.date_from, b.date_to, b.nights, b.channel, b.status,
          COALESCE((SELECT SUM(c.amount_cents) FROM charges c WHERE c.booking_id = b.id), 0) AS total_cents,
          COALESCE((SELECT SUM(p.amount_cents) FROM payments p JOIN charges c ON c.id = p.charge_id WHERE c.booking_id = b.id), 0) AS paid_cents,
          EXISTS(SELECT 1 FROM charges c WHERE c.booking_id = b.id AND c.category = 'food' AND c.amount_cents > 0) AS has_food,
          EXISTS(SELECT 1 FROM charges c WHERE c.booking_id = b.id AND c.category = 'transport' AND c.amount_cents > 0) AS has_transport
        FROM bookings b
        WHERE b.date_from BETWEEN date('now') AND date('now', '+30 days') AND b.status NOT IN ('cancelled','completed')
        ORDER BY b.date_from ASC`).all<StayRow>(),
      db.prepare(`SELECT b.id, b.guest_name, b.guest_phone, b.date_from, b.date_to, b.nights, b.channel, b.status,
          COALESCE((SELECT SUM(c.amount_cents) FROM charges c WHERE c.booking_id = b.id), 0) AS total_cents,
          COALESCE((SELECT SUM(p.amount_cents) FROM payments p JOIN charges c ON c.id = p.charge_id WHERE c.booking_id = b.id), 0) AS paid_cents,
          EXISTS(SELECT 1 FROM charges c WHERE c.booking_id = b.id AND c.category = 'food' AND c.amount_cents > 0) AS has_food,
          EXISTS(SELECT 1 FROM charges c WHERE c.booking_id = b.id AND c.category = 'transport' AND c.amount_cents > 0) AS has_transport
        FROM bookings b
        WHERE b.status = 'completed'
        ORDER BY b.date_to DESC LIMIT 100`).all<StayRow>(),
      db.prepare(`SELECT COUNT(*) AS count FROM leads WHERE status = 'new'`).first<{ count: number }>(),
      db.prepare(`SELECT COUNT(*) AS count FROM leads WHERE created_at >= datetime('now', '-7 days')`).first<{ count: number }>(),
      db.prepare(`WITH booking_totals AS (
        SELECT b.id,
          COALESCE((SELECT SUM(c.amount_cents) FROM charges c WHERE c.booking_id = b.id), 0) AS total_cents,
          COALESCE((SELECT SUM(p.amount_cents) FROM payments p JOIN charges c ON c.id = p.charge_id WHERE c.booking_id = b.id), 0) AS paid_cents
        FROM bookings b
      ) SELECT COALESCE(SUM(MAX(total_cents - paid_cents, 0)), 0) AS outstanding FROM booking_totals`).first<{ outstanding: number }>(),
      db.prepare(`SELECT COUNT(*) AS count FROM bookings WHERE date_from BETWEEN date('now') AND date('now', '+7 days') AND status != 'cancelled'`).first<{ count: number }>(),
      db.prepare(`SELECT COUNT(*) AS count FROM bookings WHERE date_from <= date('now') AND date_to >= date('now') AND status = 'checked_in'`).first<{ count: number }>(),
      db.prepare(`SELECT synced_at, processed, inserted, updated, skipped, error FROM sync_log ORDER BY synced_at DESC LIMIT 1`).first<SyncLogRow>(),
      db.prepare(`SELECT
          COALESCE(SUM(MAX(0, CAST(JULIANDAY(MIN(SUBSTR(b.date_to,1,10), ?2)) - JULIANDAY(MAX(SUBSTR(b.date_from,1,10), ?1)) AS INTEGER))), 0) AS occupied_nights,
          COALESCE(SUM(COALESCE(rev.total_cents, 0)), 0) AS revenue_cents,
          COALESCE(SUM(COALESCE(rev.total_cents, 0) + COALESCE(b.airbnb_payout_cents, 0) - b.ota_commission_cents - b.cost_staff_cents - b.cost_food_cents - b.cost_transport_cents), 0) AS contribution_cents
        FROM bookings b
        LEFT JOIN (SELECT booking_id, SUM(amount_cents) AS total_cents FROM charges GROUP BY booking_id) rev ON rev.booking_id = b.id
        WHERE b.status != 'cancelled' AND SUBSTR(b.date_from,1,10) < ?2 AND SUBSTR(b.date_to,1,10) > ?1`)
        .bind(monthStartStr, monthEndStr).first<MonthSummaryRow>(),
    ]);
    leads = leadResult.results;
    attentionLeads = attentionLeadResult.results;
    attentionBookings = attentionBookingResult.results;
    upcomingStays = upcomingResult.results;
    completedBookings = completedResult.results;
    newLeadsCount = newCountResult?.count ?? 0;
    weekLeadsCount = weekCountResult?.count ?? 0;
    outstandingCents = outstandingResult?.outstanding ?? 0;
    arrivalsThisWeek = arrivalsResult?.count ?? 0;
    inHouseCount = inHouseResult?.count ?? 0;
    lastSync = lastSyncResult ?? null;
    monthSummary = monthSummaryResult ?? { occupied_nights: 0, revenue_cents: 0, contribution_cents: 0 };
  } catch (cause) {
    console.error('[admin] failed to load CRM', cause);
    error = 'The CRM database could not be read. Confirm that migrations 0001_crm.sql through 0008 have run.';
  }
}
const cpanCents = daysInMonth > 0 ? Math.round(monthSummary.contribution_cents / daysInMonth) : 0;
const statusLabel = (status: string) => (PIPELINE_LABELS as Record<string, string>)[status] || status;
const notice = Astro.url.searchParams.get('saved');
const leadAdded = Astro.url.searchParams.get('leadAdded');
const leadError = Astro.url.searchParams.get('leadError');
---
<AdminLayout title="Dashboard">
  <div class="actions" style="justify-content:space-between;margin-bottom:6px">
    <h1>Bookings & inquiries</h1>
    <div class="actions">
      <button type="button" class="secondary" id="open-add-lead">Add Lead</button>
      <a class="button secondary" href="/admin/api/export">Export CSV</a>
      <button type="button" class="secondary" id="sync-hosthub-btn">🔄 Sync HostHub</button>
    </div>
  </div>
  <p class="muted">Hosthub owns reservations. This dashboard owns follow-up, charges and payments.</p>
  <p class="muted" style="margin-top:-8px;font-size:12px">
    <span id="last-sync-info">Last sync: {lastSync ? `${timeAgo(lastSync.synced_at)} · ${lastSync.processed} reservations` : 'never'}</span>
    <span id="sync-feedback"></span>
  </p>
  {error && <div class="alert">{error}</div>}
  {notice && <div class="alert">Saved successfully.</div>}
  {leadAdded && <div class="alert">Lead added.</div>}
  {leadError && <div class="alert">{leadError}</div>}
  {!error && (
    <p class="summary-line">{newLeadsCount} new leads · {weekLeadsCount} this week · {arrivalsThisWeek} arrivals this week · {inHouseCount} in house · {money(outstandingCents)} outstanding</p>
  )}
  {!error && (
    <p class="summary-line month-summary">
      This month: {monthSummary.occupied_nights} nights occupied · {money(monthSummary.revenue_cents)} revenue · {money(monthSummary.contribution_cents)} contribution · {money(cpanCents)} CPAN
      <span class="info-tip" tabindex="0" title="Contribution per Available Night. Your north-star KPI — how much profit each available night generates on average.">ⓘ</span>
    </p>
  )}

  {!error && (attentionLeads.length > 0 || attentionBookings.length > 0) && (
    <>
      <p class="section-label">── Needs Attention ──</p>
      <div class="card" style="margin-bottom:28px">
        <div class="list">
          {attentionLeads.map((lead) => (
            <div class="row">
              <div class="stack">
                <div class="actions">
                  <h3>{lead.guest_name || 'Unnamed inquiry'}</h3>
                  <span class={`badge ${lead.status}`}>{statusLabel(lead.status)}</span>
                </div>
                <span class="muted">{lead.experience_type} · {shortDate(lead.date_from)}{lead.date_to ? ` → ${shortDate(lead.date_to)}` : ''} · {lead.adults + lead.children} guests</span>
                <span class="amount">{estimateLeadValue(lead)}</span>
              </div>
              <div class="actions">
                {lead.whatsapp && <a class="button whatsapp" href={`https://wa.me/${lead.whatsapp.replace(/\D/g,'')}`} target="_blank" rel="noopener">💬 WhatsApp</a>}
                <a class="button" href={`/admin/leads/${lead.id}`}>{LEAD_ACTION_LABELS[lead.status as typeof PIPELINE_STATUSES[number]] || 'Open'}</a>
              </div>
            </div>
          ))}
          {attentionBookings.map((booking) => (
            <div class="row">
              <div class="stack">
                <div class="actions"><h3>{booking.guest_name}</h3><span class="badge lost">Balance due</span></div>
                <span class="muted">{shortDate(booking.date_from)} → {shortDate(booking.date_to)}</span>
                <span class="amount negative">Outstanding: {money(booking.outstanding_cents)}</span>
              </div>
              <a class="button" href={`/admin/bookings/${booking.id}`}>Collect Balance</a>
            </div>
          ))}
        </div>
      </div>
    </>
  )}

  {!error && (
    <>
      <p class="section-label">── Upcoming Stays ──</p>
      {upcomingStays.length === 0 && <p class="muted" style="margin-bottom:28px">No stays in the next 30 days.</p>}
      {upcomingStays.length > 0 && (
        <div class="grid grid-2" style="margin-bottom:28px">
          {upcomingStays.map((stay) => {
            const balance = stay.total_cents - stay.paid_cents;
            return (
              <div class="card">
                <div class="actions" style="justify-content:space-between">
                  <h3>{stay.guest_name}</h3>
                  <div class="actions">
                    <span class={`badge ${channelBadgeClass(stay.channel)}`}>{BOOKING_CHANNEL_LABELS[stay.channel as typeof BOOKING_CHANNELS[number]] || stay.channel}</span>
                    <span class={`badge ${stay.status}`}>{stay.status.replace('_',' ')}</span>
                  </div>
                </div>
                <p class="muted" style="margin:6px 0">{shortDate(stay.date_from)} → {shortDate(stay.date_to)} · {stay.nights} nights</p>
                <p class="muted" style="margin:0 0 10px">Food: {stay.has_food ? '✓' : '—'} · Transport: {stay.has_transport ? '✓' : '—'}</p>
                <div class="actions" style="justify-content:space-between">
                  {balance > 0
                    ? <span class="amount negative">Balance: {money(balance)}</span>
                    : <span class="amount positive">Paid ✓</span>}
                  <a class="button secondary" href={`/admin/bookings/${stay.id}`}>Open</a>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </>
  )}

  {!error && (
    <>
      <p class="section-label">── All Leads ──</p>
      <div class="pipeline">
        {LEADS_FILTERS.map((f) => (
          <a href={f === 'all' ? '/admin' : `/admin?leads=${f}`} class={activeFilter === f ? 'active' : ''}>{f === 'all' ? 'All' : f.charAt(0).toUpperCase() + f.slice(1)}</a>
        ))}
      </div>
      {leads.length === 0 && <p class="muted">No leads captured yet.</p>}
      {leads.length > 0 && (
        <table>
          <thead>
            <tr><th>Name</th><th>Type</th><th>Dates</th><th>Guests</th><th>Est. Value</th><th>Status</th><th>WhatsApp</th></tr>
          </thead>
          <tbody>
            {leads.map((lead) => (
              <tr class="lead-row" data-href={`/admin/leads/${lead.id}`}>
                <td>{lead.guest_name || 'Unnamed inquiry'}</td>
                <td>{lead.experience_type}</td>
                <td>{shortDate(lead.date_from)}{lead.date_to ? ` → ${shortDate(lead.date_to)}` : ''}</td>
                <td>{lead.adults + lead.children}</td>
                <td>{estimateLeadValue(lead)}</td>
                <td><span class={`badge ${lead.status}`}>{statusLabel(lead.status)}</span></td>
                <td>
                  {lead.whatsapp
                    ? <a href={`https://wa.me/${lead.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener">{lead.whatsapp}</a>
                    : <span class="muted">—</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </>
  )}

  {!error && (
    <details style="margin-top:28px">
      <summary>Show completed bookings ({completedBookings.length}) ▼</summary>
      {completedBookings.length === 0 && <p class="muted" style="margin-top:12px">No completed bookings yet.</p>}
      {completedBookings.length > 0 && (
        <div class="grid grid-2" style="margin-top:14px">
          {completedBookings.map((stay) => {
            const balance = stay.total_cents - stay.paid_cents;
            return (
              <div class="card">
                <div class="actions" style="justify-content:space-between">
                  <h3>{stay.guest_name}</h3>
                  <span class={`badge ${channelBadgeClass(stay.channel)}`}>{BOOKING_CHANNEL_LABELS[stay.channel as typeof BOOKING_CHANNELS[number]] || stay.channel}</span>
                </div>
                <p class="muted" style="margin:6px 0">{shortDate(stay.date_from)} → {shortDate(stay.date_to)} · {stay.nights} nights</p>
                <div class="actions" style="justify-content:space-between">
                  {balance > 0
                    ? <span class="amount negative">Balance: {money(balance)}</span>
                    : <span class="amount positive">Paid ✓</span>}
                  <a class="button secondary" href={`/admin/bookings/${stay.id}`}>Open</a>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </details>
  )}

  <dialog id="add-lead-dialog">
    <form method="POST" action="/admin/api/leads/create">
      <div class="actions" style="justify-content:space-between;margin-bottom:14px">
        <h2 style="margin:0">Add lead</h2>
        <button type="button" class="secondary" data-close-dialog>Close</button>
      </div>
      <div class="form-grid">
        <label>Name<input name="guest_name" required /></label>
        <label>WhatsApp<input name="whatsapp" type="tel" required placeholder="+57 300 000 0000" /></label>
        <label>Email<input name="email" type="email" /></label>
        <label>Type
          <select name="experience_type" id="lead-type-select">
            <option value="daytrip">Day Trip</option>
            <option value="stay">Stay</option>
          </select>
        </label>
        <label>Guest intent
          <select name="guest_intent">
            <option value="">—</option>
            {GUEST_INTENTS.map((intent) => <option value={intent.value}>{intent.label}</option>)}
          </select>
        </label>
        <label>Check-in<input name="date_from" type="date" id="lead-date-from" /></label>
        <label id="checkout-label">Checkout<input name="date_to" type="date" id="lead-date-to" /></label>
        <div class="span-2 field-error" id="lead-date-error" style="display:none">Check-out must be after check-in</div>
        <label>Adults<input name="adults" type="number" min="1" value="2" /></label>
        <label>Children<input name="children" type="number" min="0" value="0" /></label>
        <label class="span-2">Notes<textarea name="notes" placeholder="What were they asking about?"></textarea></label>
      </div>
      <div class="actions" style="justify-content:flex-end;margin-top:16px">
        <button type="button" class="secondary" data-close-dialog>Cancel</button>
        <button type="submit" id="add-lead-save-btn">Add lead</button>
      </div>
    </form>
  </dialog>
</AdminLayout>

<script>
  document.querySelectorAll('tr.lead-row').forEach((row) => {
    row.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) return;
      const href = row.getAttribute('data-href');
      if (href) window.location.href = href;
    });
  });

  const dialog = document.getElementById('add-lead-dialog');
  document.getElementById('open-add-lead')?.addEventListener('click', () => {
    if (dialog instanceof HTMLDialogElement) dialog.showModal();
  });
  dialog?.querySelectorAll('[data-close-dialog]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });
  });

  const typeSelect = document.getElementById('lead-type-select');
  const checkoutLabel = document.getElementById('checkout-label');
  const syncCheckout = () => {
    if (checkoutLabel) checkoutLabel.style.display = typeSelect && 'value' in typeSelect && typeSelect.value === 'stay' ? '' : 'none';
  };
  typeSelect?.addEventListener('change', syncCheckout);
  syncCheckout();

  if (new URLSearchParams(window.location.search).get('leadError') && dialog instanceof HTMLDialogElement) {
    dialog.showModal();
  }

  function wireDateValidation(checkinId: string, checkoutId: string, errorId: string, submitId: string) {
    const checkin = document.getElementById(checkinId) as HTMLInputElement | null;
    const checkout = document.getElementById(checkoutId) as HTMLInputElement | null;
    const error = document.getElementById(errorId);
    const submit = document.getElementById(submitId) as HTMLButtonElement | null;
    if (!checkin || !checkout) return;

    function addDay(dateStr: string): string {
      const d = new Date(`${dateStr}T00:00:00Z`);
      d.setUTCDate(d.getUTCDate() + 1);
      return d.toISOString().slice(0, 10);
    }
    function isInvalid(): boolean {
      return !!(checkin!.value && checkout!.value && checkout!.value <= checkin!.value);
    }
    function refresh() {
      const invalid = isInvalid();
      if (error) (error as HTMLElement).style.display = invalid ? '' : 'none';
      if (submit) submit.disabled = invalid;
    }

    checkin.addEventListener('change', () => {
      checkout!.min = checkin!.value ? addDay(checkin!.value) : '';
      if (isInvalid()) checkout!.value = '';
      refresh();
    });
    checkout.addEventListener('change', refresh);

    if (checkin.value) checkout.min = addDay(checkin.value);
    refresh();
  }

  wireDateValidation('lead-date-from', 'lead-date-to', 'lead-date-error', 'add-lead-save-btn');

  const syncBtn = document.getElementById('sync-hosthub-btn');
  const syncFeedback = document.getElementById('sync-feedback');
  syncBtn?.addEventListener('click', async () => {
    if (!(syncBtn instanceof HTMLButtonElement)) return;
    syncBtn.disabled = true;
    const original = syncBtn.textContent;
    syncBtn.textContent = '⏳ Syncing…';
    if (syncFeedback) syncFeedback.textContent = '';
    try {
      const res = await fetch('/admin/api/sync-hosthub');
      const data = await res.json();
      if (syncFeedback) {
        syncFeedback.textContent = data.success
          ? ` · Synced — ${data.result.inserted} new, ${data.result.updated} updated`
          : ' · Sync failed';
      }
      if (data.success) setTimeout(() => window.location.reload(), 1200);
    } catch {
      if (syncFeedback) syncFeedback.textContent = ' · Sync failed';
    } finally {
      syncBtn.disabled = false;
      syncBtn.textContent = original;
    }
  });
</script>

<style>
  .summary-line { font-weight: 750; margin: 0 0 20px; }
  .month-summary { margin-top: -14px; color: #615854; font-weight: 700; }
  .info-tip { display:inline-flex; cursor:help; border-radius:999px; background:#eee8e5; color:var(--brown); width:16px; height:16px; align-items:center; justify-content:center; font-size:11px; font-weight:700; margin-left:4px; }
  .amount.positive { color:#166534; }
  .amount.negative { color:var(--red); }
  .section-label { text-align:center; color:#a89890; font-size:12px; font-weight:700; letter-spacing:.04em; margin:28px 0 14px; }
  tr.lead-row { cursor: pointer; }
  tr.lead-row:hover { background: #faf7f6; }
  dialog#add-lead-dialog { border: 1px solid var(--line); border-radius: 14px; padding: 22px; max-width: 560px; width: calc(100% - 40px); box-shadow: 0 10px 40px rgb(38 29 26 / 18%); }
  dialog#add-lead-dialog::backdrop { background: rgb(38 29 26 / 35%); }
  .field-error { color: var(--red); font-size: 12px; margin-top: -8px; }
  details summary { cursor:pointer; font-weight:700; color:var(--brown); padding:10px 0; list-style:none; }
  details summary::-webkit-details-marker { display:none; }
</style>
