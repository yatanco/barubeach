---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../lib/db';
import { money, shortDate, timeAgo, isOneOf, PIPELINE_STATUSES, PIPELINE_LABELS, GUEST_INTENTS, estimateLeadValue } from '../../lib/crm';

export const prerender = false;

interface LeadRow {
  id: string; created_at: string; status: string; source: string; experience_type: string;
  guest_name: string | null; whatsapp: string | null; date_from: string | null; date_to: string | null;
  adults: number; children: number; estimated_price: string | null; quote_total: number | null; quote_currency: string | null;
}
interface BookingRow {
  id: string; reservation_id: string | null; channel: string; source: string; guest_name: string; guest_phone: string | null;
  date_from: string; date_to: string; status: string; total_cents: number; paid_cents: number;
}
interface SyncLogRow {
  synced_at: string; processed: number; inserted: number; updated: number; skipped: number; error: string | null;
}

const db = getDb(Astro.locals);
let leads: LeadRow[] = [];
let bookings: BookingRow[] = [];
let newLeadsCount = 0;
let weekLeadsCount = 0;
let outstandingCents = 0;
let arrivalsThisWeek = 0;
let inHouseCount = 0;
let statusCounts: Record<string, number> = {};
let lastSync: SyncLogRow | null = null;
let error = '';

const stageParam = Astro.url.searchParams.get('stage');
const activeStage = stageParam && isOneOf(stageParam, PIPELINE_STATUSES) ? stageParam : null;

if (!db) {
  error = 'D1 is not configured yet. Bind the database as DB and run the migration.';
} else {
  try {
    const leadsQuery = activeStage
      ? db.prepare(`SELECT id, created_at, status, source, experience_type, guest_name, whatsapp,
          date_from, date_to, adults, children, estimated_price, quote_total, quote_currency FROM leads WHERE status = ?1 ORDER BY created_at DESC LIMIT 100`).bind(activeStage)
      : db.prepare(`SELECT id, created_at, status, source, experience_type, guest_name, whatsapp,
          date_from, date_to, adults, children, estimated_price, quote_total, quote_currency FROM leads ORDER BY created_at DESC LIMIT 100`);

    const [leadResult, bookingResult, newCountResult, weekCountResult, outstandingResult, statusCountResult, arrivalsResult, inHouseResult, lastSyncResult] = await Promise.all([
      leadsQuery.all<LeadRow>(),
      db.prepare(`SELECT b.id, b.reservation_id, b.channel, b.source, b.guest_name, b.guest_phone, b.date_from, b.date_to, b.status,
        COALESCE((SELECT SUM(c.amount_cents) FROM charges c WHERE c.booking_id = b.id), 0) AS total_cents,
        COALESCE((SELECT SUM(p.amount_cents) FROM payments p JOIN charges c ON c.id = p.charge_id WHERE c.booking_id = b.id), 0) AS paid_cents
        FROM bookings b ORDER BY b.date_from ASC`).all<BookingRow>(),
      db.prepare(`SELECT COUNT(*) AS count FROM leads WHERE status = 'new'`).first<{ count: number }>(),
      db.prepare(`SELECT COUNT(*) AS count FROM leads WHERE created_at >= datetime('now', '-7 days')`).first<{ count: number }>(),
      db.prepare(`WITH booking_totals AS (
        SELECT b.id,
          COALESCE((SELECT SUM(c.amount_cents) FROM charges c WHERE c.booking_id = b.id), 0) AS total_cents,
          COALESCE((SELECT SUM(p.amount_cents) FROM payments p JOIN charges c ON c.id = p.charge_id WHERE c.booking_id = b.id), 0) AS paid_cents
        FROM bookings b
      ) SELECT COALESCE(SUM(MAX(total_cents - paid_cents, 0)), 0) AS outstanding FROM booking_totals`).first<{ outstanding: number }>(),
      db.prepare(`SELECT status, COUNT(*) AS count FROM leads GROUP BY status`).all<{ status: string; count: number }>(),
      db.prepare(`SELECT COUNT(*) AS count FROM bookings WHERE date_from BETWEEN date('now') AND date('now', '+7 days') AND status != 'cancelled'`).first<{ count: number }>(),
      db.prepare(`SELECT COUNT(*) AS count FROM bookings WHERE date_from <= date('now') AND date_to >= date('now') AND status = 'checked_in'`).first<{ count: number }>(),
      db.prepare(`SELECT synced_at, processed, inserted, updated, skipped, error FROM sync_log ORDER BY synced_at DESC LIMIT 1`).first<SyncLogRow>(),
    ]);
    leads = leadResult.results;
    bookings = bookingResult.results;
    newLeadsCount = newCountResult?.count ?? 0;
    weekLeadsCount = weekCountResult?.count ?? 0;
    outstandingCents = outstandingResult?.outstanding ?? 0;
    arrivalsThisWeek = arrivalsResult?.count ?? 0;
    inHouseCount = inHouseResult?.count ?? 0;
    statusCounts = Object.fromEntries(statusCountResult.results.map((r) => [r.status, r.count]));
    lastSync = lastSyncResult ?? null;
  } catch (cause) {
    console.error('[admin] failed to load CRM', cause);
    error = 'The CRM database could not be read. Confirm that migrations 0001_crm.sql and 0002_sync_log.sql have run.';
  }
}
const notice = Astro.url.searchParams.get('saved');
const leadAdded = Astro.url.searchParams.get('leadAdded');
const leadError = Astro.url.searchParams.get('leadError');
---
<AdminLayout title="Dashboard">
  <div class="actions" style="justify-content:space-between;margin-bottom:6px">
    <h1>Bookings & inquiries</h1>
    <div class="actions">
      <button type="button" class="secondary" id="open-add-lead">Add Lead</button>
      <a class="button secondary" href="/admin/api/export">Export CSV</a>
      <button type="button" class="secondary" id="sync-hosthub-btn">🔄 Sync HostHub</button>
    </div>
  </div>
  <p class="muted">Hosthub owns reservations. This dashboard owns follow-up, charges and payments.</p>
  <p class="muted" style="margin-top:-8px;font-size:12px">
    <span id="last-sync-info">Last sync: {lastSync ? `${timeAgo(lastSync.synced_at)} · ${lastSync.processed} reservations` : 'never'}</span>
    <span id="sync-feedback"></span>
  </p>
  {error && <div class="alert">{error}</div>}
  {notice && <div class="alert">Saved successfully.</div>}
  {leadAdded && <div class="alert">Lead added.</div>}
  {leadError && <div class="alert">{leadError}</div>}
  {!error && (
    <p class="summary-line">{newLeadsCount} new leads · {weekLeadsCount} this week · {arrivalsThisWeek} arrivals this week · {inHouseCount} in house · {money(outstandingCents)} outstanding</p>
  )}

  {!error && (
    <div class="pipeline">
      <a href="/admin" class={!activeStage ? 'active' : ''}>All<span class="count">{leads.length}</span></a>
      {PIPELINE_STATUSES.map((status) => (
        <a href={`/admin?stage=${status}`} class={activeStage === status ? 'active' : ''}>
          {PIPELINE_LABELS[status]}<span class="count">{statusCounts[status] ?? 0}</span>
        </a>
      ))}
    </div>
  )}

  <div class="grid grid-2">
    <section class="card">
      <h2>Bookings</h2>
      <div class="list">
        {bookings.length === 0 && <p class="muted">No bookings have been linked yet.</p>}
        {bookings.map((booking) => (
          <div class="row">
            <div class="stack">
              <div class="actions">
                <h3>{booking.guest_name}</h3>
                <span class={`badge ${booking.status}`}>{booking.status.replace('_', ' ')}</span>
                <span class={`badge ${booking.channel.replace(/[^a-z0-9]/gi, '')}`}>{booking.channel}</span>
                {booking.source === 'hosthub_ical' && <span class="badge hh" title="Synced from HostHub">HH</span>}
              </div>
              <span class="muted">{shortDate(booking.date_from)} → {shortDate(booking.date_to)} · Reservation {booking.reservation_id || 'not linked'}</span>
              <span class="amount">Outstanding: {money(Math.max(0, booking.total_cents - booking.paid_cents))}</span>
            </div>
            <a class="button secondary" href={`/admin/bookings/${booking.id}`}>Open</a>
          </div>
        ))}
      </div>
    </section>

    <section class="card">
      <h2>Leads</h2>
      {leads.length === 0 && <p class="muted">No leads captured yet.</p>}
      {leads.length > 0 && (
        <table>
          <thead>
            <tr><th>Name</th><th>Type</th><th>Dates</th><th>Guests</th><th>Est. Value</th><th>Status</th><th>WhatsApp</th></tr>
          </thead>
          <tbody>
            {leads.map((lead) => (
              <tr class="lead-row" data-href={`/admin/leads/${lead.id}`}>
                <td>{lead.guest_name || 'Unnamed inquiry'}</td>
                <td>{lead.experience_type}</td>
                <td>{shortDate(lead.date_from)}{lead.date_to ? ` → ${shortDate(lead.date_to)}` : ''}</td>
                <td>{lead.adults + lead.children}</td>
                <td>{estimateLeadValue(lead)}</td>
                <td><span class={`badge ${lead.status}`}>{lead.status}</span></td>
                <td>
                  {lead.whatsapp
                    ? <a href={`https://wa.me/${lead.whatsapp.replace(/\D/g, '')}`} target="_blank" rel="noopener">{lead.whatsapp}</a>
                    : <span class="muted">—</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>
  </div>

  <dialog id="add-lead-dialog">
    <form method="POST" action="/admin/api/leads/create">
      <div class="actions" style="justify-content:space-between;margin-bottom:14px">
        <h2 style="margin:0">Add lead</h2>
        <button type="button" class="secondary" data-close-dialog>Close</button>
      </div>
      <div class="form-grid">
        <label>Name<input name="guest_name" required /></label>
        <label>WhatsApp<input name="whatsapp" type="tel" required placeholder="+57 300 000 0000" /></label>
        <label>Email<input name="email" type="email" /></label>
        <label>Type
          <select name="experience_type" id="lead-type-select">
            <option value="daytrip">Day Trip</option>
            <option value="stay">Stay</option>
          </select>
        </label>
        <label>Guest intent
          <select name="guest_intent">
            <option value="">—</option>
            {GUEST_INTENTS.map((intent) => <option value={intent.value}>{intent.label}</option>)}
          </select>
        </label>
        <label>Check-in<input name="date_from" type="date" id="lead-date-from" /></label>
        <label id="checkout-label">Checkout<input name="date_to" type="date" id="lead-date-to" /></label>
        <div class="span-2 field-error" id="lead-date-error" style="display:none">Check-out must be after check-in</div>
        <label>Adults<input name="adults" type="number" min="1" value="2" /></label>
        <label>Children<input name="children" type="number" min="0" value="0" /></label>
        <label class="span-2">Notes<textarea name="notes" placeholder="What were they asking about?"></textarea></label>
      </div>
      <div class="actions" style="justify-content:flex-end;margin-top:16px">
        <button type="button" class="secondary" data-close-dialog>Cancel</button>
        <button type="submit" id="add-lead-save-btn">Add lead</button>
      </div>
    </form>
  </dialog>
</AdminLayout>

<script>
  document.querySelectorAll('tr.lead-row').forEach((row) => {
    row.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) return;
      const href = row.getAttribute('data-href');
      if (href) window.location.href = href;
    });
  });

  const dialog = document.getElementById('add-lead-dialog');
  document.getElementById('open-add-lead')?.addEventListener('click', () => {
    if (dialog instanceof HTMLDialogElement) dialog.showModal();
  });
  dialog?.querySelectorAll('[data-close-dialog]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (dialog instanceof HTMLDialogElement) dialog.close();
    });
  });

  const typeSelect = document.getElementById('lead-type-select');
  const checkoutLabel = document.getElementById('checkout-label');
  const syncCheckout = () => {
    if (checkoutLabel) checkoutLabel.style.display = typeSelect && 'value' in typeSelect && typeSelect.value === 'stay' ? '' : 'none';
  };
  typeSelect?.addEventListener('change', syncCheckout);
  syncCheckout();

  if (new URLSearchParams(window.location.search).get('leadError') && dialog instanceof HTMLDialogElement) {
    dialog.showModal();
  }

  function wireDateValidation(checkinId: string, checkoutId: string, errorId: string, submitId: string) {
    const checkin = document.getElementById(checkinId) as HTMLInputElement | null;
    const checkout = document.getElementById(checkoutId) as HTMLInputElement | null;
    const error = document.getElementById(errorId);
    const submit = document.getElementById(submitId) as HTMLButtonElement | null;
    if (!checkin || !checkout) return;

    function addDay(dateStr: string): string {
      const d = new Date(`${dateStr}T00:00:00Z`);
      d.setUTCDate(d.getUTCDate() + 1);
      return d.toISOString().slice(0, 10);
    }
    function isInvalid(): boolean {
      return !!(checkin!.value && checkout!.value && checkout!.value <= checkin!.value);
    }
    function refresh() {
      const invalid = isInvalid();
      if (error) (error as HTMLElement).style.display = invalid ? '' : 'none';
      if (submit) submit.disabled = invalid;
    }

    checkin.addEventListener('change', () => {
      checkout!.min = checkin!.value ? addDay(checkin!.value) : '';
      if (isInvalid()) checkout!.value = '';
      refresh();
    });
    checkout.addEventListener('change', refresh);

    if (checkin.value) checkout.min = addDay(checkin.value);
    refresh();
  }

  wireDateValidation('lead-date-from', 'lead-date-to', 'lead-date-error', 'add-lead-save-btn');

  const syncBtn = document.getElementById('sync-hosthub-btn');
  const syncFeedback = document.getElementById('sync-feedback');
  syncBtn?.addEventListener('click', async () => {
    if (!(syncBtn instanceof HTMLButtonElement)) return;
    syncBtn.disabled = true;
    const original = syncBtn.textContent;
    syncBtn.textContent = '⏳ Syncing…';
    if (syncFeedback) syncFeedback.textContent = '';
    try {
      const res = await fetch('/admin/api/sync-hosthub');
      const data = await res.json();
      if (syncFeedback) {
        syncFeedback.textContent = data.success
          ? ` · Synced — ${data.result.inserted} new, ${data.result.updated} updated`
          : ' · Sync failed';
      }
      if (data.success) setTimeout(() => window.location.reload(), 1200);
    } catch {
      if (syncFeedback) syncFeedback.textContent = ' · Sync failed';
    } finally {
      syncBtn.disabled = false;
      syncBtn.textContent = original;
    }
  });
</script>

<style>
  .summary-line { font-weight: 750; margin: 0 0 20px; }
  tr.lead-row { cursor: pointer; }
  tr.lead-row:hover { background: #faf7f6; }
  dialog#add-lead-dialog { border: 1px solid var(--line); border-radius: 14px; padding: 22px; max-width: 560px; width: calc(100% - 40px); box-shadow: 0 10px 40px rgb(38 29 26 / 18%); }
  dialog#add-lead-dialog::backdrop { background: rgb(38 29 26 / 35%); }
  .field-error { color: var(--red); font-size: 12px; margin-top: -8px; }
</style>
