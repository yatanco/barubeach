---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import UnifiedRecordDetail from '../../../components/admin/UnifiedRecordDetail.astro';
import { requireDb } from '../../../lib/db';

export const prerender = false;

const db = requireDb(Astro.locals);
const lead = await db.prepare('SELECT * FROM leads WHERE id = ?1').bind(Astro.params.id).first<any>();
if (!lead) return Astro.redirect('/admin');
const leadError = Astro.url.searchParams.get('leadError');
---
<AdminLayout title={lead.guest_name || 'Lead'}>
  <p><a href="/admin">← Dashboard</a></p>
  {leadError && <div class="alert">{leadError}</div>}
  <UnifiedRecordDetail kind="lead" record={lead} />
</AdminLayout>
