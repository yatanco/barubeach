---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireDb } from '../../../lib/db';
import {
  PIPELINE_STATUSES, PIPELINE_LABELS, GUEST_INTENTS, shortDate, money,
  nightsBetween, formatUsd, formatMoneyAmount, QUOTE_RATES, QUOTE_CURRENCIES, waLinkTo, buildQuoteWhatsAppMessage,
} from '../../../lib/crm';

export const prerender = false;
interface PaymentLinkRow {
  id:string; charge_description:string; amount_cents:number; provider:string; url:string; status:string; created_at:string; expires_at:string|null;
}
const db = requireDb(Astro.locals);
const lead = await db.prepare('SELECT * FROM leads WHERE id = ?1').bind(Astro.params.id).first<any>();
if (!lead) return Astro.redirect('/admin');
const depositLinks = (await db.prepare(`SELECT * FROM payment_links WHERE lead_id = ?1 ORDER BY created_at DESC`).bind(lead.id).all<PaymentLinkRow>()).results;
const notice = Astro.url.searchParams.get('saved');
const leadError = Astro.url.searchParams.get('leadError');

const nights = nightsBetween(lead.date_from, lead.date_to);
const currency = lead.quote_currency || 'USD';
// The $350/$250/$50 suggestion rates are USD baselines — don't auto-suggest a
// converted number in COP (no reliable exchange rate to hand), leave blank for manual entry.
const accommodationSuggestion = currency === 'USD' ? nights * QUOTE_RATES.accommodationPerNight : 0;
const transportSuggestion = currency === 'USD' ? QUOTE_RATES.transportDefault : 0;
const foodSuggestion = currency === 'USD' ? (lead.adults || 0) * QUOTE_RATES.foodPerAdultPerNight * nights : 0;
const transportIncluded = !!lead.transport_included;
const foodIncluded = !!lead.food_included;
const accommodationValue = lead.quote_accommodation ?? (accommodationSuggestion || '');
const transportValue = lead.quote_transport ?? (transportSuggestion || '');
const foodValue = lead.quote_food ?? (foodSuggestion || '');
const totalSuggestion = (Number(accommodationValue) || 0) + (transportIncluded ? (Number(transportValue) || 0) : 0) + (foodIncluded ? (Number(foodValue) || 0) : 0);
const totalValue = lead.quote_total ?? (totalSuggestion || '');
const depositValue = lead.quote_deposit ?? (totalSuggestion ? Math.round(totalSuggestion * 0.5) : '');

const quoteMessage = lead.quote_saved_at ? buildQuoteWhatsAppMessage(lead) : undefined;
const waHref = lead.whatsapp ? waLinkTo(lead.whatsapp, quoteMessage) : null;
---
<AdminLayout title={lead.guest_name || 'Lead'}>
  <p><a href="/admin">← Dashboard</a></p>
  <div class="actions" style="justify-content:space-between;margin-bottom:14px">
    <h1 style="margin:0">{lead.guest_name || 'Unnamed lead'}</h1>
    {waHref
      ? <a class="button whatsapp" href={waHref} target="_blank" rel="noopener">💬 Open WhatsApp</a>
      : <span title="Add phone number first"><button type="button" class="button whatsapp" disabled>💬 Open WhatsApp</button></span>}
  </div>
  {notice && <div class="alert">Saved successfully.</div>}
  {leadError && <div class="alert">{leadError}</div>}

  <section class="card" style="max-width:760px;margin-bottom:20px">
    <div class="actions" style="justify-content:space-between;margin-bottom:16px">
      <span class="badge">{lead.experience_type}</span>
      <span class="muted">Source: {lead.source} · Created {shortDate(lead.created_at)}</span>
    </div>

    <form class="form-grid" method="POST" action={`/admin/api/leads/${lead.id}/update`} id="main-form">
      <label>Name<input name="guest_name" required value={lead.guest_name || ''} /></label>
      <label>Phone<input type="tel" name="whatsapp" value={lead.whatsapp || ''} placeholder="+57 300 000 0000" /></label>
      <label>Email<input name="email" type="email" value={lead.email || ''} /></label>
      <label>Guest intent
        <select name="guest_intent">
          <option value="">—</option>
          {GUEST_INTENTS.map((intent) => <option value={intent.value} selected={intent.value === lead.guest_intent}>{intent.label}</option>)}
        </select>
      </label>
      <label>Check-in<input type="date" name="date_from" id="main-date-from" value={lead.date_from?.slice(0,10) || ''} /></label>
      <label>Checkout
        <input type="date" name="date_to" id="main-date-to" value={lead.date_to?.slice(0,10) || ''} />
      </label>
      <div class="span-2 field-error" id="main-date-error" style="display:none">Check-out must be after check-in</div>
      <label>Adults<input type="number" min="1" name="adults" value={lead.adults || 1} /></label>
      <label>Children<input type="number" min="0" name="children" value={lead.children || 0} /></label>
      <label class="span-2">Notes<textarea name="notes">{lead.notes || ''}</textarea></label>
      <div class="span-2"><button type="submit" id="main-save-btn">Save changes</button></div>
    </form>

    <div class="actions" style="justify-content:space-between;margin-top:18px;padding-top:16px;border-top:1px solid var(--line)">
      <span class={`badge ${lead.status}`}>{lead.status}</span>
      <form class="inline" method="POST" action={`/admin/api/leads/${lead.id}/status`}>
        <label style="min-width:160px">Move to
          <select name="status">
            {PIPELINE_STATUSES.map((status) => <option value={status} selected={status === lead.status}>{PIPELINE_LABELS[status]}</option>)}
            <option value="lost" selected={lead.status === 'lost'}>Lost</option>
            <option value="spam" selected={lead.status === 'spam'}>Spam</option>
          </select>
        </label>
        <button type="submit" class="secondary">Update</button>
      </form>
    </div>
  </section>

  <section class="card" style="max-width:760px;margin-bottom:20px">
    <h2>Quote</h2>
    <form method="POST" action={`/admin/api/leads/${lead.id}/quote`} id="quote-form">
      <div class="actions" style="gap:20px;margin-bottom:16px;flex-wrap:wrap">
        <fieldset class="toggle-group">
          <legend>Currency</legend>
          {QUOTE_CURRENCIES.map((c) => (
            <label class="radio-inline"><input type="radio" name="quote_currency" value={c} checked={c === currency} /> {c}</label>
          ))}
        </fieldset>
        <fieldset class="toggle-group">
          <legend>Transport</legend>
          <label class="radio-inline"><input type="radio" name="transport_included" value="1" checked={transportIncluded} /> Yes</label>
          <label class="radio-inline"><input type="radio" name="transport_included" value="0" checked={!transportIncluded} /> No</label>
        </fieldset>
        <fieldset class="toggle-group">
          <legend>Food</legend>
          <label class="radio-inline"><input type="radio" name="food_included" value="1" checked={foodIncluded} /> Yes</label>
          <label class="radio-inline"><input type="radio" name="food_included" value="0" checked={!foodIncluded} /> No</label>
        </fieldset>
      </div>

      <div class="form-grid">
        <label>Accommodation (<span class="qty-currency">{currency}</span>)<input type="number" min="0" step="1" name="quote_accommodation" id="quote-accommodation" value={accommodationValue} /></label>
        <div class="muted" id="accommodation-hint" style="align-self:end;font-size:12px;padding-bottom:9px">
          {currency === 'USD'
            ? `${nights} nights × $350 = ${formatUsd(accommodationSuggestion)} USD`
            : 'Enter amount manually in COP'}
        </div>

        <label id="transport-field" style={transportIncluded ? '' : 'display:none'}>Transport (<span class="qty-currency">{currency}</span>)<input type="number" min="0" step="1" name="quote_transport" id="quote-transport" value={transportValue} /></label>
        <label id="food-field" style={foodIncluded ? '' : 'display:none'}>Food (<span class="qty-currency">{currency}</span>)<input type="number" min="0" step="1" name="quote_food" id="quote-food" value={foodValue} /></label>

        <label>Total (<span class="qty-currency">{currency}</span>)<input type="number" min="0" step="1" name="quote_total" id="quote-total" value={totalValue} /></label>
        <label>Deposit — 50% (<span class="qty-currency">{currency}</span>)<input type="number" min="0" step="1" name="quote_deposit" id="quote-deposit" value={depositValue} /></label>

        <div class="span-2"><button type="submit">Save Quote</button></div>
      </div>
    </form>
  </section>

  {Number(lead.quote_deposit) > 0 && (
    <section class="card" style="max-width:760px;margin-bottom:20px">
      <h2>Collect deposit</h2>
      <p class="muted" style="margin-top:-8px">
        Deposit amount: <strong>{formatMoneyAmount(lead.quote_deposit, currency)} {currency}</strong>
        {currency !== 'COP' && ' — quote is in USD, enter the COP amount to charge below (payment links are COP only)'}
      </p>
      <form class="form-grid" id="deposit-link-form">
        <label class="span-2">Description<input name="description" id="deposit-description" required value={`Depósito — ${lead.guest_name || 'Casa Gaviota'}`} /></label>
        <label>Amount (COP)<input name="amount" inputmode="numeric" id="deposit-amount" required value={currency === 'COP' ? Math.round(lead.quote_deposit) : ''} placeholder={currency !== 'COP' ? 'Enter COP amount' : ''} /></label>
        <div class="span-2 actions" style="align-items:flex-start;flex-wrap:wrap;gap:16px">
          <div class="stack" style="gap:6px">
            <button type="submit" data-provider="wompi" style="background:#3369ff">🔵 Generate Wompi link</button>
            <span class="field-error" id="wompi-link-error" style="display:none"></span>
          </div>
          <div class="stack" style="gap:6px">
            <button type="submit" data-provider="bold" style="background:#ffc93c;color:#261d1a">🟡 Generate Bold link</button>
            <span class="field-error" id="bold-link-error" style="display:none"></span>
          </div>
        </div>
      </form>

      {depositLinks.length === 0 && <p class="muted" style="margin-top:14px">No payment links generated yet.</p>}
      {depositLinks.length > 0 && (
        <table style="margin-top:14px">
          <thead><tr><th>Provider</th><th>Description</th><th>Amount</th><th>Status</th><th>Link</th></tr></thead>
          <tbody>
            {depositLinks.map((link) => (
              <tr>
                <td><span class="badge">{link.provider}</span></td>
                <td>{link.charge_description}</td>
                <td class="amount">{money(link.amount_cents)}</td>
                <td><span class={`badge ${link.status === 'active' ? 'confirmed' : 'lost'}`}>{link.status}</span></td>
                <td class="actions">
                  <button type="button" class="secondary copy-link-btn" data-url={link.url}>Copy</button>
                  <a class="button secondary" href={link.url} target="_blank" rel="noopener">Open</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}

      {depositLinks.length > 0 && (
        <div class="stack" style="margin-top:16px">
          <button type="button" class="secondary" id="copy-deposit-message-btn">📋 Copy deposit request</button>
        </div>
      )}
    </section>
  )}

  <details>
    <summary>+ Convert to Booking</summary>
    <p class="muted" style="margin-top:12px">Create the reservation in Hosthub first, then paste its booking ID here.</p>
    <section class="card" style="max-width:760px">
      <form class="form-grid" method="POST" action="/admin/api/bookings/create" id="convert-form">
        <input type="hidden" name="lead_id" value={lead.id} />
        <label>Hosthub booking ID<input name="reservation_id" required placeholder="c1zshdhyycnzc1" /></label>
        <label>Guest name<input name="guest_name" required value={lead.guest_name || ''} /></label>
        <label>Phone<input name="guest_phone" value={lead.whatsapp || ''} /></label>
        <label>Check-in<input type="date" name="date_from" id="convert-date-from" required value={lead.date_from?.slice(0,10) || ''} /></label>
        <label>Checkout
          <input type="date" name="date_to" id="convert-date-to" required value={lead.date_to?.slice(0,10) || ''} />
        </label>
        <div class="span-2 field-error" id="convert-date-error" style="display:none">Check-out must be after check-in</div>
        <label>Adults<input type="number" min="1" name="adults" required value={lead.adults || 1} /></label>
        <label>Children<input type="number" min="0" name="children" value={lead.children || 0} /></label>
        <label class="span-2">Internal notes<textarea name="notes">{lead.notes || ''}</textarea></label>
        <div class="span-2"><button type="submit" id="convert-save-btn">Create linked booking</button></div>
      </form>
    </section>
  </details>
</AdminLayout>

<style>
  details { margin-top:4px; }
  details summary { cursor:pointer; font-weight:700; color:var(--brown); padding:10px 0; list-style:none; }
  details summary::-webkit-details-marker { display:none; }
  details[open] summary { margin-bottom:4px; }
  .field-error { color:var(--red); font-size:12px; margin-top:-8px; }
  fieldset.toggle-group { border:1px solid var(--line); border-radius:8px; padding:8px 12px; display:flex; align-items:center; gap:12px; margin:0; }
  fieldset.toggle-group legend { font-size:12px; font-weight:700; color:#615854; padding:0 4px; }
  .radio-inline { display:inline-flex !important; align-items:center; gap:4px; font-weight:500 !important; width:auto !important; color:var(--ink); }
  .radio-inline input { width:auto !important; }
</style>

<script>
  function wireDateValidation(checkinId: string, checkoutId: string, errorId: string, submitId: string) {
    const checkin = document.getElementById(checkinId) as HTMLInputElement | null;
    const checkout = document.getElementById(checkoutId) as HTMLInputElement | null;
    const error = document.getElementById(errorId);
    const submit = document.getElementById(submitId) as HTMLButtonElement | null;
    if (!checkin || !checkout) return;

    function addDay(dateStr: string): string {
      const d = new Date(`${dateStr}T00:00:00Z`);
      d.setUTCDate(d.getUTCDate() + 1);
      return d.toISOString().slice(0, 10);
    }
    function isInvalid(): boolean {
      return !!(checkin!.value && checkout!.value && checkout!.value <= checkin!.value);
    }
    function refresh() {
      const invalid = isInvalid();
      if (error) (error as HTMLElement).style.display = invalid ? '' : 'none';
      if (submit) submit.disabled = invalid;
    }

    checkin.addEventListener('change', () => {
      checkout!.min = checkin!.value ? addDay(checkin!.value) : '';
      if (isInvalid()) checkout!.value = '';
      refresh();
    });
    checkout.addEventListener('change', refresh);

    if (checkin.value) checkout.min = addDay(checkin.value);
    refresh();
  }

  wireDateValidation('main-date-from', 'main-date-to', 'main-date-error', 'main-save-btn');
  wireDateValidation('convert-date-from', 'convert-date-to', 'convert-date-error', 'convert-save-btn');
</script>

<script define:vars={{ nights: nights, adults: lead.adults || 0 }}>
  const RATES = { accommodation: 350, transport: 250, foodPerAdultNight: 50 };

  const transportField = document.getElementById('transport-field');
  const foodField = document.getElementById('food-field');
  const accommodationInput = document.getElementById('quote-accommodation');
  const transportInput = document.getElementById('quote-transport');
  const foodInput = document.getElementById('quote-food');
  const totalInput = document.getElementById('quote-total');
  const depositInput = document.getElementById('quote-deposit');
  const accommodationHint = document.getElementById('accommodation-hint');

  let totalDirty = false;
  let depositDirty = false;
  // Track fields the admin has actually typed into (vs. values this script wrote itself as a
  // suggestion) so a currency switch can safely clear stale suggestions without ever touching
  // something the admin deliberately entered. Anything already saved on the lead counts as "edited".
  let accommodationEdited = !!accommodationInput.value && accommodationInput.value !== String(nights * RATES.accommodation);
  let transportEdited = !!transportInput.value && transportInput.value !== String(RATES.transport);
  let foodEdited = !!foodInput.value && foodInput.value !== String(Math.round(adults * RATES.foodPerAdultNight * nights));

  function currency() {
    return document.querySelector('input[name="quote_currency"]:checked')?.value || 'USD';
  }
  function transportIncluded() {
    return document.querySelector('input[name="transport_included"]:checked')?.value === '1';
  }
  function foodIncluded() {
    return document.querySelector('input[name="food_included"]:checked')?.value === '1';
  }

  function syncToggleVisibility() {
    const tIncluded = transportIncluded();
    const fIncluded = foodIncluded();
    transportField.style.display = tIncluded ? '' : 'none';
    foodField.style.display = fIncluded ? '' : 'none';
    transportInput.required = tIncluded;
    foodInput.required = fIncluded;
    if (currency() === 'USD') {
      if (tIncluded && !transportEdited && !transportInput.value) transportInput.value = String(RATES.transport);
      if (fIncluded && !foodEdited && !foodInput.value) foodInput.value = String(Math.round(adults * RATES.foodPerAdultNight * nights));
    }
  }

  function syncCurrencyLabels() {
    const cur = currency();
    document.querySelectorAll('.qty-currency').forEach((el) => { el.textContent = cur; });
    if (accommodationHint) {
      accommodationHint.textContent = cur === 'USD'
        ? `${nights} nights × $350 = $${nights * RATES.accommodation} USD`
        : 'Enter amount manually in COP';
    }
    if (cur === 'USD') {
      if (!accommodationEdited) accommodationInput.value = String(nights * RATES.accommodation);
      if (transportIncluded() && !transportEdited) transportInput.value = String(RATES.transport);
      if (foodIncluded() && !foodEdited) foodInput.value = String(Math.round(adults * RATES.foodPerAdultNight * nights));
    } else {
      if (!accommodationEdited) accommodationInput.value = '';
      if (!transportEdited) transportInput.value = '';
      if (!foodEdited) foodInput.value = '';
    }
  }

  function recalcTotal() {
    if (totalDirty) return;
    const acc = Number(accommodationInput.value) || 0;
    const trans = transportIncluded() ? (Number(transportInput.value) || 0) : 0;
    const food = foodIncluded() ? (Number(foodInput.value) || 0) : 0;
    totalInput.value = String(Math.round(acc + trans + food));
    recalcDeposit();
  }
  function recalcDeposit() {
    if (depositDirty) return;
    depositInput.value = String(Math.round((Number(totalInput.value) || 0) * 0.5));
  }

  accommodationInput.addEventListener('input', () => { accommodationEdited = true; recalcTotal(); });
  transportInput.addEventListener('input', () => { transportEdited = true; recalcTotal(); });
  foodInput.addEventListener('input', () => { foodEdited = true; recalcTotal(); });
  totalInput.addEventListener('input', () => { totalDirty = true; recalcDeposit(); });
  depositInput.addEventListener('input', () => { depositDirty = true; });
  document.querySelectorAll('input[name="transport_included"]').forEach((el) => el.addEventListener('change', () => { syncToggleVisibility(); recalcTotal(); }));
  document.querySelectorAll('input[name="food_included"]').forEach((el) => el.addEventListener('change', () => { syncToggleVisibility(); recalcTotal(); }));
  document.querySelectorAll('input[name="quote_currency"]').forEach((el) => el.addEventListener('change', () => { syncCurrencyLabels(); recalcTotal(); }));

  syncToggleVisibility();
</script>

<script define:vars={{ guestName: lead.guest_name, leadId: lead.id, waLinks: depositLinks.map((l: any) => ({ provider: l.provider, description: l.charge_description, amount: l.amount_cents / 100, url: l.url })) }}>
  const depositForm = document.getElementById('deposit-link-form');
  depositForm?.querySelectorAll('button[data-provider]').forEach((btn) => {
    btn.addEventListener('click', async (event) => {
      event.preventDefault();
      if (!(btn instanceof HTMLButtonElement)) return;
      const provider = btn.dataset.provider;
      const errorBox = document.getElementById(`${provider}-link-error`);
      const description = (document.getElementById('deposit-description')).value.trim();
      const amount = Number((document.getElementById('deposit-amount')).value.replace(/[^0-9]/g, ''));
      if (!description || !amount) return;
      if (errorBox) errorBox.style.display = 'none';
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Generating…';
      try {
        const res = await fetch(`/admin/api/leads/${leadId}/payment-links`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ provider, amount, description }),
        });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else if (errorBox) {
          errorBox.textContent = data.error || 'Could not generate payment link.';
          errorBox.style.display = '';
        }
      } catch {
        if (errorBox) {
          errorBox.textContent = 'Network error — could not reach the server.';
          errorBox.style.display = '';
        }
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  });

  document.querySelectorAll('.copy-link-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-url');
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = original; }, 1500);
      } catch {
        // clipboard API unavailable — nothing else to do here
      }
    });
  });

  document.getElementById('copy-deposit-message-btn')?.addEventListener('click', async () => {
    if (!waLinks.length) return;
    const latest = waLinks[0];
    const wompi = waLinks.find((l) => l.provider === 'wompi');
    const bold = waLinks.find((l) => l.provider === 'bold');
    const lines = [
      `Hola ${guestName || ''}! 🌴`,
      '',
      'Para confirmar tu reserva en Casa Gaviota,',
      'necesitamos el depósito de:',
      '',
      `💳 $${latest.amount.toLocaleString('es-CO')} COP`,
      '',
      'Puedes pagar aquí:',
    ];
    if (wompi) lines.push(`- Wompi: ${wompi.url}`);
    if (bold) lines.push(`- Bold: ${bold.url}`);
    lines.push(
      '',
      'Una vez confirmado el pago bloqueamos',
      'tus fechas. ¡Gracias! 🌊',
    );
    const message = lines.join('\n');
    const btn = document.getElementById('copy-deposit-message-btn');
    try {
      await navigator.clipboard.writeText(message);
      if (btn) { const original = btn.textContent; btn.textContent = 'Copied!'; setTimeout(() => { if (btn) btn.textContent = original; }, 1500); }
    } catch {
      // clipboard API unavailable — nothing else to do here
    }
  });
</script>
