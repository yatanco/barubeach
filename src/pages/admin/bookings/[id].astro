---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireDb } from '../../../lib/db';
import {
  money, shortDate, timeAgo, channelBadgeClass,
  BOOKING_CHANNELS, BOOKING_CHANNEL_LABELS, DEFAULT_COMMISSION_RATE,
  PROVIDER_PAYMENT_METHODS, PROVIDER_PAYMENT_METHOD_LABELS,
} from '../../../lib/crm';

export const prerender = false;
interface ChargeRow {
  id:string; category:string; description:string; amount_cents:number; cost_cents:number; currency:string;
  paid_cents:number;
}
interface PaymentLinkRow {
  id:string; charge_description:string; amount_cents:number; provider:string; url:string; status:string; created_at:string; expires_at:string|null;
}
interface ProviderPaymentRow {
  id:string; provider_name:string; service:string; amount_cents:number; method:string; paid_at:string; notes:string|null;
}
interface RCRow {
  category: string; // '' for freeform extra lines
  label: string;
  chargeId: string;
  revenueCents: number;
  costCents: number;
}

const STANDARD_CATEGORIES = ['accommodation', 'food', 'transport'] as const;
const STANDARD_LABELS: Record<typeof STANDARD_CATEGORIES[number], string> = {
  accommodation: 'Accommodation', food: 'Food', transport: 'Transport',
};

const db = requireDb(Astro.locals);
const booking = await db.prepare('SELECT * FROM bookings WHERE id = ?1').bind(Astro.params.id).first<any>();
if (!booking) return Astro.redirect('/admin');
const charges = (await db.prepare(`SELECT c.*,
  COALESCE((SELECT SUM(p.amount_cents) FROM payments p WHERE p.charge_id = c.id), 0) AS paid_cents
  FROM charges c WHERE c.booking_id = ?1 ORDER BY c.created_at`).bind(booking.id).all<ChargeRow>()).results;
const lastSync = booking.source === 'hosthub_ical'
  ? await db.prepare(`SELECT synced_at FROM sync_log ORDER BY synced_at DESC LIMIT 1`).first<{ synced_at: string }>()
  : null;

const totalRevenue = charges.reduce((sum, c) => sum + c.amount_cents, 0);
const totalCost = charges.reduce((sum, c) => sum + c.cost_cents, 0);
const paid = charges.reduce((sum, c) => sum + c.paid_cents, 0);
const chargeViews = charges.map((charge) => {
  const balance = charge.amount_cents - charge.paid_cents;
  return { ...charge, balance, paymentStatus: charge.paid_cents <= 0 ? 'unpaid' : balance <= 0 ? 'paid' : 'partial' };
});

const standardRows: RCRow[] = STANDARD_CATEGORIES.map((cat) => {
  const charge = charges.find((c) => c.category === cat) ?? null;
  return { category: cat, label: STANDARD_LABELS[cat], chargeId: charge?.id ?? '', revenueCents: charge?.amount_cents ?? 0, costCents: charge?.cost_cents ?? 0 };
});
const extraRows: RCRow[] = charges
  .filter((c) => !(STANDARD_CATEGORIES as readonly string[]).includes(c.category))
  .map((c) => ({ category: '', label: c.description, chargeId: c.id, revenueCents: c.amount_cents, costCents: c.cost_cents }));
const rcRows: RCRow[] = [...standardRows, ...extraRows];
const accommodationCents = standardRows.find((r) => r.category === 'accommodation')?.revenueCents ?? 0;

const airbnbPayoutCents = booking.airbnb_payout_cents ?? 0;
const commissionRate = booking.commission_rate ?? DEFAULT_COMMISSION_RATE;
const otaCommissionCents = booking.ota_commission_cents ?? 0;
// Live preview from current charges + rate — kept separate from the persisted
// ota_commission_cents (used in Net Contribution below) so the commission box
// stays internally consistent even before the rate cell has been saved.
const commissionPreviewCents = Math.round(accommodationCents * commissionRate / 100 * 1.19);

const paymentLinks = (await db.prepare(`SELECT * FROM payment_links WHERE booking_id = ?1 ORDER BY created_at DESC`).bind(booking.id).all<PaymentLinkRow>()).results;
const providerPayments = (await db.prepare(`SELECT * FROM provider_payments WHERE booking_id = ?1 ORDER BY paid_at DESC`).bind(booking.id).all<ProviderPaymentRow>()).results;
const providerPaymentsTotal = providerPayments.reduce((sum, item) => sum + item.amount_cents, 0);

// Airbnb collects accommodation revenue directly (payout is net of Airbnb's own cut), so it's
// added on top of charges rather than replacing them; ota_commission_cents is only ever
// non-zero for Booking.com.
const netContribution = totalRevenue + airbnbPayoutCents - otaCommissionCents - totalCost - providerPaymentsTotal;
const perNight = booking.nights > 0 ? Math.round(netContribution / booking.nights) : 0;
const perGuest = booking.adults > 0 ? Math.round(netContribution / booking.adults) : 0;
const guests = booking.adults + booking.children;

const notice = Astro.url.searchParams.get('saved');
---
<AdminLayout title={booking.guest_name}>
  <p><a href="/admin">← Dashboard</a></p>
  {notice && <div class="alert">Saved successfully.</div>}
  <div class="actions" style="justify-content:space-between;margin-bottom:22px">
    <div>
      <div class="actions"><h1 style="margin:0">{booking.guest_name}</h1><span class={`badge ${channelBadgeClass(booking.channel)}`}>{BOOKING_CHANNEL_LABELS[booking.channel as typeof BOOKING_CHANNELS[number]] || booking.channel}</span>{booking.source === 'hosthub_ical' && <span class="badge hh">HH</span>}</div>
      <p class="muted">{shortDate(booking.date_from)} → {shortDate(booking.date_to)} · {booking.nights} nights · {booking.adults} adults · {booking.children} children</p>
    </div>
    {booking.guest_phone && <a class="button" href={`https://wa.me/${booking.guest_phone.replace(/\D/g,'')}`} target="_blank">Open WhatsApp</a>}
  </div>

  <section class="card" style="margin-bottom:20px">
    <h2>HostHub reservation</h2>
    <div class="grid grid-2">
      <div class="stack">
        <span><strong>Channel:</strong> <span class={`badge ${channelBadgeClass(booking.channel)}`}>{BOOKING_CHANNEL_LABELS[booking.channel as typeof BOOKING_CHANNELS[number]] || booking.channel}</span></span>
        <span><strong>Reservation ID:</strong> {booking.reservation_id || 'not linked'}</span>
        <span><strong>Source:</strong> {booking.source === 'hosthub_ical' ? 'HostHub iCal sync' : 'Manual entry'}</span>
        <span><strong>Last synced:</strong> {lastSync ? timeAgo(lastSync.synced_at) : 'never'}</span>
        {booking.hosthub_notes && <span class="muted">{booking.hosthub_notes}</span>}
      </div>
      <div class="stack" style="justify-content:center">
        <a class="button secondary" href="https://app.hosthub.com" target="_blank" rel="noopener">Open in HostHub →</a>
        <span class="muted" style="font-size:12px">HostHub owns availability and channel sync. This CRM owns extras, payments and operations.</span>
      </div>
    </div>
  </section>

  <section class="card" style="margin-bottom:20px">
    <h2>Booking details</h2>
    <form class="form-grid" method="POST" action={`/admin/api/bookings/${booking.id}/channel`} id="channel-form">
      <label>Channel
        <select name="channel" id="channel-select">
          {BOOKING_CHANNELS.map((c) => <option value={c} selected={c === booking.channel}>{BOOKING_CHANNEL_LABELS[c]}</option>)}
        </select>
      </label>
      <label id="airbnb-payout-field" style={booking.channel === 'airbnb' ? '' : 'display:none'}>
        Airbnb payout received (COP)<input name="airbnb_payout" inputmode="numeric" value={airbnbPayoutCents / 100} />
      </label>

      {booking.source === 'manual'
        ? <>
            <label>Check-in<input type="date" name="date_from" id="booking-date-from" value={booking.date_from?.slice(0,10) || ''} /></label>
            <label>Checkout<input type="date" name="date_to" id="booking-date-to" value={booking.date_to?.slice(0,10) || ''} /></label>
            <div class="span-2 field-error" id="booking-date-error" style="display:none">Check-out must be after check-in</div>
          </>
        : <div class="span-2 muted" style="font-size:12px">Dates are managed by the HostHub sync — edit the reservation in HostHub, not here.</div>}

      <div class="span-2"><button type="submit" id="channel-save-btn">Save booking details</button></div>
    </form>
  </section>

  <section class="card" style="margin-top:20px">
    <h2>Revenue & cost</h2>
    <div style="overflow-x:auto">
      <table class="rc-table" id="rc-table" data-nights={booking.nights} data-guests={guests}>
        <thead><tr><th>Service</th><th>Revenue</th><th>Cost</th></tr></thead>
        <tbody>
          {rcRows.map((row) => (
            <tr data-category={row.category} data-charge-id={row.chargeId} data-revenue-cents={row.revenueCents} data-cost-cents={row.costCents}>
              <td>{row.label}</td>
              <td class="rc-cell" data-field="revenue">
                <span class="rc-display">{money(row.revenueCents)}</span>
                <input class="rc-input" type="text" inputmode="numeric" value={row.revenueCents / 100} style="display:none" />
              </td>
              <td class="rc-cell" data-field="cost">
                <span class="rc-display">{money(row.costCents)}</span>
                <input class="rc-input" type="text" inputmode="numeric" value={row.costCents / 100} style="display:none" />
              </td>
            </tr>
          ))}
          <tr id="add-line-input-row" style="display:none">
            <td><input id="add-line-description" placeholder="Description" /></td>
            <td><input id="add-line-revenue" inputmode="numeric" placeholder="0" /></td>
            <td><input id="add-line-cost" inputmode="numeric" placeholder="0" /></td>
          </tr>
          <tr id="add-line-actions-row" style="display:none">
            <td colspan="3" style="text-align:right">
              <button type="button" class="secondary" id="add-line-cancel">Cancel</button>
              <button type="button" id="add-line-save">Save</button>
            </td>
          </tr>
          <tr class="rc-total-row">
            <td><strong>Total</strong></td>
            <td><strong class="amount" id="total-revenue">{money(totalRevenue)}</strong></td>
            <td><strong class="amount" id="total-cost">{money(totalCost)}</strong></td>
          </tr>
        </tbody>
      </table>
    </div>
    <button type="button" class="secondary" id="add-line-btn" style="margin-top:12px">+ Add line</button>
    <p class="field-error" id="rc-error" style="display:none;margin-top:10px"></p>

    {booking.channel === 'booking.com' && (
      <div class="commission-box">
        <h3 style="margin-bottom:10px">Booking.com commission</h3>
        <div class="row" style="border-top:0;padding-top:0">
          <span>Rate</span>
          <span class="rc-cell" data-field="rate" id="commission-rate-cell">
            <span class="rc-display amount">{commissionRate}%</span>
            <input class="rc-input" type="text" inputmode="decimal" value={commissionRate} style="display:none" />
          </span>
        </div>
        <div class="row"><span>Commission</span><span class="amount" id="commission-amount">{money(Math.round(accommodationCents * commissionRate / 100))}</span></div>
        <div class="row"><span>VAT (19%)</span><span class="amount" id="commission-vat">{money(Math.round(accommodationCents * commissionRate / 100 * 0.19))}</span></div>
        <div class="row"><strong>Total</strong><strong class="amount" id="commission-total">{money(commissionPreviewCents)}</strong></div>
        <p class="muted" style="font-size:12px;margin:10px 0 0">Rate varies by booking (Genius discounts etc). Default 18%. Click the rate to edit it.</p>
      </div>
    )}

    {booking.channel === 'airbnb' && (
      <div class="info-box">✅ Stay paid by Airbnb automatically. Focus on food and transport upsells.</div>
    )}

    <div class="contribution-box">
      <div class="row" style="border-top:0;padding-top:0"><strong>Net contribution</strong><strong class="amount" id="net-contribution">{money(netContribution)}</strong></div>
      <div class="row"><span>Per night</span><span class="amount" id="per-night">{money(perNight)}</span></div>
      <div class="row"><span>Per guest</span><span class="amount" id="per-guest">{money(perGuest)}</span></div>
    </div>
  </section>

  <section class="card" style="margin-top:20px">
    <h2>Payments received</h2>
    {chargeViews.filter((c) => c.amount_cents > 0).length === 0 && <p class="muted">Add revenue in the table above to begin tracking payments.</p>}
    {chargeViews.filter((c) => c.amount_cents > 0).map((charge) => (
      <div class="row">
        <div class="stack">
          <div class="actions"><h3>{charge.description}</h3><span class="badge">{charge.paymentStatus}</span></div>
          <span>{money(charge.paid_cents, charge.currency)} received of {money(charge.amount_cents, charge.currency)}</span>
        </div>
        {charge.balance > 0 && <form class="inline" method="POST" action={`/admin/api/charges/${charge.id}/payments`}>
          <label>Payment (COP)<input name="amount" inputmode="numeric" required value={Math.max(0,charge.balance/100)} /></label>
          <label>Method<input name="method" placeholder="Transfer / cash" /></label>
          <label>Reference<input name="reference" /></label>
          <button type="submit">Record</button>
        </form>}
      </div>
    ))}
  </section>

  <section class="card" style="margin-top:20px">
    <h2>Payment links</h2>
    <form class="form-grid" id="payment-link-form">
      <label class="span-2">Description<input name="description" required placeholder="Depósito 50%" id="link-description" /></label>
      <label>Amount (COP)<input name="amount" inputmode="numeric" required placeholder="750.000" id="link-amount" /></label>
      <div class="span-2 actions" style="align-items:flex-start;flex-wrap:wrap;gap:16px">
        <div class="stack" style="gap:6px">
          <button type="submit" data-provider="wompi" style="background:#3369ff">🔵 Generate Wompi link</button>
          <span class="field-error" id="wompi-link-error" style="display:none"></span>
        </div>
        <div class="stack" style="gap:6px">
          <button type="submit" data-provider="bold" style="background:#ffc93c;color:#261d1a">🟡 Generate Bold link</button>
          <span class="field-error" id="bold-link-error" style="display:none"></span>
        </div>
      </div>
    </form>

    {paymentLinks.length === 0 && <p class="muted" style="margin-top:14px">No payment links generated yet.</p>}
    {paymentLinks.length > 0 && (
      <table style="margin-top:14px">
        <thead><tr><th>Provider</th><th>Description</th><th>Amount</th><th>Status</th><th>Link</th></tr></thead>
        <tbody>
          {paymentLinks.map((link) => (
            <tr>
              <td><span class="badge">{link.provider}</span></td>
              <td>{link.charge_description}</td>
              <td class="amount">{money(link.amount_cents)}</td>
              <td><span class={`badge ${link.status === 'active' ? 'confirmed' : 'lost'}`}>{link.status}</span></td>
              <td class="actions">
                <button type="button" class="secondary copy-link-btn" data-url={link.url}>Copy</button>
                <a class="button secondary" href={link.url} target="_blank" rel="noopener">Open</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    {paymentLinks.length > 0 && booking.guest_name && (
      <div class="stack" style="margin-top:16px">
        <button type="button" class="secondary" id="copy-wa-message-btn">📋 Copy WhatsApp message</button>
      </div>
    )}
  </section>

  <section class="card" style="margin-top:20px">
    <div class="actions" style="justify-content:space-between">
      <h2>Provider payments</h2>
      <button type="button" class="secondary" id="open-add-provider-payment">+ Add provider payment</button>
    </div>
    {providerPayments.length === 0 && <p class="muted">No supplier payments recorded yet.</p>}
    {providerPayments.length > 0 && (
      <>
        <table>
          <thead><tr><th>Provider</th><th>Service</th><th>Amount</th><th>Method</th><th>Paid</th><th>Notes</th></tr></thead>
          <tbody>
            {providerPayments.map((payment) => (
              <tr>
                <td>{payment.provider_name}</td>
                <td>{payment.service}</td>
                <td class="amount">{money(payment.amount_cents)}</td>
                <td>{PROVIDER_PAYMENT_METHOD_LABELS[payment.method as typeof PROVIDER_PAYMENT_METHODS[number]] || payment.method}</td>
                <td>{shortDate(payment.paid_at)}</td>
                <td class="muted">{payment.notes || '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <div class="row"><strong>Total provider payments</strong><strong class="amount" id="provider-payments-total" data-cents={providerPaymentsTotal}>{money(providerPaymentsTotal)}</strong></div>
      </>
    )}
  </section>

  <dialog id="add-provider-payment-dialog">
    <form method="POST" action={`/admin/api/bookings/${booking.id}/provider-payments`}>
      <div class="actions" style="justify-content:space-between;margin-bottom:14px">
        <h2 style="margin:0">Add provider payment</h2>
        <button type="button" class="secondary" data-close-dialog>Close</button>
      </div>
      <div class="form-grid">
        <label>Provider name<input name="provider_name" required placeholder="Capitán Andrés" /></label>
        <label>Service<input name="service" required placeholder="Boat transfer" /></label>
        <label>Amount (COP)<input name="amount" inputmode="numeric" required placeholder="300.000" /></label>
        <label>Method
          <select name="method">
            {PROVIDER_PAYMENT_METHODS.map((m) => <option value={m}>{PROVIDER_PAYMENT_METHOD_LABELS[m]}</option>)}
          </select>
        </label>
        <label>Date paid<input type="date" name="paid_at" required value={new Date().toISOString().slice(0,10)} /></label>
        <label class="span-2">Notes<textarea name="notes"></textarea></label>
      </div>
      <div class="actions" style="justify-content:flex-end;margin-top:16px">
        <button type="button" class="secondary" data-close-dialog>Cancel</button>
        <button type="submit">Save payment</button>
      </div>
    </form>
  </dialog>
</AdminLayout>

<style>
  .contribution-box { background:#E6C497; color:#57392E; border-radius:10px; padding:6px 16px; margin-top:16px; }
  .contribution-box .row { border-top:1px solid rgb(87 57 46 / 15%); }
  .contribution-box .row:first-child { border-top:0; }
  .contribution-box .amount { color:#57392E; }
  .commission-box { background:#f6f3f1; border:1px solid var(--line); border-radius:10px; padding:6px 16px; margin-top:16px; }
  .info-box { background:#dff8f1; color:#116149; border-radius:10px; padding:14px 16px; margin-top:16px; font-weight:700; }
  .field-error { color:var(--red); font-size:12px; margin-top:-8px; }
  .rc-table { border-collapse:collapse; width:100%; margin-top:4px; table-layout:fixed; }
  .rc-table th, .rc-table td { padding:10px 8px; text-align:left; border-bottom:1px solid var(--line); }
  .rc-table th:nth-child(1), .rc-table td:nth-child(1) { width:50%; }
  .rc-table th:nth-child(2), .rc-table td:nth-child(2) { width:25%; }
  .rc-table th:nth-child(3), .rc-table td:nth-child(3) { width:25%; }
  .rc-table th { color:#756b67; font-size:11px; text-transform:uppercase; letter-spacing:.04em; }
  .rc-table th:not(:first-child), .rc-table td:not(:first-child) { text-align:right; }
  .rc-cell { cursor:pointer; font-variant-numeric:tabular-nums; }
  .rc-cell .rc-display { border-bottom:1px dotted transparent; }
  .rc-cell:hover .rc-display { border-bottom-color:#a89890; }
  .rc-input { width:100%; max-width:140px; text-align:right; padding:4px 6px; }
  .rc-total-row td { border-top:2px solid var(--ink); border-bottom:0; padding-top:12px; }
  #add-line-input-row input { padding:6px 8px; }
  tr.rc-save-flash { background:#dff8f1; transition:background 0.6s ease; }
  tr.rc-error-flash { background:#fee4e2; }
  dialog#add-provider-payment-dialog { border:1px solid var(--line); border-radius:14px; padding:22px; max-width:520px; width:calc(100% - 40px); box-shadow:0 10px 40px rgb(38 29 26 / 18%); }
  dialog#add-provider-payment-dialog::backdrop { background:rgb(38 29 26 / 35%); }
</style>

<script>
  const channelSelect = document.getElementById('channel-select');
  const airbnbField = document.getElementById('airbnb-payout-field');
  function syncChannelFields() {
    if (!(channelSelect instanceof HTMLSelectElement)) return;
    if (airbnbField) (airbnbField as HTMLElement).style.display = channelSelect.value === 'airbnb' ? '' : 'none';
  }
  channelSelect?.addEventListener('change', syncChannelFields);
  syncChannelFields();

  function wireDateValidation(checkinId: string, checkoutId: string, errorId: string, submitId: string) {
    const checkin = document.getElementById(checkinId) as HTMLInputElement | null;
    const checkout = document.getElementById(checkoutId) as HTMLInputElement | null;
    const error = document.getElementById(errorId);
    const submit = document.getElementById(submitId) as HTMLButtonElement | null;
    if (!checkin || !checkout) return;

    function addDay(dateStr: string): string {
      const d = new Date(`${dateStr}T00:00:00Z`);
      d.setUTCDate(d.getUTCDate() + 1);
      return d.toISOString().slice(0, 10);
    }
    function isInvalid(): boolean {
      return !!(checkin!.value && checkout!.value && checkout!.value <= checkin!.value);
    }
    function refresh() {
      const invalid = isInvalid();
      if (error) (error as HTMLElement).style.display = invalid ? '' : 'none';
      if (submit) submit.disabled = invalid;
    }

    checkin.addEventListener('change', () => {
      checkout!.min = checkin!.value ? addDay(checkin!.value) : '';
      if (isInvalid()) checkout!.value = '';
      refresh();
    });
    checkout.addEventListener('change', refresh);

    if (checkin.value) checkout.min = addDay(checkin.value);
    refresh();
  }

  wireDateValidation('booking-date-from', 'booking-date-to', 'booking-date-error', 'channel-save-btn');
</script>

<script define:vars={{ bookingId: booking.id, channel: booking.channel, guestName: booking.guest_name, waLinks: paymentLinks.map((l: any) => ({ provider: l.provider, description: l.charge_description, amount: l.amount_cents / 100, url: l.url })) }}>
  function pesosFromInput(str) {
    const n = Number(String(str).replace(/[^0-9]/g, ''));
    return Number.isFinite(n) ? n : 0;
  }
  function formatCOP(pesos) {
    return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(pesos);
  }

  function flashRow(el, ok) {
    el.classList.add(ok ? 'rc-save-flash' : 'rc-error-flash');
    setTimeout(() => el.classList.remove('rc-save-flash', 'rc-error-flash'), 700);
  }

  function showRcError(message) {
    const box = document.getElementById('rc-error');
    if (!box) return;
    box.textContent = message;
    box.style.display = '';
    setTimeout(() => { box.style.display = 'none'; }, 5000);
  }

  const rcTable = document.getElementById('rc-table');

  async function saveRow(tr) {
    const chargeId = tr.dataset.chargeId;
    const category = tr.dataset.category;
    const revenue = Number(tr.dataset.revenueCents || '0') / 100;
    const cost = Number(tr.dataset.costCents || '0') / 100;
    const url = chargeId ? `/admin/api/charges/${chargeId}/amounts` : `/admin/api/bookings/${bookingId}/charges/standard`;
    const body = chargeId ? { revenue, cost } : { category, revenue, cost };
    try {
      const res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      const data = await res.json();
      if (data.success) {
        if (!chargeId && data.chargeId) tr.dataset.chargeId = data.chargeId;
        flashRow(tr, true);
        return true;
      }
      flashRow(tr, false);
      showRcError(data.error || 'Could not save.');
      return false;
    } catch {
      flashRow(tr, false);
      showRcError('Network error — could not save.');
      return false;
    }
  }

  function recomputeTotals() {
    let totalRevenueCents = 0;
    let totalCostCents = 0;
    let accommodationRevenueCents = 0;
    rcTable?.querySelectorAll('tbody > tr[data-revenue-cents]').forEach((tr) => {
      totalRevenueCents += Number(tr.dataset.revenueCents || '0');
      totalCostCents += Number(tr.dataset.costCents || '0');
      if (tr.dataset.category === 'accommodation') accommodationRevenueCents = Number(tr.dataset.revenueCents || '0');
    });
    const totalRevenueEl = document.getElementById('total-revenue');
    const totalCostEl = document.getElementById('total-cost');
    if (totalRevenueEl) totalRevenueEl.textContent = formatCOP(totalRevenueCents / 100);
    if (totalCostEl) totalCostEl.textContent = formatCOP(totalCostCents / 100);

    let commissionCents = 0;
    if (channel === 'booking.com') {
      const rateInput = document.querySelector('#commission-rate-cell .rc-input');
      const rate = rateInput ? Number(rateInput.value) || 0 : 0;
      commissionCents = Math.round(accommodationRevenueCents * rate / 100 * 1.19);
      const commissionEl = document.getElementById('commission-amount');
      const vatEl = document.getElementById('commission-vat');
      const totalEl = document.getElementById('commission-total');
      if (commissionEl) commissionEl.textContent = formatCOP(Math.round(accommodationRevenueCents * rate / 100) / 100);
      if (vatEl) vatEl.textContent = formatCOP(Math.round(accommodationRevenueCents * rate / 100 * 0.19) / 100);
      if (totalEl) totalEl.textContent = formatCOP(commissionCents / 100);
    }

    const airbnbInput = document.querySelector('input[name="airbnb_payout"]');
    const airbnbCents = airbnbInput ? pesosFromInput(airbnbInput.value) * 100 : 0;
    const providerTotalCents = Number(document.getElementById('provider-payments-total')?.dataset.cents || '0');
    const netCents = totalRevenueCents + airbnbCents - commissionCents - totalCostCents - providerTotalCents;
    const netEl = document.getElementById('net-contribution');
    if (netEl) netEl.textContent = formatCOP(netCents / 100);

    const nights = Number(rcTable?.dataset.nights || '0');
    const guests = Number(rcTable?.dataset.guests || '0');
    const perNightEl = document.getElementById('per-night');
    const perGuestEl = document.getElementById('per-guest');
    if (perNightEl) perNightEl.textContent = formatCOP(nights > 0 ? Math.round(netCents / nights) / 100 : 0);
    if (perGuestEl) perGuestEl.textContent = formatCOP(guests > 0 ? Math.round(netCents / guests) / 100 : 0);
  }

  function wireMoneyCell(cell) {
    const display = cell.querySelector('.rc-display');
    const input = cell.querySelector('.rc-input');
    if (!display || !input) return;
    let lastGoodPesos = input.value;
    display.addEventListener('click', () => {
      display.style.display = 'none';
      input.style.display = '';
      input.focus();
      input.select();
    });
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') input.blur();
      if (event.key === 'Escape') { input.value = lastGoodPesos; input.blur(); }
    });
    input.addEventListener('blur', async () => {
      const pesos = pesosFromInput(input.value);
      const tr = cell.closest('tr');
      const field = cell.dataset.field;
      const previousCents = field === 'revenue' ? tr?.dataset.revenueCents : tr?.dataset.costCents;
      input.value = String(pesos);
      display.textContent = formatCOP(pesos);
      display.style.display = '';
      input.style.display = 'none';
      if (!tr) return;
      if (field === 'revenue') tr.dataset.revenueCents = String(pesos * 100);
      else tr.dataset.costCents = String(pesos * 100);
      recomputeTotals();
      const ok = await saveRow(tr);
      if (ok) {
        lastGoodPesos = String(pesos);
      } else {
        // Roll back to the last value the server actually accepted.
        const revertedPesos = Number(previousCents || '0') / 100;
        input.value = String(revertedPesos);
        display.textContent = formatCOP(revertedPesos);
        if (field === 'revenue') tr.dataset.revenueCents = previousCents || '0';
        else tr.dataset.costCents = previousCents || '0';
        recomputeTotals();
      }
    });
  }
  rcTable?.querySelectorAll('.rc-cell').forEach(wireMoneyCell);

  const rateCell = document.getElementById('commission-rate-cell');
  if (rateCell) {
    const display = rateCell.querySelector('.rc-display');
    const input = rateCell.querySelector('.rc-input');
    if (display && input) {
      const originalRate = input.value;
      display.addEventListener('click', () => {
        display.style.display = 'none';
        input.style.display = '';
        input.focus();
        input.select();
      });
      input.addEventListener('keydown', (event) => {
        if (event.key === 'Enter') input.blur();
        if (event.key === 'Escape') { input.value = originalRate; input.blur(); }
      });
      input.addEventListener('blur', async () => {
        const rate = Number(input.value.replace(/[^0-9.]/g, '')) || 0;
        input.value = String(rate);
        display.textContent = `${rate}%`;
        display.style.display = '';
        input.style.display = 'none';
        recomputeTotals();
        try {
          const res = await fetch(`/admin/api/bookings/${bookingId}/commission-rate`, {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ rate }),
          });
          const data = await res.json();
          flashRow(rateCell.closest('.row'), !!data.success);
        } catch {
          flashRow(rateCell.closest('.row'), false);
        }
      });
    }
  }

  document.querySelector('input[name="airbnb_payout"]')?.addEventListener('input', recomputeTotals);

  const addLineBtn = document.getElementById('add-line-btn');
  const addLineInputRow = document.getElementById('add-line-input-row');
  const addLineActionsRow = document.getElementById('add-line-actions-row');
  addLineBtn?.addEventListener('click', () => {
    if (addLineInputRow) addLineInputRow.style.display = '';
    if (addLineActionsRow) addLineActionsRow.style.display = '';
    addLineBtn.style.display = 'none';
    document.getElementById('add-line-description')?.focus();
  });
  document.getElementById('add-line-cancel')?.addEventListener('click', () => {
    if (addLineInputRow) addLineInputRow.style.display = 'none';
    if (addLineActionsRow) addLineActionsRow.style.display = 'none';
    if (addLineBtn) addLineBtn.style.display = '';
  });
  document.getElementById('add-line-save')?.addEventListener('click', async () => {
    const descriptionInput = document.getElementById('add-line-description');
    const revenueInput = document.getElementById('add-line-revenue');
    const costInput = document.getElementById('add-line-cost');
    const description = descriptionInput.value.trim();
    if (!description) { descriptionInput.focus(); return; }
    const revenue = pesosFromInput(revenueInput.value);
    const cost = pesosFromInput(costInput.value);
    const btn = document.getElementById('add-line-save');
    if (btn instanceof HTMLButtonElement) btn.disabled = true;
    try {
      const res = await fetch(`/admin/api/bookings/${bookingId}/charges/create`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ description, revenue, cost }),
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      } else {
        showRcError(data.error || 'Could not save.');
        if (btn instanceof HTMLButtonElement) btn.disabled = false;
      }
    } catch {
      showRcError('Network error — could not save.');
      if (btn instanceof HTMLButtonElement) btn.disabled = false;
    }
  });

  const linkForm = document.getElementById('payment-link-form');
  linkForm?.querySelectorAll('button[data-provider]').forEach((btn) => {
    btn.addEventListener('click', async (event) => {
      event.preventDefault();
      if (!(btn instanceof HTMLButtonElement)) return;
      const provider = btn.dataset.provider;
      const errorBox = document.getElementById(`${provider}-link-error`);
      const description = (document.getElementById('link-description')).value.trim();
      const amount = Number((document.getElementById('link-amount')).value.replace(/[^0-9]/g, ''));
      if (!description || !amount) return;
      if (errorBox) errorBox.style.display = 'none';
      const original = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Generating…';
      try {
        const res = await fetch(`/admin/api/bookings/${bookingId}/payment-links`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ provider, amount, description }),
        });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else if (errorBox) {
          errorBox.textContent = data.error || 'Could not generate payment link.';
          errorBox.style.display = '';
        }
      } catch {
        if (errorBox) {
          errorBox.textContent = 'Network error — could not reach the server.';
          errorBox.style.display = '';
        }
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  });

  document.querySelectorAll('.copy-link-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-url');
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = original; }, 1500);
      } catch {
        // clipboard API unavailable — nothing else to do here
      }
    });
  });

  document.getElementById('copy-wa-message-btn')?.addEventListener('click', async () => {
    if (!waLinks.length) return;
    const latest = waLinks[0];
    const wompi = waLinks.find((l) => l.provider === 'wompi');
    const bold = waLinks.find((l) => l.provider === 'bold');
    const lines = [
      `Hola ${guestName || ''}! 🌴`,
      '',
      `Link de pago para ${latest.description}:`,
      `💳 $${latest.amount.toLocaleString('es-CO')} COP`,
      '',
    ];
    if (wompi) lines.push(`Wompi: ${wompi.url}`);
    if (bold) lines.push(`Bold: ${bold.url}`);
    lines.push('', 'Válido por 72 horas.');
    const message = lines.join('\n');
    const btn = document.getElementById('copy-wa-message-btn');
    try {
      await navigator.clipboard.writeText(message);
      if (btn) { const original = btn.textContent; btn.textContent = 'Copied!'; setTimeout(() => { if (btn) btn.textContent = original; }, 1500); }
    } catch {
      // clipboard API unavailable — nothing else to do here
    }
  });

  const providerDialog = document.getElementById('add-provider-payment-dialog');
  document.getElementById('open-add-provider-payment')?.addEventListener('click', () => {
    if (providerDialog instanceof HTMLDialogElement) providerDialog.showModal();
  });
  providerDialog?.querySelectorAll('[data-close-dialog]').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (providerDialog instanceof HTMLDialogElement) providerDialog.close();
    });
  });
</script>
