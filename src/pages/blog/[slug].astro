---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const publishDate = post.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const canonical = `https://casagaviota.com/blog/${post.id}`;
---

<Layout
  title={`${post.data.title} | Casa Gaviota Barú`}
  description={post.data.description}
  canonical={canonical}
  lang="en"
  defaultPopupType="stay"
>
  <Header lang="en" />

  <main class="py-16 md:py-24">
    <div class="max-w-[680px] mx-auto px-4 sm:px-6">

      <div class="mb-10">
        <a href="/blog" class="text-xs text-muted hover:text-brown transition-colors uppercase tracking-wider">
          ← Travel Guide
        </a>
      </div>

      <p class="text-sm text-muted mb-4">{publishDate}</p>
      <h1 class="font-serif text-3xl sm:text-4xl md:text-5xl font-semibold leading-tight text-brown mb-10">
        {post.data.title}
      </h1>

      <article class="prose-blog">
        <Content />
      </article>

    </div>
  </main>

  <!-- ARTICLE CTA -->
  <section class="py-20 md:py-28" style="background: #E6C497;">
    <div class="max-w-xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold mb-4 text-brown">Plan a private day in Barú</h2>
      <p class="text-ink/70 leading-relaxed mb-8">
        Casa Gaviota is a private beach house on Isla Barú — one group at a time, no crowds, fresh food.
      </p>
      <button
        onclick="window.dispatchEvent(new CustomEvent('open-wa-popup', {detail:{type:'stay'}}))"
        class="inline-flex items-center gap-2 text-white font-semibold px-8 py-4 rounded-xl hover:opacity-90 transition-opacity text-base cursor-pointer"
        style="background: #25D366;"
      >
        <svg class="w-5 h-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Check Availability →
      </button>
    </div>
  </section>

  <Footer lang="en" />
</Layout>

<style>
  .prose-blog :global(h2) {
    font-family: 'Playfair Display', serif;
    color: #57392E;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .prose-blog :global(p) {
    font-size: 1.125rem;
    line-height: 1.85;
    color: rgba(30, 20, 15, 0.78);
    margin-bottom: 1.35rem;
  }
  .prose-blog :global(a) {
    color: #57392E;
    text-decoration: none;
  }
  .prose-blog :global(a:hover) {
    text-decoration: underline;
  }
  .prose-blog :global(ul),
  .prose-blog :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.35rem;
  }
  .prose-blog :global(ul) { list-style: disc; }
  .prose-blog :global(ol) { list-style: decimal; }
  .prose-blog :global(li) {
    font-size: 1.125rem;
    line-height: 1.75;
    color: rgba(30, 20, 15, 0.78);
    margin-bottom: 0.4rem;
  }
  .prose-blog :global(strong) {
    font-weight: 600;
    color: rgba(30, 20, 15, 0.9);
  }
  @media (max-width: 640px) {
    .prose-blog :global(h2) { font-size: 1.25rem; }
    .prose-blog :global(p),
    .prose-blog :global(li) { font-size: 1rem; }
  }
</style>
