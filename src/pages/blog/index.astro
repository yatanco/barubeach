---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Guía de Viaje — Barú y Cartagena | Casa Gaviota"
  description="Guías honestas para viajeros que buscan privacidad, playas tranquilas y una estadía más natural cerca de Cartagena."
  lang="es"
>
  <Header lang="es" />

  <main class="max-w-4xl mx-auto px-6 py-16">
    <h1 class="font-serif text-4xl text-brown mb-4">Guía de Viaje</h1>
    <p class="text-muted mb-12">
      Guías honestas para viajeros que buscan privacidad,
      playas tranquilas y una estadía más natural en Barú
      y Cartagena.
    </p>

    <div id="soro-blog"></div>
    <script src="https://app.trysoro.com/api/embed/08152de2-dff8-4912-ae27-81ac87b3cd76" defer></script>
  </main>

  <Footer lang="es" />
</Layout>
