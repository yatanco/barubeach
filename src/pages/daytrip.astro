---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WAInlineForm from '../components/WAInlineForm.tsx';
---

<Layout
  title="Day Trip to Barú — Private Beach House | Casa Gaviota"
  description="A private day trip to a beach house on Isla Barú near Cartagena. Transport, private beach, and fresh Caribbean lunch — all included. No beach clubs, no crowds."
  lang="en"
  defaultPopupType="daytrip"
>
  <Header lang="en" altHref="/es/pasadia" />

  <!-- HERO -->
  <section class="relative min-h-screen flex items-center justify-center">
    <img
      src="/images/daytrip-1.jpg"
      alt="Day trip to Casa Gaviota private beach in Barú"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      width="1280"
      height="720"
    />
    <div class="absolute inset-0" style="background: rgba(87,57,46,0.50);"></div>
    <div class="relative z-10 text-center text-white px-6 max-w-3xl mx-auto py-24">
      <p class="text-sand text-xs sm:text-sm uppercase tracking-widest font-medium mb-5">Barú · Colombia</p>
      <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl font-semibold leading-tight mb-4">
        Private Day Trip
      </h1>
      <h2 class="text-xl sm:text-2xl font-light mb-3">Your beach. Your group. Your day.</h2>
      <p class="text-sm sm:text-base text-white/70 mb-2 uppercase tracking-wider">
        Transport · private beach · fresh lunch · all included
      </p>
      <p class="text-white/60 text-sm mb-8">We host one group at a time.</p>

      <button
        onclick="window.dispatchEvent(new CustomEvent('open-wa-popup', {detail:{type:'daytrip'}}))"
        class="bg-sand text-brown font-semibold px-8 py-4 rounded-full text-base hover:opacity-90 transition-opacity cursor-pointer mb-4"
      >
        Check Availability →
      </button>
      <p class="text-white/60 text-sm italic mb-6">One group at a time — your beach, exclusively.</p>
      <a href="#pricing" class="block text-white/45 text-sm hover:text-white/70 transition-colors">
        See pricing ↓
      </a>
    </div>
  </section>

  <!-- REVIEWS -->
  <section id="reviews" class="py-20 bg-rose/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-3 text-brown">What our guests say</h2>
        <p class="text-muted text-sm">⭐ 4.8 · Airbnb, Booking.com &amp; Google</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="reviews-initial">
        {[
          'Best day trip we did in Colombia. Private beach, incredible food, and no tourists.',
          'The boat ride alone was worth it. Then the beach house blew us away.',
          'We wanted total privacy and that is exactly what we got. Just our group, the ocean, and amazing service.',
          'The lunch was better than any restaurant in Cartagena. And we did not share the beach with anyone.',
        ].map(quote => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-terracotta/15">
            <p class="text-terracotta text-3xl leading-none mb-3">"</p>
            <p class="text-ink/75 text-sm leading-relaxed">{quote}</p>
          </div>
        ))}
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-4 hidden" id="reviews-extra">
        {[
          'I have done beach clubs in Cartagena. This is not that. This is so much better.',
          'Our kids were free to run, swim, and play. We were free to relax. No one bothered us.',
          'Manuel and his team are legends. Food, service, everything was perfect.',
          'Honestly one of the highlights of our whole trip to Colombia.',
          'We came for one day and already booked a full stay for next year.',
        ].map(quote => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-terracotta/15">
            <p class="text-terracotta text-3xl leading-none mb-3">"</p>
            <p class="text-ink/75 text-sm leading-relaxed">{quote}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 text-center">
        <button
          id="show-more-reviews"
          class="border border-brown text-brown font-medium text-sm px-6 py-3 rounded-full hover:bg-brown/5 transition"
        >
          Show more reviews
        </button>
      </div>
    </div>
  </section>
  <script is:inline>
    document.getElementById('show-more-reviews')?.addEventListener('click', function() {
      document.getElementById('reviews-extra')?.classList.remove('hidden');
      this.style.display = 'none';
    });
  </script>

  <!-- ALL-IN PRICING -->
  <section id="pricing" class="py-20 md:py-28" style="background: #E6C497;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12">
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-3 text-brown">Simple, all-in pricing</h2>
        <p class="text-ink/70">Transport, house, beach, and lunch — all included. No surprises.</p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
        {[
          { group: 'Couple', people: '2 people', price: '$300 USD' },
          { group: 'Family', people: '4 people', price: '$500 USD' },
          { group: 'Group of 6', people: '6 people', price: '$700 USD' },
          { group: 'Group of 8', people: '8 people', price: '$900 USD' },
        ].map(({ group, people, price }) => (
          <div class="bg-white rounded-2xl p-5 text-center shadow-sm">
            <p class="font-semibold text-brown text-sm mb-1">{group}</p>
            <p class="text-xs text-ink/50 mb-3">{people}</p>
            <p class="text-xl font-bold text-brown">{price}</p>
          </div>
        ))}
      </div>

      <div class="bg-white/60 rounded-2xl p-6 text-center mb-8">
        <p class="text-sm text-ink/70 font-medium">All-in price. Includes transport from Cartagena, private beach access, and fresh Caribbean lunch.</p>
      </div>

      <div class="text-center">
        <button
          onclick="window.dispatchEvent(new CustomEvent('open-wa-popup', {detail:{type:'daytrip'}}))"
          class="inline-flex items-center gap-2 bg-brown text-white px-8 py-4 rounded-full text-sm font-semibold hover:opacity-90 transition cursor-pointer"
        >
          Check Availability →
        </button>
      </div>
    </div>
  </section>

  <!-- PRIVATE VERSION -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div data-lightbox="private" class="grid grid-cols-2 gap-3">
          <img
            src="/images/beach-1.jpg"
            alt="Private beach at Casa Gaviota"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="300"
            height="225"
          />
          <img
            src="/images/beach-2.jpg"
            alt="Exclusive beach access at Casa Gaviota"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="300"
            height="225"
          />
        </div>
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 leading-snug text-brown">
            A private version of the beach.
          </h2>
          <p class="text-ink/70 leading-relaxed mb-4">
            This is not a beach club. You are not sharing with 50 strangers at a bar playing reggaeton. This is a real beach house on 80 meters of private beach, reserved entirely for your group.
          </p>
          <p class="text-ink/70 leading-relaxed">Manuel and the team handle everything — pickup, arrival, food, and return. You just show up.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU'RE BOOKING -->
  <section class="py-16 md:py-20" style="background: #FAFAF5;">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-brown text-center mb-10">What you are booking</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {[
          { icon: '🌊', title: 'Private beach', desc: '80 meters of beach — only your group. No vendors, no music from the neighbors.' },
          { icon: '🏠', title: 'The whole house', desc: 'Private beach house, shaded areas, hammocks, outdoor showers. Use it all.' },
          { icon: '🍽️', title: 'Fresh Caribbean lunch', desc: 'Prepared on-site by the house team. Fish, rice, patacones, fresh fruit. Included.' },
        ].map(({ icon, title, desc }) => (
          <div class="text-center p-6">
            <div class="text-4xl mb-4">{icon}</div>
            <h3 class="font-semibold text-brown mb-2">{title}</h3>
            <p class="text-sm text-ink/65 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT IS INCLUDED -->
  <section class="py-20 md:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold text-brown text-center mb-12">What is included</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          'Round-trip transport from Cartagena',
          'Private beach house for the day',
          '80 meters of private beach, just for your group',
          'Fresh Caribbean lunch',
          'Non-alcoholic drinks',
          'Hammocks and outdoor seating areas',
          'Showers and changing areas',
          'Service from the house team throughout the day',
        ].map(item => (
          <div class="flex items-center gap-3 p-4 bg-sand/20 rounded-xl">
            <span class="text-terracotta font-bold flex-shrink-0">✓</span>
            <span class="text-sm text-ink/80">{item}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- A TYPICAL DAY -->
  <section class="py-24 md:py-32 bg-brown text-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-sand text-xs uppercase tracking-widest mb-12">A Typical Day</p>
      <div class="space-y-6">
        {[
          { time: '7:30 AM', label: '🌅 Pickup in Cartagena' },
          { time: '9:00 AM', label: '🚤 Arrive at Casa Gaviota' },
          { time: '9:00 – 1:00', label: '🏖️ Swim, explore, relax on the beach' },
          { time: '1:00 PM', label: '🍽️ Fresh Caribbean lunch' },
          { time: '1:00 – 3:00', label: '🌴 Beach, hammocks, rest' },
          { time: '3:00 PM', label: '🌇 Return to Cartagena' },
          { time: '~5:00 PM', label: '🏙️ Arrive back in Cartagena' },
        ].map(({ time, label }, i) => (
          <div class={`flex items-center gap-4 ${i % 2 === 1 ? 'opacity-60' : ''}`}>
            <span class="text-sand text-sm w-28 text-right flex-shrink-0">{time}</span>
            <span class="w-2 h-2 rounded-full bg-sand/60 flex-shrink-0"></span>
            <span class="font-serif text-xl text-left">{label}</span>
          </div>
        ))}
      </div>
      <p class="text-white/40 mt-12 text-base">Times are approximate. The day adjusts to you.</p>
      <div data-lightbox="typical-day" class="grid grid-cols-2 gap-3 mt-10 max-w-sm mx-auto">
        <img
          src="/images/daytrip-2.jpg"
          alt="Day trip to Casa Gaviota beach"
          class="rounded-xl w-full aspect-square object-cover opacity-80"
          loading="lazy"
          width="200"
          height="200"
        />
        <img
          src="/images/beach-3.jpg"
          alt="Casa Gaviota beach scene"
          class="rounded-xl w-full aspect-square object-cover opacity-80"
          loading="lazy"
          width="200"
          height="200"
        />
      </div>
    </div>
  </section>

  <!-- FOOD -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 leading-snug text-brown">
            Fresh food, made at the house.
          </h2>
          <p class="text-ink/70 leading-relaxed mb-4">
            The Caribbean lunch is prepared on-site by the house team. Grilled fish, coconut rice, patacones, fresh salads, tropical fruit. Simple, fresh, and genuinely delicious.
          </p>
          <p class="text-ink/70 leading-relaxed mb-8">
            Many guests say it is one of the best meals of their trip to Colombia.
          </p>
          <p class="text-sm font-medium text-ink/50 border-l-2 border-terracotta/40 pl-4 italic">
            "The food was better than restaurants." — Guest review
          </p>
        </div>
        <div data-lightbox="food" class="grid grid-cols-2 gap-3">
          <img
            src="/images/food-1.jpg"
            alt="Fresh Caribbean lunch at Casa Gaviota"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="300"
            height="225"
          />
          <img
            src="/images/food-2.jpg"
            alt="Prepared food at Casa Gaviota"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="300"
            height="225"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- CHOOSE YOUR DAY -->
  <section class="py-16 md:py-20 bg-sand/30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-brown mb-4">Choose your day</h2>
      <p class="text-ink/60 text-sm mb-10">We run private day trips Thursday through Sunday. Only one group per day.</p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        {['Thursday', 'Friday', 'Saturday', 'Sunday'].map(day => (
          <div class="bg-white border border-terracotta/20 rounded-xl py-5 px-4 text-center">
            <p class="font-semibold text-brown text-sm">{day}</p>
            <p class="text-xs text-ink/45 mt-1">Available</p>
          </div>
        ))}
      </div>
      <p class="text-xs text-ink/40 mt-6">Availability subject to confirmation. Contact us to check specific dates.</p>
    </div>
  </section>

  <!-- BEACH CLUB VS PRIVATE COMPARISON -->
  <section class="py-20 md:py-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold text-brown text-center mb-12">
        Beach club or private beach house?
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="rounded-2xl p-7 border-2 border-red-200 bg-red-50/50">
          <h3 class="font-semibold text-red-700 text-sm uppercase tracking-wide mb-5">Beach Club</h3>
          <ul class="space-y-3">
            {[
              'Shared with dozens of strangers',
              'Vendors walking the beach all day',
              'Loud music from neighboring parties',
              'Generic food from a shared kitchen',
              'No privacy or sense of ownership',
              'You have to fight for a good spot',
            ].map(item => (
              <li class="flex items-start gap-2.5 text-sm text-red-800/80">
                <span class="flex-shrink-0 font-bold text-red-400 mt-0.5">✗</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl p-7" style="background: #57392E;">
          <h3 class="font-semibold text-sand text-sm uppercase tracking-wide mb-5">Casa Gaviota</h3>
          <ul class="space-y-3">
            {[
              'Entire beach reserved for your group',
              'No vendors, no strangers, no noise',
              'Complete silence except the ocean',
              'Fresh Caribbean lunch made at the house',
              'Full privacy from arrival to departure',
              'The whole beach is yours all day',
            ].map(item => (
              <li class="flex items-start gap-2.5 text-sm text-white/85">
                <span class="flex-shrink-0 font-bold text-sand mt-0.5">✓</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO THIS IS FOR -->
  <section class="py-20 md:py-28 bg-rose/15">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold text-brown text-center mb-12">Who this is for</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {[
          { icon: '👨‍👩‍👧‍👦', title: 'Families', desc: 'Safe, quiet beach. Kids can run free. Parents actually relax.' },
          { icon: '🎂', title: 'Birthday groups', desc: 'Private setting for a celebration that feels truly special.' },
          { icon: '💑', title: 'Couples', desc: 'Total seclusion. No other people. Just the two of you and the sea.' },
          { icon: '🥂', title: 'Friend groups', desc: 'Bigger groups up to 10. A day everyone will remember.' },
          { icon: '💼', title: 'Corporate teams', desc: 'Offsite or team-building with a backdrop nobody forgets.' },
        ].map(({ icon, title, desc }) => (
          <div class="bg-white rounded-2xl p-6 border border-terracotta/15 shadow-sm">
            <div class="text-3xl mb-3">{icon}</div>
            <h3 class="font-semibold text-brown mb-2">{title}</h3>
            <p class="text-sm text-ink/65 leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="py-20 bg-rose/15">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-12 text-center text-brown">Frequently Asked Questions</h2>
      <div class="space-y-2">
        {[
          {
            q: 'Is transport included?',
            a: 'Yes — included in all day trip packages. We pick you up from Cartagena and bring you back. The boat ride to the house is also included.',
          },
          {
            q: 'Is food included?',
            a: 'Yes — a fresh Caribbean lunch is included in all day trip packages. Grilled fish, coconut rice, patacones, fresh salad, and tropical fruit. Prepared at the house by the team.',
          },
          {
            q: 'What time does the day start and end?',
            a: 'Pickup in Cartagena around 7:30 AM. Arrive at the house around 9:00 AM. Return to Cartagena at 3:00 PM, arriving back around 5:00 PM. Times can be adjusted depending on your group.',
          },
          {
            q: 'Can we bring alcohol or extra food?',
            a: 'Yes — feel free to bring drinks. Alcoholic beverages are not included in the package but are welcome. Just let us know in advance if you have any special requests.',
          },
          {
            q: 'How many people can come?',
            a: 'The house holds up to 8 guests for a day trip. For groups of up to 10, message us to arrange.',
          },
          {
            q: 'What if the weather is bad?',
            a: 'In case of bad weather we coordinate rescheduling or a full refund. We will always communicate with you in advance if conditions look problematic.',
          },
          {
            q: 'What activities can we do?',
            a: 'Swimming, snorkeling, hammock time, walks, boat trips to nearby islands. We can also arrange a live papayera band, kayaks, or other activities on request.',
          },
          {
            q: 'How do I book?',
            a: 'Message us on WhatsApp with your preferred date and number of guests. We will confirm availability and send payment details. A deposit is required to hold your date.',
          },
        ].map(({ q, a }) => (
          <details class="group bg-white rounded-xl border border-terracotta/20 overflow-hidden">
            <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none font-medium text-sm sm:text-base hover:bg-rose/10 transition-colors">
              <span>{q}</span>
              <span class="text-terracotta flex-shrink-0 text-xl leading-none group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="px-5 pb-5 text-ink/65 text-sm leading-relaxed border-t border-terracotta/10 pt-4">
              {a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- DAY TRIP FORM -->
  <section id="book" class="py-20 md:py-28" style="background: #E6C497;">
    <div class="max-w-xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-3 text-brown">Book your private day trip</h2>
        <p class="text-muted">Choose your date and group size. We will confirm and send details within a few hours.</p>
      </div>
      <WAInlineForm lang="en" defaultType="daytrip" client:load />
    </div>
  </section>

  <Footer lang="en" />
</Layout>
