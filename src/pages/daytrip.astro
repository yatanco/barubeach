---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DayTripForm from '../components/DayTripForm.tsx';

const WA = 'https://wa.me/573163946401?text=gaviotadaytrip';
const KEY = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<Layout
  title="Private Day Trip to Barú from Cartagena — Casa Gaviota"
  description="A private beach house as your base for the day. Transport from Cartagena, fresh Caribbean lunch, beach, no shared tours. Perfect for groups, families, and celebrations."
  lang="en"
>
  <Header lang="en" altHref="/es/pasadia" />

  <!-- HERO -->
  <section class="relative min-h-[85vh] flex items-end pb-20 md:items-center md:pb-0">
    <img
      src="/images/daytrip-1.jpg"
      alt="Private beach day trip at Casa Gaviota, Barú"
      class="absolute inset-0 w-full h-full object-cover"
      loading="eager"
      fetchpriority="high"
      width="1280"
      height="720"
    />
    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(87,57,46,0.85) 0%, rgba(87,57,46,0.35) 50%, rgba(87,57,46,0.10) 100%);"></div>
    <div class="relative z-10 w-full max-w-3xl mx-auto px-6 text-white">
      <p class="text-sand text-xs sm:text-sm uppercase tracking-widest font-medium mb-4">Barú · Colombia</p>
      <h1 class="font-serif text-4xl sm:text-5xl md:text-6xl font-semibold leading-tight mb-4">
        Private Day Trip to Barú
      </h1>
      <h2 class="text-lg sm:text-xl font-light mb-4 text-white/90 max-w-xl">
        Just Your Group — No Crowds, No Shared Tours
      </h2>
      <p class="text-sm text-white/70 mb-10 max-w-lg leading-relaxed">
        A private beach house as your base for the day. Transport, food, and space to actually relax or celebrate.
      </p>
      <a
        href={WA}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-sand text-brown px-7 py-4 rounded-full text-sm font-semibold hover:opacity-90 transition shadow-lg"
      >
        Plan your day on WhatsApp →
      </a>
    </div>
  </section>

  <!-- THE PRIVATE VERSION -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <img
            src="/images/beach-1.jpg"
            alt="Private beach at Casa Gaviota"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="600"
            height="450"
          />
        </div>
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 leading-snug text-brown">
            The private version of Barú.
          </h2>
          <p class="text-ink/70 leading-relaxed mb-4">Barú is beautiful.</p>
          <p class="text-ink/70 leading-relaxed mb-6">
            But most day trips from Cartagena are not very relaxing. Crowded beaches. Loud music. Vendors every few minutes. Fixed schedules. Shared spaces.
          </p>
          <p class="text-ink/70 leading-relaxed mb-6">
            Casa Gaviota is different. Here, your group gets a private beach house as your home base for the day. Swim, eat, rest, celebrate, listen to music, or simply do nothing.
          </p>
          <ul class="space-y-2 mb-6">
            {['No rush.', 'No crowds.', 'No pressure.'].map(item => (
              <li class="flex items-center gap-3 font-medium text-ink/80">
                <span class="text-terracotta text-lg">—</span>
                {item}
              </li>
            ))}
          </ul>
          <p class="text-ink/70 leading-relaxed">Just your people, the sea, good food, and a house where you can actually settle in.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT YOU'RE BOOKING -->
  <section class="py-20 bg-rose/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div class="order-2 md:order-1">
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 leading-snug text-brown">
            What you are really booking.
          </h2>
          <p class="text-ink/70 leading-relaxed mb-4">You are not booking a "tour."</p>
          <p class="text-ink/70 leading-relaxed mb-6">
            You are booking a private space for the day. A place where your group can arrive, leave your things safely, eat comfortably, rest in the shade, play music, celebrate, and enjoy Barú without fighting for space.
          </p>
          <p class="text-ink/70 leading-relaxed font-medium">That is why groups choose Casa Gaviota.</p>
        </div>
        <div class="order-1 md:order-2">
          <img
            src="/images/house-1.jpg"
            alt="Casa Gaviota house and social areas"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="600"
            height="450"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT PEOPLE SAY -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-12 text-center text-brown">What People Say</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {[
          'It felt completely private.',
          'It was peaceful and beautiful.',
          'The food was one of the best parts.',
          'We could actually relax.',
          'The team made everything easy.',
        ].map(quote => (
          <div class="bg-white rounded-2xl p-6 shadow-sm border border-terracotta/15">
            <p class="text-terracotta text-3xl leading-none mb-3">"</p>
            <p class="text-ink/75 text-sm leading-relaxed">{quote}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 text-center">
        <p class="text-sm text-ink/50 mb-4">200+ verified reviews across platforms</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="http://airbnb.com/h/casagaviotabaru"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border border-brown text-brown font-medium text-sm px-6 py-3 rounded-full hover:bg-brown/5 transition"
          >
            Read all reviews on Airbnb →
          </a>
          <a
            href="https://share.google/SHahHFkk8vXJIW7hH"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 border border-brown text-brown font-medium text-sm px-6 py-3 rounded-full hover:bg-brown/5 transition"
          >
            Read all reviews on Google →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHAT IS INCLUDED -->
  <section class="py-20 bg-rose/20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">
        <div>
          <img
            src="/images/daytrip-2.jpg"
            alt="Day trip at Casa Gaviota includes private beach access"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-md"
            loading="lazy"
            width="600"
            height="450"
          />
        </div>
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-8 text-brown">What is included</h2>
          <ul class="space-y-4">
            {[
              { icon: '🏠', text: 'Private access to the house for your group' },
              { icon: '🚤', text: 'Transport from Cartagena' },
              { icon: '🍹', text: 'Welcome drink' },
              { icon: '🍽️', text: 'Fresh Caribbean lunch prepared at the house' },
              { icon: '🏖️', text: 'Beach access · hammocks · shaded areas' },
              { icon: '🚿', text: 'Bathrooms and social spaces' },
              { icon: '👤', text: 'On-site support from Manuel and the team' },
              { icon: '🎂', text: 'Help with birthdays and celebrations' },
              { icon: '✨', text: 'Optional upgrades: seafood, music, decoration' },
            ].map(({ icon, text }) => (
              <li class="flex items-start gap-3 text-sm text-ink/70">
                <span class="flex-shrink-0">{icon}</span>
                {text}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- A TYPICAL DAY -->
  <section class="py-20 md:py-28">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-12 text-center text-brown">A typical day</h2>
      <div class="space-y-0">
        {[
          { icon: '🌅', label: 'Morning', text: 'Pickup in Cartagena' },
          { icon: '🚤', label: 'Travel', text: 'Arrive at Casa Gaviota' },
          { icon: '🍹', label: 'Welcome', text: 'Welcome drink — settle in, drop your things' },
          { icon: '🏖️', label: 'Your time', text: 'Swim, rest, music, photos, or just relax' },
          { icon: '🍽️', label: 'Lunch', text: 'Fresh food prepared at the house' },
          { icon: '🌴', label: 'Afternoon', text: 'Free time with your group' },
          { icon: '🌇', label: 'Evening', text: 'Return to Cartagena' },
        ].map(({ icon, label, text }, i) => (
          <div class="flex items-start gap-4 py-4 border-b border-terracotta/20 last:border-0">
            <span class="text-xl flex-shrink-0 mt-0.5">{icon}</span>
            <div>
              <p class="font-medium text-sm text-ink">{label}</p>
              <p class="text-ink/60 text-sm">{text}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="text-center text-muted text-sm mt-8">The day has structure, but does not feel rushed.</p>
    </div>
  </section>

  <!-- FOOD -->
  <section class="py-20 bg-brown text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
        <div class="grid grid-cols-2 gap-3">
          <img src="/images/food-1.jpg" alt="Caribbean food at Casa Gaviota" class="rounded-2xl w-full aspect-square object-cover" loading="lazy" width="300" height="300" />
          <img src="/images/food-2.jpg" alt="Fresh lunch at Casa Gaviota" class="rounded-2xl w-full aspect-square object-cover" loading="lazy" width="300" height="300" />
        </div>
        <div>
          <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 text-white">Food is one of the things guests remember most.</h2>
          <p class="text-white/65 leading-relaxed mb-4">
            Lunch is prepared fresh at the house and served in a relaxed, family-style way. Fresh fish, chicken, coconut rice, patacones, salad, fruit, juice.
          </p>
          <p class="text-white/65 leading-relaxed mb-4">
            Lobster, birthday cakes, drinks, and special menus can be arranged in advance.
          </p>
          <p class="text-white/50 leading-relaxed italic text-sm">
            "It feels like being invited to a beach house where someone cooks well and takes care of you."
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CHOOSE YOUR DAY -->
  <section class="py-20 md:py-28">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-12 text-center text-brown">Choose the kind of day you want</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            icon: '☀️',
            title: 'Relaxed Private Day',
            desc: 'For families, couples, or friends who want a peaceful day by the sea. House + beach + lunch + hammocks + team.',
          },
          {
            icon: '🎂',
            title: 'Birthday or Celebration',
            desc: 'Add music, drinks, cake, decoration, or upgraded food. Celebrate without a crowded beach club.',
          },
          {
            icon: '🦞',
            title: 'Premium Private Day',
            desc: 'Private boat, lobster, cocktails, DJ, or live music. Casa Gaviota as a special private event.',
          },
        ].map(({ icon, title, desc }) => (
          <div class="bg-white rounded-2xl p-7 border border-terracotta/20 shadow-sm hover:shadow-md transition-shadow">
            <div class="text-3xl mb-4">{icon}</div>
            <h3 class="font-serif font-semibold text-xl mb-3 text-brown">{title}</h3>
            <p class="text-ink/65 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="py-20 bg-rose/15">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-6 text-brown">Pricing</h2>
      <p class="text-ink/70 leading-relaxed mb-4">
        Casa Gaviota is a private experience, not a per-person group tour. Price depends on group size, date, transport, food, and extras. The more people, the better the value per person.
      </p>
      <p class="text-ink/70 leading-relaxed mb-10">
        Send us your date and group size and we will give you a clear quote.
      </p>
      <a
        href={WA}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-sand text-brown px-8 py-4 rounded-full text-sm font-semibold hover:opacity-90 transition shadow-md"
      >
        Get a quote on WhatsApp →
      </a>
    </div>
  </section>

  <!-- DAY TRIP FAQ -->
  <section id="faq" class="py-20 md:py-28">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-12 text-center text-brown">Questions</h2>
      <div class="space-y-2">
        {[
          {
            q: 'Is Casa Gaviota private for our group?',
            a: 'Yes. Your group has a private beach house as your base for the day, instead of joining a shared tour or beach club.',
          },
          {
            q: 'Is transport included?',
            a: 'Transport can be included depending on the package. We help coordinate land transport, boat transport, or a combination depending on your group, date, and conditions.',
          },
          {
            q: 'How far is it from Cartagena?',
            a: 'Casa Gaviota is in Barú, outside Cartagena. Travel time is between 1 and 2 hours depending on weather and transport type. We will explain the best option before you book.',
          },
          {
            q: 'Is food included?',
            a: 'Most day trip options include lunch or can include lunch. We will confirm the menu, price, and any upgrades before your visit.',
          },
          {
            q: 'Can we celebrate a birthday?',
            a: 'Yes. Casa Gaviota is a great place for birthdays and small celebrations. We can help with a simple setup, music, cake, drinks, food, and timing.',
          },
          {
            q: 'Is it good for children?',
            a: 'Yes, families are welcome. Adults are responsible for supervising children, especially near the sea.',
          },
          {
            q: 'Can we bring our own drinks?',
            a: 'Yes. You can bring drinks or snacks, and we can help with ice, coolers, or service depending on the package.',
          },
          {
            q: 'Is this a luxury beach club?',
            a: 'No. Casa Gaviota is a private beach house. Beautiful, warm, natural, and comfortable — but not a luxury resort or commercial beach club.',
          },
          {
            q: 'Can we stay overnight?',
            a: 'Yes, Casa Gaviota is also available for overnight stays depending on availability. Ask us if you want to extend the experience.',
          },
        ].map(({ q, a }) => (
          <details class="group bg-white rounded-xl border border-terracotta/20 overflow-hidden">
            <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none font-medium text-sm sm:text-base hover:bg-rose/10 transition-colors">
              <span>{q}</span>
              <span class="text-terracotta flex-shrink-0 text-xl leading-none group-open:rotate-45 transition-transform">+</span>
            </summary>
            <div class="px-5 pb-5 text-ink/65 text-sm leading-relaxed border-t border-terracotta/10 pt-4">
              {a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- DAY TRIP FORM -->
  <section id="book" class="py-20 bg-rose/15">
    <div class="max-w-xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-10">
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold mb-3 text-brown">Ready to plan your private day?</h2>
        <p class="text-muted">Tell us your date and group size. We will get back to you quickly.</p>
      </div>
      <DayTripForm accessKey={KEY} lang="en" client:load />
    </div>
  </section>

  <Footer lang="en" />
</Layout>
