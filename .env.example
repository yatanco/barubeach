# HostHub PMS — Phase 2 availability sync
# Production: set via `wrangler secret put HOSTHUB_API_KEY`
HOSTHUB_API_KEY=your_hosthub_key_here
HOSTHUB_RENTAL_ID=m4jmlqny2d
HOSTHUB_BASE_URL=https://app.hosthub.com/api/2019-03-01

# HostHub iCal feed — CRM booking sync (see README "HostHub iCal sync")
# Production: set via `wrangler secret put HOSTHUB_ICAL_URL`. Never hardcode this value.
HOSTHUB_ICAL_URL=

# Lead capture — Google Apps Script webhook URL
# Production: set via `wrangler secret put LEADS_WEBHOOK_URL`
# Setup: https://script.google.com → new project → doPost() → deploy as web app
LEADS_WEBHOOK_URL=
PUBLIC_META_PIXEL_ID=1039533654806987

# Evergreen Bold checkout URL used in copied deposit/balance messages.
# Production: set via `wrangler pages secret put BOLD_PAYMENT_LINK`.
# Optional locally because the application has a production fallback.
BOLD_PAYMENT_LINK=
