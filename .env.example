# HostHub PMS — Phase 2 availability sync
# Production: set via `wrangler secret put HOSTHUB_API_KEY`
HOSTHUB_API_KEY=your_hosthub_key_here
HOSTHUB_RENTAL_ID=m4jmlqny2d
HOSTHUB_BASE_URL=https://app.hosthub.com/api/2019-03-01

# HostHub iCal feed — CRM booking sync (see README "HostHub iCal sync")
# Production: set via `wrangler secret put HOSTHUB_ICAL_URL`. Never hardcode this value.
HOSTHUB_ICAL_URL=

# Lead capture — Google Apps Script webhook URL
# Production: set via `wrangler secret put LEADS_WEBHOOK_URL`
# Setup: https://script.google.com → new project → doPost() → deploy as web app
LEADS_WEBHOOK_URL=
PUBLIC_META_PIXEL_ID=1039533654806987

# Evergreen Bold checkout URL used in copied deposit/balance messages.
# Production: set via `wrangler pages secret put BOLD_PAYMENT_LINK`.
# Optional locally because the application has a production fallback.
BOLD_PAYMENT_LINK=

# New-lead notification via a Telegram bot (free, no capacity limits).
# Production: set via `wrangler pages secret put TELEGRAM_BOT_TOKEN` / `TELEGRAM_CHAT_ID`.
# Setup:
#   1. Message @BotFather on Telegram, send /newbot, follow the prompts — it replies
#      with a token like "123456789:AAExampleTokenHere". That's TELEGRAM_BOT_TOKEN.
#   2. Open your new bot's chat and send it any message (e.g. "hi") so it's allowed
#      to message you back.
#   3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates in a browser (with your
#      real token) — find "chat":{"id":NNNNNNN} in the JSON. That number is
#      TELEGRAM_CHAT_ID.
# Without both set, no notification is sent — capture-lead still works as before,
# it just silently skips this step.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Meta Conversions API — forwards each Lead event server-side (in addition to the
# browser pixel) for better Event Match Quality and to recover events lost to ad
# blockers / iOS ITP. Production: set via `wrangler pages secret put META_CAPI_ACCESS_TOKEN`.
# Setup: Events Manager → Pixel Casa Gaviota → Configuración → API de conversiones →
# "Generar token de acceso manualmente".
# Without it, sendCapiLead() silently no-ops — capture-lead still works as before.
META_CAPI_ACCESS_TOKEN=
